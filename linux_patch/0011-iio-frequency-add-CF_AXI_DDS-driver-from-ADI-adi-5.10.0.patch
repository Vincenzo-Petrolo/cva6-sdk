+struct axidds_core_info {
+	unsigned int version;
+	bool standalone;
+	bool rate_format_skip_en;
+	bool complex_modified;
+	bool issue_sync_en;
+	struct cf_axi_dds_chip_info *chip_info;
+	unsigned int data_format;
+	unsigned int rate;
