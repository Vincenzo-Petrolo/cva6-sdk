+/**
+ * @brief Probe entry point for the OpenWiFi platform driver.
+ *
+ * @param pdev Platform device.
+ * @return 0 on success, negative errno on failure.
+ */
+static int openwifi_dev_probe(struct platform_device *pdev)
+{
+  struct ieee80211_hw *dev;
+  struct openwifi_priv *priv;
+  int err = -ENODEV;
+  const char *fpga_model;
+  const char *root_compatible;
+  bool use_direct_dac_mode;
+  u32 reg;
+  bool hw_registered = false;
+  bool sysfs_entries_created = false;
+
+  struct device_node *np = pdev->dev.of_node;
+  struct device_node *root_node;
+
+  struct device *tmp_dev;
+#ifndef ENABLE_DIRECT_DAC_MODE
+  struct platform_device *tmp_pdev;
+  struct iio_dev *tmp_indio_dev;
+#endif
+
+  printk("\n");
+
+  if (np) {
+    const struct of_device_id *match;
+
+    match = of_match_node(openwifi_dev_of_ids, np);
+    if (match) {
+      printk("%s openwifi_dev_probe: match!\n", sdr_compatible_str);
+      err = 0;
+    }
+  }
+
+  if (err) {
+    return err;
+  }
+
+  dev = ieee80211_alloc_hw(sizeof(*priv), &openwifi_ops);
+  if (!dev) {
+    printk(KERN_ERR "%s openwifi_dev_probe: ieee80211 alloc failed\n", sdr_compatible_str);
+    err = -ENOMEM;
+    goto err_free_dev;
+  }
+
+  priv = dev->priv;
+  priv->pdev = pdev;
+  priv->hw = dev;
+  priv->rx_dma_regs = NULL;
+  priv->dma_backend = OPENWIFI_DMA_UNKNOWN;
+  priv->rx_dma_watchdog_enabled = false;
+  priv->rx_dma_wd_stall_count = 0;
+  priv->rx_dma_wd_rearm_grace_ticks = 0;
+  INIT_DELAYED_WORK(&priv->rx_dma_watchdog_work, openwifi_rx_dma_watchdog_work);
+
+  fpga_model = NULL;
+  root_compatible = NULL;
+  use_direct_dac_mode = true;
+
+  root_node = of_find_node_by_path("/");
+  if (!root_node) {
+    priv->hardware_type = UNKNOWN_HARDWARE;
+    priv->fpga_type = SMALL_FPGA;
+    printk("%s openwifi_dev_probe: WARNING cannot read root DT node for FPGA model\n", sdr_compatible_str);
+  } else {
+    err = of_property_read_string(root_node, "model", &fpga_model);
+    if (of_property_read_string(root_node, "compatible", &root_compatible) < 0) {
+      root_compatible = NULL;
+    }
+    of_node_put(root_node);
+  }
+  if (root_node && err < 0 && !root_compatible) {
+    priv->hardware_type = UNKNOWN_HARDWARE;
+    priv->fpga_type = SMALL_FPGA;
+    printk("%s openwifi_dev_probe: WARNING unknown openwifi FPGA model %d\n", sdr_compatible_str, err);
+  } else if (root_node) {
+    openwifi_classify_platform_from_model(priv, fpga_model, root_compatible);
+    use_direct_dac_mode = openwifi_platform_uses_direct_dac_mode(fpga_model, root_compatible);
+  }
+
+  /* Seed with a non-WiFi LO so first mac80211 channel set always retunes RF. */
+  priv->actual_rx_lo = OW_RF_INIT_LO_MHZ;
+  priv->actual_tx_lo = OW_RF_INIT_LO_MHZ;
+  priv->band = freq_MHz_to_band(priv->actual_rx_lo);
+  priv->use_short_slot = false; // updated by openwifi_bss_info_changed: BSS_CHANGED_ERP_SLOT
+  priv->ampdu_reference = 0;
+  priv->last_tx_quad_cal_lo = OW_RF_INIT_LO_MHZ;
+  memset(priv->tx_aggr_prev_valid, 0, sizeof(priv->tx_aggr_prev_valid));
+  memset(priv->tx_aggr_prev_key, 0, sizeof(priv->tx_aggr_prev_key));
+
+  /* Find ad9361-phy driver for LO/channel control. */
+  tmp_dev = bus_find_device(&spi_bus_type, NULL, "ad9361-phy", custom_match_spi_dev);
+  if (tmp_dev == NULL) {
+    printk(KERN_ERR "%s find_dev ad9361-phy failed\n", sdr_compatible_str);
+    err = -ENODEV;
+    goto err_free_dev;
+  }
+  printk("%s bus_find_device ad9361-phy: %s. driver_data pointer %p\n", sdr_compatible_str, ((struct spi_device *)tmp_dev)->modalias, (void *)(((struct spi_device *)tmp_dev)->dev.driver_data));
+  if (((struct spi_device *)tmp_dev)->dev.driver_data == NULL) {
+    printk(KERN_ERR "%s find_dev ad9361-phy failed. dev.driver_data == NULL\n", sdr_compatible_str);
+    put_device(tmp_dev);
+    err = -ENODEV;
+    goto err_free_dev;
+  }
+
+  priv->ad9361_phy = ad9361_spi_to_phy((struct spi_device *)tmp_dev);
+  put_device(tmp_dev);
+  if (!priv->ad9361_phy) {
+    printk(KERN_ERR "%s ad9361_spi_to_phy failed\n", sdr_compatible_str);
+    err = -ENODEV;
+    goto err_free_dev;
+  }
+  printk("%s ad9361_spi_to_phy ad9361-phy: %s\n", sdr_compatible_str, priv->ad9361_phy->spi->modalias);
+
+  /* Configure DAC source path: write DATA_SEL=DMA to all DAC channels.
+   * Address differs: Zynq has separate DDS IP at 0x99024000, Theshire has
+   * DAC sub-block within axi_ad9361 at 0x40084000. */
+#ifdef ENABLE_DIRECT_DAC_MODE
+  if (use_direct_dac_mode) {
+    phys_addr_t dac_phys_base = openwifi_platform_is_cheshire(fpga_model, root_compatible)
+        ? OW_DAC_DDS_BASE_THESHIRE
+        : OW_DAC_DDS_BASE_ZYNQ;
+    err = openwifi_set_dac_dma_mode_direct(dac_phys_base);
+    if (err < 0) {
+      goto err_free_dev;
+    }
+    printk("%s openwifi_dev_probe: DAC set to DMA mode at %pa (direct register write)\n",
+      sdr_compatible_str, &dac_phys_base);
+  }
+#else
+  /* Find cf_axi_dds platform device for DAC channel data source selection. */
+  tmp_dev = bus_find_device(&platform_bus_type, NULL, "cf-ad9361-dds-core-lpc", custom_match_platform_dev);
+  if (!tmp_dev) {
+    printk(KERN_ERR "%s bus_find_device platform_bus_type cf-ad9361-dds-core-lpc failed\n", sdr_compatible_str);
+    err = -ENODEV;
+    goto err_free_dev;
+  }
+
+  tmp_pdev = to_platform_device(tmp_dev);
+  if (!tmp_pdev) {
+    printk(KERN_ERR "%s to_platform_device failed\n", sdr_compatible_str);
+    put_device(tmp_dev);
+    err = -ENODEV;
+    goto err_free_dev;
+  }
+
+  tmp_indio_dev = platform_get_drvdata(tmp_pdev);
+  if (!tmp_indio_dev) {
+    printk(KERN_ERR "%s platform_get_drvdata failed\n", sdr_compatible_str);
+    put_device(tmp_dev);
+    err = -ENODEV;
+    goto err_free_dev;
+  }
+
+  priv->dds_st = iio_priv(tmp_indio_dev);
+  put_device(tmp_dev);
+  if (!priv->dds_st) {
+    printk(KERN_ERR "%s iio_priv failed\n", sdr_compatible_str);
+    err = -ENODEV;
+    goto err_free_dev;
+  }
+  printk("%s openwifi_dev_probe: cf-ad9361-dds-core-lpc dds_st->version %08x chip_info->name %s\n",
+    sdr_compatible_str, priv->dds_st->version, priv->dds_st->chip_info->name);
+  cf_axi_dds_datasel(priv->dds_st, -1, DATA_SEL_DMA);
+  printk("%s openwifi_dev_probe: cf_axi_dds_datasel DATA_SEL_DMA\n", sdr_compatible_str);
+#endif
+
+  if (test_mode & ~OW_TEST_MODE_SHORT_GI_MASK) {
+    printk(KERN_INFO "%s openwifi_dev_probe: ignoring unsupported test_mode bits 0x%x\n",
+      sdr_compatible_str, test_mode & ~OW_TEST_MODE_SHORT_GI_MASK);
+  }
+
+  priv->rssi_correction = rssi_correction_lookup_table(OW_DEFAULT_RSSI_CORR_FREQ_MHZ);
+  priv->last_auto_fpga_lbt_th = rssi_dbm_to_rssi_half_db(OW_DEFAULT_DEMOD_TH_DBM, priv->rssi_correction);
+
+  priv->rf_bw = OW_RF_BW_40MHZ_HZ;
+
+  priv->xpu_cfg = XPU_NORMAL;
+
+  priv->openofdm_tx_cfg = OPENOFDM_TX_NORMAL;
+  priv->openofdm_rx_cfg = OPENOFDM_RX_NORMAL;
+
+  printk("%s openwifi_dev_probe: priv->rf_bw == %dHz. bool for 20MHz %d, 40MHz %d\n",
+    sdr_compatible_str, priv->rf_bw,
+    (priv->rf_bw == OW_RF_BW_20MHZ_HZ), (priv->rf_bw == OW_RF_BW_40MHZ_HZ));
+  if (priv->rf_bw == OW_RF_BW_20MHZ_HZ) { // kept for legacy testing only
+    priv->rx_intf_cfg = RX_INTF_BYPASS;
+    priv->tx_intf_cfg = TX_INTF_BYPASS;
+  } else if (priv->rf_bw == OW_RF_BW_40MHZ_HZ) {
+    priv->rx_intf_cfg = RX_INTF_BW_20MHZ_AT_0MHZ_ANT0;
+    if (TX_OFFSET_TUNING_ENABLE) {
+      priv->tx_intf_cfg = TX_INTF_BW_20MHZ_AT_N_10MHZ_ANT0; // Let's use rx0 tx0 as default mode, because it works for both 9361 and 9364
+    } else {
+      priv->tx_intf_cfg = TX_INTF_BW_20MHZ_AT_0MHZ_ANT0;
+    }
+  } else {
+    printk("%s openwifi_dev_probe: Warning! priv->rf_bw == %dHz (should be %u or %u)\n",
+      sdr_compatible_str, priv->rf_bw, OW_RF_BW_20MHZ_HZ, OW_RF_BW_40MHZ_HZ);
+    err = -EBADRQC;
+    goto err_free_dev;
+  }
+
+  printk("%s openwifi_dev_probe: test_mode %x TX_OFFSET_TUNING_ENABLE %d init_tx_att %d\n",
+    sdr_compatible_str, test_mode, TX_OFFSET_TUNING_ENABLE, init_tx_att);
+
+  if (priv->tx_intf_cfg == TX_INTF_BW_20MHZ_AT_0MHZ_ANT0
+      || priv->tx_intf_cfg == TX_INTF_BW_20MHZ_AT_N_10MHZ_ANT0) {
+    priv->runtime_tx_ant_cfg = OPENWIFI_TX_ANT_MIN;
+  } else if (priv->tx_intf_cfg == TX_INTF_BW_20MHZ_AT_0MHZ_ANT_BOTH) {
+    priv->runtime_tx_ant_cfg = OPENWIFI_TX_ANT_MAX;
+  } else {
+    priv->runtime_tx_ant_cfg = OPENWIFI_TX_ANT_SINGLE_CHAIN_MAX;
+  }
+  if (priv->rx_intf_cfg == RX_INTF_BW_20MHZ_AT_0MHZ_ANT0) {
+    priv->runtime_rx_ant_cfg = OPENWIFI_RX_ANT_MIN;
+  } else {
+    priv->runtime_rx_ant_cfg = OPENWIFI_RX_ANT_MAX;
+  }
+
+  priv->ctrl_out.en_mask = AD9361_CTRL_OUT_EN_MASK;
+  priv->ctrl_out.index = (priv->rx_intf_cfg == RX_INTF_BW_20MHZ_AT_0MHZ_ANT0
+    ? AD9361_CTRL_OUT_INDEX_ANT0 : AD9361_CTRL_OUT_INDEX_ANT1);
+
+  memset(priv->drv_rx_reg_val, 0, sizeof(priv->drv_rx_reg_val));
+  memset(priv->drv_tx_reg_val, 0, sizeof(priv->drv_tx_reg_val));
+  memset(priv->drv_xpu_reg_val, 0, sizeof(priv->drv_xpu_reg_val));
+  memset(priv->rf_reg_val, 0, sizeof(priv->rf_reg_val));
+
+  priv->rf_reg_val[RF_TX_REG_IDX_ATT] = init_tx_att;
+
+  /* Turn radio on by default when probing. */
+  err = openwifi_set_antenna(dev, priv->runtime_tx_ant_cfg, priv->runtime_rx_ant_cfg);
+  if (err) {
+    printk("%s openwifi_dev_probe: WARNING openwifi_set_antenna FAIL %d\n", sdr_compatible_str, err);
+    err = -EIO;
+    goto err_free_dev;
+  }
+  reg = ad9361_spi_read(priv->ad9361_phy->spi, REG_CTRL_OUTPUT_POINTER);
+  printk("%s openwifi_dev_probe: ad9361_spi_read REG_CTRL_OUTPUT_POINTER 0x%02x\n", sdr_compatible_str, reg);
+  reg = ad9361_spi_read(priv->ad9361_phy->spi, REG_CTRL_OUTPUT_ENABLE);
+  printk("%s openwifi_dev_probe: ad9361_spi_read REG_CTRL_OUTPUT_ENABLE 0x%02x\n", sdr_compatible_str, reg);
+
+  reg = ad9361_get_tx_atten(priv->ad9361_phy, openwifi_tx_atten_channel_for_runtime_cfg(priv->runtime_tx_ant_cfg));
+  if (reg == (AD9361_RADIO_ON_TX_ATT + priv->rf_reg_val[RF_TX_REG_IDX_ATT])) {
+    priv->radio_enabled_cached = true;
+    printk("%s openwifi_dev_probe: rfkill radio on\n", sdr_compatible_str);
+  } else {
+    printk("%s openwifi_dev_probe: WARNING rfkill radio on failed. tx att read %d require %d\n",
+      sdr_compatible_str, reg, AD9361_RADIO_ON_TX_ATT + priv->rf_reg_val[RF_TX_REG_IDX_ATT]);
+  }
+
+  priv->drv_xpu_reg_val[DRV_XPU_REG_IDX_GIT_REV] = GIT_REV;
+
+  /* DELIBERATE mac80211 contract deviation for research driver:
+   * mac80211.h:2522 documents max_rates as "maximum number of alternate rate
+   * retry stages the hw can handle."  Our FPGA physically retries at ONE rate
+   * (rates[0]); rates[1..3] are never attempted by hardware.
+   *
+   * WHY THIS IS SAFE despite the contract mismatch:
+   * Minstrel fills rates[0..2] before calling openwifi_tx().  The FPGA executes
+   * only rates[0] for rates[0].count attempts.  The TX status path reports:
+   *   rates[0].count = actual_retries,  rates[1].idx = -1  (sdr_tx.c:931)
+   * Minstrel's status handler (minstrel_ht.c:1219-1229) iterates the rates[]
+   * array and calls minstrel_ht_txstat_valid() on each stage.  It returns false
+   * when idx < 0 OR count == 0.  Since rates[1].idx = -1, the loop terminates
+   * after stage 0.  Minstrel counts attempts/success ONLY for stage 0 — no
+   * corruption, no false credit for stages 1-2.
+   *
+   * WHY max_rates=4 (not 1) is better for rate adaptation:
+   *   - has_mrr=true (minstrel_ht.c:1838): enables multi-rate mode
+   *   - 3-stage rate table (minstrel_ht.c:1441-1447): max_tp + max_prob
+   *   - sample rotation (minstrel_ht.c:1460): systematic rate probing
+   *   NOTE: spatial mux downgrade (minstrel_ht.c:1231) requires rate2->attempts
+   *   > 30 on max_tp_rate[1], which never accumulates because rates[1] is never
+   *   attempted.  This benefit is illusory for single-stage HW.
+   * With max_rates=1, minstrel puts ALL retries on one rate — every failure
+   * is 100% failure at that rate, no multi-rate exploration.
+   *
+   * RETRY BUDGET: minstrel_calc_retransmit (minstrel_ht.c:1260-1316) computes
+   * retry_count PER STAGE independently based on segment_size (6000us) and
+   * max_retry (7).  For fast rates (MCS 5-7, ~200us/attempt), retry_count
+   * reaches max_retry=7 because tx_time << segment_size.  For slow rates
+   * (MCS 0, ~2ms/attempt), retry_count is 2-3.  So the FPGA's effective retry
+   * count is rate-dependent, NOT a fixed "~2".  At the high MCS rates where
+   * this optimization matters most, retry_count stays at 7.
+   * MEASURE after deployment: if retry rate is high, consider max_rates=2.
+   *
+   * TODO(openwifi-max-rates-contract): This is a research hack, not a
+   * spec-correct implementation.  To make it proper, the driver would need
+   * to either: (a) implement multi-rate HW retry in FPGA so rates[1..3]
+   * are actually attempted, or (b) set max_rates=1 and find another way to
+   * make minstrel less conservative (e.g., minstrel module parameters). */
+  dev->max_rates = 4;
+  SET_IEEE80211_DEV(dev, &pdev->dev);
+  platform_set_drvdata(pdev, dev);
+
+  openwifi_probe_init_supported_bands(dev);
+  openwifi_probe_init_wiphy_caps(dev);
+
+  memset(priv->dest_mac_addr_queue_map, 0, sizeof(priv->dest_mac_addr_queue_map));
+  priv->slice_idx = OW_SLICE_IDX_INVALID;
+  sg_init_table(&(priv->tx_sg), 1);
+  openwifi_probe_init_mac_addr(dev);
+
+  spin_lock_init(&priv->lock);
+  spin_lock_init(&priv->tx_submit_lock);
+  err = ieee80211_register_hw(dev);
+  if (err) {
+    pr_err(KERN_ERR "%s openwifi_dev_probe: WARNING Cannot register device\n", sdr_compatible_str);
+    err = -EIO;
+    goto err_free_dev;
+  }
+  hw_registered = true;
+  printk("%s openwifi_dev_probe: ieee80211_register_hw %d\n", sdr_compatible_str, err);
+
+  err = openwifi_probe_create_sysfs_entries(pdev, priv);
+  if (err < 0) {
+    goto err_free_dev;
+  }
+  sysfs_entries_created = true;
+
+  openwifi_probe_init_stats(priv);
+  wiphy_info(dev->wiphy, "hwaddr %pm, FPGA %s\n", priv->mac_addr, priv->rf->name);
+
+  openwifi_rfkill_init(dev);
+  return 0;
+
+err_free_dev:
+  if (sysfs_entries_created) {
+    sysfs_remove_bin_file(&pdev->dev.kobj, &priv->bin_iq);
+    sysfs_remove_group(&pdev->dev.kobj, &tx_intf_attribute_group);
+    sysfs_remove_group(&pdev->dev.kobj, &stat_attribute_group);
+    sysfs_remove_group(&pdev->dev.kobj, &stabilization_attribute_group);
+  }
+  if (hw_registered) {
+    ieee80211_unregister_hw(dev);
+  }
+  if (dev) {
+    ieee80211_free_hw(dev);
+  }
+
+  return err;
+}
+
+/**
+ * @brief Remove entry point for the OpenWiFi platform driver.
+ *
+ * @param pdev Platform device.
+ * @return 0 always. Platform core ignores non-zero remove return values.
+ */
+static int openwifi_dev_remove(struct platform_device *pdev)
+{
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv;
+  int cleanup_ret;
+
+  if (!dev) {
+    pr_info("%s openwifi_dev_remove: dev %p\n", sdr_compatible_str, (void*)dev);
+    return 0;
+  }
+  priv = dev->priv;
+
+  sysfs_remove_bin_file(&pdev->dev.kobj, &priv->bin_iq);
+  sysfs_remove_group(&pdev->dev.kobj, &tx_intf_attribute_group);
+  sysfs_remove_group(&pdev->dev.kobj, &stat_attribute_group);
+  sysfs_remove_group(&pdev->dev.kobj, &stabilization_attribute_group);
+
+  openwifi_rfkill_exit(dev);
+  ieee80211_unregister_hw(dev);
+
+  /* openwifi_stop() runs during unregister. If resources remain active, retry
+   * cleanup here. Do not rely on non-zero .remove returns for safety. */
+  if (openwifi_runtime_dma_resources_active(priv)) {
+    cleanup_ret = openwifi_cleanup_runtime_dma_resources(priv, "openwifi_dev_remove");
+    if (cleanup_ret) {
+      pr_err("%s openwifi_dev_remove: runtime DMA resources still active after retry (ret=%d); keeping ieee80211_hw allocated to preserve memory safety (reload/reprobe required)\n",
+        sdr_compatible_str, cleanup_ret);
+      platform_set_drvdata(pdev, NULL);
+      return 0;
+    }
+  }
+
+  if (openwifi_runtime_dma_resources_active(priv)) {
+    pr_err("%s openwifi_dev_remove: runtime resources still active unexpectedly; keeping ieee80211_hw allocated to preserve memory safety\n",
+      sdr_compatible_str);
+    platform_set_drvdata(pdev, NULL);
+    return 0;
+  }
+
+  ieee80211_free_hw(dev);
+  platform_set_drvdata(pdev, NULL);
+  return 0;
+}
+
+static struct platform_driver openwifi_dev_driver = {
+  .driver = {
+    .name = "sdr,sdr",
+    .owner = THIS_MODULE,
+    .of_match_table = openwifi_dev_of_ids,
+  },
+  .probe = openwifi_dev_probe,
+  .remove = openwifi_dev_remove,
+};
+
+module_platform_driver(openwifi_dev_driver);
