+    dma_buf = (u8 *)bounce_buf;
+    if (priv->stat.stat_enable) {
+      OW_U32_INC(priv->stat.tx_bounce_buf_count);
+    }
+  }
+
+  retry_limit_hw_value = (retry_limit_raw == 0 ? 0 : ((retry_limit_raw - 1) & OW_TX_RETRY_LIMIT_MASK));
+
+  queue_idx = drv_ring_idx; /* driver ring index maps 1:1 to FPGA queue index */
+
+  if (use_cts_protect) {
+    rate_signal_value = (use_ht_rate ? rate_hw_value : wifi_mcs_table_11b_force_up[rate_hw_value]);
+    cts_rate_signal_value = wifi_mcs_table_11b_force_up[cts_rate_hw_value];
+    cts_reg = (use_cts_protect << 31
+      | cts_use_traffic_rate << 30 | cts_duration << 8 | cts_rate_signal_value << 4 | rate_signal_value);
+  }
+  phy_hdr_config = (ht_aggr_start << 20 | rate_hw_value << 16 | use_ht_rate << 15 | use_short_gi << 14 | use_ht_aggr << 13 | len_psdu);
+  tx_config = (prio << 26 | ring->bd_wr_idx << 20 | queue_idx << 18 | retry_limit_hw_value << 14 | pkt_need_ack << 13 | num_dma_symbol);
+
+  /* We must be sure that tx_flags is written last because the HW
+   * looks at it to check if the rest of data is valid or not
+   */
+  /* We must be sure this has been written before following HW
+   * register write, because this write will make the HW attempts
+   * to DMA the just-written data
+   */
+
+  /* DMA completion polling before acquiring the spinlock.
+   * ADI axi_dmac is interrupt-driven (IRQ handler calls vchan_cookie_complete).
+   * If the IRQ lands on the same CPU holding spin_lock_irqsave, the completion
+   * ISR cannot fire and the polling loop always times out → packet dropped.
+   * Moving the poll here keeps IRQs enabled so the DMAC ISR can run.
+   * priv->tx_cookie is stable (set by previous locked submit, zero-init on first call).
+   * priv->tx_chan is stable (set once in openwifi_start, never changed).
+   * Worst-case IRQ-off reduced from ~450us to ~50us (FPGA MMIO + DMA submit only). */
+  /* DMA completion check before acquiring spinlock (IRQs enabled so DMAC ISR can run).
+   * If still stalled from a previous timeout, do one non-blocking check and fast-drop
+   * rather than burning the full poll budget on a wedged channel.
+   * Otherwise poll up to tx_dma_wait_us microseconds for the previous transfer. */
+  /* Worker is mid-terminate -- drop immediately, don't poll or submit. */
+  if (READ_ONCE(priv->tx_dma_terminating)) {
+    goto openwifi_tx_early_out_free_bounce;
+  }
+
+  cookie_snapshot = READ_ONCE(priv->tx_cookie);
+  if (cookie_snapshot == 0) {
+    /* First submit (no previous cookie): skip completion polling.
+     * If channel is already marked stalled without a valid cookie, fast-drop
+     * instead of attempting submit on ambiguous DMA state. */
+    if (READ_ONCE(priv->tx_dma_stalled)) {
+      OW_U32_INC(priv->stat.tx_dma_stall_fast_drop_count);
+      if (printk_timed_ratelimit(&priv->tx_timeout_warn_jiffies,
+          clamp(tx_timeout_warn_interval_ms, OW_WARN_INTERVAL_MS_MIN, OW_WARN_INTERVAL_MS_MAX))) {
+        printk("%s openwifi_tx: DMA stalled with invalid cookie 0, fast-drop\n",
+               sdr_compatible_str);
+      }
+      goto openwifi_tx_early_out_free_bounce;
+    }
+  } else if (READ_ONCE(priv->tx_dma_stalled)) {
+    status = dma_async_is_tx_complete(priv->tx_chan, cookie_snapshot, NULL, NULL);
+    if (status == DMA_COMPLETE) {
+      /* Fast-path recovery must clear stall and wake queues atomically.
+       * Clearing without waking can leave queues permanently stopped. */
+      spin_lock_irqsave(&priv->lock, flags);
+      if (READ_ONCE(priv->tx_dma_stalled) && !READ_ONCE(priv->tx_dma_terminating)) {
+        int idx_hw_queue;
+
+        WRITE_ONCE(priv->tx_dma_stalled, false);
+        WRITE_ONCE(priv->tx_dma_stall_recovery_cycles, 0);
+        WRITE_ONCE(priv->tx_dma_stall_window_count, 0);
+        WRITE_ONCE(priv->tx_dma_stall_first_jiffies, 0);
+        OW_U32_INC(priv->stat.tx_dma_stall_clear_count);
+        for (idx_hw_queue = 0; idx_hw_queue < MAX_NUM_HW_QUEUE; idx_hw_queue++) {
+          if (priv->tx_ring[idx_hw_queue].stop_prio_mask != 0U) {
+            ow_tx_ring_wake_all_stopped(dev, &priv->tx_ring[idx_hw_queue]);
+          }
+        }
+      }
+      spin_unlock_irqrestore(&priv->lock, flags);
+    } else {
+      OW_U32_INC(priv->stat.tx_dma_stall_fast_drop_count);
+      if (status == DMA_ERROR) {
+        OW_U32_INC(priv->stat.tx_dma_error_count);
+      }
+      if (printk_timed_ratelimit(&priv->tx_timeout_warn_jiffies,
+          clamp(tx_timeout_warn_interval_ms, OW_WARN_INTERVAL_MS_MIN, OW_WARN_INTERVAL_MS_MAX))) {
+        printk("%s openwifi_tx: DMA stalled, fast-drop status %d\n",
+               sdr_compatible_str, status);
+      }
+      goto openwifi_tx_early_out_free_bounce;
+    }
+  } else {
+    {
+      int poll_step = clamp(tx_dma_poll_step_us, OW_TX_DMA_POLL_STEP_US_MIN, OW_TX_DMA_POLL_STEP_US_MAX);
+      max_polls = clamp(tx_dma_wait_us, OW_TX_DMA_POLL_US_MIN, OW_TX_DMA_POLL_US_MAX) / poll_step;
+      status = dma_async_is_tx_complete(priv->tx_chan, cookie_snapshot, NULL, NULL);
+      while (delay_count < max_polls && status != DMA_COMPLETE) {
+        status = dma_async_is_tx_complete(priv->tx_chan, cookie_snapshot, NULL, NULL);
+        delay_count++;
+        udelay(poll_step);
+      }
+    }
+#ifdef DEBUG_OPENWIFI
+    {
+      static u32 tx_dma_count;
+      tx_dma_count++;
+      if (delay_count > 0 && (tx_dma_count & OW_TX_DELAY_LOG_MASK) == 1) {
+        printk(KERN_INFO "%s tx_dma_wait#%u: delay_count=%d (%d us, step=%d)\n",
+          sdr_compatible_str, tx_dma_count, delay_count,
+          delay_count * clamp(tx_dma_poll_step_us, OW_TX_DMA_POLL_STEP_US_MIN, OW_TX_DMA_POLL_STEP_US_MAX),
+          clamp(tx_dma_poll_step_us, OW_TX_DMA_POLL_STEP_US_MIN, OW_TX_DMA_POLL_STEP_US_MAX));
+      }
+    }
+#endif
+    if (status == DMA_COMPLETE) {
+      /* proceed to DMA submit */
+    } else if (status == DMA_ERROR) {
+      /* Unreachable on ADI backend: dma_cookie_status() only returns
+       * DMA_COMPLETE or DMA_IN_PROGRESS. Kept as a safety net for other backends. */
+      OW_U32_INC(priv->stat.tx_dma_error_count);
+      OW_U32_INC(priv->stat.tx_dma_stall_enter_count);
+      if (printk_timed_ratelimit(&priv->tx_timeout_warn_jiffies,
+          clamp(tx_timeout_warn_interval_ms, OW_WARN_INTERVAL_MS_MIN, OW_WARN_INTERVAL_MS_MAX))) {
+        printk("%s openwifi_tx: DMA_ERROR -> stall (errors=%u)\n",
+               sdr_compatible_str, READ_ONCE(priv->stat.tx_dma_error_count));
+      }
+      openwifi_tx_enter_stall(priv, dev);
+      goto openwifi_tx_early_out_free_bounce;
+    } else {
+      /* DMA_IN_PROGRESS: timed out after poll budget */
+      OW_U32_INC(priv->stat.tx_dma_timeout_count);
+      OW_U32_INC(priv->stat.tx_dma_stall_enter_count);
+      if (printk_timed_ratelimit(&priv->tx_timeout_warn_jiffies,
+          clamp(tx_timeout_warn_interval_ms, OW_WARN_INTERVAL_MS_MIN, OW_WARN_INTERVAL_MS_MAX))) {
+        printk("%s openwifi_tx: WARNING status!=DMA_COMPLETE delay_count=%d -> stall (timeouts=%u)\n",
+               sdr_compatible_str, delay_count, READ_ONCE(priv->stat.tx_dma_timeout_count));
+      }
+      openwifi_tx_enter_stall(priv, dev);
+      goto openwifi_tx_early_out_free_bounce;
+    }
+  }
+
+  /* DMA map BEFORE acquiring priv->lock — the cache flush (~10-50 us on
+   * non-coherent RISC-V for 1500B) does not need shared state and was the
+   * largest single cost inside the locked TX submit section. */
+  dma_mapping_addr = dma_map_single(priv->tx_chan->device->dev, dma_buf,
+         num_dma_byte, DMA_MEM_TO_DEV);
+
+  if (dma_mapping_error(priv->tx_chan->device->dev, dma_mapping_addr)) {
+    printk_ratelimited("%s openwifi_tx: WARNING sn %d TX DMA mapping error\n", sdr_compatible_str, ring->bd_wr_idx);
+    goto openwifi_tx_early_out_free_bounce;
+  }
+
+  spin_lock_irqsave(&priv->lock, flags); /* ring stop mask is shared with TX interrupt path */
+
+  /* Recheck after DMA poll + DMA map: the recovery worker may have set
+   * tx_dma_terminating during either the poll (up to tx_dma_wait_us window)
+   * or the dma_map_single cache flush.  Without this re-check we could
+   * submit into a channel mid-terminate. */
+  if (READ_ONCE(priv->tx_dma_terminating)) {
+    goto openwifi_tx_after_dma_mapping;
+  }
+
+  /* Check whether FPGA DMA FIFO and target queue have enough room. */
+  dma_fifo_no_room_flag = tx_intf_api->TX_INTF_REG_S_AXIS_FIFO_NO_ROOM_read();
+  hw_queue_len = tx_intf_api->TX_INTF_REG_QUEUE_FIFO_DATA_COUNT_read();
+  /* Check FPGA FIFO/queue room. hw_count clamped to avoid unsigned underflow.
+   * hard_no_room: FPGA physically full → must NOT submit DMA.
+   * soft_threshold: room available but low → stop queue for future pkts, current proceeds. */
+  {
+    u32 hw_count = (hw_queue_len >> (queue_idx * OW_TX_HW_QUEUE_LEN_STRIDE_BITS)) & OW_TX_HW_QUEUE_LEN_MASK;
+    u32 queue_avail = (hw_count >= NUM_TX_BD) ? 0 : (NUM_TX_BD - hw_count);
+    bool hard_no_room = ((dma_fifo_no_room_flag >> queue_idx) & 1) != 0 || (hw_count >= NUM_TX_BD);
+    bool soft_threshold = !hard_no_room && (queue_avail <= RING_ROOM_THRESHOLD);
+    if (hard_no_room || soft_threshold || ring->stop_prio_mask != 0U) {
+      bool prio_already_stopped = ow_tx_ring_stop_has_prio(ring, prio);
+
+      if (priv->drv_tx_reg_val[DRV_TX_REG_IDX_PRINT_CFG] & DMESG_LOG_NORMAL_QUEUE_STOP) {
+        printk("%s openwifi_tx: WARNING ieee80211_stop_queue prio%d queue%d no room flag%x hwq len%08x request%d wr%d rd%d\n", sdr_compatible_str,
+                prio, queue_idx, dma_fifo_no_room_flag, hw_queue_len, num_dma_symbol, ring->bd_wr_idx, ring->bd_rd_idx);
+      }
+      /* NOTE: ieee80211_stop_queue under lock is intentional here.  This is
+       * the queue-full path (rare — only when FPGA FIFO/queue runs out of room).
+       * The hot-path wake calls are already outside lock (Phase TX-B wake_masks).
+       * Moving stop_queue outside lock would require snapshot + defer for a path
+       * that fires ~0.1% of TX packets.  Not worth the complexity. */
+      if (!prio_already_stopped) {
+        ieee80211_stop_queue(dev, prio);
+        ow_tx_ring_stop_set_prio(ring, prio);
+        if (priv->stat.stat_enable) {
+          priv->stat.tx_prio_stop1_num[prio]++;
+          priv->stat.tx_queue_stop1_num[queue_idx]++;
+        }
+      }
+      if (hard_no_room) {
+        OW_U32_INC(priv->stat.tx_dma_hard_stop_count);
+      } else {
+        OW_U32_INC(priv->stat.tx_dma_soft_stop_count);
+      }
+    }
+    if (hard_no_room) {
+      /* TODO(openwifi-tx): evaluate deferred retry for hard_no_room drops.
+       * Current behavior reports driver drop and does not requeue this skb.
+       * Required constraints for a safe design:
+       * 1) bounded memory: max one pending skb per ring for first iteration;
+       * 2) deterministic lock order: tx_submit_lock -> priv->lock only;
+       * 3) no skb double-mutation: perform/duplicate room precheck before
+       *    delimiter/padding/bounce-buffer transformations;
+       * 4) strict lifecycle handling: flush pending skbs on stop/remove/reset
+       *    with explicit tx status reporting;
+       * 5) queue semantics: wake queues only after pending slot is consumed or
+       *    dropped to avoid reordering/starvation. */
+      goto openwifi_tx_after_dma_mapping;
+    }
+  }
+  /* End of queue room check. */
+
+  sg_init_table(&(priv->tx_sg), 1); /* single-segment mapping per TX submit */
+  sg_dma_address( &(priv->tx_sg) ) = dma_mapping_addr;
+  sg_dma_len( &(priv->tx_sg) ) = num_dma_byte;
+
+  tx_intf_api->TX_INTF_REG_CTS_TOSELF_CONFIG_write(cts_reg);
+  tx_intf_api->TX_INTF_REG_TX_CONFIG_write(tx_config);
+  tx_intf_api->TX_INTF_REG_PHY_HDR_CONFIG_write(phy_hdr_config);
+  priv->txd = priv->tx_chan->device->device_prep_slave_sg(priv->tx_chan, &(priv->tx_sg),1,DMA_MEM_TO_DEV, DMA_CTRL_ACK | DMA_PREP_INTERRUPT, NULL);
+  if (!(priv->txd)) {
+    printk_ratelimited("%s openwifi_tx: WARNING sn %d device_prep_slave_sg %p\n", sdr_compatible_str, ring->bd_wr_idx, (void*)(priv->txd));
+    goto openwifi_tx_after_dma_mapping;
+  }
+
+  WRITE_ONCE(priv->tx_cookie, priv->txd->tx_submit(priv->txd));
+
+  if (dma_submit_error(READ_ONCE(priv->tx_cookie))) {
+    printk_ratelimited("%s openwifi_tx: WARNING sn %d dma_submit_error(tx_cookie) %d\n", sdr_compatible_str,
+           ring->bd_wr_idx, (u32)(READ_ONCE(priv->tx_cookie)));
+    WRITE_ONCE(priv->tx_cookie, 0);
+    goto openwifi_tx_after_dma_mapping;
+  }
+
+  /* TX submit succeeded; commit descriptor ownership to software ring state. */
+  ring->bds[ring->bd_wr_idx].prio = prio;
+  ring->bds[ring->bd_wr_idx].len_mpdu = len_mpdu;
+  ring->bds[ring->bd_wr_idx].seq_no = seq_no;
+  ring->bds[ring->bd_wr_idx].skb_linked = skb;
+  ring->bds[ring->bd_wr_idx].dma_mapping_addr = dma_mapping_addr;
+  ring->bds[ring->bd_wr_idx].dma_len_bytes = num_dma_byte;
+  ring->bds[ring->bd_wr_idx].bounce_buf = bounce_buf;
+
+  /* Build actual_tx_rate from the final rate after all driver overrides.
+   * Start from original mac80211 flags (rc_flags), then patch only the
+   * bits that the overrides actually changed (MCS, SHORT_GI).  This
+   * preserves 40_MHZ_WIDTH, GREEN_FIELD, SHORT_PREAMBLE, STBC, LDPC
+   * which minstrel-HT uses for rate bucket selection. */
+  {
+    struct ieee80211_tx_rate atr;
+    u16 atr_flags = rc_flags;
+    if (use_ht_rate) {
+      atr_flags |= IEEE80211_TX_RC_MCS;
+    } else {
+      atr_flags &= ~IEEE80211_TX_RC_MCS;
+    }
+    if (use_short_gi) {
+      atr_flags |= IEEE80211_TX_RC_SHORT_GI;
+    } else {
+      atr_flags &= ~IEEE80211_TX_RC_SHORT_GI;
+    }
+    atr.idx = (s8)rate_hw_value;
+    atr.count = 0; /* filled by openwifi_tx_interrupt as nof_retx + 1 */
+    atr.flags = atr_flags;
+    ring->bds[ring->bd_wr_idx].actual_tx_rate = atr;
+  }
+
+  ring->bd_wr_idx = ((ring->bd_wr_idx+1)&(NUM_TX_BD-1));
+
+  dma_async_issue_pending(priv->tx_chan);
+
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  if (priv->stat.stat_enable) {
+    priv->stat.tx_prio_num[prio]++;
+    priv->stat.tx_queue_num[queue_idx]++;
+  }
+
+  tx_submit_locked = false;
+  spin_unlock(&priv->tx_submit_lock);
+  return;
+
+openwifi_tx_after_dma_mapping:
+  dma_unmap_single(priv->tx_chan->device->dev, dma_mapping_addr, num_dma_byte, DMA_MEM_TO_DEV);
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+openwifi_tx_early_out_free_bounce:
+  if (tx_submit_locked) {
+    tx_submit_locked = false;
+    spin_unlock(&priv->tx_submit_lock);
+  }
+  /* Free bounce buffer on TX error path (kfree(NULL) is safe). */
+  kfree(bounce_buf);
+  bounce_buf = NULL;
+  report_pkt_loss_due_to_driver_drop(dev, skb, len_mpdu);
+  return;
+
+openwifi_tx_early_out:
+  if (tx_submit_locked) {
+    tx_submit_locked = false;
+    spin_unlock(&priv->tx_submit_lock);
+  }
+  report_pkt_loss_due_to_driver_drop(dev, skb, len_mpdu);
+}
diff --git a/drivers/sdr_utils.c b/drivers/sdr_utils.c
new file mode 100644
index 0000000..e3f209e
--- /dev/null
+++ b/drivers/sdr_utils.c
@@ -0,0 +1,606 @@
+/**
+ * @file sdr_utils.c
+ * @brief Shared SDR helper routines (RF control, RSSI utilities, antenna, misc).
+ *
+ * Included only by sdr.c (single translation unit split).
+ */
+
+//=============================================================================
+// Shared Constants
+//=============================================================================
+
+#define OW_AD9361_TX_CH_ANT0                  1U
+#define OW_AD9361_TX_CH_ANT1                  2U
+#define OW_RSSI_HALF_DB_PER_DB                2
+#define OW_RSSI_CORR_2G_DB                    153
+#define OW_RSSI_CORR_5G_DB                    145
+#define OW_AUTO_LBT_TH_DBM_DEFAULT            (-62)
+#define OW_HZ_PER_MHZ                         1000000ULL
+#define OW_RFPLL_RATE_DIV_SHIFT               1U
+#define OW_TX_QUAD_CAL_REDO_DELTA_MHZ         100U
+#define OW_OPENOFDM_POWER_THRES_RSSI_SHIFT    16U
+
+#define OW_TX_ANT_CHAIN0_MASK BIT(0)
+#define OW_TX_ANT_CHAIN1_MASK BIT(1)
+#define OW_RX_ANT_CHAIN0_SELECT 0U
+#define OW_RX_ANT_CHAIN1_SELECT 1U
+
+static const int tx_intf_fo_mapping[] = {0, 0, 0, 0, 0, -10, 10, -10, 10};
+static const int rx_intf_fo_mapping[] = {0, 0, 0, 0, -10, -10, 10, 10};
+
+#ifdef ENABLE_DIRECT_DAC_MODE
+/**
+ * @brief Force ADI DAC core data path to DMA mode via direct register writes.
+ *
+ * @param dac_phys_base Physical base address of the DAC DDS register block.
+ * @return 0 on success, -ENOMEM on ioremap failure.
+ */
+static int openwifi_set_dac_dma_mode_direct(phys_addr_t dac_phys_base)
+{
+  void __iomem *dac_base;
+  int channel_idx;
+
+  dac_base = ioremap(dac_phys_base, OW_DAC_DDS_REG_SIZE);
+  if (!dac_base) {
+    printk(KERN_ERR "%s openwifi_set_dac_dma_mode_direct: ioremap failed for %pa\n",
+      sdr_compatible_str, &dac_phys_base);
+    return -ENOMEM;
+  }
+
+  for (channel_idx = 0; channel_idx < OW_DAC_NUM_BUF_CHANNELS; channel_idx++) {
+    u32 chan_offset_bytes = OW_DAC_REG_CHAN_CNTRL_7_OFFSET + channel_idx * OW_DAC_CHAN_STRIDE;
+
+    writel(OW_DAC_DATA_SEL_DMA, dac_base + chan_offset_bytes);
+  }
+
+  iounmap(dac_base);
+  return 0;
+}
+#endif
+
+//=============================================================================
+// RF Kill Helpers
+//=============================================================================
+
+/**
+ * @brief Check whether the RF TX path is effectively enabled.
+ *
+ * @param priv Driver private state.
+ * @return true if TX attenuation indicates radio-on state, false otherwise.
+ */
+static bool openwifi_is_radio_enabled(struct openwifi_priv *priv)
+{
+  int tx_att0_mdB;
+  int tx_att1_mdB;
+
+  tx_att0_mdB = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT0);
+  tx_att1_mdB = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT1);
+  if (tx_att0_mdB < 0 || tx_att1_mdB < 0) {
+    printk(KERN_WARNING "%s openwifi_is_radio_enabled: ad9361_get_tx_atten failed (%d, %d), keep cached=%d\n",
+      sdr_compatible_str, tx_att0_mdB, tx_att1_mdB, priv->radio_enabled_cached);
+    return priv->radio_enabled_cached;
+  }
+
+  return (tx_att0_mdB < AD9361_RADIO_OFF_TX_ATT) || (tx_att1_mdB < AD9361_RADIO_OFF_TX_ATT);
+}
+
+/**
+ * @brief Initialize rfkill polling state from current RF attenuation state.
+ *
+ * @param hw mac80211 hardware handle.
+ */
+void openwifi_rfkill_init(struct ieee80211_hw *hw)
+{
+  struct openwifi_priv *priv = hw->priv;
+  bool radio_enabled;
+
+  radio_enabled = openwifi_is_radio_enabled(priv);
+  priv->radio_enabled_cached = radio_enabled;
+  printk("%s openwifi_rfkill_init: wireless switch is %s\n",
+    sdr_compatible_str, radio_enabled ? "on" : "off");
+  wiphy_rfkill_set_hw_state(hw->wiphy, !radio_enabled);
+  wiphy_rfkill_start_polling(hw->wiphy);
+}
+
+/**
+ * @brief Poll rfkill state and synchronize hardware switch status to wiphy.
+ *
+ * @param hw mac80211 hardware handle.
+ */
+void openwifi_rfkill_poll(struct ieee80211_hw *hw)
+{
+  bool enabled;
+  struct openwifi_priv *priv = hw->priv;
+
+  enabled = openwifi_is_radio_enabled(priv);
+  if (unlikely(enabled != priv->radio_enabled_cached)) {
+    priv->radio_enabled_cached = enabled;
+    printk("%s openwifi_rfkill_poll: WARNING wireless radio switch turned %s\n",
+      sdr_compatible_str, enabled ? "on" : "off");
+    wiphy_rfkill_set_hw_state(hw->wiphy, !enabled);
+  }
+}
+
+/**
+ * @brief Stop rfkill polling.
+ *
+ * @param hw mac80211 hardware handle.
+ */
+void openwifi_rfkill_exit(struct ieee80211_hw *hw)
+{
+  printk("%s openwifi_rfkill_exit\n", sdr_compatible_str);
+  wiphy_rfkill_stop_polling(hw->wiphy);
+}
+
+//=============================================================================
+// RSSI and Frequency Utilities
+//=============================================================================
+
+/**
+ * @brief Convert RSSI dBm to half-dB representation used by hardware logic.
+ *
+ * @param rssi_dbm RSSI in dBm.
+ * @param rssi_correction Board-dependent correction in dB.
+ * @return RSSI in 0.5 dB units.
+ */
+static inline int rssi_dbm_to_rssi_half_db(int rssi_dbm, int rssi_correction)
+{
+  return (rssi_correction + rssi_dbm) * OW_RSSI_HALF_DB_PER_DB;
+}
+
+/**
+ * @brief Map center frequency in MHz to 2.4G/5G band enum used by firmware.
+ *
+ * @param freq_mhz Frequency in MHz.
+ * @return BAND_2_4GHZ or BAND_5_8GHZ.
+ */
+static inline u8 freq_MHz_to_band(u32 freq_mhz)
+{
+  if (freq_mhz < OPENWIFI_FREQ_MHz_TH_FOR_2_4GHZ_5GHZ) {
+    return BAND_2_4GHZ;
+  }
+  return BAND_5_8GHZ;
+}
+
+/**
+ * @brief Lookup board-specific RSSI correction value for a given RF frequency.
+ *
+ * @param freq_mhz Frequency in MHz.
+ * @return RSSI correction in dB.
+ */
+static inline int rssi_correction_lookup_table(u32 freq_mhz)
+{
+  if (freq_mhz < OPENWIFI_FREQ_MHz_TH_FOR_2_4GHZ_5GHZ) {
+    return OW_RSSI_CORR_2G_DB;
+  }
+  return OW_RSSI_CORR_5G_DB;
+}
+
+/**
+ * @brief Trigger AD9361 TX quadrature calibration around LO retune events.
+ *
+ * @param priv Driver private state.
+ * @param actual_tx_lo TX LO in MHz.
+ */
+static inline void ad9361_tx_calibration(struct openwifi_priv *priv, u32 actual_tx_lo)
+{
+  int ret;
+  u32 prev_spi_disable;
+
+  priv->last_tx_quad_cal_lo = actual_tx_lo;
+  prev_spi_disable = xpu_api->XPU_REG_SPI_DISABLE_read();
+  xpu_api->XPU_REG_SPI_DISABLE_write(OW_SPI_DISABLE_ENABLE);
+  ret = ad9361_do_calib_run(priv->ad9361_phy, TX_QUAD_CAL, (int)priv->ad9361_phy->state->last_tx_quad_cal_phase);
+  xpu_api->XPU_REG_SPI_DISABLE_write(prev_spi_disable);
+
+  if (ret < 0) {
+    printk(KERN_WARNING "%s ad9361_tx_calibration %dMHz tx_quad_cal failed %d\n",
+      sdr_compatible_str, actual_tx_lo, ret);
+  } else {
+    printk("%s ad9361_tx_calibration %dMHz tx_quad_cal done\n", sdr_compatible_str, actual_tx_lo);
+  }
+}
+
+/**
+ * @brief Update RX-side thresholds and bookkeeping after LO retune.
+ *
+ * @param priv Driver private state.
+ * @param actual_rx_lo RX LO in MHz.
+ */
+static inline void openwifi_rf_rx_update_after_tuning(struct openwifi_priv *priv, u32 actual_rx_lo)
+{
+  int static_lbt_th;
+  int auto_lbt_th;
+  int fpga_lbt_th;
+  int receiver_rssi_dbm_th;
+  int receiver_rssi_half_db;
+
+  priv->rssi_correction = rssi_correction_lookup_table(actual_rx_lo);
+
+  auto_lbt_th = rssi_dbm_to_rssi_half_db(OW_AUTO_LBT_TH_DBM_DEFAULT, priv->rssi_correction);
+  static_lbt_th = rssi_dbm_to_rssi_half_db(-(int)priv->drv_xpu_reg_val[DRV_XPU_REG_IDX_LBT_TH], priv->rssi_correction);
+  if (priv->drv_xpu_reg_val[DRV_XPU_REG_IDX_LBT_TH] == OW_LBT_TH_AUTO_SENTINEL) {
+    fpga_lbt_th = auto_lbt_th;
+  } else {
+    fpga_lbt_th = static_lbt_th;
+  }
+  xpu_api->XPU_REG_LBT_TH_write(fpga_lbt_th);
+  priv->last_auto_fpga_lbt_th = auto_lbt_th;
+
+  if (priv->drv_rx_reg_val[DRV_RX_REG_IDX_DEMOD_TH] == OW_DEMOD_TH_AUTO_SENTINEL) {
+    receiver_rssi_dbm_th = OPENOFDM_RX_RSSI_DBM_TH_DEFAULT;
+  } else {
+    receiver_rssi_dbm_th = -(int)priv->drv_rx_reg_val[DRV_RX_REG_IDX_DEMOD_TH];
+  }
+  receiver_rssi_half_db = rssi_dbm_to_rssi_half_db(receiver_rssi_dbm_th, priv->rssi_correction);
+  if (openofdm_rx_api && openofdm_rx_api->OPENOFDM_RX_REG_POWER_THRES_write) {
+    openofdm_rx_api->OPENOFDM_RX_REG_POWER_THRES_write(
+      (OPENOFDM_RX_DC_RUNNING_SUM_TH_INIT << OW_OPENOFDM_POWER_THRES_RSSI_SHIFT) | (u32)(u16)receiver_rssi_half_db);
+  } else {
+    printk_once(KERN_WARNING "%s openofdm_rx power_thres API unavailable; skipping receiver threshold write\n",
+      sdr_compatible_str);
+  }
+
+  xpu_api->XPU_REG_BAND_CHANNEL_write(
+    (priv->use_short_slot << OW_XPU_BAND_CHANNEL_SHORT_SLOT_SHIFT) |
+    (priv->band << OW_XPU_BAND_CHANNEL_BAND_SHIFT) |
+    actual_rx_lo);
+
+  printk("%s openwifi_rf_rx_update_after_tuning %dMHz rssi_correction %d fpga_lbt_th %d(%ddBm) auto %d static %d receiver_th %d(%ddBm)\n",
+    sdr_compatible_str, actual_rx_lo, priv->rssi_correction, fpga_lbt_th,
+    rssi_half_db_to_rssi_dbm(fpga_lbt_th, priv->rssi_correction),
+    auto_lbt_th, static_lbt_th, receiver_rssi_half_db, receiver_rssi_dbm_th);
+}
+
+//=============================================================================
+// RF Channel Control
+//=============================================================================
+
+/**
+ * @brief AD9361 channel tuning path.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param conf Channel configuration.
+ */
+static void ad9361_rf_set_channel(struct ieee80211_hw *dev, struct ieee80211_conf *conf)
+{
+  struct openwifi_priv *priv = dev->priv;
+  u32 actual_rx_lo_mhz;
+  u32 actual_tx_lo_mhz;
+  u32 previous_tx_lo_mhz;
+  u32 tx_lo_delta_mhz;
+  u64 tx_rate_hz;
+  u64 rx_rate_hz;
+  u64 previous_tx_rate_hz;
+  int ret;
+  int rollback_ret;
+  bool channel_changed;
+
+  actual_rx_lo_mhz = conf->chandef.chan->center_freq - priv->rx_freq_offset_to_lo_MHz;
+  channel_changed = (actual_rx_lo_mhz != priv->actual_rx_lo);
+
+  printk("%s ad9361_rf_set_channel target %dMHz rx offset %dMHz current %dMHz change flag %d\n", sdr_compatible_str,
+    conf->chandef.chan->center_freq, priv->rx_freq_offset_to_lo_MHz, priv->actual_rx_lo, channel_changed);
+
+  if (channel_changed) {
+    previous_tx_lo_mhz = priv->actual_tx_lo;
+    actual_tx_lo_mhz = conf->chandef.chan->center_freq - priv->tx_freq_offset_to_lo_MHz;
+    tx_rate_hz = (((u64)OW_HZ_PER_MHZ) * ((u64)actual_tx_lo_mhz)) >> OW_RFPLL_RATE_DIV_SHIFT;
+    rx_rate_hz = (((u64)OW_HZ_PER_MHZ) * ((u64)actual_rx_lo_mhz)) >> OW_RFPLL_RATE_DIV_SHIFT;
+    previous_tx_rate_hz = (((u64)OW_HZ_PER_MHZ) * ((u64)previous_tx_lo_mhz)) >> OW_RFPLL_RATE_DIV_SHIFT;
+    if (priv->last_tx_quad_cal_lo > actual_tx_lo_mhz) {
+      tx_lo_delta_mhz = priv->last_tx_quad_cal_lo - actual_tx_lo_mhz;
+    } else {
+      tx_lo_delta_mhz = actual_tx_lo_mhz - priv->last_tx_quad_cal_lo;
+    }
+
+    printk("%s ad9361_rf_set_channel target %dMHz tx offset %dMHz current %dMHz diff_tx_lo %dMHz\n", sdr_compatible_str,
+      conf->chandef.chan->center_freq, priv->tx_freq_offset_to_lo_MHz, priv->actual_tx_lo, tx_lo_delta_mhz);
+
+    ret = clk_set_rate(priv->ad9361_phy->clks[TX_RFPLL], tx_rate_hz);
+    if (ret < 0) {
+      printk(KERN_WARNING "%s ad9361_rf_set_channel: TX_RFPLL set_rate failed %d target %uMHz\n",
+        sdr_compatible_str, ret, actual_tx_lo_mhz);
+      return;
+    }
+
+    ret = clk_set_rate(priv->ad9361_phy->clks[RX_RFPLL], rx_rate_hz);
+    if (ret < 0) {
+      printk(KERN_WARNING "%s ad9361_rf_set_channel: RX_RFPLL set_rate failed %d target %uMHz\n",
+        sdr_compatible_str, ret, actual_rx_lo_mhz);
+      rollback_ret = clk_set_rate(priv->ad9361_phy->clks[TX_RFPLL], previous_tx_rate_hz);
+      if (rollback_ret < 0) {
+        printk(KERN_WARNING "%s ad9361_rf_set_channel: TX rollback failed %d target %uMHz\n",
+          sdr_compatible_str, rollback_ret, previous_tx_lo_mhz);
+      }
+      return;
+    }
+
+    priv->actual_tx_lo = actual_tx_lo_mhz;
+    priv->actual_rx_lo = actual_rx_lo_mhz;
+
+    priv->band = freq_MHz_to_band(actual_rx_lo_mhz);
+
+    if (tx_lo_delta_mhz > OW_TX_QUAD_CAL_REDO_DELTA_MHZ) {
+      ad9361_tx_calibration(priv, actual_tx_lo_mhz);
+    }
+
+    openwifi_rf_rx_update_after_tuning(priv, actual_rx_lo_mhz);
+    printk("%s ad9361_rf_set_channel %dMHz done\n", sdr_compatible_str, conf->chandef.chan->center_freq);
+  }
+}
+
+const struct openwifi_rf_ops ad9361_rf_ops = {
+  .name    = "ad9361",
+  .set_chan  = ad9361_rf_set_channel,
+};
+
+//=============================================================================
+// Generic Utility Helpers
+//=============================================================================
+
+/**
+ * @brief Reverse byte-order in a 16-bit value.
+ *
+ * @param value Input value.
+ * @return Byte-reversed value.
+ */
+u16 reverse16(u16 value)
+{
+  union u16_byte2 tmp0, tmp1;
+  tmp0.a = value;
+  tmp1.c[0] = tmp0.c[1];
+  tmp1.c[1] = tmp0.c[0];
+  return tmp1.a;
+}
+
+/**
+ * @brief Reverse byte-order in a 32-bit value.
+ *
+ * @param value Input value.
+ * @return Byte-reversed value.
+ */
+u32 reverse32(u32 value)
+{
+  union u32_byte4 tmp0, tmp1;
+  tmp0.a = value;
+  tmp1.c[0] = tmp0.c[3];
+  tmp1.c[1] = tmp0.c[2];
+  tmp1.c[2] = tmp0.c[1];
+  tmp1.c[3] = tmp0.c[0];
+  return tmp1.a;
+}
+
+/**
+ * @brief Integer log2 helper for queue parameter conversion.
+ *
+ * @param val Input value.
+ * @return floor(log2(val)).
+ */
+u32 log2val(u32 val)
+{
+  u32 ret_val = 0;
+  while (val > 1) {
+    val >>= 1;
+    ret_val++;
+  }
+  return ret_val;
+}
+
+//=============================================================================
+// Antenna Control Helpers
+//=============================================================================
+
+/**
+ * @brief Configure TX/RX antenna paths in RF chip and FPGA interfaces.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param tx_ant TX antenna selector: 1=TX0, 2=TX1, 3=TX0+TX1.
+ * @param rx_ant RX antenna selector.
+ * @return 0 on success, -EINVAL on invalid input or RF/FPGA write mismatch.
+ */
+static int openwifi_set_antenna(struct ieee80211_hw *dev, u32 tx_ant, u32 rx_ant)
+{
+  struct openwifi_priv *priv = dev->priv;
+  u8 fpga_tx_ant_setting, target_rx_ant;
+  u32 atten_mdb_tx0, atten_mdb_tx1;
+  u32 previous_fpga_tx_ant_setting;
+  u32 previous_fpga_rx_ant_setting;
+  int previous_tx_att0_mdB;
+  int previous_tx_att1_mdB;
+  int previous_ctrl_out_index;
+  struct ctrl_outs_control ctrl_out;
+  struct ctrl_outs_control rollback_ctrl_out;
+  bool tx_att0_written = false;
+  bool tx_att1_written = false;
+  bool ctrl_out_written = false;
+  bool fpga_tx_written = false;
+  bool fpga_rx_written = false;
+  int ret;
+  int rollback_ret;
+
+  printk("%s openwifi_set_antenna: tx_ant%d rx_ant%d\n", sdr_compatible_str, tx_ant, rx_ant);
+
+  if (tx_ant < OPENWIFI_TX_ANT_MIN || tx_ant > OPENWIFI_TX_ANT_MAX) {
+    return -EINVAL;
+  }
+  if (rx_ant < OPENWIFI_RX_ANT_MIN || rx_ant > OPENWIFI_RX_ANT_MAX) {
+    return -EINVAL;
+  }
+
+  previous_tx_att0_mdB = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT0);
+  previous_tx_att1_mdB = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT1);
+  previous_ctrl_out_index = ad9361_spi_read(priv->ad9361_phy->spi, REG_CTRL_OUTPUT_POINTER);
+  previous_fpga_tx_ant_setting = tx_intf_api->TX_INTF_REG_ANT_SEL_read();
+  previous_fpga_rx_ant_setting = rx_intf_api->RX_INTF_REG_ANT_SEL_read();
+
+  if (tx_ant <= OPENWIFI_TX_ANT_SINGLE_CHAIN_MAX) {
+    fpga_tx_ant_setting = tx_ant;
+  } else {
+    fpga_tx_ant_setting = tx_ant + OPENWIFI_TX_ANT_FPGA_BOTH_OFFSET;
+  }
+  if (rx_ant == OPENWIFI_RX_ANT_MIN) {
+    target_rx_ant = OW_RX_ANT_CHAIN0_SELECT;
+  } else {
+    target_rx_ant = OW_RX_ANT_CHAIN1_SELECT;
+  }
+
+  atten_mdb_tx0 = ((tx_ant & OW_TX_ANT_CHAIN0_MASK) ?
+    (AD9361_RADIO_ON_TX_ATT + priv->rf_reg_val[RF_TX_REG_IDX_ATT]) : AD9361_RADIO_OFF_TX_ATT);
+  atten_mdb_tx1 = ((tx_ant & OW_TX_ANT_CHAIN1_MASK) ?
+    (AD9361_RADIO_ON_TX_ATT + priv->rf_reg_val[RF_TX_REG_IDX_ATT]) : AD9361_RADIO_OFF_TX_ATT);
+  ret = ad9361_set_tx_atten(priv->ad9361_phy, atten_mdb_tx0, true, false, true);
+  if (ret < 0) {
+    printk("%s openwifi_set_antenna: WARNING ad9361_set_tx_atten ant0 %d FAIL!\n", sdr_compatible_str, atten_mdb_tx0);
+    goto rollback;
+  } else {
+    tx_att0_written = true;
+    printk("%s openwifi_set_antenna: ad9361_set_tx_atten ant0 %d OK\n", sdr_compatible_str, atten_mdb_tx0);
+  }
+  ret = ad9361_set_tx_atten(priv->ad9361_phy, atten_mdb_tx1, false, true, true);
+  if (ret < 0) {
+    printk("%s openwifi_set_antenna: WARNING ad9361_set_tx_atten ant1 %d FAIL!\n", sdr_compatible_str, atten_mdb_tx1);
+    goto rollback;
+  } else {
+    tx_att1_written = true;
+    printk("%s openwifi_set_antenna: ad9361_set_tx_atten ant1 %d OK\n", sdr_compatible_str, atten_mdb_tx1);
+  }
+
+  ctrl_out.en_mask = priv->ctrl_out.en_mask;
+  ctrl_out.index = (target_rx_ant == OW_RX_ANT_CHAIN0_SELECT) ?
+    AD9361_CTRL_OUT_INDEX_ANT0 : AD9361_CTRL_OUT_INDEX_ANT1;
+  ret = ad9361_ctrl_outs_setup(priv->ad9361_phy, &(ctrl_out));
+  if (ret < 0) {
+    printk("%s openwifi_set_antenna: WARNING ad9361_ctrl_outs_setup en_mask 0x%02x index 0x%02x FAIL!\n",
+      sdr_compatible_str, ctrl_out.en_mask, ctrl_out.index);
+    goto rollback;
+  } else {
+    ctrl_out_written = true;
+    printk("%s openwifi_set_antenna: ad9361_ctrl_outs_setup en_mask 0x%02x index 0x%02x\n",
+      sdr_compatible_str, ctrl_out.en_mask, ctrl_out.index);
+  }
+
+  tx_intf_api->TX_INTF_REG_ANT_SEL_write(fpga_tx_ant_setting);
+  ret = tx_intf_api->TX_INTF_REG_ANT_SEL_read();
+  if (ret != fpga_tx_ant_setting) {
+    printk("%s openwifi_set_antenna: WARNING TX_INTF_REG_ANT_SEL_write target %d read back %d\n",
+      sdr_compatible_str, fpga_tx_ant_setting, ret);
+    ret = -EIO;
+    goto rollback;
+  } else {
+    fpga_tx_written = true;
+    printk("%s openwifi_set_antenna: TX_INTF_REG_ANT_SEL_write value %d\n", sdr_compatible_str, ret);
+  }
+
+  rx_intf_api->RX_INTF_REG_ANT_SEL_write(target_rx_ant);
+  ret = rx_intf_api->RX_INTF_REG_ANT_SEL_read();
+  if (ret != target_rx_ant) {
+    printk("%s openwifi_set_antenna: WARNING RX_INTF_REG_ANT_SEL_write target %d read back %d\n",
+      sdr_compatible_str, target_rx_ant, ret);
+    ret = -EIO;
+    goto rollback;
+  } else {
+    fpga_rx_written = true;
+    printk("%s openwifi_set_antenna: RX_INTF_REG_ANT_SEL_write value %d\n", sdr_compatible_str, ret);
+  }
+
+  priv->runtime_tx_ant_cfg = tx_ant;
+  priv->runtime_rx_ant_cfg = rx_ant;
+
+  if (TX_OFFSET_TUNING_ENABLE) {
+    priv->tx_intf_cfg = ((tx_ant & OW_TX_ANT_CHAIN0_MASK) ?
+      TX_INTF_BW_20MHZ_AT_N_10MHZ_ANT0 : TX_INTF_BW_20MHZ_AT_N_10MHZ_ANT1);
+  } else {
+    if (tx_ant == OPENWIFI_TX_ANT_MAX) {
+      priv->tx_intf_cfg = TX_INTF_BW_20MHZ_AT_0MHZ_ANT_BOTH;
+    } else {
+      priv->tx_intf_cfg = ((tx_ant & OW_TX_ANT_CHAIN0_MASK) ?
+        TX_INTF_BW_20MHZ_AT_0MHZ_ANT0 : TX_INTF_BW_20MHZ_AT_0MHZ_ANT1);
+    }
+  }
+
+  priv->rx_intf_cfg = (target_rx_ant == OW_RX_ANT_CHAIN0_SELECT) ?
+    RX_INTF_BW_20MHZ_AT_0MHZ_ANT0 : RX_INTF_BW_20MHZ_AT_0MHZ_ANT1;
+  priv->ctrl_out.index = ctrl_out.index;
+
+  priv->tx_freq_offset_to_lo_MHz = tx_intf_fo_mapping[priv->tx_intf_cfg];
+  priv->rx_freq_offset_to_lo_MHz = rx_intf_fo_mapping[priv->rx_intf_cfg];
+
+  return 0;
+
+rollback:
+  if (fpga_rx_written) {
+    rx_intf_api->RX_INTF_REG_ANT_SEL_write(previous_fpga_rx_ant_setting);
+  }
+  if (fpga_tx_written) {
+    tx_intf_api->TX_INTF_REG_ANT_SEL_write(previous_fpga_tx_ant_setting);
+  }
+  if (ctrl_out_written && previous_ctrl_out_index >= 0) {
+    rollback_ctrl_out.en_mask = priv->ctrl_out.en_mask;
+    rollback_ctrl_out.index = (u8)previous_ctrl_out_index;
+    rollback_ret = ad9361_ctrl_outs_setup(priv->ad9361_phy, &rollback_ctrl_out);
+    if (rollback_ret < 0) {
+      printk("%s openwifi_set_antenna: WARNING rollback ctrl_out failed %d\n",
+        sdr_compatible_str, rollback_ret);
+    }
+  }
+  if (tx_att1_written && previous_tx_att1_mdB >= 0) {
+    rollback_ret = ad9361_set_tx_atten(priv->ad9361_phy, (u32)previous_tx_att1_mdB, false, true, true);
+    if (rollback_ret < 0) {
+      printk("%s openwifi_set_antenna: WARNING rollback tx_att1 failed %d\n",
+        sdr_compatible_str, rollback_ret);
+    }
+  }
+  if (tx_att0_written && previous_tx_att0_mdB >= 0) {
+    rollback_ret = ad9361_set_tx_atten(priv->ad9361_phy, (u32)previous_tx_att0_mdB, true, false, true);
+    if (rollback_ret < 0) {
+      printk("%s openwifi_set_antenna: WARNING rollback tx_att0 failed %d\n",
+        sdr_compatible_str, rollback_ret);
+    }
+  }
+  return ret;
+}
+
+/**
+ * @brief Read and print current antenna configuration from driver, FPGA, and RF.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param tx_ant Output TX antenna selector.
+ * @param rx_ant Output RX antenna selector.
+ * @return 0 on success.
+ */
+static int openwifi_get_antenna(struct ieee80211_hw *dev, u32 *tx_ant, u32 *rx_ant)
+{
+  struct openwifi_priv *priv = dev->priv;
+  int tx_att0_mdB;
+  int tx_att1_mdB;
+  int ctrl_out_index;
+
+  if (!tx_ant || !rx_ant) {
+    return -EINVAL;
+  }
+
+  *tx_ant = priv->runtime_tx_ant_cfg;
+  *rx_ant = priv->runtime_rx_ant_cfg;
+
+  printk("%s openwifi_get_antenna: tx_ant%d rx_ant%d\n", sdr_compatible_str, *tx_ant, *rx_ant);
+
+  printk("%s openwifi_get_antenna: drv tx cfg %d offset %d drv rx cfg %d offset %d drv ctrl_out sel %x\n",
+    sdr_compatible_str, priv->tx_intf_cfg, priv->tx_freq_offset_to_lo_MHz,
+    priv->rx_intf_cfg, priv->rx_freq_offset_to_lo_MHz, priv->ctrl_out.index);
+
+  printk("%s openwifi_get_antenna: fpga tx sel %d rx sel %d\n", sdr_compatible_str,
+  tx_intf_api->TX_INTF_REG_ANT_SEL_read(), rx_intf_api->RX_INTF_REG_ANT_SEL_read());
+
+  tx_att0_mdB = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT0);
+  tx_att1_mdB = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT1);
+  ctrl_out_index = ad9361_spi_read(priv->ad9361_phy->spi, REG_CTRL_OUTPUT_POINTER);
+
+  printk("%s openwifi_get_antenna: rf tx att0 %d tx att1 %d ctrl_out sel %x\n",
+    sdr_compatible_str, tx_att0_mdB, tx_att1_mdB, ctrl_out_index);
+  if (tx_att0_mdB < 0 || tx_att1_mdB < 0 || ctrl_out_index < 0) {
+    return -EIO;
+  }
+
+  return 0;
+}
diff --git a/drivers/sdrctl_intf.c b/drivers/sdrctl_intf.c
new file mode 100644
index 0000000..b3e9e0b
--- /dev/null
+++ b/drivers/sdrctl_intf.c
@@ -0,0 +1,724 @@
+// Author: Xianjun Jiao, Michael Mehari, Wei Liu
+// SPDX-FileCopyrightText: 2019 UGent
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/*
+ * sdrctl_intf.c contract notes:
+ * - This file is the userspace-facing debug/control shim for SDRCTL testmode
+ *   register access and selected driver-owned controls.
+ * - Allowlists below define which hardware register addresses are intentionally
+ *   exposed through SDRCTL.
+ * - TX_INTF PKT_INFO1..4 are special: the hardware registers are live
+ *   completion FIFOs owned by the TX IRQ path, so SDRCTL returns the last
+ *   IRQ-captured completion tuple snapshot instead of popping the FIFOs.
+ * - SET on TX_INTF PKT_INFO1..4 is rejected; those addresses are read-only
+ *   debug snapshots from the real TX IRQ consumer.
+ */
+
+#define OW_SLICE_COUNT_VALUE_MASK           0xFFFFFU
+#define OW_FREQ_MHZ_MIN                     2000U
+#define OW_FREQ_MHZ_MAX                     6000U
