+/**
+ * @brief Check if character is a hexadecimal digit.
+ *
+ * @param c Character to validate.
+ * @return true when c is [0-9a-fA-F].
+ */
+static bool openwifi_is_hex_digit(char c)
+{
+  return ((c >= '0' && c <= '9')
+          || (c >= 'a' && c <= 'f')
+          || (c >= 'A' && c <= 'F'));
+}
+
+/**
+ * @brief Compact sysfs MAC input to plain hexadecimal digits.
+ *
+ * Accepted:
+ * - 8/12 plain hex digits
+ * - optional 0x/0X prefix
+ * - optional ':' or '-' separators for full MAC form
+ *
+ * @param buf Sysfs input buffer.
+ * @param hex_out Output compacted hex string (NUL-terminated).
+ * @param hex_out_size Output buffer size.
+ * @return Number of hex digits copied, or negative errno.
+ */
+static int openwifi_compact_mac_hex_input(const char *buf, char *hex_out, size_t hex_out_size)
+{
+  size_t idx_in;
+  size_t idx_out = 0;
+  bool allow_prefix = true;
+
+  if (!buf || !hex_out || hex_out_size < 13U) {
+    return -EINVAL;
+  }
+
+  for (idx_in = 0; buf[idx_in] != '\0' && buf[idx_in] != '\n'; idx_in++) {
+    char c = buf[idx_in];
+
+    if (allow_prefix && idx_out == 0 && c == '0'
+        && (buf[idx_in + 1] == 'x' || buf[idx_in + 1] == 'X')) {
+      idx_in++;
+      continue;
+    }
+    allow_prefix = false;
+
+    if (c == ':' || c == '-') {
+      continue;
+    }
+    if (openwifi_is_hex_digit(c)) {
+      if (idx_out >= (hex_out_size - 1U)) {
+        return -EINVAL;
+      }
+      hex_out[idx_out++] = c;
+      continue;
+    }
+    return -EINVAL;
+  }
+
+  hex_out[idx_out] = '\0';
+  return (int)idx_out;
+}
+
+/**
+ * @brief Parse RX sender filter sysfs input as legacy low32 or full 48-bit MAC.
+ *
+ * Accepted input formats:
+ * - 0 or 0x0 (clear filter; wildcard sender).
+ * - 8 hex digits (legacy MAC[2..5] low32), optional 0x prefix.
+ * - 12 hex digits (full MAC[0..5]), optional 0x prefix.
+ * - Full MAC with separators (for example aa:bb:cc:dd:ee:ff).
+ *
+ * @param buf Sysfs input string.
+ * @param mac_high16_out Parsed MAC[0..1] in compare endian.
+ * @param mac_low32_out Parsed MAC[2..5] in compare endian.
+ * @return 0 on success, -EINVAL on invalid format/value.
+ * @note Legacy clear support (0/0x0) is kept for existing scripts.
+ * @note TODO: After userspace/sysfs migration is complete, consider strict-only
+ *       8/12-hex input and drop the legacy single-zero clear form.
+ */
+static int openwifi_parse_rx_target_sender_mac(const char *buf, u16 *mac_high16_out, u32 *mac_low32_out)
+{
+  u32 low32_be;
+  unsigned long long mac48_be;
+  int digit_count;
+  char mac_hex[13];
+
+  digit_count = openwifi_compact_mac_hex_input(buf, mac_hex, sizeof(mac_hex));
+  if (digit_count < 0) {
+    return digit_count;
+  }
+  /* Keep historical "echo 0" clear behavior for script compatibility. */
+  if (digit_count == 1 && mac_hex[0] == '0') {
+    *mac_high16_out = 0;
+    *mac_low32_out = 0;
+    return 0;
+  }
+  if (digit_count != 8 && digit_count != 12) {
+    return -EINVAL;
+  }
+
+  if (digit_count == 8) {
+    if (kstrtouint(mac_hex, 16, &low32_be)) {
+      return -EINVAL;
+    }
+    *mac_high16_out = 0;
+    *mac_low32_out = reverse32(low32_be);
+    return 0;
+  }
+
+  if (kstrtoull(mac_hex, 16, &mac48_be)) {
+    return -EINVAL;
+  }
+  *mac_high16_out = reverse16((u16)((mac48_be >> 32) & 0xFFFFU));
+  *mac_low32_out = reverse32((u32)(mac48_be & 0xFFFFFFFFU));
+  return 0;
+}
+
+static ssize_t rx_target_sender_mac_addr_show(struct device *input_dev, struct device_attribute *attr, char *buf) 
+{
+  struct platform_device *pdev = to_platform_device(input_dev);
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+
+  if (priv->stat.rx_target_sender_mac_addr_high16 == 0) {
+    return sprintf(buf, "%08x\n", reverse32(priv->stat.rx_target_sender_mac_addr));
+  }
+  return sprintf(buf, "%04x%08x\n", reverse16(priv->stat.rx_target_sender_mac_addr_high16),
+    reverse32(priv->stat.rx_target_sender_mac_addr));
+}
+static ssize_t rx_target_sender_mac_addr_store(struct device *input_dev, struct device_attribute *attr, const char *buf, size_t len) 
