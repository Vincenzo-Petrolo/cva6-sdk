+/**
+ * @brief Configure mac80211/wiphy capability flags and interface masks.
+ *
+ * @param dev mac80211 hardware handle.
+ */
+static void openwifi_probe_init_wiphy_caps(struct ieee80211_hw *dev)
+{
+  struct openwifi_priv *priv = dev->priv;
+
+  ieee80211_hw_set(dev, RX_INCLUDES_FCS);
+  ieee80211_hw_set(dev, BEACON_TX_STATUS);
+  ieee80211_hw_set(dev, REPORTS_TX_ACK_STATUS);
+  /* Advertise A-MPDU support for the maintained one-peer RX BA contract.
+   * mac80211 exposes this as a global HW capability bit, while the current
+   * OpenWiFi contract is still limited to one active RX BA peer/TID session.
+   * TX aggregation is wired through mac80211/TX_INTF, RX BlockAck session
+   * state is programmed explicitly, and mac80211 keeps reorder buffering in
+   * software. Zynq still exposes AP mode, but additional AP-side RX BA peers
+   * are rejected at runtime instead of being represented as extra hardware
+   * session state. */
+  ieee80211_hw_set(dev, AMPDU_AGGREGATION);
+  /* Intentionally do not advertise AP_LINK_PS.
+   * OpenWiFi AP mode in this repo does not implement the mac80211 buffered-
+   * frame/TIM hooks needed for AP-side station power save, and this project
+   * does not plan to add that functionality. */
+  ieee80211_hw_set(dev, SIGNAL_DBM);
+  wiphy_ext_feature_set(dev->wiphy, NL80211_EXT_FEATURE_CQM_RSSI_LIST);
+
+  dev->extra_tx_headroom = LEN_MPDU_DELIM;
+  dev->vif_data_size = sizeof(struct openwifi_vif);
+  dev->queues = MAX_NUM_HW_QUEUE;
+  /* Hardware register model supports one active VIF context at a time
+   * (OW_MAX_ACTIVE_VIF). Keep AP+STA+monitor exposed on both Zynq and
+   * Cheshire so Cheshire/CVA6 can still run controlled AP-side Wi-Fi tests
+   * even without an Ethernet uplink.
+   *
+   * NOTE(openwifi-cheshire-ap-test): Cheshire AP exposure is intentional and
+   * must not be narrowed back to STA-only without explicit review. The point
+   * is controlled Wi-Fi-side testing/bring-up, not Ethernet-backed product
+   * AP deployment.
+   *
+   * RX BA offload remains narrower than generic AP admission: only one active
+   * peer/TID session is supported at a time, and additional AP-side RX BA
+   * sessions are rejected at runtime. IBSS/mesh are intentionally not
+   * advertised. */
+  dev->wiphy->interface_modes =
+      BIT(NL80211_IFTYPE_MONITOR) |
+      BIT(NL80211_IFTYPE_AP) |
+      BIT(NL80211_IFTYPE_STATION);
+  /* 0 means "do not advertise a driver-side AP association limit" in
+   * cfg80211/nl80211. Keep AP admission uncapped here; the actual narrow
+   * point remains RX BA offload, which still supports only one active
+   * peer/TID session at a time. */
+  dev->wiphy->max_ap_assoc_sta = 0;
+  dev->wiphy->iface_combinations = &openwifi_if_comb;
+  dev->wiphy->n_iface_combinations = 1;
+  dev->wiphy->available_antennas_tx = NUM_TX_ANT_MASK;
+  dev->wiphy->available_antennas_rx = NUM_RX_ANT_MASK;
+  dev->wiphy->regulatory_flags = (REGULATORY_STRICT_REG | REGULATORY_CUSTOM_REG);
+  wiphy_apply_custom_regulatory(dev->wiphy, &sdr_regd);
+
+  priv->rf = &ad9361_rf_ops;
+}
