+  u32 actual_rx_lo;
+  u32 actual_tx_lo;
+  u32 last_tx_quad_cal_lo;
+
+  struct ieee80211_rate           rates_2GHz[OPENWIFI_NUM_RATE_2GHZ];
+  struct ieee80211_rate           rates_5GHz[OPENWIFI_NUM_RATE_5GHZ];
+  struct ieee80211_channel        channels_2GHz[OPENWIFI_NUM_CHANNEL_2GHZ];
+  struct ieee80211_channel        channels_5GHz[OPENWIFI_NUM_CHANNEL_5GHZ];
