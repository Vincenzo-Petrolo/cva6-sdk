+  tx_intf_api->TX_INTF_REG_PHY_HDR_CONFIG_write=TX_INTF_REG_PHY_HDR_CONFIG_write;
+
+  /* Request and map I/O memory */
+  io = platform_get_resource(pdev, IORESOURCE_MEM, 0);
