+#ifdef DEBUG_OPENWIFI
+/**
+ * @brief Dump early RX slot headers to detect DMA write activity.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_rx_dump_early_slots(struct openwifi_priv *priv)
+{
+  int idx_slot;
+  bool has_any_data = false;
+
+  if (ow_rx_irq_count > OW_RX_DEBUG_EARLY_IRQ_DUMP_COUNT) {
+    return;
+  }
+
+  for (idx_slot = 0; idx_slot < NUM_RX_BD; idx_slot++) {
+    u8 *slot_base = priv->rx_cyclic_buf + idx_slot * RX_BD_BUF_SIZE;
+    u32 slot_word0 = ow_rx_read_u32(slot_base, 0U);
+
+    if (slot_word0 == 0U) {
+      continue;
+    }
+
+    printk(KERN_INFO "%s rx_buf_dump: irq#%u slot%d hdr=%*ph\n",
+      sdr_compatible_str, ow_rx_irq_count, idx_slot,
+      OW_RX_PKT_HDR_DUMP_BYTES, slot_base);
+    has_any_data = true;
+  }
+
+  if (!has_any_data) {
+    printk(KERN_WARNING "%s rx_buf_dump: irq#%u ALL %d SLOTS EMPTY (DMA not delivering data?)\n",
+      sdr_compatible_str, ow_rx_irq_count, NUM_RX_BD);
+  }
+}
