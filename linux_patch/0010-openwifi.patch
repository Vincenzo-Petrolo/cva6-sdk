+u16 reverse16(u16 d) {
+  union u16_byte2 tmp0, tmp1;
+  tmp0.a = d;
+  tmp1.c[0] = tmp0.c[1];
+  tmp1.c[1] = tmp0.c[0];
+  return(tmp1.a);
+}
+
+u32 reverse32(u32 d) {
+  union u32_byte4 tmp0, tmp1;
+  tmp0.a = d;
+  tmp1.c[0] = tmp0.c[3];
+  tmp1.c[1] = tmp0.c[2];
+  tmp1.c[2] = tmp0.c[1];
+  tmp1.c[3] = tmp0.c[0];
+  return(tmp1.a);
+}
