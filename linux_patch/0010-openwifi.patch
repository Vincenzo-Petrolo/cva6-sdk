+/**
+ * @brief Validate register byte offset for one SDRCTL register category.
+ *
+ * @param reg_cat Register category from SDRCTL protocol.
+ * @param reg_addr Register byte offset in the selected category.
+ * @return 0 on valid offset, negative errno otherwise.
+ */
+static int openwifi_validate_reg_addr(u32 reg_cat, u32 reg_addr)
+{
+  if ((reg_addr & 0x3U) != 0U) {
+    return -EINVAL;
+  }
+
+  switch (reg_cat) {
+  case SDRCTL_REG_CAT_RF:
+  case SDRCTL_REG_CAT_DRV_RX:
+  case SDRCTL_REG_CAT_DRV_TX:
+  case SDRCTL_REG_CAT_DRV_XPU:
+    return 0;
+  case SDRCTL_REG_CAT_RX_INTF:
+    return openwifi_reg_addr_in_allowlist(reg_addr, ow_reg_addr_allowlist_rx_intf,
+      ARRAY_SIZE(ow_reg_addr_allowlist_rx_intf)) ? 0 : -ERANGE;
+  case SDRCTL_REG_CAT_TX_INTF:
+    return openwifi_reg_addr_in_allowlist(reg_addr, ow_reg_addr_allowlist_tx_intf,
+      ARRAY_SIZE(ow_reg_addr_allowlist_tx_intf)) ? 0 : -ERANGE;
+  case SDRCTL_REG_CAT_RX:
+    return openwifi_reg_addr_in_allowlist(reg_addr, ow_reg_addr_allowlist_openofdm_rx,
+      ARRAY_SIZE(ow_reg_addr_allowlist_openofdm_rx)) ? 0 : -ERANGE;
+  case SDRCTL_REG_CAT_TX:
+    return openwifi_reg_addr_in_allowlist(reg_addr, ow_reg_addr_allowlist_openofdm_tx,
+      ARRAY_SIZE(ow_reg_addr_allowlist_openofdm_tx)) ? 0 : -ERANGE;
+  case SDRCTL_REG_CAT_XPU:
+    return openwifi_reg_addr_in_allowlist(reg_addr, ow_reg_addr_allowlist_xpu,
+      ARRAY_SIZE(ow_reg_addr_allowlist_xpu)) ? 0 : -ERANGE;
+  default:
+    return -EOPNOTSUPP;
+  }
+}
