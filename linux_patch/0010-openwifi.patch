+/**
+ * @brief Initialize one software TX ring and descriptor table.
+ *
+ * @param priv Driver private state.
+ * @param ring_idx Software queue index.
+ * @return 0 on success, -ENOMEM on allocation failure.
+ */
+static int openwifi_init_tx_ring(struct openwifi_priv *priv, int ring_idx)
+{
+  struct openwifi_ring *ring = &(priv->tx_ring[ring_idx]);
+  int i;
+
+  ring->stop_flag = -1;
+  ring->stop_prio_mask = 0U;
+  ring->bd_wr_idx = 0;
+  ring->bd_rd_idx = 0;
+  ring->bds = kzalloc(sizeof(struct openwifi_buffer_descriptor) * NUM_TX_BD, GFP_KERNEL);
+  if (ring->bds == NULL) {
+    printk("%s openwifi_init_tx_ring: WARNING Cannot allocate TX ring\n", sdr_compatible_str);
+    return -ENOMEM;
+  }
+
+  for (i = 0; i < NUM_TX_BD; i++) {
+    ring->bds[i].skb_linked = NULL;
+    ring->bds[i].dma_mapping_addr = 0;
+    ring->bds[i].dma_len_bytes = 0;
+    ring->bds[i].seq_no = OPENWIFI_TX_SEQ_INVALID;
+    ring->bds[i].prio = OPENWIFI_TX_PRIO_INVALID;
+    ring->bds[i].len_mpdu = 0;
+  }
+
+  return 0;
+}
+
+/**
+ * @brief Free one software TX ring and all associated buffers/mappings.
+ *
+ * @param priv Driver private state.
+ * @param ring_idx Software queue index.
+ */
+static void openwifi_free_tx_ring(struct openwifi_priv *priv, int ring_idx)
+{
+  struct openwifi_ring *ring = &(priv->tx_ring[ring_idx]);
+  int i;
+  u32 dma_len_bytes;
+
+  ring->stop_flag = -1;
+  ring->stop_prio_mask = 0U;
+  ring->bd_wr_idx = 0;
+  ring->bd_rd_idx = 0;
+  if (!ring->bds) {
+    return;
+  }
+  for (i = 0; i < NUM_TX_BD; i++) {
+    if (ring->bds[i].skb_linked == 0 && ring->bds[i].dma_mapping_addr == 0) {
+      continue;
+    }
+    if (ring->bds[i].dma_mapping_addr != 0) {
+      dma_len_bytes = ring->bds[i].dma_len_bytes;
+
+      if (dma_len_bytes == 0 && ring->bds[i].skb_linked != NULL) {
+        dma_len_bytes = ring->bds[i].skb_linked->len;
+      }
+      if (dma_len_bytes != 0) {
+        dma_unmap_single(priv->tx_chan->device->dev, ring->bds[i].dma_mapping_addr, dma_len_bytes, DMA_MEM_TO_DEV);
+      }
+    }
+    /* Free optional aligned bounce buffer on ring teardown. */
+    kfree(ring->bds[i].bounce_buf);
+    ring->bds[i].bounce_buf = NULL;
+    if ((ring->bds[i].dma_mapping_addr != 0 && ring->bds[i].skb_linked == 0)
+        || (ring->bds[i].dma_mapping_addr == 0 && ring->bds[i].skb_linked != 0)) {
+      printk("%s openwifi_free_tx_ring: WARNING ring %d i %d skb_linked %p dma_mapping_addr %08x\n", sdr_compatible_str,
+      ring_idx, i, (void*)(ring->bds[i].skb_linked), (unsigned int)(ring->bds[i].dma_mapping_addr));
+    }
+    if (ring->bds[i].skb_linked != NULL) {
+      ieee80211_free_txskb(priv->hw, ring->bds[i].skb_linked);
+    }
+
+    ring->bds[i].skb_linked = NULL;
+    ring->bds[i].dma_mapping_addr = 0;
+    ring->bds[i].dma_len_bytes = 0;
+    ring->bds[i].seq_no = OPENWIFI_TX_SEQ_INVALID;
+    ring->bds[i].prio = OPENWIFI_TX_PRIO_INVALID;
+    ring->bds[i].len_mpdu = 0;
+  }
+  if (ring->bds) {
+    kfree(ring->bds);
+  }
+  ring->bds = NULL;
+}
+
+//=============================================================================
+// Split Driver Sources (Single Translation Unit)
+//=============================================================================
+
+#include "sdr_utils.c"
+#include "sdr_rx.c"
+#include "sdr_tx.c"
+
+/**
+ * @brief Convert DMA backend enum to printable string.
+ *
+ * @param dma_backend Backend enum value.
+ * @return Constant backend name string.
+ */
+static const char *openwifi_dma_backend_name(enum openwifi_dma_backend dma_backend)
+{
+  if (dma_backend == OPENWIFI_DMA_ADI) {
+    return "ADI";
+  }
+  if (dma_backend == OPENWIFI_DMA_XILINX) {
+    return "Xilinx";
+  }
+  return "unknown";
+}
+
+/**
+ * @brief Classify hardware/fpga type from root DT platform identity strings.
+ *
+ * @param priv Driver private state.
+ * @param fpga_model Root DT model string.
+ * @param root_compatible Root DT compatible string.
+ */
+static void openwifi_classify_platform_from_model(struct openwifi_priv *priv, const char *fpga_model,
+  const char *root_compatible)
+{
+  priv->platform_is_cheshire = openwifi_platform_is_cheshire(fpga_model, root_compatible);
+  /* Cheshire runs on ZCU104 (ZynqMP UltraScale+) with AD9361 — classify as
+   * ZYNQMP_AD9361, not UNKNOWN_HARDWARE. The DTS uses "eth,cheshire" tokens
+   * which don't match openwifi_platform_is_zynqmp_class() checks, so we map
+   * it explicitly here. */
+  if (priv->platform_is_cheshire) {
+    priv->hardware_type = ZYNQMP_AD9361;
+  } else if (openwifi_platform_is_zynqmp_class(fpga_model, root_compatible)) {
+    priv->hardware_type = ZYNQMP_AD9361;
+  } else {
+    priv->hardware_type = ZYNQ_AD9361;
+  }
+  priv->fpga_type = openwifi_platform_is_large_fpga(fpga_model, root_compatible) ? LARGE_FPGA : SMALL_FPGA;
+}
+
+/**
+ * @brief Validate required DMA prep callbacks for current RX/TX channels.
+ *
+ * @param priv Driver private state.
+ * @return 0 when both channels expose required APIs, -EOPNOTSUPP otherwise.
+ */
+static int openwifi_validate_dma_prep_ops(struct openwifi_priv *priv)
+{
+  if (!priv->rx_chan || !priv->rx_chan->device || !priv->rx_chan->device->device_prep_dma_cyclic) {
+    printk(KERN_ERR "%s openwifi_start: RX DMA backend lacks device_prep_dma_cyclic\n",
+      sdr_compatible_str);
+    return -EOPNOTSUPP;
+  }
+  if (!priv->tx_chan || !priv->tx_chan->device || !priv->tx_chan->device->device_prep_slave_sg) {
+    printk(KERN_ERR "%s openwifi_start: TX DMA backend lacks device_prep_slave_sg\n",
+      sdr_compatible_str);
+    return -EOPNOTSUPP;
+  }
+  return 0;
+}
+
+/**
+ * @brief Terminate one DMA channel with bounded retries.
+ *
+ * @param chan DMA channel.
+ * @param tag Caller/context tag for logs.
+ * @return 0 on success, negative errno when terminate failed after retries.
+ */
+static int openwifi_dma_terminate_sync_retry(struct dma_chan *chan, const char *tag)
+{
+  int ret = 0;
+  int attempt;
+
+  if (!chan) {
+    return 0;
+  }
+  for (attempt = 1; attempt <= OW_DMA_TERMINATE_RETRY_MAX; attempt++) {
+    ret = dmaengine_terminate_sync(chan);
+    if (!ret) {
+      return 0;
+    }
+    printk(KERN_WARNING "%s %s: dmaengine_terminate_sync failed (%d) attempt %d/%d\n",
+      sdr_compatible_str, tag, ret, attempt, OW_DMA_TERMINATE_RETRY_MAX);
+    if (attempt < OW_DMA_TERMINATE_RETRY_MAX) {
+      msleep(OW_DMA_TERMINATE_RETRY_DELAY_MS);
+    }
+  }
+  return ret;
+}
+
+/**
+ * @brief Disable RX DMA completion callbacks for teardown safety.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_disarm_rx_dma_callback(struct openwifi_priv *priv)
+{
+  if (!priv || !priv->rxd) {
+    return;
+  }
+  WRITE_ONCE(priv->rxd->callback, NULL);
+  WRITE_ONCE(priv->rxd->callback_param, NULL);
+}
+
+/* TODO(openwifi-lifecycle-contract):
+ * Implement mirrored setup/teardown contracts per runtime subsystem (replicate
+ * the same pattern for each major flow), not only one global helper.
+ *
+ * Target subsystems:
+ * - TX DMA/ring ownership lifecycle (sdr.c + sdr_tx.c)
+ * - RX DMA/callback/watchdog lifecycle (sdr.c + sdr_rx.c)
+ * - IRQ registration/unregistration lifecycle
+ * - delayed-work/timer lifecycle used by runtime recovery paths
+ *
+ * For each subsystem, add paired helpers with mirrored names:
+ * - openwifi_<subsys>_setup_*()
+ * - openwifi_<subsys>_teardown_*()
+ *
+ * Then compose those subsystem helpers in start/stop/remove/recovery paths so
+ * teardown is idempotent, reverse-ordered, and only executes steps marked
+ * active by that subsystem's lifecycle state (bitmask/flags).
+ */
+
+/**
+ * @brief Check whether runtime DMA/ring resources remain allocated.
+ *
+ * @param priv Driver private state.
+ * @return true when any runtime DMA/ring resource is still allocated.
+ */
+static bool openwifi_runtime_dma_resources_active(const struct openwifi_priv *priv)
+{
+  int i;
+
+  if (!priv) {
+    return false;
+  }
+  if (priv->rx_chan || priv->tx_chan || priv->rx_cyclic_buf || priv->rx_dma_regs) {
+    return true;
+  }
+  for (i = 0; i < MAX_NUM_SW_QUEUE; i++) {
+    if (priv->tx_ring[i].bds) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * @brief Terminate DMA and release runtime DMA/ring resources.
+ *
+ * @param priv Driver private state.
+ * @param tag Caller/context tag for terminate logs.
+ * @return 0 on success, negative errno on terminate failure.
+ */
+static int openwifi_cleanup_runtime_dma_resources(struct openwifi_priv *priv, const char *tag)
+{
+  int term_tx_ret;
+  int term_rx_ret;
+  int term_ret;
+  int i;
+
+  if (!priv) {
+    return 0;
+  }
+
+  /* If terminate fails, avoid stale cyclic RX callbacks into this driver. */
+  openwifi_disarm_rx_dma_callback(priv);
+
+  term_tx_ret = openwifi_dma_terminate_sync_retry(priv->tx_chan, tag);
+  term_rx_ret = openwifi_dma_terminate_sync_retry(priv->rx_chan, tag);
+  term_ret = term_tx_ret ? term_tx_ret : term_rx_ret;
+  if (term_ret) {
+    return term_ret;
+  }
+
+  if (priv->tx_chan) {
+    for (i = 0; i < MAX_NUM_SW_QUEUE; i++) {
+      openwifi_free_tx_ring(priv, i);
+    }
+    dma_release_channel(priv->tx_chan);
+    priv->tx_chan = NULL;
+  }
+
+  if (priv->rx_chan) {
+    openwifi_free_rx_ring(priv);
+    dma_release_channel(priv->rx_chan);
+    priv->rx_chan = NULL;
+  }
+
+  openwifi_unmap_rx_dma_regs(priv);
+  return 0;
+}
+
+/**
+ * @brief Select AD9361 TX attenuation channel from runtime TX antenna config.
+ *
+ * @param runtime_tx_ant_cfg Runtime TX antenna selector.
+ * @return AD9361 TX channel index.
+ */
+static u32 openwifi_tx_atten_channel_for_runtime_cfg(u8 runtime_tx_ant_cfg)
+{
+  if (runtime_tx_ant_cfg == OPENWIFI_TX_ANT_MIN || runtime_tx_ant_cfg == OPENWIFI_TX_ANT_MAX) {
+    return OW_AD9361_TX_CH_ANT0;
+  }
+  return OW_AD9361_TX_CH_ANT1;
+}
+
+/**
+ * @brief Map an interrupt by DT name, with legacy index fallback.
+ *
+ * Cross-layer mapping references:
+ * - IRQ wiring: openwifi-hw/.../scripts/modular_block_design/05_connections.tcl
+ * - DT names/order: kernel_boot/boards/zcu104_fmcs2/src/system.dts
+ *   and kernel_boot/boards/zcu104_fmcs2/src/dts_adi/system_adi_dma.dts
+ *
+ * @param np Device-tree node that owns the interrupt list.
+ * @param irq_name Interrupt name in the interrupt-names property.
+ * @param fallback_idx Legacy interrupt index fallback.
+ * @return Linux IRQ number, or 0 when mapping fails.
+ */
+static u32 openwifi_map_irq_by_name_or_index(struct device_node *np, const char *irq_name, u32 fallback_idx)
+{
+  int irq_idx = -EINVAL;
+  u32 irq;
+
+  if (!np) {
+    return 0;
+  }
+
+  if (irq_name) {
+    irq_idx = of_property_match_string(np, "interrupt-names", irq_name);
+  }
+  if (irq_idx >= 0) {
+    irq = irq_of_parse_and_map(np, (u32)irq_idx);
+    if (irq != 0U) {
+      return irq;
+    }
+  }
+
+  return irq_of_parse_and_map(np, fallback_idx);
+}
+
+/**
+ * @brief Start device data path, DMA channels, IRQs, and watchdogs.
+ *
+ * @param dev mac80211 hardware handle.
+ * @return 0 on success, negative errno on failure.
+ */
+static int openwifi_start(struct ieee80211_hw *dev)
+{
+  struct openwifi_priv *priv = dev->priv;
+  enum openwifi_dma_backend rx_dma_backend_detected;
+  enum openwifi_dma_backend tx_dma_backend_detected;
+  int ret, i;
+  int term_ret;
+  u32 reg;
+
+  /* If a previous stop/start path left stale runtime resources, attempt one
+   * cleanup pass before failing closed. */
+  if (openwifi_runtime_dma_resources_active(priv)) {
+    pr_warn("%s openwifi_start: stale runtime DMA resources detected, attempting cleanup\n",
+      sdr_compatible_str);
+    ret = openwifi_cleanup_runtime_dma_resources(priv, "openwifi_start(recover)");
+    if (ret || openwifi_runtime_dma_resources_active(priv)) {
+      pr_err("%s openwifi_start: stale runtime DMA resources present after cleanup attempt; reload/reprobe required\n",
+        sdr_compatible_str);
+      return -EBUSY;
+    }
+  }
+
+  priv->rx_dma_watchdog_enabled = false;
+  priv->rx_dma_wd_stall_count = 0;
+  priv->rx_dma_wd_rearm_grace_ticks = 0;
+
+  /* Clear per-slot claim flags and re-entrancy guard from any previous
+   * stop/start cycle.  Without this, stale claims would permanently
+   * blacklist ring slots and a stale rx_processing flag would prevent
+   * all RX processing. */
+  clear_bit(0, &priv->rx_processing);
+  memset(priv->rx_slot_claimed, 0, sizeof(priv->rx_slot_claimed));
+  priv->rx_scan_start_idx = 0;
+
+  WRITE_ONCE(priv->tx_dma_stalled, false);
+  WRITE_ONCE(priv->tx_dma_terminating, false);
+  WRITE_ONCE(priv->tx_dma_recovery_enabled, false);
+  WRITE_ONCE(priv->tx_cookie, 0);
+  WRITE_ONCE(priv->tx_dma_stall_first_jiffies, 0);
+  WRITE_ONCE(priv->tx_dma_stall_window_count, 0);
+  WRITE_ONCE(priv->tx_timeout_warn_jiffies, 0);
+  WRITE_ONCE(priv->tx_dma_stall_recovery_cycles, 0);
+  INIT_DELAYED_WORK(&priv->tx_stall_recovery_work, openwifi_tx_stall_recovery);
+
+  priv->rx_invalid_header_count = 0;
+  priv->rx_invalid_warn_jiffies = 0;
+
+  priv->rx_irq49_count = 0;
+  priv->rx_dma_cb_count = 0;
+  priv->rx_dma_cb_full_count = 0;
+  priv->rx_dma_cb_last_irq49 = 0;
+  priv->rx_dma_cb_stall_count = 0;
+  priv->rx_dma_cb_stall_start_jiffies = 0;
+  priv->rx_dma_cb_last_full_jiffies = jiffies;
+
+  priv->rx_dma_wd_restart_count = 0;
+  memset(priv->tx_aggr_prev_valid, 0, sizeof(priv->tx_aggr_prev_valid));
+  memset(priv->tx_aggr_prev_key, 0, sizeof(priv->tx_aggr_prev_key));
+  priv->tx_pkt_info_last_valid = false;
+  memset(priv->tx_pkt_info_last, 0, sizeof(priv->tx_pkt_info_last));
+  priv->tx_pkt_info_latched_valid = false;
+  memset(priv->tx_pkt_info_latched, 0, sizeof(priv->tx_pkt_info_latched));
+
+  tx_dma_wait_us = clamp(tx_dma_wait_us, OW_TX_DMA_POLL_US_MIN, OW_TX_DMA_POLL_US_MAX);
+  tx_dma_poll_step_us = clamp(tx_dma_poll_step_us, OW_TX_DMA_POLL_STEP_US_MIN, OW_TX_DMA_POLL_STEP_US_MAX);
+  rx_callback_fallback_n_cb = clamp(rx_callback_fallback_n_cb, OW_RX_CB_FALLBACK_N_CB_MIN, OW_RX_CB_FALLBACK_N_CB_MAX);
+  rx_callback_fallback_n_ms = clamp(rx_callback_fallback_n_ms, OW_RX_CB_FALLBACK_N_MS_MIN, OW_RX_CB_FALLBACK_N_MS_MAX);
+  rx_invalid_warn_interval_ms = clamp(rx_invalid_warn_interval_ms, OW_WARN_INTERVAL_MS_MIN, OW_WARN_INTERVAL_MS_MAX);
+  tx_timeout_warn_interval_ms = clamp(tx_timeout_warn_interval_ms, OW_WARN_INTERVAL_MS_MIN, OW_WARN_INTERVAL_MS_MAX);
+
+  for (i = 0; i < MAX_NUM_VIF; i++) {
+    priv->vif[i] = NULL;
+  }
+
+  /* Turn on radio. */
+  ret = openwifi_set_antenna(dev, priv->runtime_tx_ant_cfg, priv->runtime_rx_ant_cfg);
+  if (ret) {
+    printk(KERN_ERR "%s openwifi_start: openwifi_set_antenna failed (%d)\n",
+      sdr_compatible_str, ret);
+    goto err_dma;
+  }
+  reg = ad9361_get_tx_atten(priv->ad9361_phy, openwifi_tx_atten_channel_for_runtime_cfg(priv->runtime_tx_ant_cfg));
+  if (reg == (AD9361_RADIO_ON_TX_ATT + priv->rf_reg_val[RF_TX_REG_IDX_ATT])) {
+    priv->radio_enabled_cached = true;
+    printk("%s openwifi_start: rfkill radio on\n", sdr_compatible_str);
+  } else {
+    printk("%s openwifi_start: WARNING rfkill radio on failed. tx att read %d require %d\n",
+      sdr_compatible_str, reg, AD9361_RADIO_ON_TX_ATT + priv->rf_reg_val[RF_TX_REG_IDX_ATT]);
+  }
+
+  rx_intf_api->hw_init(priv->rx_intf_cfg, OW_HW_INIT_NUM_DMA_SYMBOLS, OW_HW_INIT_NUM_IQ_SYMBOLS);
+  tx_intf_api->hw_init(priv->tx_intf_cfg, OW_HW_INIT_NUM_DMA_SYMBOLS, OW_HW_INIT_NUM_IQ_SYMBOLS, priv->fpga_type);
+  openofdm_tx_api->hw_init(priv->openofdm_tx_cfg);
+  openofdm_rx_api->hw_init(priv->openofdm_rx_cfg);
+  xpu_api->hw_init(priv->xpu_cfg);
+
+  xpu_api->XPU_REG_MAC_ADDR_write(priv->mac_addr);
+
+  printk("%s openwifi_start: rx_intf_cfg %d openofdm_rx_cfg %d tx_intf_cfg %d openofdm_tx_cfg %d\n",
+    sdr_compatible_str, priv->rx_intf_cfg, priv->openofdm_rx_cfg, priv->tx_intf_cfg, priv->openofdm_tx_cfg);
+  printk("%s openwifi_start: rx_freq_offset_to_lo_MHz %d tx_freq_offset_to_lo_MHz %d\n",
+    sdr_compatible_str, priv->rx_freq_offset_to_lo_MHz, priv->tx_freq_offset_to_lo_MHz);
+
+  tx_intf_api->TX_INTF_REG_INTERRUPT_SEL_write(OW_TX_INTF_INTERRUPT_DISABLE);
+  rx_intf_api->RX_INTF_REG_INTERRUPT_TEST_write(OW_RX_INTERRUPT_TEST_DISABLE);
+  /* Hold M-AXIS in reset until RX DMA and IRQ paths are ready. */
+  rx_intf_api->RX_INTF_REG_M_AXIS_RST_write(1);
+
+  /* Handle all dma_request_chan failures (including EPROBE_DEFER).
+   * Falling through with ERR_PTR would let later code dereference it. */
+  priv->rx_chan = dma_request_chan(&(priv->pdev->dev), "rx_dma_s2mm");
+  if (IS_ERR_OR_NULL(priv->rx_chan)) {
+    ret = priv->rx_chan ? PTR_ERR(priv->rx_chan) : -ENODEV;
+    pr_err("%s openwifi_start: No Rx channel ret %d\n", sdr_compatible_str, ret);
+    priv->rx_chan = NULL;
+    goto err_dma;
+  }
+
+  priv->tx_chan = dma_request_chan(&(priv->pdev->dev), "tx_dma_mm2s");
+  if (IS_ERR_OR_NULL(priv->tx_chan)) {
+    ret = priv->tx_chan ? PTR_ERR(priv->tx_chan) : -ENODEV;
+    pr_err("%s openwifi_start: No Tx channel ret %d\n", sdr_compatible_str, ret);
+    priv->tx_chan = NULL;
+    goto err_free_rx_chan;
+  }
+  printk("%s openwifi_start: DMA channel setup successfully. rx=%s tx=%s\n",
+    sdr_compatible_str, dma_chan_name(priv->rx_chan), dma_chan_name(priv->tx_chan));
+
+  rx_dma_backend_detected = openwifi_classify_dma_backend(priv->rx_chan);
+  tx_dma_backend_detected = openwifi_classify_dma_backend(priv->tx_chan);
+  if (rx_dma_backend_detected == OPENWIFI_DMA_UNKNOWN) {
+    pr_err("%s openwifi_start: unsupported RX DMA backend\n", sdr_compatible_str);
+    ret = -ENODEV;
+    goto err_free_tx_chan;
+  }
+  if (WARN_ON(tx_dma_backend_detected != rx_dma_backend_detected)) {
+    pr_err("%s openwifi_start: RX/TX DMA backend mismatch rx=%d tx=%d\n",
+      sdr_compatible_str, rx_dma_backend_detected, tx_dma_backend_detected);
+    ret = -EINVAL;
+    goto err_free_tx_chan;
+  }
+  priv->dma_backend = rx_dma_backend_detected;
+  printk("%s openwifi_start: DMA backend=%s\n", sdr_compatible_str, openwifi_dma_backend_name(priv->dma_backend));
+
+  ret = openwifi_validate_dma_prep_ops(priv);
+  if (ret) {
+    goto err_free_tx_chan;
+  }
+
+  ret = openwifi_map_rx_dma_regs(priv);
+  if (ret) {
+    printk("%s openwifi_start: openwifi_map_rx_dma_regs ret %d\n",
+      sdr_compatible_str, ret);
+    goto err_free_tx_chan;
+  }
+
+  ret = openwifi_init_rx_ring(priv);
+  if (ret) {
+    printk("%s openwifi_start: openwifi_init_rx_ring ret %d\n", sdr_compatible_str,ret);
+    goto err_free_rings;
+  }
+
+  priv->seqno = 0;
+  for (i = 0; i < MAX_NUM_SW_QUEUE; i++) {
+    if ((ret = openwifi_init_tx_ring(priv, i))) {
+      printk("%s openwifi_start: openwifi_init_tx_ring %d ret %d\n", sdr_compatible_str, i, ret);
+      goto err_free_rings;
+    }
+  }
+
+  if ((ret = rx_dma_setup(dev))) {
+    printk("%s openwifi_start: rx_dma_setup ret %d\n", sdr_compatible_str, ret);
+    goto err_free_rings;
+  }
+
+  priv->irq_rx = openwifi_map_irq_by_name_or_index(priv->pdev->dev.of_node,
+    OW_RX_IRQ_DT_NAME, OW_RX_IRQ_DT_INDEX);
+  if (!priv->irq_rx) {
+    ret = -ENODEV;
+    wiphy_err(dev->wiphy, "openwifi_start: invalid irq_rx mapping\n");
+    goto err_stop_rx_dma;
+  }
+  ret = request_irq(priv->irq_rx, openwifi_rx_interrupt,
+    IRQF_SHARED, "sdr,rx_pkt_intr", dev);
+  if (ret) {
+    wiphy_err(dev->wiphy, "openwifi_start:failed to register IRQ handler openwifi_rx_interrupt\n");
+    goto err_stop_rx_dma;
+  } else {
+    printk("%s openwifi_start: irq_rx %d\n", sdr_compatible_str, priv->irq_rx);
+  }
+
+  priv->irq_tx = openwifi_map_irq_by_name_or_index(priv->pdev->dev.of_node,
+    OW_TX_IRQ_DT_NAME, OW_TX_IRQ_DT_INDEX);
+  if (!priv->irq_tx) {
+    ret = -ENODEV;
+    wiphy_err(dev->wiphy, "openwifi_start: invalid irq_tx mapping\n");
+    goto err_free_irq_rx;
+  }
+  ret = request_irq(priv->irq_tx, openwifi_tx_interrupt,
+    IRQF_SHARED, "sdr,tx_itrpt", dev);
+  if (ret) {
+    wiphy_err(dev->wiphy, "openwifi_start: failed to register IRQ handler openwifi_tx_interrupt\n");
+    goto err_free_irq_rx;
+  } else {
+    printk("%s openwifi_start: irq_tx %d\n", sdr_compatible_str, priv->irq_tx);
+  }
+
+  /* Reset RX BA software/hardware state before reopening RX interrupts. */
+  openwifi_reset_rx_ba_session(priv);
+  xpu_api->XPU_REG_BSSID_FILTER_ADDR_write(NULL);
+
+  rx_intf_api->RX_INTF_REG_INTERRUPT_TEST_write(OW_RX_INTERRUPT_TEST_ENABLE);
+  tx_intf_api->TX_INTF_REG_INTERRUPT_SEL_write(OW_TX_INTF_INTERRUPT_ENABLE);
+  /* Release M-AXIS after both RX/TX IRQ handlers are installed. */
+  rx_intf_api->RX_INTF_REG_M_AXIS_RST_write(0);
+  xpu_api->XPU_REG_TSF_LOAD_VAL_write(0, 0);
+
+  priv->stat.csma_cfg0 = xpu_api->XPU_REG_FORCE_IDLE_MISC_read();
+
+  /* Disable AD9361 auto calibration and enable OpenWiFi FPGA SPI control. */
+  priv->ad9361_phy->state->auto_cal_en = false;
+  priv->ad9361_phy->state->manual_tx_quad_cal_en = true;
+  xpu_api->XPU_REG_SPI_DISABLE_write(OW_SPI_DISABLE_DISABLE);
+
+  /* Defensive WMM CW initialization.  Standard 802.11e AC defaults:
+   * VO=0x32 (CW 3-7), VI=0x43 (CW 7-15), BE=0xA4 (CW 15-1023), BK=0xA4.
+   *
+   * Written unconditionally because:
+   * 1. FPGA resets CSMA_CFG to 0x00000000 (CW=0 for all queues = no backoff)
+   * 2. hw_init() does NOT write CSMA_CFG (xpu.c:446-447 commented out)
+   * 3. conf_tx() fires after association and overwrites with AP WMM params
+   * 4. If AP is non-WMM, conf_tx() writes all-BE (0xA4A4A4A4) — these
+   *    defaults provide correct WMM differentiation before that point */
+  xpu_api->XPU_REG_CSMA_CFG_write(OW_CSMA_CFG_WMM_DEFAULT);
+  xpu_api->XPU_REG_AIFS_CFG_write(OW_AIFS_CFG_WMM_DEFAULT);
+  openwifi_cache_wmm_default_edca(priv);
+  printk(KERN_INFO "%s openwifi_start: default CSMA_CFG=0x%08x AIFS_CFG=0x%08x AMPDU_ACTION=0x%08x\n",
+    sdr_compatible_str,
+    xpu_api->XPU_REG_CSMA_CFG_read(),
+    xpu_api->XPU_REG_AIFS_CFG_read(),
+    xpu_api->XPU_REG_AMPDU_ACTION_read());
+
+  openwifi_rx_dma_watchdog_arm(priv);
+
+  printk("%s openwifi_start: NUM_RX_BD=%d RX_BD_BUF_SIZE=%d NUM_TX_BD=%d\n",
+         sdr_compatible_str, NUM_RX_BD, RX_BD_BUF_SIZE, NUM_TX_BD);
+  printk("%s openwifi_start: tx_dma_wait_us=%d tx_dma_poll_step_us=%d "
+         "rx_callback_fallback_n_cb=%d rx_callback_fallback_n_ms=%d "
+         "rx_invalid_warn_interval_ms=%d tx_timeout_warn_interval_ms=%d "
+         "rx_watchdog_enable=%d\n",
+         sdr_compatible_str, tx_dma_wait_us, tx_dma_poll_step_us,
+         rx_callback_fallback_n_cb, rx_callback_fallback_n_ms,
+         rx_invalid_warn_interval_ms, tx_timeout_warn_interval_ms,
+         rx_watchdog_enable);
+  printk("%s openwifi_start: debug_flags:"
+#ifdef DEBUG_OPENWIFI
+         " DEBUG_OPENWIFI"
+#endif
+#ifdef ENABLE_RX_SCAN_ALL_SLOTS
+         " ENABLE_RX_SCAN_ALL_SLOTS"
+#endif
+         " test_mode=%d\n",
+         sdr_compatible_str, test_mode);
+  printk("%s openwifi_start: normal end\n", sdr_compatible_str);
+  WRITE_ONCE(priv->tx_dma_recovery_enabled, true);
+  return 0;
+
+err_free_irq_rx:
+  free_irq(priv->irq_rx, dev);
+  /* TX mapping exists even when request_irq() failed. */
+  if (priv->irq_tx) {
+    irq_dispose_mapping(priv->irq_tx);
+  }
+err_stop_rx_dma:
+  /* RX mapping exists after irq_of_parse_and_map(). */
+  if (priv->irq_rx) {
+    irq_dispose_mapping(priv->irq_rx);
+  }
+  openwifi_disarm_rx_dma_callback(priv);
+  term_ret = openwifi_dma_terminate_sync_retry(priv->rx_chan, "openwifi_start(rx)");
+  if (term_ret) {
+    ret = term_ret;
+    goto err_dma_terminate_failed;
+  }
+err_free_rings:
+  openwifi_free_rx_ring(priv);
+  for (i = 0; i < MAX_NUM_SW_QUEUE; i++) {
+    openwifi_free_tx_ring(priv, i);
+  }
+err_free_tx_chan:
+  dma_release_channel(priv->tx_chan);
+  priv->tx_chan = NULL;
+  openwifi_unmap_rx_dma_regs(priv);
+err_free_rx_chan:
+  dma_release_channel(priv->rx_chan);
+  priv->rx_chan = NULL;
+err_dma_terminate_failed:
+  /* Do not free/release DMA-backed buffers/channels after terminate failure.
+   * Leaving resources pinned is safer than risking DMA use-after-free. */
+err_dma:
+  WRITE_ONCE(priv->tx_dma_recovery_enabled, false);
+  printk("%s openwifi_start: abnormal end ret %d\n", sdr_compatible_str, ret);
+  return ret;
+}
