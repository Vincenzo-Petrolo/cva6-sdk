+static inline void XPU_REG_MAC_ADDR_write(u8 *mac_addr) {//, u32 en_flag){
+	u32 mac_addr_low32;
+	u32 mac_addr_high16;
+
+	mac_addr_low32 = ((u32)mac_addr[0])
+		| ((u32)mac_addr[1] << 8)
+		| ((u32)mac_addr[2] << 16)
+		| ((u32)mac_addr[3] << 24);
+	mac_addr_high16 = ((u32)mac_addr[4]) | ((u32)mac_addr[5] << 8);
+
+	XPU_REG_MAC_ADDR_LOW_write(mac_addr_low32);
+	XPU_REG_MAC_ADDR_HIGH_write(mac_addr_high16);
+	#if 0
+	if (en_flag) {
+		XPU_REG_MAC_ADDR_HIGH_write( (*( (u16*)(mac_addr + 4) )) | 0x80000000 ); // 0x80000000 by default we turn on mac addr filter
+	} else {
+		XPU_REG_MAC_ADDR_HIGH_write( (*( (u16*)(mac_addr + 4) )) & 0x7FFFFFFF );
+	}
+	#endif
+}
