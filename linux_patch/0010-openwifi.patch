+
+//=============================================================================
+// RX Interrupt Architecture: IRQ49 vs DMA Callback
+//=============================================================================
+/*
+ * There are two RX-delivery paths: the primary FPGA IRQ49 path and the DMA
+ * callback fallback path.
+ *
+ * IRQ49 (rx_pkt_intr) is raised by rx_intf when a full packet is available
+ * in the cyclic RX buffer. openwifi_rx_interrupt(irq != 0) handles this path
+ * and increments rx_irq49_count.
+ *
+ * The ADI AXI-DMAC callback runs on period completions and calls
+ * openwifi_rx_interrupt(0, data) only when IRQ49 progress appears stalled.
+ * Fallback is triggered after threshold count/time limits:
+ * rx_callback_fallback_n_cb and rx_callback_fallback_n_ms.
+ */
+
+//=============================================================================
+// Build Configuration
+//=============================================================================
+
+/* Toggle: bypass cf_axi_dds IIO driver and use direct DAC register writes. */
+#define ENABLE_DIRECT_DAC_MODE
+
