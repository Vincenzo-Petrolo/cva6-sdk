+static inline void XPU_REG_TSF_LOAD_VAL_write(u32 high_value, u32 low_value){
+	/* TODO(openwifi-tsf-load-contract): split TSF load control from data.
+	 * Current contract aliases HIGH bit31 as load strobe, so TSF bit63 cannot be
+	 * represented independently during software load.
+	 * Required closure:
+	 * 1) introduce a dedicated load-control register/bit in RTL/API;
+	 * 2) keep full 64-bit TSF data path purely data;
+	 * 3) update this writer to avoid bit31 toggle side effects;
+	 * 4) validate with explicit bit63 set/readback test. */
+	XPU_REG_TSF_LOAD_VAL_LOW_write(low_value);
+	XPU_REG_TSF_LOAD_VAL_HIGH_write(high_value|0x80000000); // msb high
+	XPU_REG_TSF_LOAD_VAL_HIGH_write(high_value&(~0x80000000)); // msb low
+}
