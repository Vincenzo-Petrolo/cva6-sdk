+static bool openwifi_tx_rate_index_from_mcs(long mcs_raw, u32 *rate_index)
+{
+  u32 mcs_u32, rate_hw_value, index;
+  bool use_ht_rate;
+
+  if (mcs_raw < 0) {
+    return false;
+  }
+  mcs_u32 = (u32)mcs_raw;
+  use_ht_rate = ((mcs_u32 & OW_TX_MCS_SYSFS_HT_FLAG) != 0U);
+  rate_hw_value = (mcs_u32 & (~OW_TX_MCS_SYSFS_HT_FLAG));
+  index = use_ht_rate ? (rate_hw_value + OW_TX_WIFI_RATE_HT_BASE_IDX) : rate_hw_value;
+  if (index >= ARRAY_SIZE(wifi_rate_all)) {
+    return false;
+  }
+  if (rate_index) {
+    *rate_index = index;
+  }
+
+  return true;
+}
+
+static bool openwifi_rx_rate_index_is_valid(long rate_index)
+{
+  return (rate_index >= 0) && ((u32)rate_index < ARRAY_SIZE(wifi_rate_table));
+}
