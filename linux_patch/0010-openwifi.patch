+/**
+ * @brief Initialize driver statistics/state counters to default values.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_probe_init_stats(struct openwifi_priv *priv)
+{
+  int idx_sw_queue;
+  int idx_hw_queue;
+  int idx_retry_bucket;
+
+  priv->stat.stat_enable = 0;
+
+  for (idx_sw_queue = 0; idx_sw_queue < MAX_NUM_SW_QUEUE; idx_sw_queue++) {
+    priv->stat.tx_prio_num[idx_sw_queue] = 0;
+    priv->stat.tx_prio_interrupt_num[idx_sw_queue] = 0;
+    priv->stat.tx_prio_stop0_fake_num[idx_sw_queue] = 0;
+    priv->stat.tx_prio_stop0_real_num[idx_sw_queue] = 0;
+    priv->stat.tx_prio_stop1_num[idx_sw_queue] = 0;
+    priv->stat.tx_prio_wakeup_num[idx_sw_queue] = 0;
+  }
+  for (idx_hw_queue = 0; idx_hw_queue < MAX_NUM_HW_QUEUE; idx_hw_queue++) {
+    priv->stat.tx_queue_num[idx_hw_queue] = 0;
+    priv->stat.tx_queue_interrupt_num[idx_hw_queue] = 0;
+    priv->stat.tx_queue_stop0_fake_num[idx_hw_queue] = 0;
+    priv->stat.tx_queue_stop0_real_num[idx_hw_queue] = 0;
+    priv->stat.tx_queue_stop1_num[idx_hw_queue] = 0;
+    priv->stat.tx_queue_wakeup_num[idx_hw_queue] = 0;
+    priv->requested_aifs[idx_hw_queue] = 0;
+    priv->requested_txop[idx_hw_queue] = 0;
+  }
+  openwifi_cache_wmm_default_edca(priv);
+
+  priv->stat.tx_data_pkt_need_ack_num_total = 0;
+  priv->stat.tx_data_pkt_need_ack_num_total_fail = 0;
+  for (idx_retry_bucket = 0; idx_retry_bucket < OPENWIFI_TX_DATA_RETRY_BUCKETS; idx_retry_bucket++) {
+    priv->stat.tx_data_pkt_need_ack_num_retx[idx_retry_bucket] = 0;
+    priv->stat.tx_data_pkt_need_ack_num_retx_fail[idx_retry_bucket] = 0;
+  }
+  priv->stat.tx_data_pkt_mcs_realtime = 0;
+  priv->stat.tx_data_pkt_fail_mcs_realtime = 0;
+
+  priv->stat.tx_mgmt_pkt_need_ack_num_total = 0;
+  priv->stat.tx_mgmt_pkt_need_ack_num_total_fail = 0;
+  for (idx_retry_bucket = 0; idx_retry_bucket < OPENWIFI_TX_MGMT_RETRY_BUCKETS; idx_retry_bucket++) {
+    priv->stat.tx_mgmt_pkt_need_ack_num_retx[idx_retry_bucket] = 0;
+    priv->stat.tx_mgmt_pkt_need_ack_num_retx_fail[idx_retry_bucket] = 0;
+  }
+  priv->stat.tx_mgmt_pkt_mcs_realtime = 0;
+  priv->stat.tx_mgmt_pkt_fail_mcs_realtime = 0;
+
+  priv->stat.rx_monitor_all = 0;
+  priv->stat.rx_target_sender_mac_addr = 0;
+  priv->stat.rx_target_sender_mac_addr_high16 = 0;
+  priv->stat.rx_data_ok_agc_gain_value_realtime = 0;
+  priv->stat.rx_data_fail_agc_gain_value_realtime = 0;
+  priv->stat.rx_mgmt_ok_agc_gain_value_realtime = 0;
+  priv->stat.rx_mgmt_fail_agc_gain_value_realtime = 0;
+  priv->stat.rx_ack_ok_agc_gain_value_realtime = 0;
+  priv->stat.rx_data_pkt_num_total = 0;
+  priv->stat.rx_data_pkt_num_fail = 0;
+  priv->stat.rx_mgmt_pkt_num_total = 0;
+  priv->stat.rx_mgmt_pkt_num_fail = 0;
+  priv->stat.rx_ack_pkt_num_total = 0;
+  priv->stat.rx_ack_pkt_num_fail = 0;
+  priv->stat.rx_data_pkt_mcs_realtime = 0;
+  priv->stat.rx_data_pkt_fail_mcs_realtime = 0;
+  priv->stat.rx_mgmt_pkt_mcs_realtime = 0;
+  priv->stat.rx_mgmt_pkt_fail_mcs_realtime = 0;
+  priv->stat.rx_ack_pkt_mcs_realtime = 0;
+  priv->stat.restrict_freq_mhz = 0;
+  priv->stat.csma_cfg0 = 0;
+  priv->stat.cw_max_min_cfg = 0;
+  priv->stat.dbg_ch0 = 0;
+  priv->stat.dbg_ch1 = 0;
+  priv->stat.dbg_ch2 = 0;
+  priv->stat.tx_bounce_buf_count = 0;
+  priv->stat.tx_tailroom_expand_count = 0;
+  priv->stat.tx_vo_promote_count = 0;
+  priv->stat.tx_ampdu_tx_start_count = 0;
+  priv->stat.tx_ampdu_tx_stop_count = 0;
+  priv->stat.tx_ampdu_tx_operational_count = 0;
+  priv->stat.tx_ampdu_ba_nonzero_bitmap_count = 0;
+  priv->stat.tx_ampdu_ba_zero_bitmap_count = 0;
+  priv->stat.tx_ampdu_no_ba_count = 0;
+  priv->stat.tx_ampdu_unexpected_ack_count = 0;
+  priv->stat.rx_ampdu_start_count = 0;
+  priv->stat.rx_ampdu_stop_count = 0;
+  priv->stat.rx_ampdu_reject_count = 0;
+  priv->rx_ba_active = false;
+  priv->rx_ba_tid = 0;
+  priv->rx_ba_ssn = 0;
+  priv->rx_ba_buf_size = 0;
+  priv->rx_ba_timeout_tu = 0;
+  eth_zero_addr(priv->rx_ba_peer_addr);
+}
+
+/**
+ * @brief Initialize and register a random valid MAC address.
+ *
+ * @param dev mac80211 hardware handle.
+ */
+static void openwifi_probe_init_mac_addr(struct ieee80211_hw *dev)
+{
+  struct openwifi_priv *priv = dev->priv;
+  u32 rand_val;
+
+  get_random_bytes(&rand_val, sizeof(rand_val));
+  rand_val %= OW_MAC_ADDR_LAST_OCTET_MODULO;
+  priv->mac_addr[0] = OW_MAC_ADDR_PREFIX0;
+  priv->mac_addr[1] = OW_MAC_ADDR_PREFIX1;
+  priv->mac_addr[2] = OW_MAC_ADDR_PREFIX2;
+  priv->mac_addr[3] = OW_MAC_ADDR_PREFIX3;
+  priv->mac_addr[4] = OW_MAC_ADDR_PREFIX4;
+  priv->mac_addr[5] = (u8)(rand_val + OW_MAC_ADDR_LAST_OCTET_MIN);
+  if (!is_valid_ether_addr(priv->mac_addr)) {
+    printk(KERN_WARNING "%s openwifi_dev_probe: WARNING Invalid hwaddr! Using randomly generated MAC addr\n", sdr_compatible_str);
+    eth_random_addr(priv->mac_addr);
+  }
+  printk("%s openwifi_dev_probe: mac_addr %02x:%02x:%02x:%02x:%02x:%02x\n",
+    sdr_compatible_str, priv->mac_addr[0], priv->mac_addr[1], priv->mac_addr[2], priv->mac_addr[3], priv->mac_addr[4], priv->mac_addr[5]);
+  SET_IEEE80211_PERM_ADDR(dev, priv->mac_addr);
+  /* Cache pre-parsed MAC parts for fast per-packet own-MAC check in RX. */
+  priv->own_mac_high16 = get_unaligned_le16(priv->mac_addr);
+  priv->own_mac_low32 = get_unaligned_le32(priv->mac_addr + 2);
+}
+
+/**
+ * @brief Create probe-time sysfs entries for TX IQ and debug groups.
+ *
+ * @param pdev Platform device.
+ * @param priv Driver private state.
+ * @return 0 on success, negative errno on failure.
+ */
+static int openwifi_probe_create_sysfs_entries(struct platform_device *pdev, struct openwifi_priv *priv)
+{
+  int err;
+
+  sysfs_bin_attr_init(&priv->bin_iq);
+  priv->bin_iq.attr.name = "tx_intf_iq_data";
+  priv->bin_iq.attr.mode = S_IWUSR | S_IRUGO;
+  priv->bin_iq.write = openwifi_tx_intf_bin_iq_write;
+  priv->bin_iq.read = openwifi_tx_intf_bin_iq_read;
+  priv->bin_iq.size = OW_TX_INTF_IQ_DATA_SYSFS_SIZE;
+  err = sysfs_create_bin_file(&pdev->dev.kobj, &priv->bin_iq);
+  printk("%s openwifi_dev_probe: sysfs_create_bin_file %d\n", sdr_compatible_str, err);
+  if (err < 0) {
+    return err;
+  }
+
+  priv->tx_intf_arbitrary_iq_num = 0;
+  err = sysfs_create_group(&pdev->dev.kobj, &tx_intf_attribute_group);
+  printk("%s openwifi_dev_probe: sysfs_create_group tx_intf_attribute_group %d\n", sdr_compatible_str, err);
+  if (err < 0) {
+    goto err_remove_bin_file;
+  }
+  priv->tx_intf_iq_ctl = 0;
+
+  err = sysfs_create_group(&pdev->dev.kobj, &stat_attribute_group);
+  printk("%s openwifi_dev_probe: sysfs_create_group stat_attribute_group %d\n", sdr_compatible_str, err);
+  if (err < 0) {
+    goto err_remove_tx_group;
+  }
+
+  err = sysfs_create_group(&pdev->dev.kobj, &stabilization_attribute_group);
+  printk("%s openwifi_dev_probe: sysfs_create_group stabilization_attribute_group %d\n", sdr_compatible_str, err);
+  if (err < 0) {
+    goto err_remove_stat_group;
+  }
+
+  return 0;
+
+err_remove_stat_group:
+  sysfs_remove_group(&pdev->dev.kobj, &stat_attribute_group);
+err_remove_tx_group:
+  sysfs_remove_group(&pdev->dev.kobj, &tx_intf_attribute_group);
+err_remove_bin_file:
+  sysfs_remove_bin_file(&pdev->dev.kobj, &priv->bin_iq);
+  return err;
+}
