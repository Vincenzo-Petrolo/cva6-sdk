+/**
+ * @brief Report multicast filter state to mac80211.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param mc_list Multicast address list.
+ * @return Number of multicast addresses.
+ */
+static u64 openwifi_prepare_multicast(struct ieee80211_hw *dev, struct netdev_hw_addr_list *mc_list)
+{
+  (void)dev;
+  printk_ratelimited(KERN_DEBUG "%s openwifi_prepare_multicast\n", sdr_compatible_str);
+  return netdev_hw_addr_list_count(mc_list);
+}
+
+/**
+ * @brief Program receive filter flags into FPGA.
+ *
+ * mac80211 parity references:
+ * - adi-linux-64/net/mac80211/iface.c
+ * - adi-linux-64/net/mac80211/main.c
+ *
+ * @param dev mac80211 hardware handle.
+ * @param changed_flags Changed filter flags (unused).
+ * @param total_flags In/out filter flags.
+ * @param multicast Multicast token from prepare_multicast (unused).
+ */
+static void openwifi_configure_filter(struct ieee80211_hw *dev, unsigned int changed_flags, unsigned int *total_flags, u64 multicast)
+{
+  struct openwifi_priv *priv = dev->priv;
+  u32 filter_flag;
+  (void)changed_flags;
+  (void)multicast;
+
+  (*total_flags) &= SDR_SUPPORTED_FILTERS;
+  (*total_flags) |= FIF_ALLMULTI;
+  filter_flag = (*total_flags);
+  filter_flag = (filter_flag | UNICAST_FOR_US | BROADCAST_ALL_ONE | BROADCAST_ALL_ZERO);
+
+  if ((filter_flag & OW_FILTER_MONITOR_FLAGS_MASK) == OW_FILTER_MONITOR_FLAGS_MASK) {
+    filter_flag = (filter_flag | MONITOR_ALL);
+  } else {
+    filter_flag = (filter_flag & (~MONITOR_ALL));
+  }
+
+  if (!(filter_flag & FIF_BCN_PRBRESP_PROMISC)) {
+    filter_flag = (filter_flag | MY_BEACON);
+  }
+
+  filter_flag = (filter_flag | FIF_PSPOLL);
+
+  if (priv->stat.rx_monitor_all) {
+    filter_flag = (filter_flag | MONITOR_ALL);
+  }
+
+  xpu_api->XPU_REG_FILTER_FLAG_write(filter_flag | HIGH_PRIORITY_DISCARD_FLAG);
+  printk("%s openwifi_configure_filter MON %d M_BCN %d BST0 %d BST1 %d UST %d PB_RQ %d PS_PL %d O_BSS %d CTL %d BCN_PRP %d PCP_FL %d FCS_FL %d ALL_MULTI %d\n",
+    sdr_compatible_str,
+    !!(filter_flag & MONITOR_ALL),
+    !!(filter_flag & MY_BEACON),
+    !!(filter_flag & BROADCAST_ALL_ZERO),
+    !!(filter_flag & BROADCAST_ALL_ONE),
+    !!(filter_flag & UNICAST_FOR_US),
+    !!(filter_flag & FIF_PROBE_REQ),
+    !!(filter_flag & FIF_PSPOLL),
+    !!(filter_flag & FIF_OTHER_BSS),
+    !!(filter_flag & FIF_CONTROL),
+    !!(filter_flag & FIF_BCN_PRBRESP_PROMISC),
+    !!(filter_flag & FIF_PLCPFAIL),
+    !!(filter_flag & FIF_FCSFAIL),
+    !!(filter_flag & FIF_ALLMULTI));
+}
