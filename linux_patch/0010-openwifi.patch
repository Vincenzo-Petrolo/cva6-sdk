+/**
+ * @brief Show cached RX BlockAck session state and counters.
+ *
+ * @param input_dev Platform device backing the OpenWiFi driver.
+ * @param attr Sysfs attribute descriptor (unused).
+ * @param buf Output buffer.
+ * @return Number of bytes written to @p buf.
+ */
+static ssize_t ampdu_rx_state_show(struct device *input_dev, struct device_attribute *attr, char *buf)
+{
+  struct platform_device *pdev = to_platform_device(input_dev);
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+  unsigned long flags;
+  u32 reg_val;
+  u32 peer_low;
+  u32 peer_high;
+  bool reg_rx_ba_active;
+  bool reg_rx_ba_start_pulse;
+  u8 reg_rx_ba_tid;
+  u16 reg_rx_ba_ssn;
+  bool rx_ba_active;
+  u8 rx_ba_tid;
+  u16 rx_ba_ssn;
+  u16 rx_ba_buf_size;
+  u16 rx_ba_timeout_tu;
+  u8 rx_ba_peer_addr[ETH_ALEN];
+  ssize_t ret_size;
+  (void)attr;
+
+  reg_val = xpu_api->XPU_REG_AMPDU_ACTION_read();
+  peer_low = xpu_api->XPU_REG_AMPDU_RX_PEER_LOW_read();
+  peer_high = xpu_api->XPU_REG_AMPDU_RX_PEER_HIGH_read();
+  reg_rx_ba_active = !!(reg_val & OW_XPU_AMPDU_RX_ACTION_ENABLE);
+  reg_rx_ba_start_pulse = !!(reg_val & OW_XPU_AMPDU_RX_ACTION_CLEAR_PULSE);
+  reg_rx_ba_tid = (reg_val >> OW_XPU_AMPDU_RX_ACTION_TID_SHIFT) & OW_XPU_AMPDU_RX_ACTION_TID_MASK;
+  reg_rx_ba_ssn = (reg_val >> OW_XPU_AMPDU_RX_ACTION_SSN_SHIFT) & OW_XPU_AMPDU_RX_ACTION_SSN_MASK;
+  spin_lock_irqsave(&priv->lock, flags);
+  rx_ba_active = priv->rx_ba_active;
+  rx_ba_tid = priv->rx_ba_tid;
+  rx_ba_ssn = priv->rx_ba_ssn;
+  rx_ba_buf_size = priv->rx_ba_buf_size;
+  rx_ba_timeout_tu = priv->rx_ba_timeout_tu;
+  ether_addr_copy(rx_ba_peer_addr, priv->rx_ba_peer_addr);
+  spin_unlock_irqrestore(&priv->lock, flags);
+  ret_size = sysfs_emit(buf,
+    "AMPDU_ACTION raw: %08x\n"
+    "AMPDU_ACTION active/tid/ssn/start_pulse: %u %u %u %u\n"
+    "RX BA peer raw low/high: %08x %08x\n"
+    "CACHE RX BA active/tid/ssn: %u %u %u\n"
+    "CACHE RX BA buf_size/timeout_tu: %u %u\n"
+    "CACHE RX BA peer: %pM\n"
+    "RX BA starts/stops/rejects: %u %u %u\n"
+    "TX AMPDU starts/stops/operational: %u %u %u\n",
+    reg_val,
+    reg_rx_ba_active,
+    reg_rx_ba_tid,
+    reg_rx_ba_ssn,
+    reg_rx_ba_start_pulse,
+    peer_low,
+    peer_high,
+    rx_ba_active,
+    rx_ba_tid,
+    rx_ba_ssn,
+    rx_ba_buf_size,
+    rx_ba_timeout_tu,
+    rx_ba_peer_addr,
+    READ_ONCE(priv->stat.rx_ampdu_start_count),
+    READ_ONCE(priv->stat.rx_ampdu_stop_count),
+    READ_ONCE(priv->stat.rx_ampdu_reject_count),
+    READ_ONCE(priv->stat.tx_ampdu_tx_start_count),
+    READ_ONCE(priv->stat.tx_ampdu_tx_stop_count),
+    READ_ONCE(priv->stat.tx_ampdu_tx_operational_count));
+
+  ret_size += sysfs_emit_at(buf, ret_size,
+    "TX AMPDU BA nonzero/zero/no_ba/unexpected_ack_legacy: %u %u %u %u\n",
+    READ_ONCE(priv->stat.tx_ampdu_ba_nonzero_bitmap_count),
+    READ_ONCE(priv->stat.tx_ampdu_ba_zero_bitmap_count),
+    READ_ONCE(priv->stat.tx_ampdu_no_ba_count),
+    READ_ONCE(priv->stat.tx_ampdu_unexpected_ack_count));
+  ret_size += sysfs_emit_at(buf, ret_size,
+    "NOTE: start_pulse is edge-triggered and normally reads 0 outside RX BA start/reset writes.\n");
+
+  return ret_size;
+}
