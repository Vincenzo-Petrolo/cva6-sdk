+#ifndef __HW_DEF_H_FILE__
+#define __HW_DEF_H_FILE__
+
+#include <linux/string.h>
+
+/*
+ * hw_def.h ownership notes:
+ * - This header is the maintained source of truth for OpenWiFi software-side
+ *   register addresses, bitfield layouts, and driver-facing register APIs.
+ * - Keep software-visible bit positions, masks, and shared pack/unpack helpers
+ *   here when they are used across multiple C files.
+ * - Do not treat raw RTL slv_reg comments as the canonical software contract.
+ *   The matching behavior contract belongs in the relevant driver file
+ *   (for example driver/xpu/xpu.c for XPU semantics).
+ */
+
+enum openwifi_hardware_type {
+  ZYNQ_AD9361 = 0,
+  ZYNQMP_AD9361 = 1,
+  RFSOC4X2 = 2,
+  UNKNOWN_HARDWARE,
+};
+
+enum openwifi_fpga_type {
+  SMALL_FPGA = 0,
+  LARGE_FPGA = 1,
+};
+
+#define OW_PLATFORM_TOKEN_ZYNQMP         "ZynqMP"
+#define OW_PLATFORM_TOKEN_ZCU102         "ZCU102"
+#define OW_PLATFORM_TOKEN_ZCU104         "ZCU104"
+#define OW_PLATFORM_TOKEN_ZCU106         "ZCU106"
+#define OW_PLATFORM_TOKEN_Z7035          "Z7035"
+#define OW_PLATFORM_TOKEN_ZC706          "ZC706"
+#define OW_PLATFORM_TOKEN_CHESHIRE       "eth,cheshire"
+#define OW_PLATFORM_TOKEN_CHESHIRE_DEV   "eth,cheshire-dev"
+
+/**
+ * @brief Case-insensitive substring search (kernel has no strcasestr).
+ */
+static inline const char *ow_strcasestr(const char *haystack, const char *needle)
+{
+  size_t needle_len = strlen(needle);
+
+  if (needle_len == 0) {
+    return haystack;
+  }
+  for (; *haystack; haystack++) {
+    if (strncasecmp(haystack, needle, needle_len) == 0) {
+      return haystack;
+    }
+  }
+  return NULL;
+}
+
+static inline bool openwifi_platform_id_has_token(const char *platform_id, const char *token)
+{
+  if (!platform_id || !token) {
+    return false;
+  }
+  return ow_strcasestr(platform_id, token) != NULL;
+}
+
+static inline bool openwifi_platform_has_token(const char *fpga_model, const char *root_compatible,
+  const char *token)
+{
+  return openwifi_platform_id_has_token(fpga_model, token)
+    || openwifi_platform_id_has_token(root_compatible, token);
+}
+
+static inline bool openwifi_platform_is_cheshire(const char *fpga_model, const char *root_compatible)
+{
+  return openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_CHESHIRE)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_CHESHIRE_DEV);
+}
+
+static inline bool openwifi_platform_is_zynqmp_class(const char *fpga_model, const char *root_compatible)
+{
+  return openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZYNQMP)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZCU102)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZCU104)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZCU106);
+}
+
+static inline bool openwifi_platform_is_large_fpga(const char *fpga_model, const char *root_compatible)
+{
+  return openwifi_platform_is_cheshire(fpga_model, root_compatible)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZCU102)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZCU104)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZCU106)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_Z7035)
+    || openwifi_platform_has_token(fpga_model, root_compatible, OW_PLATFORM_TOKEN_ZC706);
+}
