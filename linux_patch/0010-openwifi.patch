+  u16 target_high16;
+  u32 target_low32;
+  int ret;
+
+  ret = openwifi_parse_rx_target_sender_mac(buf, &target_high16, &target_low32);
+  if (ret) {
+    return ret;
+  }
+  priv->stat.rx_target_sender_mac_addr_high16 = target_high16;
+  priv->stat.rx_target_sender_mac_addr = target_low32;
+  return len;
+}
