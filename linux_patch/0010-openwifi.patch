+//=============================================================================
+// Design Constraints
+//=============================================================================
+/*
+ * DMA backend:
+ * - ADI axi_dmac and Xilinx axi_dma are both supported.
+ * - Backend is detected at probe from DT compatible string.
+ * - RX/TX backend mismatch is rejected.
+ *
+ * Platform:
+ * - Shared IRQ/softirq/workqueue fields must use READ_ONCE/WRITE_ONCE or lock.
+ * - Never hold a spinlock across sleeping dmaengine synchronization APIs.
+ */
+
+#ifdef DEBUG_OPENWIFI
+static u32 ow_rx_irq_count;
+static u32 ow_rx_pkt_count;
+#define RX_DEBUG_EARLY_PKT_LIMIT 5  /* log first N RX packets for debugging */
+#endif
+
