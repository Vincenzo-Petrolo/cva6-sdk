+//=============================================================================
+// RX DMA Watchdog
+//=============================================================================
+
+/**
+ * @brief Periodic watchdog that detects and recovers stalled RX DMA.
+ *
+ * @param work Delayed work item embedded in openwifi_priv.
+ */
+static void openwifi_rx_dma_watchdog_work(struct work_struct *work)
+{
+  struct openwifi_priv *priv =
+    container_of(work, struct openwifi_priv, rx_dma_watchdog_work.work);
+  u32 xfer_done, active_id, curr_dest, state_history, start_transfer;
+  bool phy_active, phy_idle, dma_progress, dma_stalled, dma_never_started;
+  bool dma_engine_running, dma_low_after_run;
+  int term_ret;
+  unsigned long flags;
+
+  if (!rx_watchdog_enable || !priv->rx_dma_watchdog_enabled || !priv->rx_dma_regs || !priv->rx_chan ||
+      !priv->hw || priv->dma_backend != OPENWIFI_DMA_ADI ||
+      !openofdm_rx_api || !openofdm_rx_api->OPENOFDM_RX_REG_STATE_HISTORY_read) {
+    return;
+  }
+  if (!rx_intf_api || !rx_intf_api->RX_INTF_REG_M_AXIS_RST_write) {
+    printk_ratelimited(KERN_WARNING "%s rx_dma_watchdog: disabled (RX_INTF_REG_M_AXIS_RST_write unavailable)\n",
+      sdr_compatible_str);
+    priv->rx_dma_watchdog_enabled = false;
+    return;
+  }
+
+  xfer_done = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_TRANSFER_DONE);
+  active_id = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_ACTIVE_TRANSFER_ID);
+  curr_dest = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_CURRENT_DEST_ADDR);
+  start_transfer = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_START_TRANSFER);
+  state_history = openofdm_rx_api->OPENOFDM_RX_REG_STATE_HISTORY_read();
+  /* TODO(openwifi-rx-watchdog-debug-cap): add explicit capability handling
+   * for builds where ADI DMAC debug registers are disabled or non-meaningful.
+   * Required closure:
+   * 1) detect/declare debug-reg availability at runtime/probe;
+   * 2) gate CURRENT_DEST_ADDR contribution when unavailable;
+   * 3) keep watchdog progress logic deterministic across ADI variants.
+   */
+  /* TRANSFER_DONE is a transfer-id bitmap, not a monotonic counter.
+   * Combine CURRENT_DEST_ADDR, ACTIVE_ID, and DONE changes as progress.
+   */
+  /* Use hardware register signals only for wedge detection.
+   * Software counters (rx_irq49_count, rx_dma_cb_count) are excluded:
+   * on cyclic DMA, callbacks fire on period completions even without
+   * real packet data, and IRQ49 fires from FPGA side regardless of
+   * DMA state -- both would mask a true DMA wedge. */
+  dma_progress = (curr_dest != priv->rx_dma_wd_last_curr_dest) ||
+                 (active_id != priv->rx_dma_wd_last_active_id) ||
+                 (xfer_done != priv->rx_dma_wd_last_xfer_done);
+  phy_idle = ow_rx_phy_is_idle(state_history);
+  /* Treat only non-idle PHY state as activity. */
+  phy_active = !phy_idle;
+  dma_engine_running = (start_transfer != 0);
+  dma_low_after_run = (!dma_engine_running) &&
+                      (priv->rx_dma_wd_last_start_transfer != 0) &&
+                      phy_active;
+  /* If DMA never moved and PHY is idle, this is an idle/no-traffic condition,
+   * not a stall that should trigger recovery.
+   */
+  dma_never_started = (xfer_done == 0) &&
+                      (curr_dest == lower_32_bits(priv->rx_cyclic_buf_dma_mapping_addr));
+  /* Treat two cases as stalls:
+   * 1) engine running, PHY active, no progress
+   * 2) START dropped low after previously running while PHY remains active
+   */
+  dma_stalled = (!dma_progress) &&
+                ((phy_active && dma_engine_running) || dma_low_after_run);
+  if (dma_never_started && phy_idle) {
+    dma_stalled = false;
+  }
+  if (priv->rx_dma_wd_rearm_grace_ticks > 0) {
+    priv->rx_dma_wd_rearm_grace_ticks--;
+    dma_stalled = false;
+  }
+
+  if (dma_stalled) {
+    priv->rx_dma_wd_stall_count++;
+  } else {
+    priv->rx_dma_wd_stall_count = 0;
+  }
+
+  if (priv->rx_dma_wd_stall_count >= OW_RX_DMA_WD_STALL_LIMIT) {
+    OW_U32_INC(priv->rx_dma_wd_restart_count);
+    printk_ratelimited(KERN_WARNING "%s rx_dma_watchdog: stalled start=0x%08x xfer_done=0x%08x active_id=0x%08x last_active_id=0x%08x curr_dest=0x%08x last_dest=0x%08x state=0x%08x -> restart RX DMA (#%u)\n",
+      sdr_compatible_str, start_transfer, xfer_done, active_id,
+      priv->rx_dma_wd_last_active_id, curr_dest, priv->rx_dma_wd_last_curr_dest,
+      state_history, READ_ONCE(priv->rx_dma_wd_restart_count));
+    openwifi_rx_dma_log_regs(priv, "rx_dma_watchdog regs_before_restart");
+
+    /* Restart sequence: hold FPGA in reset until DMA is fully re-armed.
+     * Order matters: deassert M_AXIS_RST only after rx_dma_setup so the
+     * FPGA cannot stream into an unready DMA engine.
+     */
+    rx_intf_api->RX_INTF_REG_M_AXIS_RST_write(1);
+    udelay(OW_RX_DMA_RESET_PULSE_US);
+
+    term_ret = dmaengine_terminate_sync(priv->rx_chan);
+    if (term_ret) {
+      printk(KERN_WARNING "%s rx_dma_watchdog: dmaengine_terminate_sync failed (%d)\n",
+        sdr_compatible_str, term_ret);
+      /* Termination failed, so do not clear/reinit rings on a potentially
+       * still-active channel. Release reset and retry in the next watchdog cycle. */
+      rx_intf_api->RX_INTF_REG_M_AXIS_RST_write(0);
+      priv->rx_dma_wd_stall_count = 0;
+      goto out_watchdog_update;
+    }
+
+    /* Serialize flag clear with IRQ handler which reads the same flags
+     * under spin_lock(&priv->lock).  Do NOT hold lock across
+     * dmaengine_synchronize (it can sleep) or rx_dma_setup (it may
+     * allocate).
+     */
+    spin_lock_irqsave(&priv->lock, flags);
+    openwifi_clear_rx_ring_flags(priv);
+    spin_unlock_irqrestore(&priv->lock, flags);
+
+    if (rx_dma_setup(priv->hw)) {
+      printk(KERN_ERR "%s rx_dma_watchdog: rx_dma_setup failed -- RX path disabled until next retry\n",
+        sdr_compatible_str);
+      /* Leave M_AXIS_RST asserted: no DMA to receive data.
+       * Retry is automatic once RF traffic resumes (PHY goes active,
+       * xfer_done stays stuck → stall detected → restart attempted).
+       * With no RF traffic phy_active=false so no retry, but nothing
+       * to receive either.  Manual ifdown/ifup recovers in all cases. */
+    } else {
+      /* DMA re-armed -- release FPGA to stream again. */
+      rx_intf_api->RX_INTF_REG_M_AXIS_RST_write(0);
+      xfer_done = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_TRANSFER_DONE);
+      active_id = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_ACTIVE_TRANSFER_ID);
+      curr_dest = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_CURRENT_DEST_ADDR);
+      openwifi_rx_dma_log_regs(priv, "rx_dma_watchdog regs_after_rearm");
+      priv->rx_dma_wd_rearm_grace_ticks = OW_RX_DMA_WD_REARM_GRACE_TICKS;
+    }
+
+    priv->rx_dma_wd_stall_count = 0;
+  }
+
+out_watchdog_update:
+  priv->rx_dma_wd_last_xfer_done = xfer_done;
+  priv->rx_dma_wd_last_active_id = active_id;
+  priv->rx_dma_wd_last_curr_dest = curr_dest;
+  priv->rx_dma_wd_last_start_transfer = start_transfer;
+  priv->rx_dma_wd_last_state_history = state_history;
+  if (priv->rx_dma_watchdog_enabled) {
+    schedule_delayed_work(&priv->rx_dma_watchdog_work,
+      msecs_to_jiffies(OW_RX_DMA_WD_PERIOD_MS));
+  }
+}
+
+/**
+ * @brief Arm and initialize the RX DMA watchdog state.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_rx_dma_watchdog_arm(struct openwifi_priv *priv)
+{
+  if (!rx_watchdog_enable) {
+    return;
+  }
+  if (!priv->rx_dma_regs) {
+    return;
+  }
+  if (!openofdm_rx_api || !openofdm_rx_api->OPENOFDM_RX_REG_STATE_HISTORY_read) {
+    printk(KERN_WARNING "%s rx_dma_watchdog: disabled (state_history API unavailable)\n",
+      sdr_compatible_str);
+    return;
+  }
+  if (!rx_intf_api || !rx_intf_api->RX_INTF_REG_M_AXIS_RST_write) {
+    printk(KERN_WARNING "%s rx_dma_watchdog: disabled (RX_INTF_REG_M_AXIS_RST_write unavailable)\n",
+      sdr_compatible_str);
+    return;
+  }
+
+  priv->rx_dma_watchdog_enabled = true;
+  priv->rx_dma_wd_stall_count = 0;
+  priv->rx_dma_wd_rearm_grace_ticks = OW_RX_DMA_WD_REARM_GRACE_TICKS;
+  priv->rx_dma_wd_last_xfer_done = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_TRANSFER_DONE);
+  priv->rx_dma_wd_last_active_id = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_ACTIVE_TRANSFER_ID);
+  priv->rx_dma_wd_last_curr_dest = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_CURRENT_DEST_ADDR);
+  priv->rx_dma_wd_last_start_transfer = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_START_TRANSFER);
+  priv->rx_dma_wd_last_state_history = openofdm_rx_api->OPENOFDM_RX_REG_STATE_HISTORY_read();
+  schedule_delayed_work(&priv->rx_dma_watchdog_work,
+    msecs_to_jiffies(OW_RX_DMA_WD_PERIOD_MS));
+}
+
+/**
+ * @brief Disarm RX DMA watchdog and cancel delayed work.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_rx_dma_watchdog_disarm(struct openwifi_priv *priv)
+{
+  priv->rx_dma_watchdog_enabled = false;
+  priv->rx_dma_wd_rearm_grace_ticks = 0;
+  cancel_delayed_work_sync(&priv->rx_dma_watchdog_work);
+}
+
+//=============================================================================
+// RX DMA Callback and RX IRQ Handler
+//=============================================================================
+
+/**
+ * @brief RX DMA period callback fallback when IRQ49 progress stalls.
+ *
+ * @param data ieee80211_hw pointer passed as callback_param.
+ */
+static void rx_dma_callback(void *data)
+{
+  struct ieee80211_hw *dev = data;
+  struct openwifi_priv *priv = dev->priv;
+  u32 irq49_snapshot;
+  bool need_fallback;
+  bool force_full_handler = false;
+  unsigned long fallback_period_jiffies;
+  int n_cb = clamp(rx_callback_fallback_n_cb, OW_RX_CB_FALLBACK_N_CB_MIN, OW_RX_CB_FALLBACK_N_CB_MAX);
+  int n_ms = clamp(rx_callback_fallback_n_ms, OW_RX_CB_FALLBACK_N_MS_MIN, OW_RX_CB_FALLBACK_N_MS_MAX);
+
+  OW_U32_INC(priv->rx_dma_cb_count);
+#ifdef DEBUG_OPENWIFI
+  if ((priv->rx_dma_cb_count & OW_RX_CB_LOG_EVERY_MASK) == 1U) {
+    openwifi_rx_dma_log_regs(priv, "rx_dma_callback");
+  }
+#endif
+  fallback_period_jiffies = msecs_to_jiffies(n_ms);
+
+  /* Fallback trigger rule:
+   * 1) If IRQ49 progressed since the last callback:
+   *    skip full handler, except force one periodic full run every n_ms.
+   * 2) If IRQ49 did not progress:
+   *    trigger fallback when (stall_count >= n_cb) OR (elapsed >= n_ms). */
+  irq49_snapshot = READ_ONCE(priv->rx_irq49_count);
+  if (irq49_snapshot != priv->rx_dma_cb_last_irq49) {
+    priv->rx_dma_cb_last_irq49 = irq49_snapshot;
+    priv->rx_dma_cb_stall_count = 0;
+    force_full_handler = time_after(jiffies, priv->rx_dma_cb_last_full_jiffies + fallback_period_jiffies);
+    if (!force_full_handler) {
+      return;
+    }
+  }
+
+  if (!force_full_handler) {
+    if (priv->rx_dma_cb_stall_count == 0) {
+      priv->rx_dma_cb_stall_start_jiffies = jiffies;
+    }
+    OW_U32_INC(priv->rx_dma_cb_stall_count);
+
+    need_fallback = (priv->rx_dma_cb_stall_count >= (u32)n_cb)
+                    || time_after(jiffies, priv->rx_dma_cb_stall_start_jiffies + fallback_period_jiffies);
+    if (!need_fallback) {
+      return;
+    }
+  }
+
+  priv->rx_dma_cb_stall_count = 0;
+  priv->rx_dma_cb_last_full_jiffies = jiffies;
+  OW_U32_INC(priv->rx_dma_cb_full_count);
+  /* Fallback executes the common 3-phase RX handler directly.
+   *
+   * local_irq_save is no longer needed here.  The 3-phase handler holds
+   * priv->lock only in Phase RX-A (claim, ~2 us) and Phase RX-C (release, ~1 us).
+   * Phase RX-B (skb alloc + mac80211 handoff) runs with no lock held and local
+   * IRQs enabled — TX DMA completion IRQs can fire during Phase RX-B, breaking
+   * the death spiral that previously caused throughput collapse on single-core.
+   *
+   * Re-entrancy safety: Phase RX-A's per-slot rx_slot_claimed[] flag prevents
+   * double-claiming the same slot from a concurrent IRQ or callback. */
+  openwifi_rx_interrupt(0, data);
+}
+
+/**
+ * @brief Prepare and start cyclic RX DMA.
+ *
+ * @param dev mac80211 hardware handle.
+ * @return 0 on success, -1 on setup/submit failure.
+ */
+static int rx_dma_setup(struct ieee80211_hw *dev)
+{
+  struct openwifi_priv *priv = dev->priv;
+  struct dma_device *rx_dev = priv->rx_chan->device;
+
+  priv->rxd = rx_dev->device_prep_dma_cyclic(priv->rx_chan,
+    priv->rx_cyclic_buf_dma_mapping_addr,
+    RX_BD_BUF_SIZE * NUM_RX_BD,
+    RX_BD_BUF_SIZE,
+    DMA_DEV_TO_MEM,
+    DMA_CTRL_ACK | DMA_PREP_INTERRUPT);
+  if (!(priv->rxd)) {
+    printk("%s rx_dma_setup: WARNING rx_dev->device_prep_dma_cyclic %p\n",
+      sdr_compatible_str, (void *)(priv->rxd));
+    return -1;
+  }
+  priv->rxd->callback = rx_dma_callback;
+  priv->rxd->callback_param = dev;
+
+  priv->rx_cookie = priv->rxd->tx_submit(priv->rxd);
+
+  if (dma_submit_error(priv->rx_cookie)) {
+    printk("%s rx_dma_setup: WARNING dma_submit_error(rx_cookie) %d\n",
+      sdr_compatible_str, (u32)(priv->rx_cookie));
+    return -1;
+  }
+
+  dma_async_issue_pending(priv->rx_chan);
+#ifdef DEBUG_OPENWIFI
+  printk(KERN_INFO "%s rx_dma_setup: addr=0x%llx total=%u period=%u periods=%d cookie=%d\n",
+    sdr_compatible_str,
+    (unsigned long long)priv->rx_cyclic_buf_dma_mapping_addr,
+    RX_BD_BUF_SIZE * NUM_RX_BD, RX_BD_BUF_SIZE, NUM_RX_BD,
+    priv->rx_cookie);
+#endif
+  openwifi_rx_dma_log_regs(priv, "rx_dma_setup after_issue_pending");
+  return 0;
+}
+
+/**
+ * @brief Convert half-dB RSSI to dBm with board-specific correction.
+ *
+ * @param rssi_half_db RSSI value in 0.5 dB units.
+ * @param rssi_correction Calibration correction in dB.
+ * @return RSSI in dBm, clamped to -128 dBm minimum.
+ */
+static inline int rssi_half_db_to_rssi_dbm(int rssi_half_db, int rssi_correction)
+{
+  int rssi_db = (rssi_half_db >> 1);
+  int rssi_dbm = rssi_db - rssi_correction;
+
+  if (rssi_dbm < OW_RX_RSSI_DBM_MIN) {
+    rssi_dbm = OW_RX_RSSI_DBM_MIN;
+  }
+  return rssi_dbm;
+}
+
+/* DMA-to-CPU coherency analysis for the RX cyclic buffer.
+ *
+ * DMA-to-CPU coherency differs across the four build variants. The HW
+ * interconnect path determines whether DMA writes are visible to CPU
+ * caches, and the SW mapping determines whether CPU reads bypass cache.
+ *
+ * Variant 1-3: ARM64/ZynqMP (BD + ADI DMA, BD + Xilinx DMA, RTL + ADI DMA)
+ *   HW: DMA masters write via PS HP ports (non-coherent, bypass CCI-400):
+ *       RX DMA -> axi_interconnect_2 (BD) or PULP axi_mux (RTL) -> HP0
+ *       TX DMA -> axi_interconnect_0 (BD) or PULP axi_mux (RTL) -> HP3
+ *       (see openwifi-hw: flows/bd/05_connections.tcl lines 75-76,
+ *        flows/rtl/common/setup_vivado_project_common.tcl lines 998-1001,
+ *        soc_top_zynq.sv lines 740-810)
+ *   SW: dma_alloc_coherent() maps buffer non-cacheable via pgprot_dmacoherent
+ *       (= MT_NORMAL_NC on ARM64) because the DMA device is non-coherent
+ *       (dma-coherent is disabled in DTS, CacheCoherentDest=0 in RTL).
+ *       CPU reads go to DDR, never L1/L2. No cache invalidation needed.
+ *       dma_rmb() is the sole ordering mechanism — prevents the CPU from
+ *       speculatively reordering reads past the DMA completion.
+ *
+ * Variant 4: RISC-V/CVA6 (RTL Theshire + ADI DMA)
+ *   HW: DMA masters are wire-merged in theshire_wrapper.sv into Cheshire
+ *       ext_mst[0], then route through the Cheshire xbar -> LLC ->
+ *       dram_wrapper_xilinx -> PS HPC0. Note: HPC0 goes through CCI-400
+ *       which snoops the ARM A53 cluster, but CCI-400 has no visibility
+ *       into CVA6's L1 D-cache. CVA6 CPU shares the same LLC -> HPC0
+ *       backend path for DDR access.
+ *       (see openwifi-hw: flows/rtl/theshire/archived/.../ps_ddr_bridge.tcl,
+ *        docs/specs/spec_dma_subsystem.md lines 62-66,
+ *        rtl/theshire/theshire_wrapper.sv lines 560-673)
+ *   SW: dma_alloc_coherent() on RISC-V in kernels before 6.0 does NOT
+ *       set non-cacheable mapping (ARCH_HAS_DMA_SET_UNCACHED not selected
+ *       by arch/riscv). Buffer is CACHED in CVA6's write-through L1.
+ *       DMA writes update the LLC, but CVA6's L1 D-cache is not expected
+ *       to be snooped/invalidated by the LLC on ext_mst writes (no L1
+ *       coherency protocol between Cheshire LLC and CVA6 wt_dcache).
+ *       CPU reads hit stale L1 entries. FENCE.T invalidates entire
+ *       L1 D-cache (32KB). dma_rmb() then orders reads after invalidation.
+ *
+ * Summary: ARM variants need only dma_rmb() (SW non-cacheable mapping
+ * handles coherency). CVA6 with PMA NC region needs only dma_rmb()
+ * (DMA buffers bypass L1 via PMA; NC reads go through LLC, which is the
+ * coherency point for both DMA writes and CPU NC reads — see
+ * cheshire_pkg.sv:688-690). Without PMA NC, CVA6 would need FENCE.T +
+ * dma_rmb() (L1 is cached, LLC does not snoop L1 on DMA writes).
+ *
+ * Coherency is non-coherent at THREE levels on ARM (all must agree):
+ *   1. HW port: HP0/HP3 bypass CCI-400 (no cache snoop)
+ *   2. DTS: dma-coherent commented out (system.dts:2154) -> kernel's
+ *      dev_is_dma_coherent() returns false -> pgprot_dmacoherent mapping
+ *   3. RTL: CacheCoherentDest=0 in dma_subsystem_adi.sv:595 -> DMA
+ *      engine generates non-cacheable ARCACHE on AXI bus
+ * Changing any one without the others creates a coherency mismatch.
+ *
+ * Why FENCE.T is the only current option on CVA6:
+ *   - FENCE.T is a CVA6 custom security instruction (Custom0, 0x0B) that
+ *     flushes D-cache + I-cache + drains AXI + resets uarch (branch
+ *     predictor etc). It is overkill for DMA cache invalidation but is
+ *     the ONLY instruction on this CVA6 that can invalidate L1 D-cache.
+ *   - DcacheFlushOnFence=1 IS a viable fallback: it triggers a FULL L1
+ *     D-cache invalidation on standard FENCE (clears valid bits on ALL
+ *     lines including clean ones, not just dirty writeback). Tradeoff:
+ *     every FENCE in the kernel (spinlocks, barriers) also flushes 32KB
+ *     L1. PMA NC region is preferred (zero runtime overhead).
+ *     (cheshire_pkg.sv:786, wt_dcache_missunit.sv)
+ *   - Zicbom cbo.inval: not implemented in CVA6 decoder (decoder.sv:
+ *     452-466 decodes funct3=010 as illegal). HPDCache CMO ports exist
+ *     as stubs (cva6.sv:1513-1536 FIXME). Would need decoder + pipeline
+ *     + cache wiring in RTL, plus kernel 6.0+ (Zicbom merged upstream).
+ *   - Kernel DMA API is broken on RISC-V 5.15: dev_is_dma_coherent()
+ *     hardcoded true (dma-map-ops.h:249-261, none of ARCH_HAS_SYNC_DMA
+ *     symbols selected). dma_alloc_coherent returns normal cached ptr.
+ *
+ * IMPLEMENTED: PMA NC region at top of DDR (cheshire_pkg.sv DmaNcSize).
+ *   CVA6 PMA is a cacheable-address whitelist -- unlisted addresses bypass L1.
+ *   Ref: https://docs.openhwgroup.org/projects/cva6-user-manual/01_cva6_user/PMA.html
+ *   CachedRegionLength shrunk by 4 MiB, NrCachedRegionRules stays at 3.
+ *   DTS reserved-memory node binds DMA devices to NC pool via
+ *   of_reserved_mem_device_init() in dma-axi-dmac.c.
+ *   See docs/todo/todo_dma_cache_coherency.md for full investigation.
+ *   Long-term: Zicbom in CVA6 + kernel 6.0+ for standard RISC-V
+ *   non-coherent DMA (arch/riscv/mm/dma-noncoherent.c with cbo.inval).
+ *   See also: theshire docs/specs/spec_dma_subsystem.md.
+ */
+
+/**
+ * @brief 3-phase RX interrupt handler — drains RX slots and pushes frames to mac80211.
+ *
+ * Uses a 3-phase design to minimize lock hold time on single-core RISC-V (CVA6):
+ *
+ * Phase RX-A (short, locked):
+ *   Scan ring for ready slots.  Claim up to OW_RX_PHASE_A_BUDGET into a
+ *   stack-local work list.  Snapshot ampdu_reference per slot.  Set
+ *   rx_slot_claimed[] to prevent double-consume by concurrent IRQ/callback.
+ *
+ * Phase RX-B (unlocked, IRQs enabled):
+ *   One batch dma_rmb() before the loop, then for each claimed slot: parse
+ *   metadata, validate, dev_alloc_skb(), skb_put_data() (memcpy from NC DMA
+ *   buffer), fill rx_status directly in IEEE80211_SKB_RXCB(skb), call
+ *   ieee80211_rx_irqsafe(), update telemetry stats.
+ *   TX DMA completion IRQs can fire during this phase — breaking the death
+ *   spiral that previously collapsed throughput on single-core.
+ *
+ * Phase RX-C (short, locked):
+ *   One batch dma_wmb() before the loop, then clear DMA slot flags, clear rx_slot_claimed[],
+ *   advance ring index (sequential mode), increment ampdu_reference for
+ *   ht_aggr_last slots in order.
+ *
+ * Invariants:
+ *   - Each slot is claimed at most once (rx_slot_claimed[] under priv->lock).
+ *   - DMA flag is not cleared until after Phase RX-B payload copy completes.
+ *   - Watchdog ring-clear skips claimed slots.
+ *   - ampdu_reference is seeded in Phase RX-A, tracked locally in Phase RX-B, written back in Phase RX-C.
+ *
+ * @param irq Linux IRQ number (0 when invoked from DMA callback fallback).
+ * @param dev_id ieee80211_hw pointer.
+ * @return IRQ_HANDLED always.
+ */
+static irqreturn_t openwifi_rx_interrupt(int irq, void *dev_id)
+{
+  struct ieee80211_hw *dev = dev_id;
+  struct openwifi_priv *priv = dev->priv;
+  struct ow_rx_work_entry work[OW_RX_PHASE_A_BUDGET];
+  unsigned long flags;
+  u32 n_claimed = 0;
+  u32 local_ampdu_ref = 0;
+  u32 i;
+  /* Phase RX-B per-slot locals. */
+  struct ieee80211_rx_status *rxcb;
+  struct sk_buff *skb;
+  struct ieee80211_hdr *hdr;
+  u32 addr1_low32, addr2_low32 = 0, addr3_low32 = 0, len, rate_idx, tsft_low, tsft_high;
+  bool ht_flag, short_gi, ht_aggr, ht_aggr_last;
+  u8 *pdata_tmp;
+  u8 fcs_ok;
+  s8 signal, phase_offset;
+  u16 agc_status_and_pkt_exist_flag;
+  u16 rssi_half_db;
+  u16 addr1_high16;
+  u16 addr2_high16 = 0, addr3_high16 = 0;
+  u16 seq_no = 0;
+  bool content_ok = false, len_overflow, is_unicast;
+  int rx_slot_idx_for_log;
+
+  /* Always-on counter distinguishing real IRQ (irq != 0) from
+   * rx_dma_callback fallback path (irq == 0).  Placed BEFORE the re-entrancy
+   * guard so that a nested hardirq still increments the counter even when the
+   * guard causes an early return — otherwise the callback fallback heuristic
+   * sees no IRQ progress and enters fallback unnecessarily. */
+  if (irq != 0) {
+    OW_U32_INC(priv->rx_irq49_count);
+  }
+
+  /* Re-entrancy guard: prevents a nested hardirq from entering Phase RX-B
+   * while another context is already there — which would deliver newer slots
+   * to mac80211 before older ones (out-of-order delivery that hurts TCP).
+   * Return immediately; the outer do-while loop drains remaining slots.
+   *
+   * NOTE: FPGA rx_pkt_intr is a pulse (not level-held-while-pending), so
+   * after the hardirq returns + EOI, the PLIC sees the line deasserted and
+   * does NOT re-fire.  No interrupt storm.  A NEW packet arrival generates
+   * a new pulse which the PLIC latches normally.
+   * RTL ref: openwifi-hw rx_intf — rx_pkt_intr is a 1-cycle strobe.
+   *
+   * test_and_set_bit is atomic on both SMP and UP — safe for Zynq multi-core
+   * and CVA6 single-core nested IRQ.
+   *
+   * NOTE(openwifi-rx-missed-wakeup): If a new packet arrives during Phase RX-B
+   * after an under-budget claim, the nested IRQ returns early here and the
+   * outer do-while exits (n_claimed < budget).  That packet waits for the next
+   * IRQ pulse or DMA callback period (~1-4 ms).  This is NOT a regression —
+   * the old monolithic handler under local_irq_save also couldn't see packets
+   * arriving during processing.  NAPI would fix this by polling after the
+   * handler returns — see TODO(openwifi-rx-napi). */
+  if (test_and_set_bit(0, &priv->rx_processing)) {
+    return IRQ_HANDLED;
+  }
+
+#ifdef DEBUG_OPENWIFI
+  ow_rx_irq_count++;
+  if ((ow_rx_irq_count & OW_RX_DEBUG_IRQ_LOG_MASK) == 1U) {
+    printk(KERN_INFO "%s rx_irq#%u pkts=%u slot0_flag=0x%04x\n",
+      sdr_compatible_str, ow_rx_irq_count, ow_rx_pkt_count,
+      ow_rx_slot_flag_get(priv->rx_cyclic_buf));
+  }
+  openwifi_rx_dump_early_slots(priv);
+#endif
+
+  /* Loop back to Phase RX-A if the full budget was consumed — more slots may be
+   * waiting.  This avoids waiting for the next IRQ/callback under burst RX. */
+  do {
+  n_claimed = 0;
+
+  /* =================================================================
+   * Phase RX-A: locked, short — claim ready slots into work list.
+   * ================================================================= */
+#ifdef ENABLE_RX_SCAN_ALL_SLOTS
+  spin_lock_irqsave(&priv->lock, flags);
+  /* Rotating scan: start where the last invocation left off to avoid
+   * starving high-numbered slots under sustained load. */
+  {
+    int scan_count;
+    int raw_idx;
+
+    for (scan_count = 0; scan_count < NUM_RX_BD && n_claimed < OW_RX_PHASE_A_BUDGET; scan_count++) {
+      raw_idx = (priv->rx_scan_start_idx + scan_count) % NUM_RX_BD;
+      if (priv->rx_slot_claimed[raw_idx]) {
+        continue;
+      }
+      pdata_tmp = priv->rx_cyclic_buf + raw_idx * RX_BD_BUF_SIZE;
+      agc_status_and_pkt_exist_flag = ow_rx_slot_flag_get(pdata_tmp);
+      if (agc_status_and_pkt_exist_flag == OW_RX_PKT_EXIST_FLAG_CLEAR) {
+        continue;
+      }
+      priv->rx_slot_claimed[raw_idx] = 1U;
+      work[n_claimed].slot_idx       = (u8)raw_idx;
+      work[n_claimed].agc_flag       = agc_status_and_pkt_exist_flag;
+      work[n_claimed].ampdu_ref      = priv->ampdu_reference;
+      n_claimed++;
+    }
+    /* Advance start index past the last scanned position so the next
+     * invocation begins where this one stopped. */
+    priv->rx_scan_start_idx = (priv->rx_scan_start_idx + scan_count) % NUM_RX_BD;
+  }
+  spin_unlock_irqrestore(&priv->lock, flags);
+#else
+  spin_lock_irqsave(&priv->lock, flags);
+  {
+    u8 idx = priv->rx_target_buf_idx_old;
+
+    if (!priv->rx_slot_claimed[idx]) {
+      pdata_tmp = priv->rx_cyclic_buf + idx * RX_BD_BUF_SIZE;
+      agc_status_and_pkt_exist_flag = ow_rx_slot_flag_get(pdata_tmp);
+      if (agc_status_and_pkt_exist_flag != OW_RX_PKT_EXIST_FLAG_CLEAR) {
+        priv->rx_slot_claimed[idx] = 1U;
+        work[0].slot_idx       = idx;
+        work[0].agc_flag       = agc_status_and_pkt_exist_flag;
+        work[0].ampdu_ref      = priv->ampdu_reference;
+        n_claimed = 1U;
+      }
+    }
+  }
+  spin_unlock_irqrestore(&priv->lock, flags);
+#endif
+
+  if (n_claimed == 0U) {
+    break;
+  }
+
+  /* Seed running AMPDU reference from the first slot's snapshot.
+   * Phase RX-B increments this locally on ht_aggr_last boundaries so that
+   * subsequent slots in the same batch get correct per-aggregate references. */
+  local_ampdu_ref = work[0].ampdu_ref;
+
+  /* =================================================================
+   * Phase RX-B: unlocked — parse, validate, alloc skb, mac80211 handoff.
+   * IRQs are enabled; TX DMA completion can fire during this phase.
+   * ================================================================= */
+
+  /* Keep a single DMA read barrier between Phase RX-A's slot-ready observations
+   * and Phase RX-B's metadata/payload reads. This preserves the old per-slot
+   * ordering intent while avoiding repeated barriers inside the hot loop:
+   * CPU reads in Phase RX-B are not reordered before the ready-flag checks that
+   * claimed these slots in Phase RX-A. */
+  dma_rmb();
+
+  for (i = 0; i < n_claimed; i++) {
+  rx_slot_idx_for_log = (int)work[i].slot_idx;
+  pdata_tmp = priv->rx_cyclic_buf + work[i].slot_idx * RX_BD_BUF_SIZE;
+  agc_status_and_pkt_exist_flag = work[i].agc_flag;
+
+  /* Reset per-slot debug variables so short frames don't log stale values
+   * from a previous iteration (addr2/addr3/seq_no are conditionally set). */
+  addr2_high16 = 0; addr2_low32 = 0;
+  addr3_high16 = 0; addr3_low32 = 0;
+  seq_no = 0;
+
+  tsft_low = ow_rx_read_u32(pdata_tmp, OW_RX_META_OFF_TSFT_LOW_BYTES);
+  tsft_high = ow_rx_read_u32(pdata_tmp, OW_RX_META_OFF_TSFT_HIGH_BYTES);
+  rssi_half_db = ow_rx_read_u16(pdata_tmp, OW_RX_META_OFF_RSSI_HALF_DB_BYTES);
+  len = ow_rx_read_u16(pdata_tmp, OW_RX_META_OFF_LEN_BYTES);
+
+  len_overflow = (len > (RX_BD_BUF_SIZE - OW_RX_META_HEADER_BYTES));
+
+  rate_idx = ow_rx_read_u16(pdata_tmp, OW_RX_META_OFF_RATE_IDX_BYTES);
+  ht_flag = ((rate_idx & OW_RX_RATE_HT_FLAG) != 0U);
+  short_gi = ((rate_idx & OW_RX_RATE_SHORT_GI_FLAG) != 0U);
+  ht_aggr = (ht_flag && ((rate_idx & OW_RX_RATE_HT_AGGR_FLAG) != 0U));
+  ht_aggr_last = (ht_flag && ((rate_idx & OW_RX_RATE_HT_AGGR_LAST_FLAG) != 0U));
+  phase_offset = (rate_idx >> OW_RX_RATE_PHASE_SHIFT);
+  rate_idx = (rate_idx & OW_RX_RATE_IDX_MASK);
+
+  fcs_ok = 0U;
+
+  if ((len >= OW_RX_FRAME_MIN_LEN && (!len_overflow))
+      && (rate_idx >= OW_RX_RATE_IDX_MIN_VALID && rate_idx <= OW_RX_RATE_IDX_MAX_VALID)) {
+    content_ok = true;
+    fcs_ok = pdata_tmp[OW_RX_META_HEADER_BYTES + len - 1U];
+    fcs_ok = ((fcs_ok & OW_RX_FCS_VALID_MASK) != 0U);
+#ifdef DEBUG_OPENWIFI
+    ow_rx_pkt_count++;
+    if (ow_rx_pkt_count <= RX_DEBUG_EARLY_PKT_LIMIT) {
+      printk(KERN_INFO "%s rx_pkt#%u slot=%d hdr=%*ph\n",
+        sdr_compatible_str, ow_rx_pkt_count, rx_slot_idx_for_log, OW_RX_PKT_HDR_DUMP_BYTES, pdata_tmp);
+    }
+#endif
+  } else {
+    /* Skip header parse on invalid content -- prevents garbage pointer
+     * dereference when len/rate_idx are out of range. */
+    OW_U32_INC(priv->rx_invalid_header_count);
+    if (printk_timed_ratelimit(&priv->rx_invalid_warn_jiffies,
+        clamp(rx_invalid_warn_interval_ms, OW_WARN_INTERVAL_MS_MIN, OW_WARN_INTERVAL_MS_MAX))) {
+      printk(KERN_DEBUG "%s openwifi_rx: WARNING content! len%d overflow%d rate_idx%d (total=%u)\n",
+        sdr_compatible_str, len, len_overflow, rate_idx, priv->rx_invalid_header_count);
+    }
+    /* Phase RX-C will clear the slot flag and advance the ring index. */
+    continue;
+  }
+
+  signal = rssi_half_db_to_rssi_dbm(rssi_half_db, priv->rssi_correction);
+
+  hdr = (struct ieee80211_hdr *)(pdata_tmp + OW_RX_META_HEADER_BYTES);
+  ow_rx_get_mac_parts(hdr->addr1, &addr1_high16, &addr1_low32);
+  if (len >= OW_IEEE80211_ADDR2_MIN_LEN_BYTES) {
+    ow_rx_get_mac_parts(hdr->addr2, &addr2_high16, &addr2_low32);
+  }
+
+  if (priv->drv_rx_reg_val[DRV_RX_REG_IDX_PRINT_CFG] & DMESG_LOG_ANY) {
+    if (len >= OW_IEEE80211_ADDR3_MIN_LEN_BYTES) {
+      ow_rx_get_mac_parts(hdr->addr3, &addr3_high16, &addr3_low32);
+    }
+    if (len >= OW_RX_SEQ_CTRL_MIN_LEN) {
+      seq_no = ((hdr->seq_ctrl & IEEE80211_SCTL_SEQ) >> OW_IEEE80211_SEQ_CTRL_SHIFT_BITS);
+    }
+
+    is_unicast = !ow_rx_is_broadcast_addr(addr1_high16, addr1_low32);
+
+    if (((is_unicast) && (priv->drv_rx_reg_val[DRV_RX_REG_IDX_PRINT_CFG] & DMESG_LOG_UNICAST))
+        || ((!is_unicast) && (priv->drv_rx_reg_val[DRV_RX_REG_IDX_PRINT_CFG] & DMESG_LOG_BROADCAST))
+        || ((fcs_ok == 0) && (priv->drv_rx_reg_val[DRV_RX_REG_IDX_PRINT_CFG] & DMESG_LOG_ERROR))) {
+      printk("%s openwifi_rx: %dB ht%daggr%d/%d sgi%d %dM FC%04x DI%04x ADDR%04x%08x/%04x%08x/%04x%08x SC%d fcs%d buf_idx%d %ddBm fo %d\n", sdr_compatible_str,
+        len, ht_flag, ht_aggr, ht_aggr_last, short_gi, wifi_rate_table[rate_idx], hdr->frame_control, hdr->duration_id,
+        reverse16(addr1_high16), reverse32(addr1_low32), reverse16(addr2_high16), reverse32(addr2_low32), reverse16(addr3_high16), reverse32(addr3_low32),
+        seq_no, fcs_ok, rx_slot_idx_for_log, signal, phase_offset);
+    }
+  }
+
+  if (content_ok) {
+    skb = dev_alloc_skb(len);
+    if (skb) {
+      skb_put_data(skb, pdata_tmp + OW_RX_META_HEADER_BYTES, len);
+      rxcb = IEEE80211_SKB_RXCB(skb);
+      memset(rxcb, 0, sizeof(*rxcb));
+
+      rxcb->antenna = priv->runtime_rx_ant_cfg;
+      /* rate_idx has already been validated against OW_RX_RATE_IDX_MIN_VALID/MAX_VALID. */
+      rxcb->rate_idx = wifi_rate_table_mapping[rate_idx];
+      rxcb->signal = signal;
+      /* Report legal channel center frequency to mac80211 RX metadata.
+       * priv->actual_rx_lo can be intentionally offset for DDC operation
+       * (for example +/-10 MHz), so LO is not valid channel metadata. */
+      if (dev->conf.chandef.chan) {
+        rxcb->freq = dev->conf.chandef.chan->center_freq;
+        rxcb->band = dev->conf.chandef.chan->band;
+      } else {
+        rxcb->freq = priv->actual_rx_lo;
+        rxcb->band = freq_MHz_to_band(priv->actual_rx_lo);
+      }
+
+      rxcb->mactime = (((u64)tsft_low) | (((u64)tsft_high) << OW_RX_TSFT_HIGH_SHIFT));
+      rxcb->flag |= RX_FLAG_MACTIME_START;
+      if (!fcs_ok) {
+        rxcb->flag |= RX_FLAG_FAILED_FCS_CRC;
+      }
+      if (rate_idx <= OW_RX_RATE_LEGACY_MAX_VALID) {
+        rxcb->encoding = RX_ENC_LEGACY;
+      } else {
+        rxcb->encoding = RX_ENC_HT;
+      }
+      rxcb->bw = RATE_INFO_BW_20;
+      if (short_gi) {
+        rxcb->enc_flags |= RX_ENC_FLAG_SHORT_GI;
+      }
+      if (ht_aggr && openwifi_rx_ampdu_details_allowed(priv, hdr, len)) {
+        rxcb->ampdu_reference = local_ampdu_ref;
+        rxcb->flag |= RX_FLAG_AMPDU_DETAILS | RX_FLAG_AMPDU_LAST_KNOWN;
+        if (ht_aggr_last) {
+          rxcb->flag |= RX_FLAG_AMPDU_IS_LAST;
+        }
+      }
+
+      ieee80211_rx_irqsafe(dev, skb);
+
+      if (priv->stat.stat_enable && ow_rx_is_own_mac(priv, addr1_high16, addr1_low32)) {
+        agc_status_and_pkt_exist_flag = (agc_status_and_pkt_exist_flag & OW_RX_AGC_VALUE_MASK);
+        if (len >= OW_IEEE80211_ADDR2_MIN_LEN_BYTES) {
+          if (ow_rx_sender_filter_match(addr2_high16, addr2_low32, priv->stat.rx_target_sender_mac_addr_high16,
+              priv->stat.rx_target_sender_mac_addr)) {
+            if (ieee80211_is_data(hdr->frame_control)) {
+              priv->stat.rx_data_pkt_mcs_realtime = rate_idx;
+              priv->stat.rx_data_pkt_num_total++;
+              if (!fcs_ok) {
+                priv->stat.rx_data_pkt_num_fail++;
+                priv->stat.rx_data_pkt_fail_mcs_realtime = rate_idx;
+                priv->stat.rx_data_fail_agc_gain_value_realtime = agc_status_and_pkt_exist_flag;
+              } else {
+                priv->stat.rx_data_ok_agc_gain_value_realtime = agc_status_and_pkt_exist_flag;
+              }
+            } else if (ieee80211_is_mgmt(hdr->frame_control)) {
+              priv->stat.rx_mgmt_pkt_mcs_realtime = rate_idx;
+              priv->stat.rx_mgmt_pkt_num_total++;
+              if (!fcs_ok) {
+                priv->stat.rx_mgmt_pkt_num_fail++;
+                priv->stat.rx_mgmt_pkt_fail_mcs_realtime = rate_idx;
+                priv->stat.rx_mgmt_fail_agc_gain_value_realtime = agc_status_and_pkt_exist_flag;
+              } else {
+                priv->stat.rx_mgmt_ok_agc_gain_value_realtime = agc_status_and_pkt_exist_flag;
+              }
+            }
+          }
+        } else if (ieee80211_is_ack(hdr->frame_control)) {
+          priv->stat.rx_ack_pkt_mcs_realtime = rate_idx;
+          priv->stat.rx_ack_pkt_num_total++;
+          if (!fcs_ok) {
+            priv->stat.rx_ack_pkt_num_fail++;
+          } else {
+            priv->stat.rx_ack_ok_agc_gain_value_realtime = agc_status_and_pkt_exist_flag;
+          }
+        }
+      }
+    } else {
+      printk_ratelimited(KERN_WARNING "%s openwifi_rx: WARNING dev_alloc_skb failed!\n", sdr_compatible_str);
+    }
+
+    /* NOTE: ampdu_ref advances even on alloc failure so the next A-MPDU tail
+     * still gets a fresh monotonic reference for mac80211 reorder tracking. */
+    if (ht_aggr_last) {
+      local_ampdu_ref++;
+    }
+  }
+  } /* end Phase RX-B */
+
+  /* =================================================================
+   * Phase RX-C: locked, short — release slots, advance ring, update ampdu_ref.
+   * ================================================================= */
+  spin_lock_irqsave(&priv->lock, flags);
+
+  /* Keep the release-side DMA barrier before returning slot ownership to
+   * hardware. This preserves the old per-slot helper semantics while batching
+   * the barrier once per Phase RX-C pass: Phase-C CPU writes are not reordered
+   * after the slot-flag clears that let the DMA engine reuse the slots. */
+  dma_wmb();
+
+  for (i = 0; i < n_claimed; i++) {
+    pdata_tmp = priv->rx_cyclic_buf + work[i].slot_idx * RX_BD_BUF_SIZE;
+
+    ow_rx_slot_flag_clear(pdata_tmp);
+    priv->rx_slot_claimed[work[i].slot_idx] = 0U;
+
+#ifndef ENABLE_RX_SCAN_ALL_SLOTS
+    priv->rx_target_buf_idx_old =
+      (priv->rx_target_buf_idx_old + 1U) % NUM_RX_BD;
+#endif
+  }
+  /* Preserve the newest aggregate boundary if teardown/restart bumped the
+   * global reference while this batch was in Phase RX-B (paired with the
+   * reset-side increment in openwifi_reset_rx_ba_session_locked()). */
+  if ((s32)(local_ampdu_ref - priv->ampdu_reference) > 0) {
+    priv->ampdu_reference = local_ampdu_ref;
+  }
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  /* NOTE: This do-while is bounded by the finite ring (NUM_RX_BD slots).
+   * DMA refill takes milliseconds per period; the CPU drains faster than
+   * DMA fills.  Worst case = NUM_RX_BD / BUDGET iterations (~8 at 64/8).
+   * No additional packet cap is needed. */
+  } while (n_claimed == OW_RX_PHASE_A_BUDGET);
+
+  /* NOTE: clear_bit MUST follow spin_unlock_irqrestore from Phase RX-C so
+   * that all ring state updates are visible before the guard is released.
+   * On RISC-V, clear_bit uses amoand.w with release semantics; on ARM64,
+   * it provides full ordering.  Do not move this above the Phase C unlock. */
+  clear_bit(0, &priv->rx_processing);
+  return IRQ_HANDLED;
+}
diff --git a/drivers/sdr_tx.c b/drivers/sdr_tx.c
new file mode 100644
index 0000000..b4f7a86
--- /dev/null
+++ b/drivers/sdr_tx.c
@@ -0,0 +1,2152 @@
+/**
+ * @file sdr_tx.c
+ * @brief TX DMA recovery, TX completion IRQ, and TX submission helpers.
+ *
+ * Included only by sdr.c (single translation unit split).
+ *
+ * Runtime behavior notes:
+ * - hard_no_room policy:
+ *   if FPGA queue/FIFO is physically full, stop the mac80211 queue and drop
+ *   the current packet instead of submitting DMA against a full hardware queue.
+ * - no-ack status policy:
+ *   frames marked IEEE80211_TX_CTL_NO_ACK report
+ *   IEEE80211_TX_STAT_NOACK_TRANSMITTED on successful completion.
+ * - TX completion policy:
+ *   aggregate completions now rely on an explicit hardware response class from
+ *   PKT_INFO2. A valid zero-bitmap BlockAck is reported as AMPDU with
+ *   ampdu_ack_len=0, while IEEE80211_TX_STAT_AMPDU_NO_BACK is reserved for
+ *   completions where no valid BlockAck arrived. Under the current maintained
+ *   RTL contract, aggregate TX therefore closes out as either BLOCKACK or
+ *   NONE; a distinct aggregate plain-ACK completion class is not expected.
+ */
+
+//=============================================================================
+// Deferred Performance Work (not blocking current commit)
+//=============================================================================
+/*
+ * TODO(openwifi-tx-completion-irq): Replace TX pre-submit udelay polling with
+ *   completion interrupt.  Each TX packet busy-waits up to tx_dma_wait_us
+ *   (default 1000 us, sdr.c:205; S80openwifi overrides to 100 us on CVA6) for
+ *   DMA completion.  At 100 MHz CVA6, 100 us = 10K wasted cycles worst case.  The TX DMA engine
+ *   already has IRQ support — use a completion-based submit flow instead.
+ *   struct completion tx_dma_complete exists in sdr.h (commented out) but
+ *   was never wired up.  Note: wait_for_completion is illegal from softirq
+ *   context where openwifi_tx runs — needs deferred submission model.
+ *
+ * TODO(openwifi-tx-bounce-prealloc): Pre-allocate per-ring bounce buffer.
+ *   Currently kmalloc(GFP_ATOMIC) + memcpy on DMA-misaligned frames.  Pre-
+ *   allocate one bounce buffer per SW ring slot at openwifi_start, indexed by
+ *   bd_wr_idx mod NUM_TX_BD.  Eliminates GFP_ATOMIC from softirq TX path.
+ *
+ */
+
+//=============================================================================
+// TX DMA Stall Detection and Recovery
+//=============================================================================
+
+#define OW_TX_BA_REG_INVALID       0xFFFFFFFFU
+#define OW_TX_BA_SSN_MASK          0x0FFFU
+#define OW_TX_MPDU_DELIM_SIG       0x4EU
+#define OW_TX_EMPTY_DELIM_BYTES    LEN_MPDU_DELIM
+#define OW_TX_EMPTY_DELIM_WORD     0x4E140000U
+#define OW_TX_DELAY_LOG_MASK       0x3FFU
+/* TX_INTF_REG_PKT_INFO1 uses 4-bit CW exponent.
+ * Values above 10 are treated as overflow in diagnostics and saturated. */
+#define OW_TX_CW_MAX               10U
+/* Keep overflow marker compatible with existing debug/stat interpretation. */
+#define OW_TX_CW_SLOT_OFFSET       512U
+/* Retry histogram bucket limits (array bounds in driver stats). */
+#define OW_TX_DATA_RETRY_MAX_IDX   (OPENWIFI_TX_DATA_RETRY_BUCKETS - 1U)
+#define OW_TX_MGMT_RETRY_MAX_IDX   (OPENWIFI_TX_MGMT_RETRY_BUCKETS - 1U)
+#define OW_TX_PSPOLL_AID_PREFIX    0xC000U
+#define OW_TX_RATE_HW_MAX_FOR_ACK  6U
+#define OW_TX_N_DBPS_BASE_IDX      5U
+#define OW_TX_N_DBPS_MIN_IDX       4U
+#define OW_TX_ACK_LEN_BYTES        14U
+#define OW_TX_BA_LEN_BYTES         32U
+#define OW_TX_LEGACY_PREAMBLE_US   20U
+#define OW_TX_OFDM_SYMBOL_US        4U
+#define OW_TX_SIFS_OFDM_US         16U
+/* FPGA workaround: HT aggregation at MCS0 can wedge the TX core in some
+ * bitstream versions.  All AMPDU frames at MCS0 are bumped to MCS1.
+ * actual_tx_rate in the BD captures the bumped rate so minstrel gets
+ * correct feedback instead of attributing MCS1 results to MCS0. */
+#define OW_TX_HT_AGGR_MCS0         0U  /* MCS0 hw_value */
+#define OW_TX_HT_AGGR_MCS_FALLBACK 1U  /* bump target: MCS1 */
+#define OW_TX_ACK_6M_US            44U
+#define OW_TX_MPDU_DELIM_LEN_FIELD_OFFSET 0U
+#define OW_TX_MPDU_DELIM_CRC_FIELD_OFFSET 2U
+#define OW_TX_MPDU_DELIM_SIG_FIELD_OFFSET 3U
+#define OW_TX_BA_BITMAP_BITS       64U
+#define OW_TX_DMA_ADDR_ALIGN_MASK  0x7U
+#define OW_TX_RETRY_LIMIT_MASK     0xFU
+#define OW_TX_RATE_6M_HW           4U
+#define OW_TX_HT_PREAMBLE_US       36U
+#define OW_TX_RATE_OVERRIDE_MASK   0xFU
+#define OW_TX_RATE_OVERRIDE_HT_SGI_BIT 0x10U
+#define OW_TX_QOS_CTRL_MIN_LEN_BYTES 26U
+#define OW_TX_RECLAIM_MAX_ENTRIES    (MAX_NUM_SW_QUEUE * NUM_TX_BD)
+static inline void ow_tx_restore_skb_for_status(struct sk_buff *skb, u16 len_mpdu, bool use_ht_aggr);
+static inline void report_pkt_loss_due_to_driver_drop(struct ieee80211_hw *dev, struct sk_buff *skb, u16 len_mpdu);
+static int ow_tx_reconcile_after_terminate_no_alloc(struct openwifi_priv *priv,
+                                                     struct ieee80211_hw *dev);
+
+/**
+ * @brief Convert one MPDU sequence number into its BlockAck bitmap offset.
+ *
+ * The FPGA reports a 12-bit BA starting sequence number plus a 64-bit bitmap.
+ * Aggregate completion code must use the same offset rule for both per-subframe
+ * pass/fail and aggregate-level acknowledged-subframe counting.
+ *
+ * @param seq_no MPDU sequence number from the completed BD.
+ * @param blk_ack_ssn BlockAck starting sequence number.
+ * @return Bitmap offset in the BA window.
+ */
+static inline u16 ow_tx_ba_bitmap_idx(u16 seq_no, u16 blk_ack_ssn)
+{
+  return (seq_no - blk_ack_ssn) & OW_TX_BA_SSN_MASK;
+}
+
+/**
+ * @brief Check whether one completed MPDU is acknowledged in the BA bitmap.
+ *
+ * @param seq_no MPDU sequence number from the completed BD.
+ * @param blk_ack_ssn BlockAck starting sequence number.
+ * @param blk_ack_bitmap BlockAck bitmap returned by the FPGA.
+ * @return True when the MPDU is covered and acknowledged by the BA bitmap.
+ */
+static inline bool ow_tx_mpdu_acked_by_ba(u16 seq_no, u16 blk_ack_ssn, u64 blk_ack_bitmap)
+{
+  u16 bitmap_idx;
+
+  bitmap_idx = ow_tx_ba_bitmap_idx(seq_no, blk_ack_ssn);
+  if (bitmap_idx >= OW_TX_BA_BITMAP_BITS) {
+    return false;
+  }
+
+  return (((blk_ack_bitmap >> bitmap_idx) & 0x1ULL) != 0ULL);
+}
+
+/**
+ * @brief Count acknowledged subframes inside one reported aggregate window.
+ *
+ * @param ring Driver ring that owns the completed BDs.
+ * @param last_bd_rd_idx Hardware-reported last completed BD index.
+ * @param pkt_cnt Number of completed BDs in this aggregate window.
+ * @param blk_ack_ssn BlockAck starting sequence number.
+ * @param blk_ack_bitmap BlockAck bitmap returned by the FPGA.
+ * @return Number of acknowledged subframes in the reported completion window.
+ */
+static u8 ow_tx_count_acked_ampdu_subframes(const struct openwifi_ring *ring,
+                                            u8 last_bd_rd_idx, u8 pkt_cnt,
+                                            u16 blk_ack_ssn, u64 blk_ack_bitmap)
+{
+  u8 i;
+  u8 acked_subframes = 0;
+  u8 bd_idx;
+  u16 seq_no;
+
+  for (i = 1; i <= pkt_cnt; i++) {
+    bd_idx = (last_bd_rd_idx + i - pkt_cnt + NUM_TX_BD) % NUM_TX_BD;
+    seq_no = ring->bds[bd_idx].seq_no;
+    if (seq_no == OPENWIFI_TX_SEQ_INVALID) {
+      continue;
+    }
+    if (ow_tx_mpdu_acked_by_ba(seq_no, blk_ack_ssn, blk_ack_bitmap)) {
+      acked_subframes++;
+    }
+  }
+
+  return acked_subframes;
+}
+
+/**
+ * @brief Read little-endian 16-bit value from an unaligned byte buffer.
+ *
+ * @param base Base pointer.
+ * @param offset_bytes Byte offset from @p base.
+ * @return 16-bit value.
+ */
+static inline u16 ow_tx_read_u16(const u8 *base, u32 offset_bytes)
+{
+  return get_unaligned_le16(base + offset_bytes);
+}
+
+/**
+ * @brief Read little-endian 32-bit value from an unaligned byte buffer.
+ *
+ * @param base Base pointer.
+ * @param offset_bytes Byte offset from @p base.
+ * @return 32-bit value.
+ */
+static inline u32 ow_tx_read_u32(const u8 *base, u32 offset_bytes)
+{
+  return get_unaligned_le32(base + offset_bytes);
+}
+
+/**
+ * @brief Build the aggregate-boundary key for one outgoing frame.
+ *
+ * Aggregation continuity follows the actual programmed hardware queue after
+ * any local driver remap, not the original mac80211 priority.
+ *
+ * @param addr1_low32 Destination MAC low 32 bits.
+ * @param addr1_high16 Destination MAC high 16 bits.
+ * @param duration_id 802.11 Duration/ID field.
+ * @param rate_hw_value FPGA rate selector.
+ * @param pkt_need_ack Whether the MPDU expects ACK/BlockAck.
+ * @param hw_queue Actual driver/hardware queue index.
+ * @param qos_tid QoS TID for QoS data, 0 otherwise.
+ * @param retry_limit_raw Raw retry-limit field programmed into HW.
+ * @param use_short_gi Whether short GI is enabled.
+ * @return Aggregate-boundary key value.
+ */
+static inline struct ow_tx_aggr_key ow_tx_build_aggr_key(u32 addr1_low32, u16 addr1_high16,
+                                                         __le16 duration_id, u8 rate_hw_value,
+                                                         u8 pkt_need_ack, u8 hw_queue, u8 qos_tid,
+                                                         u8 retry_limit_raw, u8 use_short_gi)
+{
+  struct ow_tx_aggr_key key;
+
+  key.addr1_low32 = addr1_low32;
+  key.addr1_high16 = addr1_high16;
+  key.duration_id = duration_id;
+  key.rate_hw_value = rate_hw_value;
+  key.pkt_need_ack = pkt_need_ack;
+  key.hw_queue = hw_queue;
+  key.qos_tid = qos_tid;
+  key.retry_limit_raw = retry_limit_raw;
+  key.use_short_gi = use_short_gi;
+
+  return key;
+}
+
+/**
+ * @brief Check whether one outgoing frame matches the cached aggregate key.
+ *
+ * @param priv Driver private state.
+ * @param hw_queue Hardware queue that owns the aggregate stream.
+ * @param p_key Candidate aggregate key.
+ * @return True when the cached key matches exactly.
+ */
+static inline bool ow_tx_aggr_key_matches_prev(const struct openwifi_priv *priv,
+                                               u8 hw_queue,
+                                               const struct ow_tx_aggr_key *p_key)
+{
+  return READ_ONCE(priv->tx_aggr_prev_key[hw_queue].addr1_low32) == p_key->addr1_low32
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].addr1_high16) == p_key->addr1_high16
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].duration_id) == p_key->duration_id
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].rate_hw_value) == p_key->rate_hw_value
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].pkt_need_ack) == p_key->pkt_need_ack
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].hw_queue) == p_key->hw_queue
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].qos_tid) == p_key->qos_tid
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].retry_limit_raw) == p_key->retry_limit_raw
+    && READ_ONCE(priv->tx_aggr_prev_key[hw_queue].use_short_gi) == p_key->use_short_gi;
+}
+
+/**
+ * @brief Cache the current aggregate-boundary key.
+ *
+ * @param priv Driver private state.
+ * @param hw_queue Hardware queue that owns the aggregate stream.
+ * @param p_key Aggregate key to store.
+ */
+static inline void ow_tx_store_aggr_key(struct openwifi_priv *priv,
+                                        u8 hw_queue,
+                                        const struct ow_tx_aggr_key *p_key)
+{
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].addr1_low32, p_key->addr1_low32);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].addr1_high16, p_key->addr1_high16);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].duration_id, p_key->duration_id);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].rate_hw_value, p_key->rate_hw_value);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].pkt_need_ack, p_key->pkt_need_ack);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].hw_queue, p_key->hw_queue);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].qos_tid, p_key->qos_tid);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].retry_limit_raw, p_key->retry_limit_raw);
+  WRITE_ONCE(priv->tx_aggr_prev_key[hw_queue].use_short_gi, p_key->use_short_gi);
+}
+
+/**
+ * @brief Identify the one completion entry that owns aggregate-level status.
+ *
+ * The maintained reclaim order reports one completion window oldest-first.
+ * Aggregate-level AMPDU status is attached only to that oldest BD.
+ *
+ * @param use_ht_aggr Whether the completed packet was aggregated.
+ * @param completion_idx_one_based Current reclaim-loop index (1..pkt_cnt).
+ * @return True when this completion entry owns aggregate-level status.
+ */
+static inline bool ow_tx_is_ampdu_status_owner(bool use_ht_aggr, u8 completion_idx_one_based)
+{
+  return use_ht_aggr && (completion_idx_one_based == 1U);
+}
+
+/**
+ * @brief Fill mac80211 aggregate-level completion fields.
+ *
+ * @param info mac80211 TX status buffer.
+ * @param pkt_cnt Number of reported subframes in the completion window.
+ * @param ampdu_ack_len Number of acknowledged subframes.
+ * @param pkt_need_ack Whether the aggregate expected BlockAck.
+ * @param tx_resp_class Hardware response-class tag.
+ *
+ * This is owner-only aggregate metadata.  Per-subframe ACK / NOACK success is
+ * still reported on every reclaimed skb so mac80211 accounting stays correct.
+ */
+static inline void ow_tx_set_ampdu_status_fields(struct ieee80211_tx_info *info, u8 pkt_cnt,
+                                                 u8 ampdu_ack_len, bool pkt_need_ack,
+                                                 u8 tx_resp_class)
+{
+  info->flags |= IEEE80211_TX_STAT_AMPDU;
+  info->status.ampdu_len = pkt_cnt;
+  info->status.ampdu_ack_len = ampdu_ack_len;
+  if (pkt_need_ack && tx_resp_class == OW_TX_RESP_CLASS_NONE) {
+    info->flags |= IEEE80211_TX_STAT_AMPDU_NO_BACK;
+  } else if (pkt_need_ack && tx_resp_class == OW_TX_RESP_CLASS_ACK) {
+    /* Keep this legacy fallback honest: current maintained RTL should not
+     * emit aggregate ACK, but if it ever does, software still treats it as
+     * "no valid BlockAck arrived". */
+    info->flags |= IEEE80211_TX_STAT_AMPDU_NO_BACK;
+  }
+}
+
+/**
+ * @brief Write little-endian 16-bit value to an unaligned byte buffer.
+ *
+ * @param base Base pointer.
+ * @param offset_bytes Byte offset from @p base.
+ * @param value Value to write.
+ */
+static inline void ow_tx_write_u16(u8 *base, u32 offset_bytes, u16 value)
+{
+  put_unaligned_le16(value, base + offset_bytes);
+}
+
+/**
+ * @brief Write little-endian 32-bit value to an unaligned byte buffer.
+ *
+ * @param base Base pointer.
+ * @param offset_bytes Byte offset from @p base.
+ * @param value Value to write.
+ */
+static inline void ow_tx_write_u32(u8 *base, u32 offset_bytes, u32 value)
+{
+  put_unaligned_le32(value, base + offset_bytes);
+}
+
+/**
+ * @brief Decode MAC address bytes into high16/low32 words.
+ *
+ * @param mac_addr Pointer to 6-byte MAC address.
+ * @param addr_high16_out Output high 16 bits.
+ * @param addr_low32_out Output low 32 bits.
+ */
+static inline void ow_tx_get_mac_parts(const u8 *mac_addr, u16 *addr_high16_out, u32 *addr_low32_out)
+{
+  *addr_high16_out = ow_tx_read_u16(mac_addr, OW_IEEE80211_MAC_ADDR_HIGH_OFFSET_BYTES);
+  *addr_low32_out = ow_tx_read_u32(mac_addr, OW_IEEE80211_MAC_ADDR_LOW_OFFSET_BYTES);
+}
+
+/**
+ * @brief Check whether destination address passes TX statistics sender filter.
+ *
+ * Legacy compatibility:
+ * - target_high16 == 0 and target_low32 != 0 keeps low32-only match behavior.
+ * - target_high16 != 0 and target_low32 != 0 uses full 48-bit match.
+ * - target_high16 == 0 and target_low32 == 0 is wildcard.
+ *
+ * @param dst_high16 Destination MAC high 16 bits.
+ * @param dst_low32 Destination MAC low 32 bits.
+ * @param target_high16 Configured filter high 16 bits.
+ * @param target_low32 Configured filter low 32 bits.
+ * @return true when destination address passes the filter.
+ */
+static inline bool ow_tx_sender_filter_match(u16 dst_high16, u32 dst_low32, u16 target_high16, u32 target_low32)
+{
+  if (target_low32 == OW_TARGET_SENDER_LOW32_WILDCARD
+      && target_high16 == OW_TARGET_SENDER_HIGH16_WILDCARD) {
+    return true;
+  }
+  if (target_high16 == OW_TARGET_SENDER_HIGH16_WILDCARD) {
+    return (dst_low32 == target_low32);
+  }
+  return (dst_low32 == target_low32) && (dst_high16 == target_high16);
+}
+
+/**
+ * @brief Check whether a Linux priority is marked stopped on a TX ring.
+ */
+static inline bool ow_tx_ring_stop_has_prio(const struct openwifi_ring *ring, u8 prio)
+{
+  return (ring->stop_prio_mask & BIT(prio)) != 0U;
+}
+
+/**
+ * @brief Mark a Linux priority as stopped on a TX ring.
+ */
+static inline void ow_tx_ring_stop_set_prio(struct openwifi_ring *ring, u8 prio)
+{
+  ring->stop_prio_mask |= BIT(prio);
+  ring->stop_flag = (int)prio;
+}
+
+/**
+ * @brief Clear one stopped Linux priority from a TX ring.
+ */
+static inline void ow_tx_ring_stop_clear_prio(struct openwifi_ring *ring, u8 prio)
+{
+  ring->stop_prio_mask &= (u8)(~BIT(prio));
+  if (ring->stop_prio_mask == 0U) {
+    ring->stop_flag = -1;
+  } else {
+    ring->stop_flag = (int)__ffs((unsigned long)ring->stop_prio_mask);
+  }
+}
+
+/**
+ * @brief Snapshot and clear stopped priorities on a TX ring (call under lock).
+ *
+ * Returns the mask of priorities that were stopped.  Caller should pass the
+ * returned mask to ow_tx_wake_from_mask() AFTER releasing priv->lock so that
+ * ieee80211_wake_queue() runs without holding the driver lock.
+ */
+static inline u8 ow_tx_ring_clear_stopped(struct openwifi_ring *ring)
+{
+  u8 mask = ring->stop_prio_mask;
+
+  ring->stop_prio_mask = 0U;
+  ring->stop_flag = -1;
+  return mask;
+}
+
+/**
+ * @brief Wake mac80211 queues from a previously snapshotted mask (call OUTSIDE lock).
+ */
+static inline void ow_tx_wake_from_mask(struct ieee80211_hw *dev, u8 mask)
+{
+  u8 prio;
+
+  for (prio = 0; prio < MAX_NUM_HW_QUEUE; prio++) {
+    if ((mask & BIT(prio)) != 0U) {
+      ieee80211_wake_queue(dev, prio);
+    }
+  }
+}
+
+/**
+ * @brief Wake and clear all stopped Linux priorities tracked on a TX ring.
+ *
+ * NOTE: This combined helper calls ieee80211_wake_queue under whatever lock
+ * the caller holds.  In the TX interrupt handler, prefer the split pattern:
+ * ow_tx_ring_clear_stopped() under lock → ow_tx_wake_from_mask() after unlock.
+ * This combined version is kept for call sites outside the hot path (recovery,
+ * reclaim, stall clear) where the lock hold is already short.
+ */
+static inline void ow_tx_ring_wake_all_stopped(struct ieee80211_hw *dev, struct openwifi_ring *ring)
+{
+  u8 mask = ow_tx_ring_clear_stopped(ring);
+
+  ow_tx_wake_from_mask(dev, mask);
+}
+
+/**
+ * @brief One reclaimed TX descriptor snapshot (copied before ring clear).
+ */
+struct ow_tx_reclaim_entry {
+  struct sk_buff *skb_linked;
+  dma_addr_t dma_mapping_addr;
+  u32 dma_len_bytes;
+  void *bounce_buf;
+  u16 len_mpdu;
+};
+
+/**
+ * @brief Check whether a TX descriptor still owns SW/DMA resources.
+ */
+static inline bool ow_tx_bd_is_active(const struct openwifi_buffer_descriptor *bd)
+{
+  return (bd->seq_no != OPENWIFI_TX_SEQ_INVALID)
+         || (bd->skb_linked != NULL)
+         || (bd->dma_mapping_addr != 0)
+         || (bd->bounce_buf != NULL);
+}
+
+/**
+ * @brief Clear one TX descriptor to the canonical empty state.
+ */
+static inline void ow_tx_bd_clear(struct openwifi_buffer_descriptor *bd)
+{
+  bd->prio = OPENWIFI_TX_PRIO_INVALID;
+  bd->len_mpdu = 0;
+  bd->seq_no = OPENWIFI_TX_SEQ_INVALID;
+  bd->skb_linked = NULL;
+  bd->dma_mapping_addr = 0;
+  bd->dma_len_bytes = 0;
+  bd->actual_tx_rate.idx = -1;
+  bd->bounce_buf = NULL;
+}
+
+/**
+ * @brief Finalize one reclaimed TX descriptor: unmap/free/report drop.
+ *
+ * Called after ownership is detached from ring state.
+ */
+static void ow_tx_finalize_reclaim_entry(struct openwifi_priv *priv,
+                                         struct ieee80211_hw *dev,
+                                         const struct ow_tx_reclaim_entry *entry)
+{
+  u32 dma_len_bytes;
+  u16 report_len_mpdu;
+
+  dma_len_bytes = entry->dma_len_bytes;
+  if (entry->dma_mapping_addr != 0
+      && priv->tx_chan != NULL
+      && priv->tx_chan->device != NULL
+      && priv->tx_chan->device->dev != NULL) {
+    if (dma_len_bytes != 0U) {
+      dma_unmap_single(priv->tx_chan->device->dev, entry->dma_mapping_addr,
+        dma_len_bytes, DMA_MEM_TO_DEV);
+    } else {
+      /* TODO(openwifi-tx-reclaim-zero-len-unmap): investigate rare reclaim
+       * entries with valid dma_mapping_addr but zero dma_len_bytes.
+       */
+      pr_warn_ratelimited("openwifi: skip tx unmap on reclaimed entry with zero dma_len_bytes\n");
+    }
+  }
+
+  kfree(entry->bounce_buf);
+
+  if (entry->skb_linked != NULL) {
+    report_len_mpdu = entry->len_mpdu;
+    if (report_len_mpdu == 0U) {
+      report_len_mpdu = (u16)entry->skb_linked->len;
+    }
+    report_pkt_loss_due_to_driver_drop(dev, entry->skb_linked, report_len_mpdu);
+  }
+}
+
+/**
+ * @brief Reconcile TX software rings after DMA terminate (allocation path).
+ *
+ * Captures active descriptors under lock, clears ring ownership, then unmaps/frees
+ * and reports packet loss outside the lock.
+ *
+ * @return Number of reclaimed descriptors, or -ENOMEM on allocation failure.
+ */
+static int ow_tx_reconcile_after_terminate_with_alloc(struct openwifi_priv *priv,
+                                                       struct ieee80211_hw *dev)
+{
+  struct ow_tx_reclaim_entry *entry_arr;
+  struct openwifi_ring *ring;
+  struct openwifi_buffer_descriptor *bd;
+  unsigned long flags;
+  int ring_idx, bd_idx;
+  int reclaim_idx = 0;
+  bool reclaim_overflow = false;
+
+  entry_arr = kcalloc(OW_TX_RECLAIM_MAX_ENTRIES, sizeof(*entry_arr), GFP_KERNEL);
+  if (entry_arr == NULL) {
+    return -ENOMEM;
+  }
+
+  spin_lock_irqsave(&priv->lock, flags);
+  for (ring_idx = 0; ring_idx < MAX_NUM_SW_QUEUE; ring_idx++) {
+    ring = &(priv->tx_ring[ring_idx]);
+    if (ring->bds == NULL) {
+      continue;
+    }
+    for (bd_idx = 0; bd_idx < NUM_TX_BD; bd_idx++) {
+      bd = &ring->bds[bd_idx];
+      if (!ow_tx_bd_is_active(bd)) {
+        continue;
+      }
+      if (reclaim_idx >= OW_TX_RECLAIM_MAX_ENTRIES) {
+        reclaim_overflow = true;
+        continue;
+      }
+      entry_arr[reclaim_idx].skb_linked = bd->skb_linked;
+      entry_arr[reclaim_idx].dma_mapping_addr = bd->dma_mapping_addr;
+      entry_arr[reclaim_idx].dma_len_bytes = bd->dma_len_bytes;
+      entry_arr[reclaim_idx].bounce_buf = bd->bounce_buf;
+      entry_arr[reclaim_idx].len_mpdu = bd->len_mpdu;
+      reclaim_idx++;
+      ow_tx_bd_clear(bd);
+    }
+    ring->bd_wr_idx = 0;
+    ring->bd_rd_idx = 0;
+  }
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  for (bd_idx = 0; bd_idx < reclaim_idx; bd_idx++) {
+    ow_tx_finalize_reclaim_entry(priv, dev, &entry_arr[bd_idx]);
+  }
+  kfree(entry_arr);
+
+  if (reclaim_overflow) {
+    pr_warn_ratelimited("openwifi: tx reclaim overflow, fallback reconcile path engaged\n");
+    reclaim_idx += ow_tx_reconcile_after_terminate_no_alloc(priv, dev);
+  }
+
+  return reclaim_idx;
+}
+
+/**
+ * @brief Reconcile TX software rings after DMA terminate (no-allocation fallback).
+ *
+ * Used only when memory allocation for bulk reconcile fails.
+ *
+ * @return Number of reclaimed descriptors.
+ */
+static int ow_tx_reconcile_after_terminate_no_alloc(struct openwifi_priv *priv,
+                                                     struct ieee80211_hw *dev)
+{
+  struct openwifi_ring *ring;
+  struct openwifi_buffer_descriptor *bd;
+  struct ow_tx_reclaim_entry entry;
+  unsigned long flags;
+  int ring_idx, bd_idx;
+  int reclaim_idx = 0;
+  bool found_entry;
+
+  for (ring_idx = 0; ring_idx < MAX_NUM_SW_QUEUE; ring_idx++) {
+    for (;;) {
+      found_entry = false;
+      entry.skb_linked = NULL;
+      entry.dma_mapping_addr = 0;
+      entry.dma_len_bytes = 0;
+      entry.bounce_buf = NULL;
+      entry.len_mpdu = 0;
+
+      spin_lock_irqsave(&priv->lock, flags);
+      ring = &(priv->tx_ring[ring_idx]);
+      if (ring->bds == NULL) {
+        spin_unlock_irqrestore(&priv->lock, flags);
+        break;
+      }
+      for (bd_idx = 0; bd_idx < NUM_TX_BD; bd_idx++) {
+        bd = &ring->bds[bd_idx];
+        if (!ow_tx_bd_is_active(bd)) {
+          continue;
+        }
+        entry.skb_linked = bd->skb_linked;
+        entry.dma_mapping_addr = bd->dma_mapping_addr;
+        entry.dma_len_bytes = bd->dma_len_bytes;
+        entry.bounce_buf = bd->bounce_buf;
+        entry.len_mpdu = bd->len_mpdu;
+        ow_tx_bd_clear(bd);
+        found_entry = true;
+        break;
+      }
+      if (!found_entry) {
+        ring->bd_wr_idx = 0;
+        ring->bd_rd_idx = 0;
+      }
+      spin_unlock_irqrestore(&priv->lock, flags);
+
+      if (!found_entry) {
+        break;
+      }
+      ow_tx_finalize_reclaim_entry(priv, dev, &entry);
+      reclaim_idx++;
+    }
+  }
+
+  return reclaim_idx;
+}
+
+/**
+ * @brief Reconcile SW TX-ring ownership immediately after successful terminate.
+ *
+ * NOTE(openwifi-tx-terminate-reconcile): This closes the stall-recovery ownership
+ * gap by reclaiming stale SW descriptors/SKBs right after DMA terminate success,
+ * before clearing tx_dma_terminating and waking queues.
+ *
+ * @return Number of reclaimed descriptors.
+ */
+static int ow_tx_reconcile_after_terminate(struct openwifi_priv *priv,
+                                           struct ieee80211_hw *dev)
+{
+  int reclaim_count;
+
+  reclaim_count = ow_tx_reconcile_after_terminate_with_alloc(priv, dev);
+  if (reclaim_count >= 0) {
+    return reclaim_count;
+  }
+
+  printk_ratelimited("%s openwifi_tx: reconcile fallback (no alloc)\n", sdr_compatible_str);
+  return ow_tx_reconcile_after_terminate_no_alloc(priv, dev);
+}
+
+/**
+ * @brief TX DMA stall recovery worker.
+ *
+ * Fires every OW_TX_DMA_RECOVERY_PERIOD_MS while tx_dma_stalled is set.
+ * Performs one non-blocking DMA completion check; on COMPLETE clears stall
+ * and wakes all stopped queues. On persistent stall emits escalation warning.
+ */
+static void openwifi_tx_stall_recovery(struct work_struct *work)
+{
+  struct openwifi_priv *priv =
+    container_of(work, struct openwifi_priv, tx_stall_recovery_work.work);
+  struct ieee80211_hw *dev = priv->hw;
+  enum dma_status status;
+  dma_cookie_t cookie_snapshot;
+  unsigned long flags, window_end_jiffies;
+  unsigned long stall_first_jiffies_snapshot;
+  u32 stall_window_count_snapshot;
+  bool is_stall_burst, is_stall_persistent;
+  int idx_hw_queue;
+  int reclaim_count;
+  int ret;
+
+  if (!READ_ONCE(priv->tx_dma_recovery_enabled)) {
+    return;
+  }
+
+  if (!READ_ONCE(priv->tx_dma_stalled)) {
+    return; /* cleared by normal path, nothing to do */
+  }
+
+  cookie_snapshot = READ_ONCE(priv->tx_cookie);
+  if (cookie_snapshot == 0) {
+    /* No valid cookie yet: avoid polling an invalid token in recovery worker.
+     * Keep stalled state and let escalation/restart policy handle progress. */
+    status = DMA_IN_PROGRESS;
+  } else {
+    status = dma_async_is_tx_complete(priv->tx_chan, cookie_snapshot, NULL, NULL);
+  }
+
+  if (status == DMA_COMPLETE) {
+    /* Clear stall and wake queues atomically under lock. */
+    spin_lock_irqsave(&priv->lock, flags);
+    if (READ_ONCE(priv->tx_dma_stalled) && !READ_ONCE(priv->tx_dma_terminating)) {
+      WRITE_ONCE(priv->tx_dma_stalled, false);
+      WRITE_ONCE(priv->tx_dma_stall_recovery_cycles, 0);
+      WRITE_ONCE(priv->tx_dma_stall_window_count, 0);
+      WRITE_ONCE(priv->tx_dma_stall_first_jiffies, 0);
+      OW_U32_INC(priv->stat.tx_dma_stall_clear_count);
+      for (idx_hw_queue = 0; idx_hw_queue < MAX_NUM_HW_QUEUE; idx_hw_queue++) {
+        if (priv->tx_ring[idx_hw_queue].stop_prio_mask != 0U) {
+          ow_tx_ring_wake_all_stopped(dev, &priv->tx_ring[idx_hw_queue]);
+        }
+      }
+    }
+    spin_unlock_irqrestore(&priv->lock, flags);
+    printk_ratelimited("%s openwifi_tx: DMA stall recovered via worker\n", sdr_compatible_str);
+    return;
+  }
+
+  OW_U32_INC(priv->tx_dma_stall_recovery_cycles);
+  stall_window_count_snapshot = READ_ONCE(priv->tx_dma_stall_window_count);
+  stall_first_jiffies_snapshot = READ_ONCE(priv->tx_dma_stall_first_jiffies);
+  window_end_jiffies = stall_first_jiffies_snapshot + OW_TX_DMA_STALL_WINDOW_JIFFIES;
+  is_stall_burst = (stall_window_count_snapshot >= OW_TX_DMA_STALL_ESCALATION_ENTRIES) &&
+                   time_before(jiffies, window_end_jiffies);
+  is_stall_persistent = (stall_first_jiffies_snapshot != 0) &&
+                        time_after(jiffies, window_end_jiffies);
+
+  if (is_stall_burst || is_stall_persistent) {
+    printk(KERN_WARNING "%s openwifi_tx: ESCALATION (worker): stall persists %u entries, %u cycles (%ums) -> TX DMA channel reset\n",
+           sdr_compatible_str, stall_window_count_snapshot,
+           READ_ONCE(priv->tx_dma_stall_recovery_cycles),
+           jiffies_to_msecs(jiffies - stall_first_jiffies_snapshot));
+
+    /* Two-lock pattern: dmaengine_terminate_sync() can sleep, so we
+     * cannot hold the spinlock across it. Instead: (1) take lock, verify
+     * still stalled, set tx_dma_terminating to block new TX submissions
+     * and TX IRQ stall-clears during the window, then release lock;
+     * (2) call the sleeping terminate; (3) reacquire lock to clear
+     * stall state and wake queues. See sdr.h for tx_dma_terminating
+     * lifecycle and all check sites. */
+    spin_lock_irqsave(&priv->lock, flags);
+    if (!READ_ONCE(priv->tx_dma_stalled) || READ_ONCE(priv->tx_dma_terminating)) {
+      spin_unlock_irqrestore(&priv->lock, flags);
+      return;
+    }
+    WRITE_ONCE(priv->tx_dma_terminating, true);
+    spin_unlock_irqrestore(&priv->lock, flags);
+
+    ret = openwifi_dma_terminate_sync_retry(priv->tx_chan, "openwifi_tx_stall_recovery(tx)");
+    if (ret) {
+      printk(KERN_ERR "%s openwifi_tx: dmaengine_terminate_sync failed: %d\n",
+             sdr_compatible_str, ret);
+      /* Bounded self-heal retries already attempted by
+       * openwifi_dma_terminate_sync_retry(). If all attempts failed,
+       * fail closed: keep TX blocked and require stop/restart/reprobe
+       * instead of re-arming worker against ambiguous DMA/SW ownership. */
+      spin_lock_irqsave(&priv->lock, flags);
+      WRITE_ONCE(priv->tx_dma_recovery_enabled, false);
+      WRITE_ONCE(priv->tx_dma_stalled, true);
+      WRITE_ONCE(priv->tx_dma_terminating, true);
+      spin_unlock_irqrestore(&priv->lock, flags);
+      printk(KERN_ERR "%s openwifi_tx: recovery disabled after terminate failure; reload/reprobe required\n",
+        sdr_compatible_str);
+      return;
+    }
+
+    /* Reset cookie after successful terminate to avoid stale-cookie re-stall. */
+    WRITE_ONCE(priv->tx_cookie, 0);
+
+    /* Reset the maintained TX datapath so a wedged FIFO/state-machine
+     * doesn't immediately re-stall the next DMA submission. Keep this live
+     * 2/3/5/6/7 mask aligned with tx_intf hw_init instead of the stale legacy
+     * 0x434 comment carried by older driver copies. */
+    tx_intf_api->TX_INTF_REG_MULTI_RST_write(OW_TX_INTF_RESET_MINI_MASK);
+    tx_intf_api->TX_INTF_REG_MULTI_RST_write(0);
+
+    reclaim_count = ow_tx_reconcile_after_terminate(priv, dev);
+    if (reclaim_count > 0) {
+      printk(KERN_WARNING "%s openwifi_tx: reclaimed %d pending TX descriptors after DMA reset\n",
+             sdr_compatible_str, reclaim_count);
+    }
+
+    /* Clear stall and wake all queues after terminate success. */
+    spin_lock_irqsave(&priv->lock, flags);
+    if (READ_ONCE(priv->tx_dma_stalled)) {
+      WRITE_ONCE(priv->tx_dma_stalled, false);
+      OW_U32_INC(priv->stat.tx_dma_stall_clear_count);
+      WRITE_ONCE(priv->tx_dma_stall_recovery_cycles, 0);
+      WRITE_ONCE(priv->tx_dma_stall_window_count, 0);
+      WRITE_ONCE(priv->tx_dma_stall_first_jiffies, 0);
+      for (idx_hw_queue = 0; idx_hw_queue < MAX_NUM_HW_QUEUE; idx_hw_queue++) {
+        if (priv->tx_ring[idx_hw_queue].stop_prio_mask != 0U) {
+          ow_tx_ring_wake_all_stopped(dev, &priv->tx_ring[idx_hw_queue]);
+        }
+      }
+    }
+    /* Only clear terminating if recovery is still enabled. If
+     * openwifi_stop() set recovery_enabled=false while we were in
+     * dmaengine_terminate_sync(), keep terminating=true to honour
+     * the teardown invariant (see sdr.h). */
+    if (READ_ONCE(priv->tx_dma_recovery_enabled)) {
+      WRITE_ONCE(priv->tx_dma_terminating, false);
+    }
+    spin_unlock_irqrestore(&priv->lock, flags);
+    printk(KERN_INFO "%s openwifi_tx: TX DMA channel reset complete, queues woken\n",
+           sdr_compatible_str);
+    return;
+  }
+
+  if (READ_ONCE(priv->tx_dma_recovery_enabled) && !READ_ONCE(priv->tx_dma_terminating)) {
+    schedule_delayed_work(&priv->tx_stall_recovery_work, msecs_to_jiffies(OW_TX_DMA_RECOVERY_PERIOD_MS));
+  }
+}
+
+/**
+ * @brief Enter TX DMA stall state: set stall flag, stop all queues, schedule recovery.
+ *
+ * Sets tx_dma_stalled and stops all mac80211 queues atomically under priv->lock
+ * so no TX interrupt can clear the stall flag before the queues are stopped
+ * (which would leave them permanently halted). Schedules the recovery worker
+ * to poll DMA completion and wake queues once the channel is healthy again.
+ *
+ * @param priv  Driver private state (openwifi_priv).
+ * @param dev   mac80211 hardware handle; needed for ieee80211_stop_queue().
+ */
+static void openwifi_tx_enter_stall(struct openwifi_priv *priv, struct ieee80211_hw *dev)
+{
+  unsigned long stall_flags, window_end_jiffies;
+  unsigned long stall_first_jiffies_snapshot;
+  u32 stall_window_count_snapshot;
+  bool is_stall_burst, is_stall_persistent;
+  int idx_hw_queue;
+
+  spin_lock_irqsave(&priv->lock, stall_flags);
+  if (READ_ONCE(priv->tx_dma_stall_window_count) == 0U) {
+    WRITE_ONCE(priv->tx_dma_stall_first_jiffies, jiffies);
+  }
+  OW_U32_INC(priv->tx_dma_stall_window_count);
+  stall_first_jiffies_snapshot = READ_ONCE(priv->tx_dma_stall_first_jiffies);
+  stall_window_count_snapshot = READ_ONCE(priv->tx_dma_stall_window_count);
+  window_end_jiffies = stall_first_jiffies_snapshot + OW_TX_DMA_STALL_WINDOW_JIFFIES;
+  is_stall_burst = (stall_window_count_snapshot >= OW_TX_DMA_STALL_ESCALATION_ENTRIES) &&
+                   time_before(jiffies, window_end_jiffies);
+  is_stall_persistent = (stall_first_jiffies_snapshot != 0U) &&
+                        time_after(jiffies, window_end_jiffies);
+
+  if (READ_ONCE(priv->tx_dma_recovery_enabled) && !READ_ONCE(priv->tx_dma_terminating)) {
+    WRITE_ONCE(priv->tx_dma_stalled, true);
+    /* NOTE: stop_queue under lock — stall entry path, fires on DMA timeout
+     * (~once per stall event).  Hot-path wakes are outside lock. */
+    for (idx_hw_queue = 0; idx_hw_queue < MAX_NUM_HW_QUEUE; idx_hw_queue++) {
+      if (!ow_tx_ring_stop_has_prio(&priv->tx_ring[idx_hw_queue], (u8)idx_hw_queue)) {
+        ieee80211_stop_queue(dev, idx_hw_queue);
+        ow_tx_ring_stop_set_prio(&priv->tx_ring[idx_hw_queue], (u8)idx_hw_queue);
+      }
+    }
+    /* Schedule recovery worker while lock is held. This prevents the
+     * post-stop re-arm race: without the lock, an in-flight caller could
+     * schedule_delayed_work() after openwifi_stop() has already cancelled
+     * the worker, leading to UAF on device removal. schedule_delayed_work()
+     * is safe under spinlock -- it only adds a timer, does not sleep. */
+    schedule_delayed_work(&priv->tx_stall_recovery_work,
+      msecs_to_jiffies(OW_TX_DMA_RECOVERY_PERIOD_MS));
+  }
+  spin_unlock_irqrestore(&priv->lock, stall_flags);
+
+  if (is_stall_burst || is_stall_persistent) {
+    printk_ratelimited("%s openwifi_tx: ESCALATION: %u stall entries, %u recovery cycles (%ums), TX channel may need reset\n",
+                       sdr_compatible_str, stall_window_count_snapshot,
+                       READ_ONCE(priv->tx_dma_stall_recovery_cycles),
+                       jiffies_to_msecs(jiffies - stall_first_jiffies_snapshot));
+  }
+}
+
+/**
+ * @brief 2-phase TX completion interrupt handler.
+ *
+ * Phase TX-A (locked): Read FPGA completion FIFOs, snapshot per-packet info
+ * (skb, dma_addr, bounce_buf) from ring, update ring indices, handle
+ * queue wake decisions.  All FPGA MMIO reads and ring bookkeeping here.
+ *
+ * Phase TX-B (unlocked): dma_unmap_single, kfree(bounce_buf), and
+ * ieee80211_tx_status_irqsafe for each completed packet.  These are the
+ * expensive operations that previously held priv->lock.
+ *
+ * @param irq Linux IRQ number.
+ * @param dev_id ieee80211_hw pointer.
+ * @return IRQ_HANDLED always.
+ */
+static irqreturn_t openwifi_tx_interrupt(int irq, void *dev_id)
+{
+  struct ieee80211_hw *dev = dev_id;
+  struct openwifi_priv *priv = dev->priv;
+  struct openwifi_ring *ring, *drv_ring_tmp;
+  struct sk_buff *skb;
+  struct ieee80211_tx_info *info;
+  struct ieee80211_hdr *hdr;
+  u32 reg_val1, hw_queue_len, reg_val2, dma_fifo_no_room_flag, num_slot_random, cw, loop_count = 0, addr1_low32, mcs_for_sysfs;
+  u16 seq_no, pkt_cnt, blk_ack_ssn;
+  u16 addr1_high16;
+  u8 nof_retx = -1, last_bd_rd_idx, i, prio, queue_idx, nof_retx_stat;
+  u8 ampdu_ack_len = 0, tx_resp_class = 0;
+  u64 blk_ack_bitmap;
+  bool tx_fail = false, fpga_queue_has_room = false;
+  bool use_ht_aggr, pkt_need_ack, use_ht_rate, report_ampdu_status, tx_ack_received, tx_blockack_received;
+  int idx_hw_queue;
+  /* Phase TX-B deferred work lists. */
+  struct ow_tx_done_entry tx_done[OW_TX_DONE_BUDGET];
+  u32 n_done = 0;
+  /* Deferred queue wake masks — populated under lock, applied after unlock.
+   * NOTE: keeps ieee80211_wake_queue() outside priv->lock to reduce lock
+   * hold time in the TX interrupt hot path. */
+  u8 wake_masks[MAX_NUM_HW_QUEUE];
+
+  memset(wake_masks, 0, sizeof(wake_masks));
+
+  spin_lock(&priv->lock);
+
+  /* Drain all TX completions currently reported by FPGA. */
+  for (;;) {
+    reg_val1 = tx_intf_api->TX_INTF_REG_PKT_INFO1_read();
+    /* tx_status_fifo writes INFO1..4 together and only this IRQ path pops
+     * them at runtime. INFO1 empty is therefore the tuple-valid gate; do not
+     * consume INFO2..4 when INFO1 reports the sentinel. */
+    if (reg_val1 == OW_TX_BA_REG_INVALID) {
+      break;
+    }
+    reg_val2 = tx_intf_api->TX_INTF_REG_PKT_INFO2_read();
+    blk_ack_bitmap = (tx_intf_api->TX_INTF_REG_PKT_INFO3_read()
+      | ((u64)tx_intf_api->TX_INTF_REG_PKT_INFO4_read() << 32));
+
+    WRITE_ONCE(priv->tx_pkt_info_last[0], reg_val1);
+    WRITE_ONCE(priv->tx_pkt_info_last[1], reg_val2);
+    WRITE_ONCE(priv->tx_pkt_info_last[2], (u32)blk_ack_bitmap);
+    WRITE_ONCE(priv->tx_pkt_info_last[3], (u32)(blk_ack_bitmap >> 32));
+    WRITE_ONCE(priv->tx_pkt_info_last_valid, true);
+
+    nof_retx = (reg_val1 & OW_TX_PKT_INFO1_RETX_MASK);
+    last_bd_rd_idx = ((reg_val1 >> OW_TX_PKT_INFO1_LAST_BD_SHIFT) & (NUM_TX_BD - 1));
+    prio = ((reg_val1 >> OW_TX_PKT_INFO1_PRIO_SHIFT) & OW_TX_PKT_INFO1_PRIO_MASK);
+    num_slot_random = ((reg_val1 >> OW_TX_PKT_INFO1_NUM_SLOT_SHIFT) & OW_TX_PKT_INFO1_NUM_SLOT_MASK);
+    cw = ((reg_val1 >> OW_TX_PKT_INFO1_CW_SHIFT) & OW_TX_PKT_INFO1_CW_MASK);
+    if (cw > OW_TX_CW_MAX) {
+      cw = OW_TX_CW_MAX;
+      num_slot_random += OW_TX_CW_SLOT_OFFSET;
+    }
+    pkt_cnt = (reg_val2 & OW_TX_PKT_INFO2_PKT_CNT_MASK);
+    blk_ack_ssn = ((reg_val2 >> OW_TX_PKT_INFO2_BA_SSN_SHIFT) & OW_TX_BA_SSN_MASK);
+    tx_resp_class = ((reg_val2 >> OW_TX_PKT_INFO2_RESP_CLASS_SHIFT) & OW_TX_PKT_INFO2_RESP_CLASS_MASK);
+
+    queue_idx = ((reg_val1 >> OW_TX_PKT_INFO1_QUEUE_SHIFT) & (MAX_NUM_HW_QUEUE - 1));
+    dma_fifo_no_room_flag = tx_intf_api->TX_INTF_REG_S_AXIS_FIFO_NO_ROOM_read();
+    hw_queue_len = tx_intf_api->TX_INTF_REG_QUEUE_FIFO_DATA_COUNT_read();
+
+    /* TX interrupt proves DMA channel alive: fires only after phy_tx_done
+     * (RTL: tx_interrupt_selection.v + tx_control.v), meaning data traversed
+     * the full TX pipeline. Clear stall and wake all stopped queues so the
+     * recovery worker doesn't need to do it.
+     * Skip if terminating: the worker is mid-terminate_sync and owns
+     * cleanup. The channel state is indeterminate during terminate --
+     * let the worker finish rather than racing it. */
+    if (READ_ONCE(priv->tx_dma_stalled) && !READ_ONCE(priv->tx_dma_terminating)) {
+      WRITE_ONCE(priv->tx_dma_stalled, false);
+      OW_U32_INC(priv->stat.tx_dma_stall_clear_count);
+      WRITE_ONCE(priv->tx_dma_stall_recovery_cycles, 0);
+      WRITE_ONCE(priv->tx_dma_stall_window_count, 0);
+      WRITE_ONCE(priv->tx_dma_stall_first_jiffies, 0);
+      for (idx_hw_queue = 0; idx_hw_queue < MAX_NUM_HW_QUEUE; idx_hw_queue++) {
+        if (priv->tx_ring[idx_hw_queue].stop_prio_mask != 0U) {
+          wake_masks[idx_hw_queue] |= ow_tx_ring_clear_stopped(&priv->tx_ring[idx_hw_queue]);
+        }
+      }
+    }
+
+    /* Wake all Linux priorities currently stopped on the completed queue when room returns.
+     * This avoids starvation when multiple priorities map into one ring. */
+    drv_ring_tmp = &(priv->tx_ring[queue_idx]);
+    if (drv_ring_tmp->stop_prio_mask != 0U) {
+      u8 stop_mask_snapshot = drv_ring_tmp->stop_prio_mask;
+      u32 hw_count = (hw_queue_len >> (queue_idx * OW_TX_HW_QUEUE_LEN_STRIDE_BITS)) & OW_TX_HW_QUEUE_LEN_MASK;
+      u32 queue_avail = (hw_count >= NUM_TX_BD) ? 0 : (NUM_TX_BD - hw_count);
+
+      fpga_queue_has_room = ((((dma_fifo_no_room_flag >> queue_idx) & 1) == 0) && queue_avail >= RING_ROOM_THRESHOLD);
+
+      if (priv->drv_tx_reg_val[DRV_TX_REG_IDX_PRINT_CFG] & DMESG_LOG_NORMAL_QUEUE_STOP) {
+        printk("%s openwifi_tx_interrupt: WARNING wake-check queue%d no room flag%x hwq len%08x wr%d rd%d stop_mask=0x%02x\n",
+          sdr_compatible_str, queue_idx, dma_fifo_no_room_flag, hw_queue_len, drv_ring_tmp->bd_wr_idx,
+          last_bd_rd_idx, stop_mask_snapshot);
+      }
+
+      if (fpga_queue_has_room) {
+        if (priv->stat.stat_enable) {
+          for (i = 0; i < MAX_NUM_SW_QUEUE; i++) {
+            if ((stop_mask_snapshot & BIT(i)) != 0U) {
+              priv->stat.tx_prio_wakeup_num[i]++;
+            }
+          }
+          priv->stat.tx_queue_wakeup_num[queue_idx]++;
+        }
+        wake_masks[queue_idx] |= ow_tx_ring_clear_stopped(drv_ring_tmp);
+      } else {
+        if (priv->drv_tx_reg_val[DRV_TX_REG_IDX_PRINT_CFG] & DMESG_LOG_NORMAL_QUEUE_STOP) {
+          printk("%s openwifi_tx_interrupt: WARNING queue%d still no room, stop_mask=0x%02x\n",
+            sdr_compatible_str, queue_idx, stop_mask_snapshot);
+        }
+      }
+    }
+
+    if (priv->stat.stat_enable) {
+      priv->stat.tx_prio_interrupt_num[prio] = priv->stat.tx_prio_interrupt_num[prio] + pkt_cnt;
+      priv->stat.tx_queue_interrupt_num[queue_idx] = priv->stat.tx_queue_interrupt_num[queue_idx] + pkt_cnt;
+    }
+
+    ring = &(priv->tx_ring[queue_idx]);
+    for (i = 1; i <= pkt_cnt; i++) {
+      ring->bd_rd_idx = (last_bd_rd_idx + i - pkt_cnt + NUM_TX_BD) % NUM_TX_BD;
+      seq_no = ring->bds[ring->bd_rd_idx].seq_no;
+
+        if (seq_no == OPENWIFI_TX_SEQ_INVALID) { /* cleared by openwifi_tx on out-of-order TX handling */
+          printk("%s openwifi_tx_interrupt: WARNING wr%d rd%d last_bd_rd_idx%d i%d pkt_cnt%d prio%d fpga q%d hwq len%d bd prio%d len_mpdu%d seq_no%d skb_linked%p dma_mapping_addr=%pad\n", sdr_compatible_str,
+          ring->bd_wr_idx, ring->bd_rd_idx, last_bd_rd_idx, i, pkt_cnt, prio, queue_idx, hw_queue_len, ring->bds[ring->bd_rd_idx].prio, ring->bds[ring->bd_rd_idx].len_mpdu, seq_no, ring->bds[ring->bd_rd_idx].skb_linked, &ring->bds[ring->bd_rd_idx].dma_mapping_addr);
+          continue;
+        }
+
+        skb = ring->bds[ring->bd_rd_idx].skb_linked;
+
+        /* Snapshot DMA info for Phase TX-B (unlocked unmap/free/status). */
+        if (n_done < OW_TX_DONE_BUDGET) {
+          tx_done[n_done].skb        = skb;
+          tx_done[n_done].dma_addr   = ring->bds[ring->bd_rd_idx].dma_mapping_addr;
+          tx_done[n_done].dma_len_bytes = ring->bds[ring->bd_rd_idx].dma_len_bytes;
+          tx_done[n_done].bounce_buf = ring->bds[ring->bd_rd_idx].bounce_buf;
+        }
+
+        info = IEEE80211_SKB_CB(skb);
+        use_ht_aggr = ((info->flags&IEEE80211_TX_CTL_AMPDU)!=0);
+        pkt_need_ack = (!(info->flags & IEEE80211_TX_CTL_NO_ACK));
+        ow_tx_restore_skb_for_status(skb, ring->bds[ring->bd_rd_idx].len_mpdu, use_ht_aggr);
+        /* ieee80211_tx_info_clear_status() clears rates[].count and zeros
+         * everything from ampdu_ack_len onwards, but PRESERVES rates[].idx
+         * and rates[].flags (they share memory with control.rates[] via union).
+         * We overwrite rates[0] with actual_tx_rate below to give minstrel
+         * correct feedback when the driver overrode the mac80211 selection. */
+        ieee80211_tx_info_clear_status(info);
+
+        /* Aggregation packet. */
+        report_ampdu_status = ow_tx_is_ampdu_status_owner(use_ht_aggr, i);
+        tx_ack_received = (tx_resp_class == OW_TX_RESP_CLASS_ACK);
+        tx_blockack_received = (tx_resp_class == OW_TX_RESP_CLASS_BLOCKACK);
+        if (use_ht_aggr) {
+          ampdu_ack_len = 0;
+          if (pkt_need_ack && tx_blockack_received) {
+            tx_fail = !ow_tx_mpdu_acked_by_ba(seq_no, blk_ack_ssn, blk_ack_bitmap);
+          } else if (pkt_need_ack) {
+            tx_fail = true;
+          } else {
+            tx_fail = false;
+          }
+          if (report_ampdu_status) {
+            if (pkt_need_ack && tx_blockack_received) {
+              ampdu_ack_len = ow_tx_count_acked_ampdu_subframes(ring, last_bd_rd_idx, pkt_cnt,
+                blk_ack_ssn, blk_ack_bitmap);
+            }
+            ow_tx_set_ampdu_status_fields(info, pkt_cnt, ampdu_ack_len, pkt_need_ack, tx_resp_class);
+            if (pkt_need_ack && priv->stat.stat_enable) {
+              if (tx_blockack_received) {
+                if (ampdu_ack_len == 0) {
+                  OW_U32_INC(priv->stat.tx_ampdu_ba_zero_bitmap_count);
+                } else {
+                  OW_U32_INC(priv->stat.tx_ampdu_ba_nonzero_bitmap_count);
+                }
+              } else if (tx_ack_received) {
+                /* Legacy debug-only counter: current maintained RTL should
+                 * keep this at zero because aggregate completion is expected
+                 * to surface as BLOCKACK or NONE, not ACK. */
+                OW_U32_INC(priv->stat.tx_ampdu_unexpected_ack_count);
+              } else {
+                OW_U32_INC(priv->stat.tx_ampdu_no_ba_count);
+              }
+            }
+          }
+        }
+        /* Normal packet. */
+        else {
+          tx_fail = pkt_need_ack ? (!tx_ack_received) : false;
+          info->flags &= (~IEEE80211_TX_CTL_AMPDU);
+        }
+        /* Update TX statistics for packets that require ACK. */
+        hdr = (struct ieee80211_hdr *)skb->data;
+        ow_tx_get_mac_parts(hdr->addr1, &addr1_high16, &addr1_low32);
+        if (priv->stat.stat_enable && pkt_need_ack
+            && ow_tx_sender_filter_match(addr1_high16, addr1_low32, priv->stat.rx_target_sender_mac_addr_high16,
+              priv->stat.rx_target_sender_mac_addr)) {
+          use_ht_rate = ((ring->bds[ring->bd_rd_idx].actual_tx_rate.flags & IEEE80211_TX_RC_MCS) != 0);
+          mcs_for_sysfs = (u32)(u8)ring->bds[ring->bd_rd_idx].actual_tx_rate.idx;
+          if (use_ht_rate) {
+            mcs_for_sysfs = (mcs_for_sysfs | OW_TX_MCS_SYSFS_HT_FLAG);
+          }
+
+          if (ieee80211_is_data(hdr->frame_control)) {
+            nof_retx_stat = (nof_retx <= OW_TX_DATA_RETRY_MAX_IDX ? nof_retx : OW_TX_DATA_RETRY_MAX_IDX);
+
+            priv->stat.tx_data_pkt_need_ack_num_total++;
+            priv->stat.tx_data_pkt_mcs_realtime = mcs_for_sysfs;
+            priv->stat.tx_data_pkt_need_ack_num_retx[nof_retx_stat]++;
+            if (tx_fail) {
+              priv->stat.tx_data_pkt_need_ack_num_total_fail++;
+              priv->stat.tx_data_pkt_fail_mcs_realtime = mcs_for_sysfs;
+              priv->stat.tx_data_pkt_need_ack_num_retx_fail[nof_retx_stat]++;
+            }
+          } else if (ieee80211_is_mgmt(hdr->frame_control)) {
+            nof_retx_stat = (nof_retx <= OW_TX_MGMT_RETRY_MAX_IDX ? nof_retx : OW_TX_MGMT_RETRY_MAX_IDX);
+
+            priv->stat.tx_mgmt_pkt_need_ack_num_total++;
+            priv->stat.tx_mgmt_pkt_mcs_realtime = mcs_for_sysfs;
+            priv->stat.tx_mgmt_pkt_need_ack_num_retx[nof_retx_stat]++;
+            if (tx_fail) {
+              priv->stat.tx_mgmt_pkt_need_ack_num_total_fail++;
+              priv->stat.tx_mgmt_pkt_fail_mcs_realtime = mcs_for_sysfs;
+              priv->stat.tx_mgmt_pkt_need_ack_num_retx_fail[nof_retx_stat]++;
+            }
+          }
+        }
+
+        if (pkt_need_ack && !tx_fail) {
+          info->flags |= IEEE80211_TX_STAT_ACK;
+        } else if (!pkt_need_ack && !tx_fail) {
+          info->flags |= IEEE80211_TX_STAT_NOACK_TRANSMITTED;
+        }
+
+        /* Write back actual transmitted rate so minstrel receives correct
+         * feedback when the driver overrode the mac80211-selected rate
+         * (sysfs override or FPGA MCS0->MCS1 workaround). */
+        info->status.rates[0] = ring->bds[ring->bd_rd_idx].actual_tx_rate;
+        info->status.rates[0].count = nof_retx + 1;
+        info->status.rates[1].idx = -1;
+        info->status.antenna = priv->runtime_tx_ant_cfg;
+
+        if (((!pkt_need_ack) && (priv->drv_tx_reg_val[DRV_TX_REG_IDX_PRINT_CFG] & DMESG_LOG_BROADCAST))
+            || ((pkt_need_ack) && (priv->drv_tx_reg_val[DRV_TX_REG_IDX_PRINT_CFG] & DMESG_LOG_UNICAST))) {
+          printk("%s openwifi_tx_interrupt: tx_result [nof_retx %d pass %d] SC%d prio%d q%d wr%d rd%d num_slot%d cw%d hwq len%08x no_room_flag%x\n", sdr_compatible_str,
+            nof_retx + 1, !tx_fail, seq_no, prio, queue_idx, ring->bd_wr_idx, ring->bd_rd_idx, num_slot_random, cw, hw_queue_len, dma_fifo_no_room_flag);
+        }
+
+        /* Defer ieee80211_tx_status_irqsafe to Phase TX-B (unlocked). */
+        if (n_done < OW_TX_DONE_BUDGET) {
+          n_done++;
+        } else {
+          /* Budget exceeded — fall back to inline completion under lock.
+           * The budget is sized so one full aggregate completion fits in the
+           * deferred array under the maintained one-aggregate-at-a-time TX
+           * path. On Zynq SMP, calling ieee80211_tx_status_irqsafe under
+           * priv->lock is still a latent lock-ordering concern if mac80211 ever
+           * calls back into the driver while processing the status queue.
+           * TODO(openwifi-tx-budget-overflow-smp): if this path ever fires on
+           * SMP, expand tx_done[] to a resizable list or chunk-drain. */
+          if (ring->bds[ring->bd_rd_idx].dma_mapping_addr != 0
+              && ring->bds[ring->bd_rd_idx].dma_len_bytes != 0) {
+            dma_unmap_single(priv->tx_chan->device->dev,
+              ring->bds[ring->bd_rd_idx].dma_mapping_addr,
+              ring->bds[ring->bd_rd_idx].dma_len_bytes, DMA_MEM_TO_DEV);
+          }
+          kfree(ring->bds[ring->bd_rd_idx].bounce_buf);
+          ieee80211_tx_status_irqsafe(dev, skb);
+        }
+
+        ring->bds[ring->bd_rd_idx].prio = OPENWIFI_TX_PRIO_INVALID;
+        ring->bds[ring->bd_rd_idx].len_mpdu = 0; /* invalid marker */
+        ring->bds[ring->bd_rd_idx].seq_no = OPENWIFI_TX_SEQ_INVALID;
+        ring->bds[ring->bd_rd_idx].skb_linked = NULL;
+        ring->bds[ring->bd_rd_idx].actual_tx_rate.idx = -1;
+        ring->bds[ring->bd_rd_idx].bounce_buf = NULL;
+        ring->bds[ring->bd_rd_idx].dma_mapping_addr = 0;
+        ring->bds[ring->bd_rd_idx].dma_len_bytes = 0;
+      }
+
+    loop_count++;
+  }
+  if (loop_count != 1 && ((priv->drv_tx_reg_val[DRV_TX_REG_IDX_PRINT_CFG]) & DMESG_LOG_ERROR)) {
+    printk("%s openwifi_tx_interrupt: WARNING loop_count %d\n", sdr_compatible_str, loop_count);
+  }
+
+  spin_unlock(&priv->lock);
+
+  /* =================================================================
+   * Phase TX-B: unlocked — queue wakes, DMA unmap, free bounce buf, mac80211 TX status.
+   * ================================================================= */
+
+  /* Deferred queue wakes — decided under lock, executed here. */
+  for (idx_hw_queue = 0; idx_hw_queue < MAX_NUM_HW_QUEUE; idx_hw_queue++) {
+    if (wake_masks[idx_hw_queue] != 0U) {
+      ow_tx_wake_from_mask(dev, wake_masks[idx_hw_queue]);
+    }
+  }
+
+  for (i = 0; i < n_done; i++) {
+    dma_unmap_single(priv->tx_chan->device->dev,
+      tx_done[i].dma_addr, tx_done[i].dma_len_bytes, DMA_MEM_TO_DEV);
+    kfree(tx_done[i].bounce_buf);
+    ieee80211_tx_status_irqsafe(dev, tx_done[i].skb);
+  }
+
+  return IRQ_HANDLED;
+}
+
+//=============================================================================
+// TX Packet Construction Helpers
+//=============================================================================
+
+/**
+ * @brief Lookup table for MPDU CRC nibble-based update.
+ */
+static const u32 crc_table[16] = {
+  0x4DBDF21C, 0x500AE278, 0x76D3D2D4, 0x6B64C2B0,
+  0x3B61B38C, 0x26D6A3E8, 0x000F9344, 0x1DB88320,
+  0xA005713C, 0xBDB26158, 0x9B6B51F4, 0x86DC4190,
+  0xD6D930AC, 0xCB6E20C8, 0xEDB71064, 0xF0000000
+};
+
+/**
+ * @brief Compute MPDU CRC over payload bytes.
+ *
+ * @param data_in Pointer to payload bytes.
+ * @param num_bytes Number of payload bytes.
+ * @return CRC32 value used by TX path.
+ */
+u32 gen_mpdu_crc(u8 *data_in, u32 num_bytes)
+{
+  u32 i, crc = 0;
+  u8 idx;
+  for (i = 0; i < num_bytes; i++) {
+    idx = (crc & 0x0F) ^ (data_in[i] & 0x0F);
+    crc = (crc >> 4) ^ crc_table[idx];
+
+    idx = (crc & 0x0F) ^ ((data_in[i] >> 4) & 0x0F);
+    crc = (crc >> 4) ^ crc_table[idx];
+  }
+
+  return crc;
+}
+
+/**
+ * @brief Compute 8-bit MPDU delimiter CRC from delimiter word.
+ *
+ * @param m 16-bit delimiter input.
+ * @return Delimiter CRC byte.
+ */
+u8 gen_mpdu_delim_crc(u16 m)
+{
+  u8 i, temp, c[8] = {1, 1, 1, 1, 1, 1, 1, 1}, mpdu_delim_crc;
+
+  for (i = 0; i < 16; i++) {
+    temp = c[7] ^ ((m >> i) & 0x01);
+
+    c[7] = c[6];
+    c[6] = c[5];
+    c[5] = c[4];
+    c[4] = c[3];
+    c[3] = c[2];
+    c[2] = c[1] ^ temp;
+    c[1] = c[0] ^ temp;
+    c[0] = temp;
+  }
+  mpdu_delim_crc = ((~c[7] & 0x01) << 0) | ((~c[6] & 0x01) << 1) | ((~c[5] & 0x01) << 2) | ((~c[4] & 0x01) << 3) | ((~c[3] & 0x01) << 4) | ((~c[2] & 0x01) << 5) | ((~c[1] & 0x01) << 6) | ((~c[0] & 0x01) << 7);
+
+  return mpdu_delim_crc;
+}
+
+/**
+ * @brief Compute number of OFDM symbols for a given payload and coding rate.
+ *
+ * @param num_octet Payload size in octets.
+ * @param n_dbps Data bits per OFDM symbol.
+ * @return Number of OFDM symbols.
+ */
+inline int calc_n_ofdm(int num_octet, int n_dbps)
+{
+  int num_bit, num_ofdm_sym;
+
+  num_bit      = 22+num_octet*8;
+  num_ofdm_sym = (num_bit/n_dbps) + ((num_bit%n_dbps)!=0);
+
+  return (num_ofdm_sym);
+}
+
+/**
+ * @brief Generate HT duration/id field for QoS data and PS-Poll frames.
+ *
+ * @param frame_control IEEE802.11 frame control field.
+ * @param aid Association ID for PS-Poll encoding.
+ * @param qos_hdr QoS control byte.
+ * @param use_ht_aggr True when frame is aggregated.
+ * @param rate_hw_value Hardware rate index.
+ * @param sifs SIFS duration in microseconds.
+ * @return Computed duration/id value.
+ */
+inline __le16 gen_ht_duration_id(__le16 frame_control, __le16 aid, u8 qos_hdr, bool use_ht_aggr, u8 rate_hw_value, u16 sifs)
+{
+  /*
+   * COTS WiFi captures: duration logic for HT QoS data.
+   * Non-aggregated and aggregated values align with legacy ACK/BA exchange
+   * timing when SIFS and legacy preamble durations are included.
+   */
+
+  __le16 dur = 0;
+  u16 n_dbps;
+  int num_octet, num_ofdm_sym;
+
+  if (ieee80211_is_pspoll(frame_control)) {
+    dur = (aid | OW_TX_PSPOLL_AID_PREFIX);
+  } else if (ieee80211_is_data_qos(frame_control) && !(qos_hdr & IEEE80211_QOS_CTL_ACK_POLICY_NOACK)) {
+    rate_hw_value = (rate_hw_value > OW_TX_RATE_HW_MAX_FOR_ACK ? OW_TX_RATE_HW_MAX_FOR_ACK : rate_hw_value);
+    n_dbps = (rate_hw_value == 0 ? wifi_n_dbps_table[OW_TX_N_DBPS_MIN_IDX] : wifi_n_dbps_table[rate_hw_value + OW_TX_N_DBPS_BASE_IDX]);
+    num_octet = (use_ht_aggr ? OW_TX_BA_LEN_BYTES : OW_TX_ACK_LEN_BYTES);
+    num_ofdm_sym = calc_n_ofdm(num_octet, n_dbps);
+    dur = sifs + OW_TX_LEGACY_PREAMBLE_US + OW_TX_OFDM_SYMBOL_US * num_ofdm_sym;
+  } else {
+    printk_ratelimited("%s openwifi_tx: WARNING gen_ht_duration_id wrong pkt type!\n", sdr_compatible_str);
+  }
+
+  return dur;
+}
+
+/**
+ * @brief Restore skb to original MPDU layout before TX status reporting.
+ *
+ * TX DMA preparation may prepend an MPDU delimiter and append CRC/padding.
+ * mac80211 TX status consumers expect original 802.11 MPDU header/payload.
+ *
+ * @param skb Packet buffer to normalize.
+ * @param len_mpdu Original MPDU length in bytes.
+ * @param use_ht_aggr True when an MPDU delimiter was prepended.
+ */
+static inline void ow_tx_restore_skb_for_status(struct sk_buff *skb, u16 len_mpdu, bool use_ht_aggr)
+{
+  if (!skb || len_mpdu == 0U) {
+    return;
+  }
+  if (use_ht_aggr && skb->len >= (len_mpdu + LEN_MPDU_DELIM)) {
+    skb_pull(skb, LEN_MPDU_DELIM);
+  }
+  if (skb->len > len_mpdu) {
+    skb_trim(skb, len_mpdu);
+  }
+}
+
+/**
+ * @brief Report TX drop to mac80211 status path as driver-side failure.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param skb Packet that was dropped before hardware completion.
+ * @param len_mpdu Original MPDU length in bytes.
+ */
+static inline void report_pkt_loss_due_to_driver_drop(struct ieee80211_hw *dev, struct sk_buff *skb, u16 len_mpdu)
+{
+  struct openwifi_priv *priv = dev->priv;
+  struct ieee80211_tx_info *info;
+
+  info = IEEE80211_SKB_CB(skb);
+  ow_tx_restore_skb_for_status(skb, len_mpdu, ((info->flags & IEEE80211_TX_CTL_AMPDU) != 0));
+  ieee80211_tx_info_clear_status(info);
+  info->status.rates[0].count = 1;
+  info->status.rates[1].idx = -1;
+  info->status.antenna = priv->runtime_tx_ant_cfg;
+  ieee80211_tx_status_irqsafe(dev, skb);
+}
+
+//=============================================================================
+// TX Submission Path
+//=============================================================================
+
+/**
+ * @brief Main TX submission callback from mac80211.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param control TX control metadata (may be NULL).
+ * @param skb Packet to transmit.
+ */
+static void openwifi_tx(struct ieee80211_hw *dev, struct ieee80211_tx_control *control, struct sk_buff *skb)
+{
+  struct openwifi_priv *priv = dev->priv;
+  unsigned long flags;
+  struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+  struct ieee80211_rate *tx_rate;
+  struct ieee80211_rate *cts_rate;
+  struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+  struct openwifi_ring *ring = NULL;
+  struct sk_buff *skb_new; /* temporary skb for local buffer expansion paths */
+  dma_addr_t dma_mapping_addr;
+  unsigned int i, j, empty_bd_idx = 0;
+  u16 rate_signal_value, len_mpdu = 0, len_psdu, num_dma_symbol, len_mpdu_delim_pad = 0, num_byte_pad;
+  u16 mpdu_delim_header;
+  u32 num_dma_byte, addr1_low32, addr2_low32 = 0, addr3_low32 = 0, tx_config, cts_reg = 0, phy_hdr_config;
+  u16 addr1_high16, addr2_high16 = 0, addr3_high16 = 0, sc, seq_no = 0, cts_duration = 0, sifs;
+  u8 cts_rate_hw_value = 0, cts_rate_signal_value = 0, rate_hw_value, pkt_need_ack, retry_limit_raw, use_short_gi, *dma_buf, retry_limit_hw_value, qos_hdr, qos_tid, prio, queue_idx, drv_ring_idx;
+  u16 rc_flags; /* u16 not u8: ieee80211_tx_rate.flags is 11 bits */
+  bool drv_seqno = false, use_rts_cts = false, use_cts_protect = false, ht_aggr_start = false, use_ht_rate = false, use_ht_aggr = false, cts_use_traffic_rate = false;
+  __le16 frame_control, duration_id;
+  u32 dma_fifo_no_room_flag, hw_queue_len, delay_count = 0;
+  u16 aid = 0;
+  enum dma_status status;
+  dma_cookie_t cookie_snapshot;
+  int max_polls;
+  void *bounce_buf = NULL; /* aligned DMA bounce buffer when source is unaligned */
+  bool tx_submit_locked = false;
+  struct ow_tx_aggr_key aggr_key;
+
+  len_mpdu = skb->len;
+
+  if (skb->data_len > 0) { /* non-linear payload is unsupported on this TX path */
+    printk_ratelimited("%s openwifi_tx: WARNING skb->data_len>0\n", sdr_compatible_str);
+    goto openwifi_tx_early_out;
+  }
+
+  /* Get Linux priority/queue and destination MAC address. */
+  prio = skb_get_queue_mapping(skb);
+  if (prio >= MAX_NUM_HW_QUEUE) {
+    printk_ratelimited("%s openwifi_tx: WARNING prio%d\n", sdr_compatible_str, prio);
+    goto openwifi_tx_early_out;
+  }
+
+  ow_tx_get_mac_parts(hdr->addr1, &addr1_high16, &addr1_low32);
+
+  /* Map Linux priority to driver ring index (1:1 by default). */
+  if (priv->slice_idx == OW_SLICE_IDX_INVALID) { /* no slice map configured */
+    drv_ring_idx = prio;
+  } else { /* custom destination-MAC to queue mapping */
+    for (i = 0; i < MAX_NUM_HW_QUEUE; i++) {
+      if (priv->dest_mac_addr_queue_map[i] == addr1_low32) {
+        break;
