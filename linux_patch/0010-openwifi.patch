+/**
+ * @brief Program the BSSID filter register pair.
+ *
+ * The XPU uses the same low/high split-register packing convention for BSSID
+ * filter state as it does for the local MAC address and active RX BA peer.
+ *
+ * @param bssid BSSID value to program, or NULL to clear the filter registers.
+ */
+static inline void XPU_REG_BSSID_FILTER_ADDR_write(const u8 *bssid)
+{
+  u32 bssid_low32 = 0;
+  u32 bssid_high16 = 0;
+
+  if (bssid) {
+    bssid_low32 = ((u32)bssid[0])
+      | ((u32)bssid[1] << 8)
+      | ((u32)bssid[2] << 16)
+      | ((u32)bssid[3] << 24);
+    bssid_high16 = ((u32)bssid[4]) | ((u32)bssid[5] << 8);
+  }
+
+  XPU_REG_BSSID_FILTER_LOW_write(bssid_low32);
+  XPU_REG_BSSID_FILTER_HIGH_write(bssid_high16);
+}
+
+/**
+ * @brief Program the one active RX BA peer MAC address.
+ *
+ * The current XPU RX BlockAck contract is single-session. RTL compares BAR
+ * and A-MPDU sender address2 against this programmed peer while the session
+ * in `XPU_REG_AMPDU_ACTION` is enabled for the matching TID/SSN window.
+ *
+ * @param peer_addr Peer MAC address, or NULL to clear the peer match.
+ */
+static inline void XPU_REG_AMPDU_RX_PEER_ADDR_write(const u8 *peer_addr)
+{
+  u32 peer_low32 = 0;
+  u32 peer_high16 = 0;
+
+  if (peer_addr) {
+    peer_low32 = ((u32)peer_addr[0])
+      | ((u32)peer_addr[1] << 8)
+      | ((u32)peer_addr[2] << 16)
+      | ((u32)peer_addr[3] << 24);
+    peer_high16 = ((u32)peer_addr[4]) | ((u32)peer_addr[5] << 8);
+  }
+
+  XPU_REG_AMPDU_RX_PEER_LOW_write(peer_low32);
+  XPU_REG_AMPDU_RX_PEER_HIGH_write(peer_high16);
+}
