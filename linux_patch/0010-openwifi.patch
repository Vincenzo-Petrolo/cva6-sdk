diff --git a/drivers/sdr_mac_ops.c b/drivers/sdr_mac_ops.c
new file mode 100644
index 0000000..2479244
--- /dev/null
+++ b/drivers/sdr_mac_ops.c
@@ -0,0 +1,868 @@
+/**
+ * @file sdr_mac_ops.c
+ * @brief mac80211 operation callbacks for the OpenWiFi SDR driver.
+ *
+ * Included only by sdr.c (single translation unit split).
+ *
+ * Policy notes:
+ * - TX AMPDU stays enabled, but RX BA remains a one-session peer/TID model.
+ * - RX BA lifecycle teardown is centralized so start/stop/disassoc/restart do
+ *   not drift apart over time.
+ * - Safe WMM defaults are still programmed at startup, and queue parameters
+ *   are still sourced from mac80211 after association. The current RTL then
+ *   arbitrates on the selected tx_queue_idx path rather than four fully
+ *   independent contending hardware ACs.
+ * - The old all-BE-to-WMM rewrite is now an explicit opt-in workaround, not
+ *   an always-on policy.
+ */
+
+//=============================================================================
+// TSF and Timing Callbacks
+//=============================================================================
+
+#define OW_TSF_HIGH_SHIFT_BITS               32U
+#define OW_TSF_WORD_MASK_U32                 0xFFFFFFFFU
+#define OW_TSF_RESET_VAL_U32                 0U
+#define OW_BEACON_QUEUE_ID                   0
+#define OW_TU_US                             1024U
+#define OW_FILTER_MONITOR_FLAGS_MASK         (FIF_BCN_PRBRESP_PROMISC | \
+                                              FIF_CONTROL | \
+                                              FIF_OTHER_BSS | \
+                                              FIF_PSPOLL)
+#define OW_AMPDU_BUF_SIZE_MAX                63U
+#define OW_AMPDU_STATUS_SAFE_BUF_SIZE_MAX    OW_TX_DONE_BUDGET
+#define OW_TSF_STABLE_READ_MAX_RETRIES       8U
+
+/**
+ * @brief Cache mac80211-requested EDCA parameters for one access category.
+ *
+ * @param priv Driver private state.
+ * @param queue Queue index in IEEE80211_AC_* order.
+ * @param params Requested queue parameters from mac80211.
+ */
+static void openwifi_cache_edca_params(
+  struct openwifi_priv *priv,
+  u16 queue,
+  const struct ieee80211_tx_queue_params *params)
+{
+  priv->requested_aifs[queue] = params->aifs;
+  priv->requested_txop[queue] = params->txop;
+}
+
+/**
+ * @brief Check whether the VIF type can use the current RX BA session model.
+ *
+ * The maintained hardware contract is still one active peer/TID at a time.
+ * That contract serves STA operation and the current AP test path on both
+ * Zynq and Cheshire. Cheshire AP exposure is intentional for controlled
+ * Wi-Fi-side testing and should not be narrowed away casually; additional RX
+ * BA sessions are still rejected at runtime instead of being hidden behind an
+ * advertised one-station AP cap.
+ *
+ * @param vif Virtual interface for the AMPDU action.
+ * @return True when the VIF type can use RX BA session control.
+ */
+static bool openwifi_vif_supports_rx_ba(const struct ieee80211_vif *vif)
+{
+  if (!vif) {
+    return false;
+  }
+
+  return (vif->type == NL80211_IFTYPE_STATION ||
+    vif->type == NL80211_IFTYPE_AP);
+}
+
+/**
+ * @brief Read current TSF timer value from FPGA registers.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param vif Virtual interface (unused).
+ * @return 64-bit TSF value.
+ */
+static u64 openwifi_get_tsf(struct ieee80211_hw *dev, struct ieee80211_vif *vif)
+{
+  u32 tsft_low, tsft_high_1, tsft_high_2;
+  u32 retry_count;
+  (void)dev;
+  (void)vif;
+
+  /* Use high-low-high sampling to avoid torn 64-bit TSF reads across
+   * low-word rollover on 32-bit register interfaces. */
+  for (retry_count = 0; retry_count < OW_TSF_STABLE_READ_MAX_RETRIES; retry_count++) {
+    tsft_high_1 = xpu_api->XPU_REG_TSF_RUNTIME_VAL_HIGH_read();
+    tsft_low = xpu_api->XPU_REG_TSF_RUNTIME_VAL_LOW_read();
+    tsft_high_2 = xpu_api->XPU_REG_TSF_RUNTIME_VAL_HIGH_read();
+    if (tsft_high_1 == tsft_high_2) {
+      return (((u64)tsft_low) | (((u64)tsft_high_2) << OW_TSF_HIGH_SHIFT_BITS));
+    }
+  }
+
+  printk_ratelimited(KERN_WARNING "%s openwifi_get_tsf: unstable high-word read after %u retries\n",
+    sdr_compatible_str, OW_TSF_STABLE_READ_MAX_RETRIES);
+  return (((u64)tsft_low) | (((u64)tsft_high_2) << OW_TSF_HIGH_SHIFT_BITS));
+}
+
+/**
+ * @brief Program TSF timer value.
+ *
+ * @param hw mac80211 hardware handle.
+ * @param vif Virtual interface (unused).
+ * @param tsf Target TSF value.
+ */
+static void openwifi_set_tsf(struct ieee80211_hw *hw, struct ieee80211_vif *vif, u64 tsf)
+{
+  u32 tsft_high = ((tsf >> OW_TSF_HIGH_SHIFT_BITS) & OW_TSF_WORD_MASK_U32);
+  u32 tsft_low = (tsf & OW_TSF_WORD_MASK_U32);
+  (void)hw;
+  (void)vif;
+
+  xpu_api->XPU_REG_TSF_LOAD_VAL_write(tsft_high, tsft_low);
+  printk("%s openwifi_set_tsf: %08x%08x\n", sdr_compatible_str, tsft_high, tsft_low);
+}
+
+/**
+ * @brief Reset TSF timer to zero.
+ *
+ * @param hw mac80211 hardware handle.
+ * @param vif Virtual interface (unused).
+ */
+static void openwifi_reset_tsf(struct ieee80211_hw *hw, struct ieee80211_vif *vif)
+{
+  (void)hw;
+  (void)vif;
+  xpu_api->XPU_REG_TSF_LOAD_VAL_write(OW_TSF_RESET_VAL_U32, OW_TSF_RESET_VAL_U32);
+  printk("%s openwifi_reset_tsf\n", sdr_compatible_str);
+}
+
+/**
+ * @brief Stub for RTS threshold callback.
+ *
+ * @param hw mac80211 hardware handle.
+ * @param value Requested RTS threshold.
+ * @return 0 because the local mac80211 stack still uses the threshold in its
+ *         per-frame protection decision path even though the maintained FPGA
+ *         path has no extra threshold register and RTS requests currently map
+ *         to CTS-to-self fallback in the TX path.
+ * @note TODO(openwifi-rts-threshold-hw): add a hardware-specific threshold
+ *       register only if the maintained path needs behavior beyond the
+ *       mac80211/software-managed protection decision plus the current
+ *       CTS-to-self fallback.
+ */
+static int openwifi_set_rts_threshold(struct ieee80211_hw *hw, u32 value)
+{
+  (void)hw;
+  printk_ratelimited("%s openwifi_set_rts_threshold value %u (mac80211-managed, RTS requests may map to CTS-to-self)\n",
+    sdr_compatible_str, value);
+  return 0;
+}
+
+//=============================================================================
+// Beacon and Interface Callbacks
+//=============================================================================
+
+/**
+ * @brief Delayed work handler for software beacon transmission.
+ *
+ * @param work Delayed work item.
+ */
+static void openwifi_beacon_work(struct work_struct *work)
+{
+  struct openwifi_vif *vif_priv = container_of(work, struct openwifi_vif, beacon_work.work);
+  struct ieee80211_vif *vif = container_of((void *)vif_priv, struct ieee80211_vif, drv_priv);
+  struct ieee80211_hw *dev = vif_priv->dev;
+  struct ieee80211_mgmt *mgmt;
+  struct sk_buff *skb;
+  u32 beacon_interval_us;
+
+  if (!READ_ONCE(vif_priv->enable_beacon)) {
+    return;
+  }
+  if (ieee80211_queue_stopped(dev, OW_BEACON_QUEUE_ID)) {
+    goto resched;
+  }
+
+  skb = ieee80211_beacon_get(dev, vif);
+  if (!skb) {
+    goto resched;
+  }
+
+  mgmt = (struct ieee80211_mgmt *)skb->data;
+  mgmt->u.beacon.timestamp = cpu_to_le64(openwifi_get_tsf(dev, vif));
+  skb_set_queue_mapping(skb, OW_BEACON_QUEUE_ID);
+  openwifi_tx(dev, NULL, skb);
+
+resched:
+  if (!READ_ONCE(vif_priv->enable_beacon) || vif->bss_conf.beacon_int == 0U) {
+    return;
+  }
+  beacon_interval_us = OW_TU_US * vif->bss_conf.beacon_int;
+  mod_delayed_work(system_wq, &vif_priv->beacon_work, usecs_to_jiffies(beacon_interval_us));
+}
+
+/**
+ * @brief Add a new mac80211 virtual interface.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param vif Virtual interface to add.
+ * @return 0 on success, negative errno on failure.
+ */
+static int openwifi_add_interface(struct ieee80211_hw *dev, struct ieee80211_vif *vif)
+{
+  int idx_vif;
+  struct openwifi_priv *priv = dev->priv;
+  struct openwifi_vif *vif_priv;
+
+  switch (vif->type) {
+  case NL80211_IFTYPE_AP:
+  case NL80211_IFTYPE_STATION:
+  case NL80211_IFTYPE_MONITOR:
+    break;
+  default:
+    return -EOPNOTSUPP;
+  }
+
+  for (idx_vif = 0; idx_vif < MAX_NUM_VIF; idx_vif++) {
+    if (priv->vif[idx_vif] == NULL) {
+      break;
+    }
+  }
+
+  printk("%s openwifi_add_interface start. vif for loop result %d\n", sdr_compatible_str, idx_vif);
+
+  if (idx_vif == MAX_NUM_VIF) {
+    return -EBUSY;
+  }
+  if (idx_vif >= OW_MAX_ACTIVE_VIF) {
+    printk("%s openwifi_add_interface: only %u active VIF supported by current HW register model\n",
+      sdr_compatible_str, OW_MAX_ACTIVE_VIF);
+    return -EBUSY;
+  }
+
+  priv->vif[idx_vif] = vif;
+  vif_priv = (struct openwifi_vif *)&vif->drv_priv;
+  vif_priv->idx = idx_vif;
+  vif_priv->dev = dev;
+  INIT_DELAYED_WORK(&vif_priv->beacon_work, openwifi_beacon_work);
+  vif_priv->enable_beacon = false;
+
+  ether_addr_copy(priv->mac_addr, vif->addr);
+  priv->own_mac_high16 = get_unaligned_le16(priv->mac_addr);
+  priv->own_mac_low32 = get_unaligned_le32(priv->mac_addr + 2);
+  xpu_api->XPU_REG_MAC_ADDR_write(priv->mac_addr);
+
+  /* Add DMA padding tailroom ON TOP of mac80211's encryption reserve.
+   * mac80211 sets needed_tailroom = IEEE80211_ENCRYPT_TAILROOM (18) at netdev
+   * creation. Encryption consumes 8-12B of that before the skb reaches us,
+   * leaving insufficient room for DMA alignment (up to 14B). Using += adds
+   * our requirement without clobbering the encryption reserve.
+   * Symmetric -= in openwifi_remove_interface() prevents accumulation across
+   * ifconfig up/down cycles. The tailroom_added flag makes this idempotent
+   * across ieee80211_reconfig() (HW restart) which calls drv_add_interface
+   * without a prior drv_remove_interface. */
+  if (!vif_priv->tailroom_added) {
+    struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+    if (wdev && wdev->netdev) {
+      wdev->netdev->needed_tailroom += OW_TX_DMA_TAIL_PAD_MAX_BYTES;
+      vif_priv->tailroom_added = true;
+    }
+  }
+
+  printk("%s openwifi_add_interface end with vif idx %d addr %pM\n",
+    sdr_compatible_str, vif_priv->idx, vif->addr);
+
+  return 0;
+}
+
+/**
+ * @brief Remove a mac80211 virtual interface.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param vif Virtual interface to remove.
+ */
+static void openwifi_remove_interface(struct ieee80211_hw *dev, struct ieee80211_vif *vif)
+{
+  struct openwifi_vif *vif_priv;
+  struct openwifi_priv *priv = dev->priv;
+  unsigned long flags;
+
+  vif_priv = (struct openwifi_vif *)&vif->drv_priv;
+  vif_priv->enable_beacon = false;
+  cancel_delayed_work_sync(&vif_priv->beacon_work);
+
+  /* Undo the DMA tailroom increment from openwifi_add_interface(). */
+  if (vif_priv->tailroom_added) {
+    struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+    if (wdev && wdev->netdev &&
+        wdev->netdev->needed_tailroom >= OW_TX_DMA_TAIL_PAD_MAX_BYTES) {
+      wdev->netdev->needed_tailroom -= OW_TX_DMA_TAIL_PAD_MAX_BYTES;
+    }
+    vif_priv->tailroom_added = false;
+  }
+
+  spin_lock_irqsave(&priv->lock, flags);
+  openwifi_reset_rx_ba_session_locked(priv);
+  spin_unlock_irqrestore(&priv->lock, flags);
+  xpu_api->XPU_REG_BSSID_FILTER_ADDR_write(NULL);
+
+  priv->vif[vif_priv->idx] = NULL;
+  printk("%s openwifi_remove_interface vif idx %d\n", sdr_compatible_str, vif_priv->idx);
+}
+
+/**
+ * @brief Clear RX BA state when mac80211 removes a tracked station.
+ *
+ * The one-active-peer RX BA model must not retain stale peer/TID state after a
+ * station disappears, which matters for the preserved AP path as well as STA
+ * reconnect sequencing.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param vif Virtual interface that owned the station.
+ * @param sta Station being removed.
+ * @return 0 after applying the teardown policy.
+ */
+static int openwifi_sta_remove(
+  struct ieee80211_hw *dev,
+  struct ieee80211_vif *vif,
+  struct ieee80211_sta *sta)
+{
+  struct openwifi_priv *priv = dev->priv;
+  unsigned long flags;
+
+  (void)vif;
+
+  if (!sta) {
+    return 0;
+  }
+
+  spin_lock_irqsave(&priv->lock, flags);
+  if (priv->rx_ba_active && ether_addr_equal(priv->rx_ba_peer_addr, sta->addr)) {
+    openwifi_reset_rx_ba_session_locked(priv);
+  }
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  return 0;
+}
+
+//=============================================================================
+// Configuration and Filter Callbacks
+//=============================================================================
+
+/**
+ * @brief Apply mac80211 config changes (primarily channel updates).
+ *
+ * @param dev mac80211 hardware handle.
+ * @param changed Bitmask of changed config fields.
+ * @return 0 always.
+ */
+static int openwifi_config(struct ieee80211_hw *dev, u32 changed)
+{
+  struct openwifi_priv *priv = dev->priv;
+  struct ieee80211_conf *conf = &dev->conf;
+  struct ieee80211_conf channel_conf_tmp;
+  struct ieee80211_channel channel_tmp;
+
+  if (changed & IEEE80211_CONF_CHANGE_CHANNEL) {
+    if (priv->stat.restrict_freq_mhz > 0 &&
+        conf->chandef.chan->center_freq != priv->stat.restrict_freq_mhz) {
+      printk("%s openwifi_config avoid Linux requested freq %dMHz (restrict freq %dMHz)\n", sdr_compatible_str,
+        conf->chandef.chan->center_freq, priv->stat.restrict_freq_mhz);
+
+      channel_conf_tmp = *conf;
+      channel_tmp = *(conf->chandef.chan);
+      channel_conf_tmp.chandef = conf->chandef;
+      channel_conf_tmp.chandef.chan = &channel_tmp;
+      channel_conf_tmp.chandef.chan->center_freq = priv->stat.restrict_freq_mhz;
+      priv->rf->set_chan(dev, &channel_conf_tmp);
+    } else {
+      priv->rf->set_chan(dev, conf);
+    }
+  } else {
+    printk("%s openwifi_config changed flag %08x\n", sdr_compatible_str, changed);
+  }
+
+  return 0;
+}
+
+/**
+ * @brief Handle BSS parameter changes from mac80211.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param vif Virtual interface.
+ * @param info New BSS configuration.
+ * @param changed Bitmask of changed fields.
+ */
+static void openwifi_bss_info_changed(
+  struct ieee80211_hw *dev,
+  struct ieee80211_vif *vif,
+  struct ieee80211_bss_conf *info,
+  u32 changed)
+{
+  struct openwifi_priv *priv = dev->priv;
+  struct openwifi_vif *vif_priv;
+  bool new_short_slot;
+  unsigned long flags;
+
+  vif_priv = (struct openwifi_vif *)&vif->drv_priv;
+
+  if (changed & BSS_CHANGED_BSSID) {
+    printk("%s openwifi_bss_info_changed BSS_CHANGED_BSSID %02x%02x%02x%02x%02x%02x\n", sdr_compatible_str,
+      info->bssid[0], info->bssid[1], info->bssid[2], info->bssid[3], info->bssid[4], info->bssid[5]);
+    xpu_api->XPU_REG_BSSID_FILTER_ADDR_write(info->bssid);
+  }
+
+  if (changed & BSS_CHANGED_BEACON_INT) {
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_BEACON_INT %x\n", sdr_compatible_str, info->beacon_int);
+  }
+
+  if (changed & BSS_CHANGED_TXPOWER) {
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_TXPOWER %x\n", sdr_compatible_str, info->txpower);
+  }
+
+  if (changed & BSS_CHANGED_ERP_CTS_PROT) {
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_ERP_CTS_PROT %x\n", sdr_compatible_str, info->use_cts_prot);
+    /* mac80211 already propagates bss_conf.use_cts_prot into the per-frame
+     * TX flags (`IEEE80211_TX_RC_USE_CTS_PROTECT`) via tx.c/rate.c.
+     * Do not cache and blanket-force CTS-to-self here: that would bypass the
+     * per-frame decision and over-apply protection outside the intended ERP
+     * data-rate cases. */
+  }
+
+  if (changed & BSS_CHANGED_BASIC_RATES) {
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_BASIC_RATES %x\n", sdr_compatible_str, info->basic_rates);
+  }
+
+  if (changed & (BSS_CHANGED_ERP_SLOT | BSS_CHANGED_ERP_PREAMBLE)) {
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_ERP_SLOT %d BSS_CHANGED_ERP_PREAMBLE %d short slot %d\n", sdr_compatible_str,
+      changed & BSS_CHANGED_ERP_SLOT, changed & BSS_CHANGED_ERP_PREAMBLE, info->use_short_slot);
+    new_short_slot = !!info->use_short_slot;
+    if (new_short_slot != priv->use_short_slot) {
+      priv->use_short_slot = new_short_slot;
+      xpu_api->XPU_REG_BAND_CHANNEL_write(
+        (priv->use_short_slot << OW_XPU_BAND_CHANNEL_SHORT_SLOT_SHIFT) |
+        (priv->band << OW_XPU_BAND_CHANNEL_BAND_SHIFT) |
+        priv->actual_rx_lo);
+    }
+  }
+
+  if (changed & BSS_CHANGED_BEACON_ENABLED) {
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_BEACON_ENABLED\n", sdr_compatible_str);
+    vif_priv->enable_beacon = info->enable_beacon;
+  }
+
+  if (changed & BSS_CHANGED_ASSOC) {
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_ASSOC assoc %d\n",
+      sdr_compatible_str, info->assoc);
+    if (!info->assoc) {
+      spin_lock_irqsave(&priv->lock, flags);
+      openwifi_reset_rx_ba_session_locked(priv);
+      spin_unlock_irqrestore(&priv->lock, flags);
+      xpu_api->XPU_REG_BSSID_FILTER_ADDR_write(NULL);
+    }
+  }
+
+  if (changed & (BSS_CHANGED_BEACON_ENABLED | BSS_CHANGED_BEACON)) {
+    cancel_delayed_work_sync(&vif_priv->beacon_work);
+    if (vif_priv->enable_beacon) {
+      schedule_delayed_work(&vif_priv->beacon_work, 0);
+      printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed enable_beacon\n", sdr_compatible_str);
+    }
+    printk_ratelimited(KERN_DEBUG "%s openwifi_bss_info_changed BSS_CHANGED_BEACON_ENABLED %d BSS_CHANGED_BEACON %d\n", sdr_compatible_str,
+      changed & BSS_CHANGED_BEACON_ENABLED, changed & BSS_CHANGED_BEACON);
+  }
+}
+
+/**
+ * @brief Configure EDCA TX queue contention parameters.
+ *
+ * @param dev mac80211 hardware handle.
+ * @param vif Virtual interface (unused).
+ * @param queue Queue index.
+ * @param params Requested queue parameters.
+ * @return 0 on success, -EINVAL on invalid queue index.
+ *
+ * Current behavior:
+ * - Applies CW min/max to the hardware CSMA register.
+ * - Applies per-queue raw AIFSN to the hardware AIFS register.
+ * - Caches requested TXOP values for observability but does not program them.
+ *
+ * TXOP remains unsupported in the current FPGA path.
+ *
+ * NOTE(openwifi-aifsn-always):
+ * AIFSN follows mac80211 on every conf_tx() call even when cw_max_min_cfg
+ * overrides CW min/max. The sysfs CW override is therefore not a freeze-all
+ * EDCA mode; it only overrides the CW register packing. Raw AIFSN 0 remains
+ * accepted for the maintained legacy mapping where the RTL treats it as
+ * effective AIFSN 2; values above the 4-bit hardware field are rejected.
+ */
+static int openwifi_conf_tx(
+  struct ieee80211_hw *dev,
+  struct ieee80211_vif *vif,
+  u16 queue,
+  const struct ieee80211_tx_queue_params *params)
+{
+  struct openwifi_priv *priv = dev->priv;
+  u32 reg_val;
+  u32 aifs_reg_val;
+  u8 cw_min_exp;
+  u8 cw_max_exp;
+  u8 raw_aifs;
+  u8 effective_aifs;
+  (void)vif;
+
+  if (queue >= MAX_NUM_HW_QUEUE) {
+    printk("%s openwifi_conf_tx: WARNING queue %d does not exist\n", sdr_compatible_str, queue);
+    return -EINVAL;
+  }
+
+  if (openwifi_validate_aifs_value(params->aifs)) {
+    printk(KERN_WARNING "%s openwifi_conf_tx: reject unsupported AIFSN %u for q%u (VO/VI/BE/BK order); hardware raw field max is %u\n",
+      sdr_compatible_str, params->aifs, queue, OW_CONF_TX_AIFS_FIELD_MASK);
+    return -ERANGE;
+  }
+  raw_aifs = (u8)params->aifs;
+  effective_aifs = openwifi_aifs_raw_to_effective(raw_aifs);
+
+  cw_min_exp = (u8)log2val(params->cw_min + 1);
+  cw_max_exp = (u8)log2val(params->cw_max + 1);
+  if (openwifi_validate_cw_exp_pair(cw_min_exp, cw_max_exp)) {
+    printk(KERN_WARNING "%s openwifi_conf_tx: reject unsupported CW exponents for q%u (VO/VI/BE/BK order): cw_min_exp=%u cw_max_exp=%u\n",
+      sdr_compatible_str, queue, cw_min_exp, cw_max_exp);
+    return -ERANGE;
+  }
+
+  openwifi_cache_edca_params(priv, queue, params);
+  openwifi_cache_cw_pair(priv, queue, cw_min_exp, cw_max_exp);
+
+  aifs_reg_val = openwifi_update_aifs_reg_for_queue(
+    xpu_api->XPU_REG_AIFS_CFG_read(),
+    queue,
+    raw_aifs);
+
+  if (priv->stat.cw_max_min_cfg == 0) {
+    printk("%s openwifi_conf_tx: [queue %d], aifs_raw: %u, aifs_eff: %u, cw_min: %d, cw_max: %d, txop: %d, txop unsupported\n",
+      sdr_compatible_str, queue, raw_aifs, effective_aifs, params->cw_min, params->cw_max, params->txop);
+
+    reg_val = openwifi_update_cw_reg_for_queue(
+      xpu_api->XPU_REG_CSMA_CFG_read(),
+      queue,
+      cw_min_exp,
+      cw_max_exp);
+  } else {
+    reg_val = priv->stat.cw_max_min_cfg;
+    printk("%s openwifi_conf_tx: sysfs CW override active; keeping q0/q1/q2/q3 (VO/VI/BE/BK) override 0x%08x while caching mac80211 request for queue %u\n",
+      sdr_compatible_str,
+      reg_val,
+      queue);
+  }
+
+  xpu_api->XPU_REG_CSMA_CFG_write(reg_val);
+  xpu_api->XPU_REG_AIFS_CFG_write(aifs_reg_val);
+
+  /* Optional all-BE workaround:
+   *
+   * After writing, check if all 4 queues ended up with identical BE CW.
+   * 0xA4A4A4A4 = all queues CW[15,1023]: each byte 0xA4 encodes
+   *   cw_min_exp=4 (CW_min=2^4-1=15), cw_max_exp=0xA=10 (CW_max=2^10-1=1023).
+   * 0xA4A44332 = standard 802.11e WMM defaults:
+   *   VO=0x32 (CW 3-7), VI=0x43 (CW 7-15), BE=0xA4 (CW 15-1023), BK=0xA4.
+   *
+   * All-BE happens when: (a) mac80211 pre-association defaults, (b) non-WMM AP
+   * (intentional by mac80211 — ieee80211_sta_wmm_params only installs real WMM
+   * params when AP advertises WMM IE), or (c) post-deauth reset before WMM IE.
+   *
+   * The default behavior now honors mac80211 exactly after association.
+   * If the old research workaround is still desired for experiments, it can
+   * be re-enabled explicitly with module parameter wmm_force_on_all_be=1. */
+  /* Check for all-BE CW only after the LAST queue (BK=3) is configured.
+   * mac80211 calls conf_tx once per queue sequentially (0,1,2,3).  Checking
+   * after each queue risks triggering on intermediate states where Q0/Q1
+   * are already set to BE but Q2/Q3 haven't been updated yet.
+   *
+   * Use reg_val (not a hardware read-back) because reg_val already contains
+   * the cumulative state of ALL 4 queues: the read-modify-write above reads
+   * the full register (including prior queues' writes), then ORs in this
+   * queue's byte.  After Q3, reg_val = final state of all 4 queues.
+   * MMIO reads over AXI are slow and stall the CPU — avoid when possible.
+   *
+   * Only trigger when: (a) this is queue 3 (last in sequence),
+   * (b) mac80211 is controlling CW (not sysfs override), AND
+   * (c) ALL 4 queues ended up as BE (OW_CSMA_CFG_ALL_BE). */
+  if (queue == IEEE80211_AC_BK && priv->stat.cw_max_min_cfg == 0 &&
+      reg_val == OW_CSMA_CFG_ALL_BE) {
+    if (wmm_force_on_all_be) {
+      xpu_api->XPU_REG_CSMA_CFG_write(OW_CSMA_CFG_WMM_DEFAULT);
+      xpu_api->XPU_REG_AIFS_CFG_write(OW_AIFS_CFG_WMM_DEFAULT);
+      /* Keep the cached driver-visible EDCA snapshot aligned with the forced
+       * WMM defaults at the point where this opt-in workaround fires. Clearing
+       * the temporary sysfs CW override still restores CW only; AIFSN
+       * continues to follow later conf_tx() programming even under that
+       * override path. */
+      openwifi_cache_wmm_default_edca(priv);
+      printk(KERN_INFO "%s openwifi_conf_tx: all-BE CW detected after Q3, "
+        "forcing WMM CW+AIFSN defaults due to wmm_force_on_all_be=1\n", sdr_compatible_str);
+    } else {
+      printk(KERN_INFO "%s openwifi_conf_tx: all-BE CW detected after Q3, "
+        "honoring mac80211 non-WMM/default EDCA request\n", sdr_compatible_str);
+    }
+  }
+
+  return 0;
+}
