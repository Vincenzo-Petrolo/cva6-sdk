+/**
+ * @brief Stop device data path and release all runtime resources.
+ *
+ * @param dev mac80211 hardware handle.
+ */
+static void openwifi_stop(struct ieee80211_hw *dev)
+{
+  struct openwifi_priv *priv = dev->priv;
+  struct ieee80211_vif *vif;
+  struct openwifi_vif *vif_priv;
+  unsigned long flags;
+  int term_tx_ret;
+  int term_rx_ret;
+  int term_ret;
+  u32 tx_att_ant1;
+  u32 tx_att_ant0;
+  int i;
+
+  openwifi_rx_dma_watchdog_disarm(priv);
+  /* Block new TX submissions and worker rescheduling during teardown.
+   * tx_dma_terminating stays true permanently -- interface is going down. */
+  spin_lock_irqsave(&priv->lock, flags);
+  WRITE_ONCE(priv->tx_dma_recovery_enabled, false);
+  WRITE_ONCE(priv->tx_dma_stalled, false);
+  WRITE_ONCE(priv->tx_dma_terminating, true);
+  spin_unlock_irqrestore(&priv->lock, flags);
+  /* Cancel TX stall recovery worker BEFORE DMA release to avoid use-after-free */
+  cancel_delayed_work_sync(&priv->tx_stall_recovery_work);
+
+  /* Enable AD9361 auto calibration and disable OpenWiFi FPGA SPI control. */
+  priv->ad9361_phy->state->auto_cal_en = true;
+  priv->ad9361_phy->state->manual_tx_quad_cal_en = false;
+  xpu_api->XPU_REG_SPI_DISABLE_write(OW_SPI_DISABLE_ENABLE);
+
+  /* Turn off radio. */
+  ad9361_tx_mute(priv->ad9361_phy, 1);
+  tx_att_ant1 = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT1);
+  tx_att_ant0 = ad9361_get_tx_atten(priv->ad9361_phy, OW_AD9361_TX_CH_ANT0);
+  if (tx_att_ant1 == AD9361_RADIO_OFF_TX_ATT && tx_att_ant0 == AD9361_RADIO_OFF_TX_ATT) {
+    priv->radio_enabled_cached = false;
+    printk("%s openwifi_stop: rfkill radio off\n", sdr_compatible_str);
+  } else {
+    printk("%s openwifi_stop: WARNING rfkill radio off failed. tx att read %d %d require %d\n",
+      sdr_compatible_str, tx_att_ant1, tx_att_ant0, AD9361_RADIO_OFF_TX_ATT);
+  }
+  tx_intf_api->TX_INTF_REG_INTERRUPT_SEL_write(OW_TX_INTF_INTERRUPT_DISABLE);
+  rx_intf_api->RX_INTF_REG_INTERRUPT_TEST_write(OW_RX_INTERRUPT_TEST_DISABLE);
+  /* Hold M-AXIS in reset while tearing down RX DMA and interrupts. */
+  rx_intf_api->RX_INTF_REG_M_AXIS_RST_write(1);
+
+  for (i = 0; i < MAX_NUM_VIF; i++) {
+    vif = priv->vif[i];
+    if (!vif) {
+      continue;
+    }
+    vif_priv = (struct openwifi_vif *)&vif->drv_priv;
+    vif_priv->enable_beacon = false;
+    cancel_delayed_work_sync(&vif_priv->beacon_work);
+    priv->vif[i] = NULL;
+  }
+
+  priv->tx_pkt_info_last_valid = false;
+  memset(priv->tx_pkt_info_last, 0, sizeof(priv->tx_pkt_info_last));
+  priv->tx_pkt_info_latched_valid = false;
+  memset(priv->tx_pkt_info_latched, 0, sizeof(priv->tx_pkt_info_latched));
+  openwifi_reset_rx_ba_session(priv);
+  xpu_api->XPU_REG_BSSID_FILTER_ADDR_write(NULL);
+
+  /* Cleanup order is reverse of acquisition in openwifi_start.
+   * Stop DMA before freeing RX/TX buffers to avoid use-after-free. */
+  /* 1. Stop IRQ handlers first (no more ISR invocations). */
+  free_irq(priv->irq_tx, dev);
+  free_irq(priv->irq_rx, dev);
+  /* 1b. Release IRQ mappings allocated by irq_of_parse_and_map(). */
+  if (priv->irq_tx) {
+    irq_dispose_mapping(priv->irq_tx);
+  }
+  if (priv->irq_rx) {
+    irq_dispose_mapping(priv->irq_rx);
+  }
+  /* Second cancel: the recovery worker reschedules itself (lockless check
+   * in openwifi_tx_stall_recovery) and can re-arm between the first cancel
+   * and the worker returning. This catches that narrow re-arm window. */
+  cancel_delayed_work_sync(&priv->tx_stall_recovery_work);
+  /* 2. Stop DMA engines (no more writes to buffers).
+   * NOTE: dmaengine_terminate_sync → tasklet_kill waits for any running
+   * DMA callback (including openwifi_rx_interrupt Phase RX-B) to return
+   * before proceeding.  free_irq above already drained hardirq handlers.
+   * Together these guarantee no RX handler is running when we free memory
+   * at step 3 — no additional synchronization needed for Phase RX-B. */
+  openwifi_disarm_rx_dma_callback(priv);
+  term_tx_ret = openwifi_dma_terminate_sync_retry(priv->tx_chan, "openwifi_stop(tx)");
+  term_rx_ret = openwifi_dma_terminate_sync_retry(priv->rx_chan, "openwifi_stop(rx)");
+  term_ret = term_tx_ret ? term_tx_ret : term_rx_ret;
+  if (term_ret) {
+    printk(KERN_ERR "%s openwifi_stop: aborting free/release after DMA terminate failure (tx=%d rx=%d); reload/reprobe required\n",
+      sdr_compatible_str, term_tx_ret, term_rx_ret);
+    /* TODO(openwifi-stop): define explicit degraded-state recovery path after
+     * terminate failure.
+     * Required closure:
+     * 1) distinguish transient terminate failures from persistent failures;
+     * 2) keep memory-safety guarantees (never free DMA-reachable buffers);
+     * 3) provide controlled recovery path (bounded retry and/or restart gate)
+     *    before final reload/reprobe escalation. */
+    return;
+  }
+  /* 3. Free memory after DMA stop+synchronize. */
+  for (i = 0; i < MAX_NUM_SW_QUEUE; i++) {
+    openwifi_free_tx_ring(priv, i);
+  }
+  openwifi_free_rx_ring(priv);
+  /* 4. Release DMA channels last. */
+  pr_info("%s openwifi_stop: releasing DMA channels\n", sdr_compatible_str);
+  dma_release_channel(priv->tx_chan);
+  dma_release_channel(priv->rx_chan);
+  priv->tx_chan = NULL;
+  priv->rx_chan = NULL;
+  openwifi_unmap_rx_dma_regs(priv);
+
+  printk("%s openwifi_stop\n", sdr_compatible_str);
+}
