+/* All platforms need DATA_SEL=DMA written to the DAC channels.
+ * Previously returned false for Cheshire, which left the axi_ad9361 DAC
+ * DATA_SEL mux at its reset default (DDS tone mode) — TX IQ data from
+ * DMA was gated out and frames never reached the air. */
+static inline bool openwifi_platform_uses_direct_dac_mode(const char *fpga_model,
+  const char *root_compatible)
+{
+  return true;
+}
