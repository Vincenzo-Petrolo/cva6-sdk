+extern int ad9361_set_tx_atten(struct ad9361_rf_phy *phy, u32 atten_mdb, bool tx1, bool tx2, bool immed);
+extern int ad9361_spi_read(struct spi_device *spi, u32 reg);
+extern int ad9361_get_tx_atten(struct ad9361_rf_phy *phy, u32 tx_num);
+
+//=============================================================================
+// Cross-Component APIs
+//=============================================================================
+
+extern struct tx_intf_driver_api *tx_intf_api;
+extern struct rx_intf_driver_api *rx_intf_api;
+extern struct openofdm_tx_driver_api *openofdm_tx_api;
+extern struct openofdm_rx_driver_api *openofdm_rx_api;
+extern struct xpu_driver_api *xpu_api;
+
+//=============================================================================
+// Forward Declarations
+//=============================================================================
+
+u32 gen_mpdu_crc(u8 *data_in, u32 num_bytes);
+u8 gen_mpdu_delim_crc(u16 m);
+static irqreturn_t openwifi_rx_interrupt(int irq, void *dev_id);
+static int rx_dma_setup(struct ieee80211_hw *dev);
+static int openwifi_dma_terminate_sync_retry(struct dma_chan *chan, const char *tag);
+static inline int rssi_half_db_to_rssi_dbm(int rssi_half_db, int rssi_correction);
+static inline int rssi_dbm_to_rssi_half_db(int rssi_dbm, int rssi_correction);
+static void ad9361_rf_set_channel(struct ieee80211_hw *dev, struct ieee80211_conf *conf);
+u16 reverse16(u16 value);
+u32 reverse32(u32 value);
+static int openwifi_set_antenna(struct ieee80211_hw *dev, u32 tx_ant, u32 rx_ant);
+static int openwifi_get_antenna(struct ieee80211_hw *dev, u32 *tx_ant, u32 *rx_ant);
+static void openwifi_reset_rx_ba_session_locked(struct openwifi_priv *priv);
+static void openwifi_reset_rx_ba_session(struct openwifi_priv *priv);
+
+struct ow_hw_queue_layout {
+  u16 ac_queue;
+  u8 cw_shift_bits;
+  u8 aifs_shift_bits;
+  u32 cw_clear_mask;
+  u32 aifs_clear_mask;
+};
+
+/* One canonical driver/RTL queue map:
+ * - q0 = VO
+ * - q1 = VI
+ * - q2 = BE
+ * - q3 = BK
+ *
+ * Keep this mapping here because both the common CW helper layer and the
+ * driver-side AIFS/CW programming paths depend on it. */
+static const struct ow_hw_queue_layout ow_hw_queue_layouts[] = {
+  {
+    IEEE80211_AC_VO,
+    OW_CONF_TX_Q0_SHIFT,
+    OW_CONF_TX_AIFS_Q0_SHIFT,
+    OW_CONF_TX_Q0_CLEAR_MASK,
+    OW_CONF_TX_AIFS_Q0_CLEAR_MASK
+  },
+  {
+    IEEE80211_AC_VI,
+    OW_CONF_TX_Q1_SHIFT,
+    OW_CONF_TX_AIFS_Q1_SHIFT,
+    OW_CONF_TX_Q1_CLEAR_MASK,
+    OW_CONF_TX_AIFS_Q1_CLEAR_MASK
+  },
+  {
+    IEEE80211_AC_BE,
+    OW_CONF_TX_Q2_SHIFT,
+    OW_CONF_TX_AIFS_Q2_SHIFT,
+    OW_CONF_TX_Q2_CLEAR_MASK,
+    OW_CONF_TX_AIFS_Q2_CLEAR_MASK
+  },
+  {
+    IEEE80211_AC_BK,
+    OW_CONF_TX_Q3_SHIFT,
+    OW_CONF_TX_AIFS_Q3_SHIFT,
+    OW_CONF_TX_Q3_CLEAR_MASK,
+    OW_CONF_TX_AIFS_Q3_CLEAR_MASK
+  },
+};
+
+/**
+ * @brief Look up the canonical hardware queue layout for one access category.
+ *
+ * @param queue Queue index in IEEE80211_AC_* order.
+ * @return Matching queue layout, or NULL when the queue index is invalid.
+ */
+static const struct ow_hw_queue_layout *openwifi_get_hw_queue_layout(u16 queue)
+{
+  u8 idx_layout;
+
+  for (idx_layout = 0; idx_layout < ARRAY_SIZE(ow_hw_queue_layouts); idx_layout++) {
+    if (ow_hw_queue_layouts[idx_layout].ac_queue == queue) {
+      return &ow_hw_queue_layouts[idx_layout];
+    }
+  }
+
+  return NULL;
+}
+
+/**
+ * @brief Extract one packed 4-bit field from an XPU register value.
+ *
+ * @param reg_val Packed register value.
+ * @param shift_bits Bit position of the nibble to extract.
+ * @return Extracted 4-bit field value.
+ */
+static u8 openwifi_extract_packed_nibble(u32 reg_val, u8 shift_bits)
+{
+  return (reg_val >> shift_bits) & OW_CONF_TX_CW_FIELD_MASK;
+}
+
+/**
+ * @brief Validate one CW min/max exponent pair against the RTL range.
+ *
+ * @param cw_min_exp CW min exponent.
+ * @param cw_max_exp CW max exponent.
+ * @return 0 on success, -ERANGE when an exponent exceeds hardware support.
+ */
+static int openwifi_validate_cw_exp_pair(u32 cw_min_exp, u32 cw_max_exp)
+{
+  if (cw_min_exp > OW_CW_EXP_MAX_SUPPORTED ||
+      cw_max_exp > OW_CW_EXP_MAX_SUPPORTED) {
+    return -ERANGE;
+  }
+
+  return 0;
+}
+
+/**
+ * @brief Validate every CW exponent nibble in a packed CSMA register value.
+ *
+ * @param reg_val Packed per-queue CW min/max value.
+ * @return 0 on success, -ERANGE when any nibble exceeds hardware support.
+ */
+static int openwifi_validate_cw_reg_value(u32 reg_val)
+{
+  u8 idx_layout;
+
+  for (idx_layout = 0; idx_layout < ARRAY_SIZE(ow_hw_queue_layouts); idx_layout++) {
+    const struct ow_hw_queue_layout *layout = &ow_hw_queue_layouts[idx_layout];
+
+    if (openwifi_validate_cw_exp_pair(
+      openwifi_extract_packed_nibble(reg_val, layout->cw_shift_bits),
+      openwifi_extract_packed_nibble(reg_val, layout->cw_shift_bits + OW_CW_NIBBLE_SHIFT_BITS))) {
+      return -ERANGE;
+    }
+  }
+
+  return 0;
+}
+
+/**
+ * @brief Cache one queue's CW exponents in q0=VO .. q3=BK order.
+ *
+ * @param priv Driver private state.
+ * @param queue Queue index in IEEE80211_AC_* order.
+ * @param cw_min_exp CW min exponent.
+ * @param cw_max_exp CW max exponent.
+ */
+static void openwifi_cache_cw_pair(
+  struct openwifi_priv *priv,
+  u16 queue,
+  u8 cw_min_exp,
+  u8 cw_max_exp)
+{
+  priv->requested_cw_min_exp[queue] = cw_min_exp;
+  priv->requested_cw_max_exp[queue] = cw_max_exp;
+}
+
+/**
+ * @brief Extract one packed CW exponent nibble from XPU_REG_CSMA_CFG.
+ *
+ * @param reg_val Packed per-queue CW min/max value.
+ * @param shift_bits Bit position of the nibble to extract.
+ * @return Extracted CW exponent nibble.
+ */
+static u8 openwifi_extract_cw_exp(u32 reg_val, u8 shift_bits)
+{
+  return openwifi_extract_packed_nibble(reg_val, shift_bits);
+}
+
+/**
+ * @brief Decode a packed XPU_REG_CSMA_CFG value into per-queue exponent arrays.
+ *
+ * @param reg_val Packed per-queue CW min/max value.
+ * @param cw_min_exp Output array indexed by IEEE80211_AC_* queue.
+ * @param cw_max_exp Output array indexed by IEEE80211_AC_* queue.
+ */
+static void openwifi_decode_cw_reg(
+  u32 reg_val,
+  u8 cw_min_exp[OW_NUM_HW_QUEUE],
+  u8 cw_max_exp[OW_NUM_HW_QUEUE])
+{
+  u8 idx_layout;
+
+  for (idx_layout = 0; idx_layout < ARRAY_SIZE(ow_hw_queue_layouts); idx_layout++) {
+    const struct ow_hw_queue_layout *layout = &ow_hw_queue_layouts[idx_layout];
+
+    cw_min_exp[layout->ac_queue] = openwifi_extract_cw_exp(reg_val, layout->cw_shift_bits);
+    cw_max_exp[layout->ac_queue] =
+      openwifi_extract_cw_exp(reg_val, layout->cw_shift_bits + OW_CW_NIBBLE_SHIFT_BITS);
+  }
+}
+
+/**
+ * @brief Cache all queue CW exponents from a packed CSMA register value.
+ *
+ * @param priv Driver private state.
+ * @param reg_val Packed per-queue CW min/max value.
+ */
+static void openwifi_cache_cw_reg(struct openwifi_priv *priv, u32 reg_val)
+{
+  u8 cw_min_exp[OW_NUM_HW_QUEUE];
+  u8 cw_max_exp[OW_NUM_HW_QUEUE];
+  u8 idx_layout;
+
+  openwifi_decode_cw_reg(reg_val, cw_min_exp, cw_max_exp);
+  for (idx_layout = 0; idx_layout < ARRAY_SIZE(ow_hw_queue_layouts); idx_layout++) {
+    const struct ow_hw_queue_layout *layout = &ow_hw_queue_layouts[idx_layout];
+    openwifi_cache_cw_pair(
+      priv,
+      layout->ac_queue,
+      cw_min_exp[layout->ac_queue],
+      cw_max_exp[layout->ac_queue]);
+  }
+}
+
+/**
+ * @brief Compose a packed CSMA CW register value from cached queue exponents.
+ *
+ * @param priv Driver private state.
+ * @return Packed per-queue CW min/max value.
+ */
+static u32 openwifi_compose_cached_cw_reg(const struct openwifi_priv *priv)
+{
+  u32 reg_val = 0;
+  u8 idx_layout;
+
+  for (idx_layout = 0; idx_layout < ARRAY_SIZE(ow_hw_queue_layouts); idx_layout++) {
+    const struct ow_hw_queue_layout *layout = &ow_hw_queue_layouts[idx_layout];
+
+    reg_val |= ((u32)priv->requested_cw_min_exp[layout->ac_queue] & OW_CONF_TX_CW_FIELD_MASK) <<
+      layout->cw_shift_bits;
+    reg_val |= ((u32)priv->requested_cw_max_exp[layout->ac_queue] & OW_CONF_TX_CW_FIELD_MASK) <<
+      (layout->cw_shift_bits + OW_CW_NIBBLE_SHIFT_BITS);
+  }
+
+  return reg_val;
+}
+
+/**
+ * @brief Update one queue's CW byte inside a packed XPU_REG_CSMA_CFG value.
+ *
+ * @param reg_val Current packed CSMA register value.
+ * @param queue Queue index in IEEE80211_AC_* order.
+ * @param cw_min_exp CW min exponent for this queue.
+ * @param cw_max_exp CW max exponent for this queue.
+ * @return Updated packed register value.
+ */
+static u32 openwifi_update_cw_reg_for_queue(
+  u32 reg_val,
+  u16 queue,
+  u8 cw_min_exp,
+  u8 cw_max_exp)
+{
+  const struct ow_hw_queue_layout *layout = openwifi_get_hw_queue_layout(queue);
+  u32 cw_pair_field;
+
+  if (!layout) {
+    return reg_val;
+  }
+
+  cw_pair_field = (cw_min_exp | (cw_max_exp << OW_CW_NIBBLE_SHIFT_BITS)) & OW_CONF_TX_CW_PAIR_MASK;
+  return (reg_val & layout->cw_clear_mask) | (cw_pair_field << layout->cw_shift_bits);
+}
+
+/**
+ * @brief Update one queue's AIFSN nibble inside a packed XPU_REG_AIFS_CFG value.
+ *
+ * @param reg_val Current packed AIFS register value.
+ * @param queue Queue index in IEEE80211_AC_* order.
+ * @param aifs Raw AIFSN nibble value for this queue.
+ * @return Updated packed register value.
+ */
+static u32 openwifi_update_aifs_reg_for_queue(u32 reg_val, u16 queue, u8 aifs)
+{
+  const struct ow_hw_queue_layout *layout = openwifi_get_hw_queue_layout(queue);
+
+  if (!layout) {
+    return reg_val;
+  }
+
+  return (reg_val & layout->aifs_clear_mask) |
+    (((u32)aifs & OW_CONF_TX_AIFS_FIELD_MASK) << layout->aifs_shift_bits);
+}
+
+/**
+ * @brief Validate one software-visible AIFSN value against the hardware field.
+ *
+ * @param aifs Requested AIFSN value from mac80211 or cached software state.
+ * @return 0 on success, -ERANGE when the value exceeds the raw 4-bit field.
+ */
+static int openwifi_validate_aifs_value(u16 aifs)
+{
+  if (aifs > OW_CONF_TX_AIFS_FIELD_MASK) {
+    return -ERANGE;
+  }
+
+  return 0;
+}
+
+/**
+ * @brief Convert a raw AIFSN nibble into the effective hardware behavior.
+ *
+ * @param raw_aifs Raw nibble stored in XPU_REG_AIFS_CFG.
+ * @return Effective AIFSN seen by the current RTL.
+ */
+static u8 openwifi_aifs_raw_to_effective(u8 raw_aifs)
+{
+  return raw_aifs ? raw_aifs : OW_CONF_TX_AIFS_ZERO_EFFECTIVE;
+}
+
+/**
+ * @brief Decode a packed XPU_REG_AIFS_CFG value into per-queue raw AIFSN nibbles.
+ *
+ * @param reg_val Packed per-queue AIFSN value.
+ * @param raw_aifs Output array indexed by IEEE80211_AC_* queue.
+ */
+static void openwifi_decode_aifs_reg(u32 reg_val, u8 raw_aifs[OW_NUM_HW_QUEUE])
+{
+  u8 idx_layout;
+
+  for (idx_layout = 0; idx_layout < ARRAY_SIZE(ow_hw_queue_layouts); idx_layout++) {
+    const struct ow_hw_queue_layout *layout = &ow_hw_queue_layouts[idx_layout];
+
+    raw_aifs[layout->ac_queue] = openwifi_extract_packed_nibble(reg_val, layout->aifs_shift_bits);
+  }
+}
+
+/**
+ * @brief Convert a CW exponent into the effective contention-window value.
+ *
+ * @param cw_exp CW exponent nibble.
+ * @param cw_value Output contention-window value when the exponent is supported.
+ * @return True when @p cw_exp is within the implemented RTL range, false otherwise.
+ */
+static bool openwifi_cw_exp_to_cw_value(u8 cw_exp, u32 *cw_value)
+{
+  if (cw_exp > OW_CW_EXP_MAX_SUPPORTED) {
+    return false;
+  }
+
+  *cw_value = BIT(cw_exp) - 1U;
+  return true;
+}
+
+/**
+ * @brief Seed cached EDCA state with the maintained WMM defaults.
+ *
+ * This cache mirrors the software-visible queue contract:
+ * q0=VO, q1=VI, q2=BE, q3=BK.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_cache_wmm_default_edca(struct openwifi_priv *priv)
+{
+  openwifi_cache_cw_reg(priv, OW_CSMA_CFG_WMM_DEFAULT);
+  priv->requested_aifs[IEEE80211_AC_VO] = OW_AIFS_Q0_WMM_DEFAULT;
+  priv->requested_aifs[IEEE80211_AC_VI] = OW_AIFS_Q1_WMM_DEFAULT;
+  priv->requested_aifs[IEEE80211_AC_BE] = OW_AIFS_Q2_WMM_DEFAULT;
+  priv->requested_aifs[IEEE80211_AC_BK] = OW_AIFS_Q3_WMM_DEFAULT;
+  priv->requested_txop[IEEE80211_AC_VO] = 0;
+  priv->requested_txop[IEEE80211_AC_VI] = 0;
+  priv->requested_txop[IEEE80211_AC_BE] = 0;
+  priv->requested_txop[IEEE80211_AC_BK] = 0;
+}
+
+/**
+ * @brief Program the XPU RX BlockAck session control register.
+ *
+ * Register contract:
+ * - bit31: RX BA session enable
+ * - bits16:5: negotiated RX BA SSN
+ * - bits4:1: active TID
+ * - bit0: clear/start pulse
+ *
+ * @param rx_ba_active True when the RX BA session should remain enabled.
+ * @param tid Active TID to expose to the RTL.
+ * @param ssn Negotiated RX BA SSN for the active window.
+ * @param pulse_clear True to emit the clear/start pulse.
+ */
+static void openwifi_write_ampdu_rx_action(bool rx_ba_active, u8 tid, u16 ssn, bool pulse_clear)
+{
+  u32 reg_val;
+
+  reg_val = (((u32)tid & OW_XPU_AMPDU_RX_ACTION_TID_MASK) << OW_XPU_AMPDU_RX_ACTION_TID_SHIFT)
+    | (((u32)ssn & OW_XPU_AMPDU_RX_ACTION_SSN_MASK) << OW_XPU_AMPDU_RX_ACTION_SSN_SHIFT);
+  if (rx_ba_active) {
+    reg_val |= OW_XPU_AMPDU_RX_ACTION_ENABLE;
+  }
+
+  xpu_api->XPU_REG_AMPDU_ACTION_write(reg_val);
+  if (pulse_clear) {
+    xpu_api->XPU_REG_AMPDU_ACTION_write(reg_val | OW_XPU_AMPDU_RX_ACTION_CLEAR_PULSE);
+    xpu_api->XPU_REG_AMPDU_ACTION_write(reg_val);
+  }
+}
+
+/**
+ * @brief Clear the cached single-session RX BlockAck state.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_clear_rx_ba_state(struct openwifi_priv *priv)
+{
+  priv->rx_ba_active = false;
+  priv->rx_ba_tid = 0;
+  priv->rx_ba_ssn = 0;
+  priv->rx_ba_buf_size = 0;
+  priv->rx_ba_timeout_tu = 0;
+  eth_zero_addr(priv->rx_ba_peer_addr);
+}
+
+/**
+ * @brief Program the XPU RX BlockAck peer match register pair.
+ *
+ * The current hardware contract binds RX BA state to one peer/TID session.
+ * BAR acceptance and RX A-MPDU bitmap updates therefore use both the active
+ * TID and this programmed sender MAC.
+ *
+ * @param peer_addr Peer MAC address, or NULL to clear the match.
+ */
+static void openwifi_write_ampdu_rx_peer(const u8 *peer_addr)
+{
+  xpu_api->XPU_REG_AMPDU_RX_PEER_ADDR_write(peer_addr);
+}
+
+/**
+ * @brief Clear cached RX BA state and matching XPU registers under lock.
+ *
+ * @param priv Driver private state. Caller must hold @c priv->lock.
+ */
+static void openwifi_reset_rx_ba_session_locked(struct openwifi_priv *priv)
+{
+  /* Force the next delivered A-MPDU detail to start a fresh software-side
+   * aggregate boundary after teardown or restart. Phase RX-C writeback uses
+   * a monotonic merge so this bump is not clobbered by an older in-flight
+   * batch in openwifi_rx_interrupt(). */
+  priv->ampdu_reference++;
+  openwifi_clear_rx_ba_state(priv);
+  openwifi_write_ampdu_rx_peer(NULL);
+  openwifi_write_ampdu_rx_action(false, 0, 0, true);
+}
+
+/**
+ * @brief Clear cached RX BA state and matching XPU registers.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_reset_rx_ba_session(struct openwifi_priv *priv)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&priv->lock, flags);
+  openwifi_reset_rx_ba_session_locked(priv);
+  spin_unlock_irqrestore(&priv->lock, flags);
+}
