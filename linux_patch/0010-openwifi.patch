diff --git a/drivers/Kconfig b/drivers/Kconfig
index dcecc9f..f4fa527 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -236,3 +236,9 @@ source "drivers/counter/Kconfig"
 
 source "drivers/most/Kconfig"
 endmenu
+
+config OPENWIFI
+	tristate "OpenWiFi support"
+	depends on IIO && SPI && AD9361 
+	help
+        Say Y or M to enable the Openwifi driver
