new file mode 100644
index 0000000..e83c257
--- /dev/null
+++ b/drivers/sysfs_intf.c
@@ -0,0 +1,1977 @@
+// Author: Xianjun Jiao, Michael Mehari, Wei Liu
+// SPDX-FileCopyrightText: 2019 UGent
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+// #define TX_INTF_IQ_WRITE_TXT_FORMAT 1//while using TXT format, the txt file size should <= 4096!!!
+#define TX_INTF_IQ_WRITE_BIN_FORMAT 1
+#define OW_TX_INTF_IQ_WORD_BYTES              sizeof(u32)
+#define OW_TX_INTF_IQ_CHAR_SPACE              ' '
+#define OW_TX_INTF_IQ_CHAR_RANGE_MIN          ','
+#define OW_TX_INTF_IQ_CHAR_RANGE_MAX          '9'
+#define OW_TX_INTF_IQ_CTL_MODE_LOAD           1U
+#define OW_TX_INTF_IQ_CTL_MODE_START          3U
+#define OW_TX_INTF_IQ_CTL_MODE_IDLE           0U
+#define OW_TX_INTF_IQ_CTL_MIN                0U
+#define OW_TX_INTF_IQ_CTL_MAX              255U
+#define OW_TX_WIFI_RATE_HT_BASE_IDX          12U
+#define OW_SYSFS_FREQ_MHZ_MIN              2000L
+#define OW_SYSFS_FREQ_MHZ_MAX              6000L
+
+#ifdef TX_INTF_IQ_WRITE_TXT_FORMAT
+static int is_valid_iq_number(int c) {
+  if (c == OW_TX_INTF_IQ_CHAR_SPACE || (c >= OW_TX_INTF_IQ_CHAR_RANGE_MIN && c <= OW_TX_INTF_IQ_CHAR_RANGE_MAX)) {
+    return 1;
+  } else {
+    return 0;
+  }
+}
+
+static ssize_t openwifi_tx_intf_bin_iq_write(struct file *filp, struct kobject *kobj,
+           struct bin_attribute *bin_attr,
+           char *buf, loff_t off, size_t count)
+{
+  struct platform_device *pdev = to_platform_device(kobj_to_dev(kobj));
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+  int ret, i, q, num_iq;
+  char *line;
+  char *ptr = buf;
+
+  printk("%s openwifi_tx_intf_bin_iq_write: count %d\n", sdr_compatible_str, (int)count);
+  if (off != 0) {
+    return -EINVAL;
+  }
+
+  num_iq = 0;
+  line = ptr;
+  while (1) {
+    ret = sscanf(line, "%d,%d\n", &i, &q);
+    if (ret == 0) {
+      printk("%s openwifi_tx_intf_bin_iq_write: sscanf ret 0\n", sdr_compatible_str);
+      break;
+    } else if (ret != 2) {
+      printk("%s openwifi_tx_intf_bin_iq_write: sscanf ret %d i %d q %d num_iq %d\n", sdr_compatible_str, ret, i, q, num_iq);
+      return -EINVAL;
+    }
+    
+    priv->tx_intf_arbitrary_iq[num_iq] = ( (q<<16)|(i&0xFFFF) );
+    num_iq++;
+    if (num_iq == OPENWIFI_TX_INTF_ARBITRARY_IQ_MAX) {
+      printk("%s openwifi_tx_intf_bin_iq_write: num_iq reach %u\n", sdr_compatible_str, OPENWIFI_TX_INTF_ARBITRARY_IQ_MAX);
+      break;
+    }
+
+    //go to the next line
+    while (is_valid_iq_number(ptr[0])) {
+      ptr++;
+    }
+    while ((is_valid_iq_number(ptr[0]) == 0) && (ptr[0] != 0)) {
+      ptr++;
+    }
+    if (ptr[0] == 0) {
+      printk("%s openwifi_tx_intf_bin_iq_write: ptr[0] == 0\n", sdr_compatible_str);
+      break;
+    }
+    line = ptr;
+  }
+  priv->tx_intf_arbitrary_iq_num = num_iq;
+
+  printk("%s openwifi_tx_intf_bin_iq_write: num_iq %d\n", sdr_compatible_str, num_iq);
+  //print i/q
+  for (i = 0; i < num_iq; i++) {
+    printk("%d %d\n", (short)(priv->tx_intf_arbitrary_iq[i]&0xffff), (short)((priv->tx_intf_arbitrary_iq[i]>>16)&0xffff) );
+  }
+  
+  return count;
+}
+#else
+static ssize_t openwifi_tx_intf_bin_iq_write(struct file *filp, struct kobject *kobj,
+           struct bin_attribute *bin_attr,
+           char *buf, loff_t off, size_t count)
+{
+  struct platform_device *pdev = to_platform_device(kobj_to_dev(kobj));
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+  int num_iq, i;
+
+  printk("%s openwifi_tx_intf_bin_iq_write: count %d\n", sdr_compatible_str, (int)count);
+  if (off != 0) {
+    return -EINVAL;
+  }
+
+  if ((count % OW_TX_INTF_IQ_WORD_BYTES) != 0) {
+    printk("%s openwifi_tx_intf_bin_iq_write: count is not integer times of %zu!\n",
+      sdr_compatible_str, OW_TX_INTF_IQ_WORD_BYTES);
+    return -EINVAL;
+  }
+
+  num_iq = (int)(count / OW_TX_INTF_IQ_WORD_BYTES);
+  if (num_iq > OPENWIFI_TX_INTF_ARBITRARY_IQ_MAX) {
+    printk("%s openwifi_tx_intf_bin_iq_write: num_iq %d exceeds max %u\n",
+      sdr_compatible_str, num_iq, OPENWIFI_TX_INTF_ARBITRARY_IQ_MAX);
+    return -EINVAL;
+  }
+  priv->tx_intf_arbitrary_iq_num = num_iq;
+
+  for (i = 0; i < num_iq; i++) {
+    priv->tx_intf_arbitrary_iq[i] = get_unaligned_le32(buf + i * OW_TX_INTF_IQ_WORD_BYTES);
+  }
+
+  // printk("%s openwifi_tx_intf_bin_iq_write: num_iq %d\n", sdr_compatible_str, num_iq);
+  // //print i/q
+  // for (i=0; i<num_iq; i++)
+  //  printk("%d %d\n", (short)(priv->tx_intf_arbitrary_iq[i]&0xffff), (short)((priv->tx_intf_arbitrary_iq[i]>>16)&0xffff) );
+  
+  return count;
+}
+#endif
+
+static ssize_t openwifi_tx_intf_bin_iq_read(struct file *filp, struct kobject *kobj,
+           struct bin_attribute *bin_attr,
+           char *buf, loff_t off, size_t count)
+{
+  struct platform_device *pdev = to_platform_device(kobj_to_dev(kobj));
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+  size_t total_bytes, remain_bytes, copy_bytes;
+  size_t idx_byte;
+  u32 word_le;
+  u8 *word_bytes;
+
+  /* tx_intf_iq_data readback is raw bytes. Use hexdump/xxd for inspection. */
+  if (off < 0) {
+    return -EINVAL;
+  }
+  total_bytes = min_t(size_t,
+    (size_t)priv->tx_intf_arbitrary_iq_num * OW_TX_INTF_IQ_WORD_BYTES,
+    bin_attr->size);
+  if ((size_t)off >= total_bytes) {
+    return 0;
+  }
+  if (count == 0U) {
+    return 0;
+  }
+
+  remain_bytes = total_bytes - (size_t)off;
+  copy_bytes = min_t(size_t, count, remain_bytes);
+
+  for (idx_byte = 0; idx_byte < copy_bytes; idx_byte++) {
+    size_t pos = (size_t)off + idx_byte;
+    size_t idx_word = pos / OW_TX_INTF_IQ_WORD_BYTES;
+    size_t idx_word_byte = pos % OW_TX_INTF_IQ_WORD_BYTES;
+
+    word_le = cpu_to_le32(priv->tx_intf_arbitrary_iq[idx_word]);
+    word_bytes = (u8 *)&word_le;
+    buf[idx_byte] = word_bytes[idx_word_byte];
+  }
+
+  return copy_bytes;
+}
+
+static ssize_t tx_intf_iq_ctl_show(struct device *input_dev, struct device_attribute *attr, char *buf) 
+{
+  struct platform_device *pdev = to_platform_device(input_dev);
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+  
+  return sprintf(buf, "%u\n", priv->tx_intf_iq_ctl);
+}
+static ssize_t tx_intf_iq_ctl_store(struct device *input_dev, struct device_attribute *attr, const char *buf, size_t len) 
+{
+  struct platform_device *pdev = to_platform_device(input_dev);
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+
+  unsigned int readin;
+  int i;
+  int ret = kstrtouint(buf, 10, &readin);
+
+  if (ret) {
+    return ret;
+  }
+  if (readin < OW_TX_INTF_IQ_CTL_MIN || readin > OW_TX_INTF_IQ_CTL_MAX) {
+    return -EINVAL;
+  }
+
+  priv->tx_intf_iq_ctl = (u8)readin;
+
+  tx_intf_api->TX_INTF_REG_ARBITRARY_IQ_CTL_write(OW_TX_INTF_IQ_CTL_MODE_LOAD); // switch to iq mode
+  printk("%s tx_intf_iq_ctl_store: Will send %d I/Q\n", sdr_compatible_str, priv->tx_intf_arbitrary_iq_num);
+  for (i = 0; i < priv->tx_intf_arbitrary_iq_num; i++) {
+    tx_intf_api->TX_INTF_REG_ARBITRARY_IQ_write(priv->tx_intf_arbitrary_iq[i]);
+  }
+  tx_intf_api->TX_INTF_REG_ARBITRARY_IQ_CTL_write(OW_TX_INTF_IQ_CTL_MODE_START); // start send
+  tx_intf_api->TX_INTF_REG_ARBITRARY_IQ_CTL_write(OW_TX_INTF_IQ_CTL_MODE_IDLE);
+
+  return len;
+}
