+/**
+ * @brief TX buffer descriptor — per-packet state for one DMA ring slot.
+ *
+ * Lifecycle: populated in openwifi_tx() after successful DMA submit,
+ * consumed in openwifi_tx_interrupt() for status reporting and cleanup,
+ * cleared by ow_tx_bd_clear() or the manual clear block in the interrupt.
+ *
+ * The ring uses bd_wr_idx (producer, openwifi_tx) and bd_rd_idx (consumer,
+ * openwifi_tx_interrupt).  A slot with seq_no == OPENWIFI_TX_SEQ_INVALID
+ * is considered empty/invalid.
+ */
+struct openwifi_buffer_descriptor {
+  u8 prio;
+  u16 len_mpdu;
+  u16 seq_no;
+  struct sk_buff *skb_linked;
+  dma_addr_t dma_mapping_addr;
+  u32 dma_len_bytes;
+  struct ieee80211_tx_rate actual_tx_rate; /* rate actually transmitted (after driver
+                                           * overrides); written in openwifi_tx, read back
+                                           * in openwifi_tx_interrupt for minstrel feedback.
+                                           * 3 bytes packed — fits in 4-byte padding gap
+                                           * before bounce_buf pointer. */
+  void *bounce_buf; /* aligned bounce buffer (NULL when not used) */
+};
+
+struct openwifi_ring {
+  struct openwifi_buffer_descriptor *bds;
+  u32 bd_wr_idx;
+  u32 bd_rd_idx;
+  int stop_flag; /* debug mirror of one stopped priority; -1 when none */
+  u8 stop_prio_mask;
+  // u32 num_dma_symbol_request;
+  // u32 reserved;
+};
+
+/**
+ * @brief Per-slot work entry for 3-phase RX processing (Phase RX-A → Phase RX-B handoff).
+ *
+ * Carries slot index, DMA flag snapshot, and ampdu_reference at claim time.
+ * Phase RX-C only reads slot_idx for slot release; AMPDU tracking uses
+ * local_ampdu_ref maintained in Phase RX-B.
+ */
+struct ow_rx_work_entry {
+  u8   slot_idx;       /* index into rx_cyclic_buf (0 .. NUM_RX_BD-1) */
+  u16  agc_flag;       /* raw agc_status_and_pkt_exist_flag at claim time */
+  u32  ampdu_ref;      /* priv->ampdu_reference snapshot for this slot */
+};
+
+/**
+ * @brief Per-packet TX completion entry for 2-phase TX processing.
+ *
+ * Phase TX-A (locked) snapshots completion info from the ring.
+ * Phase TX-B (unlocked) does dma_unmap + kfree + ieee80211_tx_status_irqsafe.
+ */
+struct ow_tx_done_entry {
+  struct sk_buff *skb;
+  dma_addr_t     dma_addr;
+  u32            dma_len_bytes;
+  void          *bounce_buf;
+};
+
+/**
+ * @brief Aggregate-boundary key for maintained TX A-MPDU continuity.
+ *
+ * The driver starts a new aggregate whenever any field in this key changes.
+ * The queue field is the actual programmed hardware queue after any local
+ * driver remap, not the original mac80211 priority.
+ */
+struct ow_tx_aggr_key {
+  u32    addr1_low32;
+  u16    addr1_high16;
+  __le16 duration_id;
+  u8     rate_hw_value;
+  u8     pkt_need_ack;
+  u8     hw_queue;
+  u8     qos_tid;
+  u8     retry_limit_raw;
+  u8     use_short_gi;
+};
