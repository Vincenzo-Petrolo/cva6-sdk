+/* TX interface AXI-Lite register map.
+ * PKT_INFO1..4 are live hardware completion FIFO read ports.
+ * The TX IRQ path is the runtime consumer; sdrctl exposes the last
+ * IRQ-captured tuple instead of popping these FIFOs directly. */
+#define TX_INTF_REG_MULTI_RST_ADDR                 (0*4)
+#define TX_INTF_REG_ARBITRARY_IQ_ADDR              (1*4)
+#define TX_INTF_REG_WIFI_TX_MODE_ADDR              (2*4)
+#define TX_INTF_REG_CTS_TOSELF_CONFIG_ADDR         (4*4)
+#define TX_INTF_REG_CSI_FUZZER_ADDR                (5*4)
+#define TX_INTF_REG_CTS_TOSELF_WAIT_SIFS_TOP_ADDR  (6*4)
+#define TX_INTF_REG_ARBITRARY_IQ_CTL_ADDR          (7*4)
+#define TX_INTF_REG_TX_CONFIG_ADDR                 (8*4)
+#define TX_INTF_REG_NUM_DMA_SYMBOL_TO_PS_ADDR      (9*4)
+#define TX_INTF_REG_CFG_DATA_TO_ANT_ADDR           (10*4)
+#define TX_INTF_REG_S_AXIS_FIFO_TH_ADDR            (11*4)
+#define TX_INTF_REG_TX_HOLD_THRESHOLD_ADDR         (12*4)
+#define TX_INTF_REG_BB_GAIN_ADDR                   (13*4)
+#define TX_INTF_REG_INTERRUPT_SEL_ADDR             (14*4)
+#define TX_INTF_REG_AMPDU_ACTION_CONFIG_ADDR       (15*4)
+#define TX_INTF_REG_ANT_SEL_ADDR                   (16*4)
+#define TX_INTF_REG_PHY_HDR_CONFIG_ADDR            (17*4)
+#define TX_INTF_REG_S_AXIS_FIFO_NO_ROOM_ADDR       (21*4)
+#define TX_INTF_REG_PKT_INFO1_ADDR                 (22*4)
+#define TX_INTF_REG_PKT_INFO2_ADDR                 (23*4)
+#define TX_INTF_REG_PKT_INFO3_ADDR                 (24*4)
+#define TX_INTF_REG_PKT_INFO4_ADDR                 (25*4)
+#define TX_INTF_REG_QUEUE_FIFO_DATA_COUNT_ADDR     (26*4)
+
+/* TX_INTF_REG_MULTI_RST bits used by the maintained TX datapath.
+ * Legacy driver copies carried a stale literal 0x434 comment; the maintained
+ * tx_intf RTL consumes bits 2/3/5/6/7 for the active mini-reset path. */
+#define OW_TX_INTF_RESET_S_AXIS_BIT                2U
+#define OW_TX_INTF_RESET_IQ_INTF_BIT               3U
+#define OW_TX_INTF_RESET_CTRL_PATH_BIT             5U
+#define OW_TX_INTF_RESET_BIT_INTF_BIT              6U
+#define OW_TX_INTF_RESET_STATUS_FIFO_BIT           7U
+#define OW_TX_INTF_RESET_S_AXIS_MASK               BIT(OW_TX_INTF_RESET_S_AXIS_BIT)
+#define OW_TX_INTF_RESET_IQ_INTF_MASK              BIT(OW_TX_INTF_RESET_IQ_INTF_BIT)
+#define OW_TX_INTF_RESET_CTRL_PATH_MASK            BIT(OW_TX_INTF_RESET_CTRL_PATH_BIT)
+#define OW_TX_INTF_RESET_BIT_INTF_MASK             BIT(OW_TX_INTF_RESET_BIT_INTF_BIT)
+#define OW_TX_INTF_RESET_STATUS_FIFO_MASK          BIT(OW_TX_INTF_RESET_STATUS_FIFO_BIT)
+#define OW_TX_INTF_RESET_MINI_MASK                 (OW_TX_INTF_RESET_STATUS_FIFO_MASK | \
+                                                    OW_TX_INTF_RESET_BIT_INTF_MASK | \
+                                                    OW_TX_INTF_RESET_CTRL_PATH_MASK | \
+                                                    OW_TX_INTF_RESET_IQ_INTF_MASK | \
+                                                    OW_TX_INTF_RESET_S_AXIS_MASK)
+
+/* TX_INTF_REG_AMPDU_ACTION_CONFIG bit layout.
+ * RTL consumer: tx_bit_intf.v.
+ * Software producer: sdr_mac_ops.c openwifi_ampdu_action().
+ * Density shift must stay at 22U here. It was previously set to 24U in the
+ * driver, which silently mis-packed every non-zero density value. */
+#define OW_AMPDU_ACTION_CONFIG_MAX_TX_BYTES_MASK   0xFFFFU
+#define OW_AMPDU_ACTION_CONFIG_BUF_SIZE_SHIFT      16U
+#define OW_AMPDU_ACTION_CONFIG_BUF_SIZE_MASK       0x3FU
+#define OW_AMPDU_ACTION_CONFIG_DENSITY_SHIFT       22U
+#define OW_AMPDU_ACTION_CONFIG_DENSITY_MASK        0x7U
+
+/* TX_INTF_REG_PKT_INFO1 bit layout.
+ * RTL producer: tx_status_fifo.v / tx_control.v.
+ * Software consumer: sdr_tx.c. */
+#define OW_TX_PKT_INFO1_RETX_MASK               0xFU
+#define OW_TX_PKT_INFO1_LAST_BD_SHIFT           5U
+#define OW_TX_PKT_INFO1_QUEUE_SHIFT             15U
+#define OW_TX_PKT_INFO1_PRIO_SHIFT              17U
+#define OW_TX_PKT_INFO1_PRIO_MASK               0x3U
+#define OW_TX_PKT_INFO1_NUM_SLOT_SHIFT          19U
+#define OW_TX_PKT_INFO1_NUM_SLOT_MASK           0x1FFU
+#define OW_TX_PKT_INFO1_CW_SHIFT                28U
+#define OW_TX_PKT_INFO1_CW_MASK                 0xFU
+
+/* TX_INTF_REG_PKT_INFO2 bit layout.
+ * RTL producer: tx_status_fifo.v / tx_control.v.
+ * Software consumer: sdr_tx.c.
+ * - bits  5:0  = pkt_cnt
+ * - bits 17:6  = blk_ack_resp_ssn
+ * - bits 31:30 = tx_resp_class */
+#define OW_TX_PKT_INFO2_PKT_CNT_MASK               0x3FU
+#define OW_TX_PKT_INFO2_BA_SSN_SHIFT               6U
+#define OW_TX_PKT_INFO2_RESP_CLASS_SHIFT           30U
+#define OW_TX_PKT_INFO2_RESP_CLASS_MASK            0x3U
+
+#define OW_TX_RESP_CLASS_NONE                      0U
+#define OW_TX_RESP_CLASS_ACK                       1U
+#define OW_TX_RESP_CLASS_BLOCKACK                  2U
+
+#define TX_INTF_NUM_ANTENNA                        2
+#define TX_INTF_NUM_BYTE_PER_DMA_SYMBOL            (64/8)
+#define TX_INTF_NUM_BYTE_PER_DMA_SYMBOL_IN_BITS    3
+
+enum tx_intf_mode {
+  TX_INTF_AXIS_LOOP_BACK = 0,
+  TX_INTF_BYPASS,
+  TX_INTF_BW_20MHZ_AT_0MHZ_ANT0,
+  TX_INTF_BW_20MHZ_AT_0MHZ_ANT1,
+  TX_INTF_BW_20MHZ_AT_0MHZ_ANT_BOTH,
+  TX_INTF_BW_20MHZ_AT_N_10MHZ_ANT0,
+  TX_INTF_BW_20MHZ_AT_P_10MHZ_ANT0,
+  TX_INTF_BW_20MHZ_AT_N_10MHZ_ANT1,
+  TX_INTF_BW_20MHZ_AT_P_10MHZ_ANT1,
