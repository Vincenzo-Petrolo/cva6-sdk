+/**
+ * @brief Append a human-readable CSMA CW register report to a sysfs buffer.
+ *
+ * The report uses the maintained queue order q0/q1/q2/q3 = VO/VI/BE/BK,
+ * shows decoded CSMA_CFG register state, and prints unsupported raw exponents
+ * honestly instead of implying that the RTL implements CW values above the
+ * supported exponent range.
+ *
+ * @param buf Output buffer.
+ * @param offset Current output offset in @p buf.
+ * @param tag Prefix describing the register source.
+ * @param reg_val Packed CSMA register value to decode.
+ * @return Updated output offset.
+ */
+static ssize_t openwifi_emit_cw_reg_report(char *buf, ssize_t offset, const char *tag, u32 reg_val)
+{
+  static const char * const ac_names[OW_NUM_HW_QUEUE] = {"VO", "VI", "BE", "BK"};
+  u8 cw_min_exp[OW_NUM_HW_QUEUE];
+  u8 cw_max_exp[OW_NUM_HW_QUEUE];
+  u32 cw_min_val;
+  u32 cw_max_val;
+  bool has_cw_min;
+  bool has_cw_max;
+  u8 queue;
+
+  openwifi_decode_cw_reg(reg_val, cw_min_exp, cw_max_exp);
+  offset += sysfs_emit_at(buf, offset, "%s CSMA_CFG raw: %08x\n", tag, reg_val);
+  for (queue = 0; queue < OW_NUM_HW_QUEUE; queue++) {
+    has_cw_min = openwifi_cw_exp_to_cw_value(cw_min_exp[queue], &cw_min_val);
+    has_cw_max = openwifi_cw_exp_to_cw_value(cw_max_exp[queue], &cw_max_val);
+    if (has_cw_min && has_cw_max) {
+      offset += sysfs_emit_at(buf, offset,
+        "%s CSMA_CFG q%u (%s): cw_min=%u (exp=%u) cw_max=%u (exp=%u)\n",
+        tag,
+        queue,
+        ac_names[queue],
+        cw_min_val,
+        cw_min_exp[queue],
+        cw_max_val,
+        cw_max_exp[queue]);
+    } else {
+      offset += sysfs_emit_at(buf, offset,
+        "%s CSMA_CFG q%u (%s): cw_min_exp=%u%s cw_max_exp=%u%s\n",
+        tag,
+        queue,
+        ac_names[queue],
+        cw_min_exp[queue],
+        has_cw_min ? "" : " (unsupported raw exponent)",
+        cw_max_exp[queue],
+        has_cw_max ? "" : " (unsupported raw exponent)");
+    }
+  }
+
+  return offset;
+}
+
+/**
+ * @brief Show live AIFS programming plus cached driver-visible EDCA state.
+ *
+ * The FPGA register stores the raw AIFSN nibble encoding. A raw nibble value
+ * of 0 means effective AIFSN 2 for legacy compatibility, so expose both raw
+ * and effective views here. TXOP is cached for observability only; the current
+ * RTL/driver path does not program TXOP into hardware. The live contender can
+ * still differ from the original mac80211 AC because sdr_tx.c may remap some
+ * small BE unicast traffic into VO before it reaches hardware. conf_tx rejects
+ * raw AIFSN values above the 4-bit hardware field, so the cache and live
+ * register should agree on the raw nibble after a successful update.
+ *
+ * @param input_dev Platform device backing the OpenWiFi driver.
+ * @param attr Sysfs attribute descriptor (unused).
+ * @param buf Output buffer.
+ * @return Number of bytes written to @p buf.
+ */
+static ssize_t aifs_cfg_show(struct device *input_dev, struct device_attribute *attr, char *buf)
+{
+  struct platform_device *pdev = to_platform_device(input_dev);
+  struct ieee80211_hw *dev = platform_get_drvdata(pdev);
+  struct openwifi_priv *priv = dev->priv;
+  u32 reg_val;
+  u8 raw_aifs[OW_NUM_HW_QUEUE];
+  u8 effective_aifs[OW_NUM_HW_QUEUE];
+  u16 requested_aifs[OW_NUM_HW_QUEUE];
+  u8 cached_effective_aifs[OW_NUM_HW_QUEUE];
+  u16 requested_txop[OW_NUM_HW_QUEUE];
+  ssize_t ret_size;
+  (void)attr;
+
+  reg_val = xpu_api->XPU_REG_AIFS_CFG_read();
+  openwifi_decode_aifs_reg(reg_val, raw_aifs);
+  effective_aifs[IEEE80211_AC_VO] = openwifi_aifs_raw_to_effective(raw_aifs[IEEE80211_AC_VO]);
+  effective_aifs[IEEE80211_AC_VI] = openwifi_aifs_raw_to_effective(raw_aifs[IEEE80211_AC_VI]);
+  effective_aifs[IEEE80211_AC_BE] = openwifi_aifs_raw_to_effective(raw_aifs[IEEE80211_AC_BE]);
+  effective_aifs[IEEE80211_AC_BK] = openwifi_aifs_raw_to_effective(raw_aifs[IEEE80211_AC_BK]);
+  requested_aifs[IEEE80211_AC_VO] = READ_ONCE(priv->requested_aifs[IEEE80211_AC_VO]);
+  requested_aifs[IEEE80211_AC_VI] = READ_ONCE(priv->requested_aifs[IEEE80211_AC_VI]);
+  requested_aifs[IEEE80211_AC_BE] = READ_ONCE(priv->requested_aifs[IEEE80211_AC_BE]);
+  requested_aifs[IEEE80211_AC_BK] = READ_ONCE(priv->requested_aifs[IEEE80211_AC_BK]);
+  cached_effective_aifs[IEEE80211_AC_VO] = openwifi_aifs_raw_to_effective((u8)requested_aifs[IEEE80211_AC_VO]);
+  cached_effective_aifs[IEEE80211_AC_VI] = openwifi_aifs_raw_to_effective((u8)requested_aifs[IEEE80211_AC_VI]);
+  cached_effective_aifs[IEEE80211_AC_BE] = openwifi_aifs_raw_to_effective((u8)requested_aifs[IEEE80211_AC_BE]);
+  cached_effective_aifs[IEEE80211_AC_BK] = openwifi_aifs_raw_to_effective((u8)requested_aifs[IEEE80211_AC_BK]);
+  requested_txop[IEEE80211_AC_VO] = READ_ONCE(priv->requested_txop[IEEE80211_AC_VO]);
+  requested_txop[IEEE80211_AC_VI] = READ_ONCE(priv->requested_txop[IEEE80211_AC_VI]);
+  requested_txop[IEEE80211_AC_BE] = READ_ONCE(priv->requested_txop[IEEE80211_AC_BE]);
+  requested_txop[IEEE80211_AC_BK] = READ_ONCE(priv->requested_txop[IEEE80211_AC_BK]);
+  ret_size = sysfs_emit(buf,
+    "FPGA AIFS_CFG raw: %08x\n"
+    "FPGA AIFSN raw q0/q1/q2/q3 (VO/VI/BE/BK): %u %u %u %u\n"
+    "FPGA AIFSN eff q0/q1/q2/q3 (VO/VI/BE/BK): %u %u %u %u\n"
+    "CACHE AIFSN raw q0/q1/q2/q3 (VO/VI/BE/BK): %u %u %u %u\n"
+    "CACHE AIFSN eff q0/q1/q2/q3 (VO/VI/BE/BK): %u %u %u %u\n"
+    "CACHE TXOP  q0/q1/q2/q3 (VO/VI/BE/BK): %u %u %u %u\n"
+    "NOTE: raw AIFSN 0 means effective AIFSN %u in the current RTL, and conf_tx rejects raw AIFSN values above %u. Effective arbitration still follows the encoded tx_queue_idx; small BE unicast frames may be promoted to VO by sdr_tx.c before they contend in hardware.\n",
+    reg_val,
+    raw_aifs[IEEE80211_AC_VO],
+    raw_aifs[IEEE80211_AC_VI],
+    raw_aifs[IEEE80211_AC_BE],
+    raw_aifs[IEEE80211_AC_BK],
+    effective_aifs[IEEE80211_AC_VO],
+    effective_aifs[IEEE80211_AC_VI],
+    effective_aifs[IEEE80211_AC_BE],
+    effective_aifs[IEEE80211_AC_BK],
+    requested_aifs[IEEE80211_AC_VO],
+    requested_aifs[IEEE80211_AC_VI],
+    requested_aifs[IEEE80211_AC_BE],
+    requested_aifs[IEEE80211_AC_BK],
+    cached_effective_aifs[IEEE80211_AC_VO],
+    cached_effective_aifs[IEEE80211_AC_VI],
+    cached_effective_aifs[IEEE80211_AC_BE],
+    cached_effective_aifs[IEEE80211_AC_BK],
+    requested_txop[IEEE80211_AC_VO],
+    requested_txop[IEEE80211_AC_VI],
+    requested_txop[IEEE80211_AC_BE],
+    requested_txop[IEEE80211_AC_BK],
+    OW_CONF_TX_AIFS_ZERO_EFFECTIVE,
+    OW_CONF_TX_AIFS_FIELD_MASK);
+
+  return ret_size;
+}
