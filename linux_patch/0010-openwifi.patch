+/* Maximum TX completions deferred to Phase TX-B (unlocked) per interrupt.
+ * Size this high enough to absorb most aggregate completions without tripping
+ * the kernel frame-size warning on the maintained targets. 56 entries keep the
+ * stack frame below the 2 KiB warning threshold while still making the inline
+ * overflow path much rarer than the original 16-entry budget. */
+#define OW_TX_DONE_BUDGET  56U
