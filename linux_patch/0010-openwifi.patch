+{
+  struct device_node *np = pdev->dev.of_node;
+  struct resource *io;
+  enum openwifi_fpga_type fpga_type;
+  int err=1;
+
+  printk("\n");
+
+  if (np) {
+    const struct of_device_id *match;
+
+    match = of_match_node(dev_of_ids, np);
