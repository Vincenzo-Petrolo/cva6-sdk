+static bool openwifi_reg_addr_in_allowlist(u32 reg_addr, const u32 *allowlist, size_t allowlist_size)
+{
+  size_t idx;
+
+  for (idx = 0; idx < allowlist_size; idx++) {
+    if (allowlist[idx] == reg_addr) {
+      return true;
+    }
+  }
+
+  return false;
+}
