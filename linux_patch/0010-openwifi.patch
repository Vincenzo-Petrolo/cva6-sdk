+/* AD9361 attenuation values are in mdB (milli-dB). */
+#define AD9361_RADIO_OFF_TX_ATT      89750U /* aligned with ADI ad9361.c mute attenuation */
+#define AD9361_RADIO_ON_TX_ATT       0U     /* aligned with rf_init.sh nominal TX-on attenuation */
