+// ------end of software and RF reg definition ------------
+
+// -------------dmesg printk control flag------------------
+#define DMESG_LOG_ERROR (1<<0)
+#define DMESG_LOG_UNICAST (1<<1)
+#define DMESG_LOG_BROADCAST (1<<2)
+#define DMESG_LOG_NORMAL_QUEUE_STOP (1<<3)
