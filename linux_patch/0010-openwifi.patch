+/**
+ * @brief Match SPI child device by DT node name.
+ *
+ * @param dev Candidate device.
+ * @param data Target node name string.
+ * @return Non-zero on match.
+ */
+static int custom_match_spi_dev(struct device *dev, const void *data)
+{
+  const char *name = data;
+  const char *node_name;
+  bool ret;
+
+  if (!dev->of_node || !dev->of_node->name) {
+    return 0;
+  }
+
+  node_name = dev->of_node->name;
+  ret = sysfs_streq(name, node_name);
+  printk("%s custom_match_spi_dev %s %s %d\n", sdr_compatible_str, name, node_name, ret);
+  return ret;
+}
