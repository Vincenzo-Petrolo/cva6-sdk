+  struct ieee80211_supported_band band_5GHz;
+  bool radio_enabled_cached;
+  u8   runtime_tx_ant_cfg;
+  u8   runtime_rx_ant_cfg;
+
+  int  rssi_correction; // dynamic RSSI correction according to current channel in _rf_set_channel()
+
+  enum rx_intf_mode     rx_intf_cfg;
+  enum tx_intf_mode     tx_intf_cfg;
+  enum openofdm_rx_mode openofdm_rx_cfg;
+  enum openofdm_tx_mode openofdm_tx_cfg;
+  enum xpu_mode         xpu_cfg;
+
+  int irq_rx;
+  int irq_tx;
+
+  u8                             *rx_cyclic_buf;
+  dma_addr_t                     rx_cyclic_buf_dma_mapping_addr;
+  struct dma_chan                *rx_chan;
+  struct dma_async_tx_descriptor *rxd;
+  dma_cookie_t                   rx_cookie;
+  void __iomem                   *rx_dma_regs;
+  enum openwifi_dma_backend      dma_backend;
+  struct delayed_work            rx_dma_watchdog_work;
+  bool                           rx_dma_watchdog_enabled;
+  u32                            rx_dma_wd_last_xfer_done;
+  u32                            rx_dma_wd_last_active_id;
+  u32                            rx_dma_wd_last_curr_dest;
+  u32                            rx_dma_wd_last_start_transfer;
+  u32                            rx_dma_wd_last_state_history;
+  u8                             rx_dma_wd_stall_count;
+  u8                             rx_dma_wd_rearm_grace_ticks;
+  struct ieee80211_hw            *hw;
+
+  struct openwifi_ring           tx_ring[MAX_NUM_SW_QUEUE];
+  struct scatterlist             tx_sg;
+  struct dma_chan                *tx_chan;
+  struct dma_async_tx_descriptor *txd;
+  dma_cookie_t                   tx_cookie;
+  // struct completion tx_dma_complete;
+  // bool openwifi_tx_first_time_run;
+
+  // int phy_tx_sn;
+  u32 slice_idx;
+  u32 dest_mac_addr_queue_map[MAX_NUM_HW_QUEUE];
+  u8  mac_addr[ETH_ALEN];
+  u16 own_mac_high16; /* cached MAC[0..1] for fast RX own-MAC check */
+  u32 own_mac_low32;  /* cached MAC[2..5] for fast RX own-MAC check */
+  u16 seqno;
+
+  bool use_short_slot;
+  u8   band;
+
+  u32 ampdu_reference;
+  /* Current RX BlockAck session contract:
+   * - one active peer/TID session at a time
+   * - used for STA operation and for AP mode when one peer owns RX BA
+   * - hardware enforces sender peer + TID before updating BA state
+   * - mac80211 keeps reorder buffering in software */
+  bool rx_ba_active;
+  u8   rx_ba_tid;
+  u16  rx_ba_ssn;
+  u16  rx_ba_buf_size;
+  u16  rx_ba_timeout_tu;
+  u8   rx_ba_peer_addr[ETH_ALEN];
+  /* Cached EDCA values for observability and CW override restore.
+   * These arrays may contain driver-seeded startup defaults before the first
+   * mac80211 conf_tx() update. The software array index matches the hardware
+   * queue byte order in XPU_REG_CSMA_CFG / XPU_REG_AIFS_CFG:
+   * q0=VO, q1=VI, q2=BE, q3=BK. */
+  u8   requested_cw_min_exp[MAX_NUM_HW_QUEUE];
+  u8   requested_cw_max_exp[MAX_NUM_HW_QUEUE];
+  u16  requested_aifs[MAX_NUM_HW_QUEUE];
+  u16  requested_txop[MAX_NUM_HW_QUEUE];
+  u8  rx_target_buf_idx_old;
+
+  /* Re-entrancy guard for openwifi_rx_interrupt (bit 0).
+   * Prevents a nested hardirq from entering Phase RX-B while the outer
+   * softirq is already in Phase RX-B — which would deliver newer slots
+   * before older ones (out-of-order delivery to mac80211).
+   * Uses test_and_set_bit/clear_bit for atomicity on both SMP and UP.
+   * Nested calls return IRQ_HANDLED immediately; the outer do-while loop
+   * drains remaining slots.  FPGA rx_pkt_intr is a pulse — no storm. */
+  unsigned long rx_processing;
+
+  /* Per-slot claim flag for 3-phase RX processing.
+   * Set to 1 under priv->lock in Phase RX-A; cleared to 0 under priv->lock
+   * in Phase RX-C.  Watchdog ring-clear skips claimed slots. */
+  u8  rx_slot_claimed[OW_NUM_RX_BD];
+  /* Rotating scan start for scan-all-slots mode.  Avoids always starting at
+   * slot 0, which can starve high-numbered slots under sustained load.
+   * Advanced in Phase RX-A to one past the last scanned position. */
+  u8  rx_scan_start_idx;
+  /* Aggregate-boundary cache is per hardware queue.
+   * TODO(openwifi-aggr-flow-table): if runtime validation still shows same-
+   * queue mixed traffic breaking continuity materially, promote this to a
+   * fuller per-(STA,TID,queue) table instead of one entry per queue. */
+  bool                 tx_aggr_prev_valid[MAX_NUM_HW_QUEUE];
+  struct ow_tx_aggr_key tx_aggr_prev_key[MAX_NUM_HW_QUEUE];
+  /* Live TX completion snapshot written by TX IRQ under priv->lock.
+   * SDRCTL must not read this tuple directly word-by-word because a later TX
+   * IRQ can otherwise mix fields from different completions. */
+  bool                 tx_pkt_info_last_valid;
+  u32                  tx_pkt_info_last[4];
+  /* Latched debug tuple served through SDRCTL PKT_INFO1-4.
+   * PKT_INFO1 snapshots tx_pkt_info_last[] into this cache under priv->lock,
+   * and PKT_INFO2-4 keep returning the same latched view until the next
+   * PKT_INFO1 refresh. */
+  bool                 tx_pkt_info_latched_valid;
+  u32                  tx_pkt_info_latched[4];
+
+  u32 drv_rx_reg_val[MAX_NUM_DRV_REG];
+  u32 drv_tx_reg_val[MAX_NUM_DRV_REG];
+  u32 drv_xpu_reg_val[MAX_NUM_DRV_REG];
+  int rf_reg_val[MAX_NUM_RF_REG];
+  int last_auto_fpga_lbt_th;
+
+  struct bin_attribute bin_iq;
+  u32                  tx_intf_arbitrary_iq[OPENWIFI_TX_INTF_ARBITRARY_IQ_MAX];
+  u16                  tx_intf_arbitrary_iq_num;
+  u8                   tx_intf_iq_ctl;
+
+  struct openwifi_stat stat;
+  // u8 num_led;
+  // struct led_classdev *led[MAX_NUM_LED];//zc706 has 4 user leds. please find openwifi_dev_probe to see how we get them.
+  // char led_name[MAX_NUM_LED][OPENWIFI_LED_MAX_NAME_LEN];
+
+  spinlock_t lock;
+  spinlock_t tx_submit_lock;
+
+  /* TX DMA stall containment
+   *
+   * tx_dma_stalled: set when DMA poll times out; gates TX submissions
+   *   and triggers the recovery worker.
+   *
+   * tx_dma_terminating: guards the unlock-to-terminate window during
+   *   escalation. dmaengine_terminate_sync() can sleep, so the spinlock
+   *   must be released before calling it. This flag is checked in
+   *   openwifi_tx() (entry bailout, fast-path stall-clear, pre-submit
+   *   recheck), in the TX IRQ stall-clear path, and in the worker's own
+   *   DMA_COMPLETE and reschedule paths. It prevents two classes of race:
+   *   (a) new TX submissions into a channel being terminated;
+   *   (b) stall-clear + queue-wake while the worker owns cleanup.
+   *   Normal recovery: set under priv->lock before sleeping terminate,
+   *   cleared under priv->lock after cleanup. Teardown (openwifi_stop)
+   *   and terminate failure: set permanently (never cleared). */
+  bool tx_dma_recovery_enabled;
+  bool tx_dma_stalled;
+  bool tx_dma_terminating;
+  struct delayed_work tx_stall_recovery_work;
+  unsigned long tx_dma_stall_first_jiffies;
+  u32 tx_dma_stall_window_count;
+  unsigned long tx_timeout_warn_jiffies;
+  u32 tx_dma_stall_recovery_cycles;
+
+  /* RX invalid header tracking */
+  u32 rx_invalid_header_count;
+  unsigned long rx_invalid_warn_jiffies;
+
+  /* RX callback/IRQ progress tracking */
+  /* rx_irq49_count counts real FPGA IRQ49 deliveries (irq != 0 path only). */
+  u32 rx_irq49_count;
+  u32 rx_dma_cb_count;
+  u32 rx_dma_cb_full_count;
+  u32 rx_dma_cb_last_irq49;
+  u32 rx_dma_cb_stall_count;
+  unsigned long rx_dma_cb_stall_start_jiffies;
+  unsigned long rx_dma_cb_last_full_jiffies;
+
+  u32 rx_dma_wd_restart_count;
+};
