+
+		default:
+			printk("%s hw_init mode %d is wrong!\n", openofdm_tx_compatible_str, mode);
+			err=1;
+	}
+
+	//rst
+	for (i=0;i<8;i++) {
+		openofdm_tx_api->OPENOFDM_TX_REG_MULTI_RST_write(0);
+	}
+	for (i=0;i<32;i++) {
+		openofdm_tx_api->OPENOFDM_TX_REG_MULTI_RST_write(0xFFFFFFFF);
