+      xpu_api->XPU_REG_SLICE_COUNT_TOTAL_write((priv->slice_idx<<20)|tmp);
+    }
+    return 0;
+  case OPENWIFI_CMD_GET_SLICE_TOTAL:
+    skb = (struct sk_buff *)cfg80211_testmode_alloc_reply_skb(hw->wiphy, nla_total_size(sizeof(u32)));
