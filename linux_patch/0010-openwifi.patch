+//=============================================================================
+// AMPDU and Ops Table
+//=============================================================================
+
+/**
+ * @brief Handle AMPDU state machine callbacks from mac80211.
+ *
+ * mac80211 source references for expected RX/TX callback ordering live in
+ * net/mac80211/agg-tx.c and net/mac80211/agg-rx.c in the active kernel tree.
+ *
+ * @param hw mac80211 hardware handle.
+ * @param vif Virtual interface.
+ * @param params AMPDU action parameters.
+ * @return 0 on handled actions, -EOPNOTSUPP otherwise.
+ *
+ * Current RX scope:
+ * - one active RX BlockAck peer/TID session at a time
+ * - RX BA start/stop is implemented for STA and the current AP path
+ * - additional AP-side RX BA sessions are rejected with -EBUSY
+ * - fuller AP multi-peer RX BA remains future work
+ * - hardware now receives the negotiated BA SSN together with sender address
+ *   and TID for the one active RX BA window
+ * - TX operational buf_size is clamped to the maintained deferred-status budget
+ *   (`OW_TX_DONE_BUDGET`, currently 56) and the hardware field width
+ * - mac80211 software reorder remains enabled
+ */
+static int openwifi_ampdu_action(struct ieee80211_hw *hw, struct ieee80211_vif *vif, struct ieee80211_ampdu_params *params)
+{
+  struct openwifi_priv *priv = hw->priv;
+  struct ieee80211_sta *sta;
+  enum ieee80211_ampdu_mlme_action action;
+  u16 max_tx_bytes;
+  u16 buf_size;
+  u16 rx_ba_ssn;
+  u32 ampdu_action_config;
+  unsigned long flags;
+
+  if (!params) {
+    return -EINVAL;
+  }
+  sta = params->sta;
+  action = params->action;
+
+  switch (action) {
+  case IEEE80211_AMPDU_TX_START:
+    if (!sta) {
+      return -EINVAL;
+    }
+    ieee80211_start_tx_ba_cb_irqsafe(vif, sta->addr, params->tid);
+    OW_U32_INC(priv->stat.tx_ampdu_tx_start_count);
+    printk("%s openwifi_ampdu_action: start TX aggregation. tid %d\n", sdr_compatible_str, params->tid);
+    break;
+  case IEEE80211_AMPDU_TX_STOP_CONT:
+  case IEEE80211_AMPDU_TX_STOP_FLUSH_CONT:
+    if (!sta) {
+      return -EINVAL;
+    }
+    ieee80211_stop_tx_ba_cb_irqsafe(vif, sta->addr, params->tid);
+    OW_U32_INC(priv->stat.tx_ampdu_tx_stop_count);
+    printk("%s openwifi_ampdu_action: stop TX aggregation. tid %d\n", sdr_compatible_str, params->tid);
+    break;
+  case IEEE80211_AMPDU_TX_STOP_FLUSH:
+    /* mac80211 API note: STOP_FLUSH does not require stop_tx_ba_cb_irqsafe(). */
+    OW_U32_INC(priv->stat.tx_ampdu_tx_stop_count);
+    printk("%s openwifi_ampdu_action: flush-stop TX aggregation. tid %d\n", sdr_compatible_str, params->tid);
+    break;
+  case IEEE80211_AMPDU_TX_OPERATIONAL:
+    if (!sta) {
+      return -EINVAL;
+    }
+    /* NOTE(openwifi-tx-ampdu-global-reg): TX_INTF_REG_AMPDU_ACTION_CONFIG is
+     * still one shared hardware register, not per peer/TID state. A later
+     * IEEE80211_AMPDU_TX_OPERATIONAL callback can therefore overwrite
+     * buf_size/density/max_tx_bytes for earlier peers or TIDs. Keep this
+     * acceptable limitation explicit until TX aggregation parameters grow a
+     * fuller per-flow hardware contract. Software also clamps buf_size to the
+     * maintained deferred-status budget (`OW_TX_DONE_BUDGET`, currently 56)
+     * so one aggregate completion IRQ never needs to surface more owner-state
+     * than the current driver bookkeeping can represent safely. */
+    buf_size = clamp_t(u16, params->buf_size, 1U,
+      min_t(u16, OW_AMPDU_BUF_SIZE_MAX, OW_AMPDU_STATUS_SAFE_BUF_SIZE_MAX));
+    max_tx_bytes = (u16)(BIT(IEEE80211_HT_MAX_AMPDU_FACTOR + sta->ht_cap.ampdu_factor) - 1U);
+    ampdu_action_config = (sta->ht_cap.ampdu_density << OW_AMPDU_ACTION_CONFIG_DENSITY_SHIFT) |
+      (buf_size << OW_AMPDU_ACTION_CONFIG_BUF_SIZE_SHIFT) |
+      max_tx_bytes;
+    tx_intf_api->TX_INTF_REG_AMPDU_ACTION_CONFIG_write(ampdu_action_config);
+    OW_U32_INC(priv->stat.tx_ampdu_tx_operational_count);
+    printk("%s openwifi_ampdu_action: TX operational. tid %d max_tx_bytes %d ampdu_density %d buf_size %d\n",
+      sdr_compatible_str, params->tid, max_tx_bytes, sta->ht_cap.ampdu_density, buf_size);
+    break;
+  case IEEE80211_AMPDU_RX_START:
+    if (!sta) {
+      return -EINVAL;
+    }
+    if (!openwifi_vif_supports_rx_ba(vif)) {
+      return -EOPNOTSUPP;
+    }
+    rx_ba_ssn = params->ssn & OW_XPU_AMPDU_RX_ACTION_SSN_MASK;
+    if (rx_ba_ssn != params->ssn) {
+      printk(KERN_WARNING "%s openwifi_ampdu_action: reject RX aggregation SSN %u for %pM tid %d; hardware contract is limited to 12-bit SSN\n",
+        sdr_compatible_str, params->ssn, sta->addr, params->tid);
+      return -ERANGE;
+    }
+
+    spin_lock_irqsave(&priv->lock, flags);
+    if (priv->rx_ba_active &&
+        (priv->rx_ba_tid != params->tid ||
+         !ether_addr_equal(priv->rx_ba_peer_addr, sta->addr))) {
+      OW_U32_INC(priv->stat.rx_ampdu_reject_count);
+      spin_unlock_irqrestore(&priv->lock, flags);
+      printk(KERN_WARNING "%s openwifi_ampdu_action: reject RX aggregation for %pM tid %d while %pM tid %d is active\n",
+        sdr_compatible_str, sta->addr, params->tid, priv->rx_ba_peer_addr, priv->rx_ba_tid);
+      return -EBUSY;
+    }
+
+    if (priv->rx_ba_active) {
+      /* Same-peer same-TID RX_START is a semantic restart: the hardware
+       * clear/start pulse resets BA history, so advance the software-side
+       * aggregate boundary as well. */
+      priv->ampdu_reference++;
+    }
+    priv->rx_ba_active = true;
+    priv->rx_ba_tid = params->tid;
+    priv->rx_ba_ssn = rx_ba_ssn;
+    priv->rx_ba_buf_size = params->buf_size;
+    priv->rx_ba_timeout_tu = params->timeout;
+    ether_addr_copy(priv->rx_ba_peer_addr, sta->addr);
+    openwifi_write_ampdu_rx_peer(sta->addr);
+    openwifi_write_ampdu_rx_action(true, params->tid, rx_ba_ssn, true);
+    spin_unlock_irqrestore(&priv->lock, flags);
+
+    OW_U32_INC(priv->stat.rx_ampdu_start_count);
+    printk("%s openwifi_ampdu_action: start RX aggregation for %pM tid %d ssn %u buf_size %u timeout %uTU\n",
+      sdr_compatible_str, sta->addr, params->tid, rx_ba_ssn, params->buf_size, params->timeout);
+    break;
+  case IEEE80211_AMPDU_RX_STOP:
+    if (!openwifi_vif_supports_rx_ba(vif)) {
+      return -EOPNOTSUPP;
+    }
+    spin_lock_irqsave(&priv->lock, flags);
+    if (priv->rx_ba_active &&
+        priv->rx_ba_tid == params->tid &&
+        (!sta || ether_addr_equal(priv->rx_ba_peer_addr, sta->addr))) {
+      openwifi_reset_rx_ba_session_locked(priv);
+      spin_unlock_irqrestore(&priv->lock, flags);
+    } else {
+      spin_unlock_irqrestore(&priv->lock, flags);
+      printk(KERN_INFO "%s openwifi_ampdu_action: RX stop for tid %d with no matching active session\n",
+        sdr_compatible_str, params->tid);
+    }
+    OW_U32_INC(priv->stat.rx_ampdu_stop_count);
+    printk("%s openwifi_ampdu_action: stop RX aggregation. tid %d\n", sdr_compatible_str, params->tid);
+    break;
+  default:
+    return -EOPNOTSUPP;
+  }
+
+  return 0;
+}
+
+/**
+ * @brief mac80211 operations table for OpenWiFi driver integration.
+ */
+static const struct ieee80211_ops openwifi_ops = {
+  .tx = openwifi_tx,
+  .start = openwifi_start,
+  .stop = openwifi_stop,
+  .add_interface = openwifi_add_interface,
+  .remove_interface = openwifi_remove_interface,
+  .sta_remove = openwifi_sta_remove,
+  .config = openwifi_config,
+  .set_antenna = openwifi_set_antenna,
+  .get_antenna = openwifi_get_antenna,
+  .bss_info_changed = openwifi_bss_info_changed,
+  .conf_tx = openwifi_conf_tx,
+  .prepare_multicast = openwifi_prepare_multicast,
+  .configure_filter = openwifi_configure_filter,
+  .rfkill_poll = openwifi_rfkill_poll,
+  .get_tsf = openwifi_get_tsf,
+  .set_tsf = openwifi_set_tsf,
+  .reset_tsf = openwifi_reset_tsf,
+  .set_rts_threshold = openwifi_set_rts_threshold,
+  .ampdu_action = openwifi_ampdu_action,
+  .testmode_cmd = openwifi_testmode_cmd,
+};
diff --git a/drivers/sdr_rx.c b/drivers/sdr_rx.c
new file mode 100644
index 0000000..36f81da
--- /dev/null
+++ b/drivers/sdr_rx.c
@@ -0,0 +1,1428 @@
+/**
+ * @file sdr_rx.c
+ * @brief RX DMA setup, watchdog, and RX interrupt handling helpers.
+ *
+ * Included only by sdr.c (single translation unit split).
+ *
+ * Runtime behavior notes:
+ * - RX DMA callback fallback policy:
+ *   run the full RX handler when IRQ49 stalls for N callbacks or T ms, and
+ *   also run it periodically (T ms cadence) even when IRQ49 is progressing.
+ */
+
+//=============================================================================
+// Deferred Performance Work (not blocking current commit)
+//=============================================================================
+/*
+ * TODO(openwifi-rx-napi): Convert RX processing from hardirq/callback to NAPI.
+ *   Currently dev_alloc_skb + NC memcpy + ieee80211_rx_irqsafe all run in
+ *   hardirq context.  NAPI would defer to softirq with IRQ coalescing, allow
+ *   napi_alloc_skb (per-CPU page fragments), and let the kernel balance RX vs
+ *   TX work via softirq scheduling.  Significant rework — the cyclic DMA +
+ *   FPGA slot-based design doesn't map directly to the NAPI poll model.
+ *   This is the highest-impact architectural change after the 3-phase refactor.
+ *
+ *
+ * TODO(openwifi-rx-skb-prealloc): Pre-allocated SKB pool for RX hot path.
+ *   dev_alloc_skb(len) per packet hits the SLUB allocator from hardirq context.
+ *   A pre-allocated ring of 8-16 SKBs (allocated during init, recycled after
+ *   mac80211 consumes them) would eliminate allocation jitter.  Moderate effort
+ *   due to pool management and refill logic.  On SMP=n the SLUB fast path is
+ *   cheap (~30 cycles), so the gain may be modest.
+ *
+ * TODO(openwifi-rx-zicbom-dma): Implement Zicbom in CVA6 for per-cacheline DMA
+ *   invalidation — eliminates NC read overhead for 1500B memcpy.
+ *
+ *   Current state: PMA NC region forces all DMA buffer reads to bypass L1.
+ *   NC reads go through LLC (not DDR) — the LLC still caches this range
+ *   (cheshire_pkg.sv:688-690: "LLC bounds use full LlcOutRegion, unchanged").
+ *   DMA writes also go through LLC, so data is likely LLC-resident when the
+ *   CPU reads it.  Cost: ~94 LLC accesses × 5-20 cycles = ~470-1880 cycles
+ *   per 1500B packet (LLC hit), much better than DDR but still slower than L1.
+ *
+ *   Target: cached DMA buffers + cbo.inval per slot before Phase RX-B read.
+ *   memcpy from L1-cached buffer would be ~2-5x faster (L1 hit after inval).
+ *   Gain depends on L1 line size — see cache line size note below.
+ *
+ *   Implementation roadmap (3 layers, all required):
+ *
+ *   1. CVA6 RTL — add Zicbom decoder + pipeline + cache wiring:
+ *      a. decoder.sv: funct3=010 (PREFETCH.R=0, CBO.CLEAN=1, CBO.FLUSH=2,
+ *         CBO.INVAL=6 encoded in funct12) currently decodes as illegal
+ *         (decoder.sv:452-466).  Add decode for CBO.INVAL (funct12=0x000,
+ *         funct3=010, opcode=MISC-MEM 0x0F).
+ *      b. Pipeline: route CBO.INVAL through issue → execute → cache port.
+ *         HPDCache already has CMO request ports as stubs (cva6.sv:1513-1536,
+ *         marked FIXME).  Wire decoded CBO.INVAL to dcache_cmo_req with
+ *         CMO_INVAL type.
+ *      c. HPDCache/wt_dcache: implement CMO_INVAL handler — invalidate the
+ *         cache line matching the address operand (rs1).  For write-through
+ *         L1, invalidate = clear valid bit (no writeback needed).
+ *      d. CSR: set cbo_block_size to L1 line size.  CVA6 wt_dcache has
+ *         DcacheLineWidth=128 bits = 16 bytes (cheshire_pkg.sv:797).
+ *         With 16B lines, 4096B slot = 256 cbo.inval instructions.
+ *         HPDCache uses 64B lines — if HPDCache is adopted, 64 cbo.inval.
+ *         Expose via riscv_cbom_block_size in DT or CSR enumerator.
+ *
+ *   2. Kernel (6.0+ or backport to 5.15):
+ *      a. CONFIG_RISCV_ISA_ZICBOM=y — enables arch/riscv/mm/dma-noncoherent.c
+ *         which implements dma_sync_*_for_cpu via cbo.inval loops.
+ *      b. DTS: remove DMA devices from reserved-memory NC pool (undo PMA NC
+ *         region workaround).  Let dma_alloc_coherent return normal cached
+ *         mapping.  Alternatively keep PMA NC for TX (device-coherent write)
+ *         and use cached + cbo.inval for RX only.
+ *      c. ARCH_HAS_SYNC_DMA_FOR_DEVICE + ARCH_HAS_SYNC_DMA_FOR_CPU must be
+ *         selected — these are the Kconfig symbols that enable the non-coherent
+ *         DMA path on RISC-V (broken/missing in 5.15, fixed in 6.0).
+ *      d. If backporting to 5.15: cherry-pick the riscv non-coherent DMA
+ *         series (merged in v6.0; Palmer Dabbelt / Christoph Hellwig).
+ *
+ *   3. OpenWiFi driver (this file):
+ *      a. Remove PMA NC workaround: let dma_alloc_coherent return cached buffer.
+ *      b. Phase RX-B: before reading slot metadata, call
+ *         dma_sync_single_for_cpu(dev, slot_dma_addr, RX_BD_BUF_SIZE,
+ *         DMA_FROM_DEVICE) — this issues cbo.inval for each cache line in the
+ *         slot.  With wt_dcache 16B lines: 4096/16 = 256 cbo.inval per slot.
+ *         With HPDCache 64B lines: 4096/64 = 64 cbo.inval per slot.
+ *      c. Phase RX-C: after clearing pkt-exist flag, no sync needed — flag
+ *         clear is a write (cbo.clean or writeback handled by write-through).
+ *      d. dma_rmb() remains after sync (ordering, not coherency).
+ *      e. Benchmark (wt_dcache 16B lines): 256 × cbo.inval (~1-5 cycles each,
+ *         ~256-1280 cycles total) vs current NC-through-LLC penalty (~470-1880
+ *         cycles for full 1500B memcpy at LLC latency).  Net gain with 16B
+ *         lines is marginal (~1-2x).  HPDCache with 64B lines (64 × cbo.inval
+ *         = ~64-320 cycles) gives a clearer win (~3-7x).  Zicbom is most
+ *         valuable when paired with HPDCache adoption.
+ *
+ *   Risk: CVA6 HPDCache CMO stubs may need non-trivial wiring.  Validate with
+ *   a standalone Zicbom test (cbo.inval loop + DMA write + read-back) before
+ *   integrating into the driver.
+ *
+ *   Cross-repo ownership:
+ *     Layer 1 (RTL):   theshire repo — hw/vendor/openhwgroup_cva6/ (decoder.sv,
+ *                      cva6.sv, cache subsystem).  After RTL change, rebuild
+ *                      bitstream with `make vivado-fpga-synth-zcu104` (theshire)
+ *                      or openwifi-hw `make build-rtl PLATFORM=theshire`.
+ *     Layer 2 (Kernel): theshire repo — sw/deps/cva6-sdk/ (defconfig + patches).
+ *                      May need kernel 6.0+ or backport patches in linux_patch/.
+ *     Layer 3 (Driver): openwifi repo — driver/sdr_rx.c (this file).  Edit here,
+ *                      then regen patch via `util/regen_openwifi_patch.sh`.
+ *
+ *   Ref: RISC-V Zicbom spec (ratified), arch/riscv/mm/dma-noncoherent.c,
+ *   CVA6 decoder.sv:452-466, cva6.sv:1513-1536 (CMO stubs).
+ *
+ * NOTE(openwifi-rx-processing-smp): The rx_processing re-entrancy guard uses
+ *   test_and_set_bit — atomic on both SMP and UP. On SMP, this prevents two
+ *   CPUs from both entering Phase RX-B, which would race on local_ampdu_ref
+ *   writeback in Phase RX-C while aggregated MPDUs are being delivered.
+ */
+
+/**
+ * @brief Decide whether RX AMPDU metadata matches the active BA session.
+ *
+ * The maintained XPU contract exposes one active RX BA peer/TID session plus
+ * the negotiated SSN used by the BA window logic. Guarding the mac80211 AMPDU
+ * metadata here intentionally keys only on peer/TID. The start SSN is written
+ * once at session start for the hardware BA window, but it is not a moving
+ * software receive-window cursor, so using it as a per-MPDU lower bound would
+ * eventually reject valid wrapped sequence numbers in long-lived sessions.
+ *
+ * @param priv Driver private state.
+ * @param hdr 802.11 header pointer for the received MPDU.
+ * @param len MPDU length in bytes.
+ * @return True when the frame matches the active RX BA peer/TID.
+ */
+static bool openwifi_rx_ampdu_details_allowed(
+  struct openwifi_priv *priv,
+  struct ieee80211_hdr *hdr,
+  u32 len)
+{
+  unsigned long flags;
+  unsigned int hdr_len_bytes;
+  bool allowed;
+
+  if (!ieee80211_is_data_qos(hdr->frame_control)) {
+    return false;
+  }
+
+  hdr_len_bytes = ieee80211_hdrlen(hdr->frame_control);
+  if (len < hdr_len_bytes) {
+    return false;
+  }
+
+  spin_lock_irqsave(&priv->lock, flags);
+  allowed = (priv->rx_ba_active &&
+    priv->rx_ba_tid == ieee80211_get_tid(hdr) &&
+    ether_addr_equal(priv->rx_ba_peer_addr, hdr->addr2));
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  return allowed;
+}
+
+//=============================================================================
+// RX Ring and DMA Register Helpers
+//=============================================================================
+
+#define OW_RX_DMA_RESET_PULSE_US          2U
+#define OW_RX_CB_LOG_EVERY_MASK           0x3FU
+#define OW_RX_DEBUG_IRQ_LOG_MASK          0xFFU
+#define OW_RX_DEBUG_EARLY_IRQ_DUMP_COUNT  3U
+#define OW_RX_PKT_HDR_DUMP_BYTES          16U
+
+#define OW_RX_RATE_PHASE_SHIFT            8U
+#define OW_RX_TSFT_HIGH_SHIFT            32U
+
+#define OW_RX_FRAME_MIN_LEN              14U
+#define OW_RX_SEQ_CTRL_MIN_LEN           28U
+
+#define OW_RX_RATE_IDX_MASK              0x1FU
+#define OW_RX_RATE_HT_FLAG               BIT(4)
+#define OW_RX_RATE_SHORT_GI_FLAG         BIT(5)
+#define OW_RX_RATE_HT_AGGR_FLAG          BIT(6)
+#define OW_RX_RATE_HT_AGGR_LAST_FLAG     BIT(7)
+#define OW_RX_FCS_VALID_MASK             0x80U
+/* RX metadata packs AGC/status in low 7 bits and pkt-exist in bit7.
+ * Keep 0x7F mask for stats extraction from agc_status_and_pkt_exist_flag.
+ * TODO(openwifi-rx-agc-mask-validate): re-validate metadata bit mapping
+ * against latest rx_intf_pl_to_m_axis.v whenever RX header format changes. */
+#define OW_RX_AGC_VALUE_MASK             0x7FU
+#define OW_RX_PKT_EXIST_FLAG_CLEAR        0U
+
+#define OW_RX_RSSI_DBM_MIN             (-128)
+
+#define OW_MAC_ADDR_BCAST_LOW32          0xFFFFFFFFU
+#define OW_MAC_ADDR_BCAST_HIGH16         0xFFFFU
+
+/**
+ * @brief Read little-endian 16-bit value from an unaligned byte buffer.
+ *
+ * @param base Base pointer.
+ * @param offset_bytes Byte offset from @p base.
+ * @return 16-bit value.
+ */
+static inline u16 ow_rx_read_u16(const u8 *base, u32 offset_bytes)
+{
+  return get_unaligned_le16(base + offset_bytes);
+}
+
+/**
+ * @brief Read little-endian 32-bit value from an unaligned byte buffer.
+ *
+ * @param base Base pointer.
+ * @param offset_bytes Byte offset from @p base.
+ * @return 32-bit value.
+ */
+static inline u32 ow_rx_read_u32(const u8 *base, u32 offset_bytes)
+{
+  return get_unaligned_le32(base + offset_bytes);
+}
+
+/**
+ * @brief Write little-endian 16-bit value to an unaligned byte buffer.
+ *
+ * @param base Base pointer.
+ * @param offset_bytes Byte offset from @p base.
+ * @param value Value to write.
+ */
+static inline void ow_rx_write_u16(u8 *base, u32 offset_bytes, u16 value)
+{
+  put_unaligned_le16(value, base + offset_bytes);
+}
+
+/**
+ * @brief Get RX slot packet-exist/AGC marker field.
+ *
+ * @param slot_base RX slot start pointer.
+ * @return Packet-exist/AGC marker value.
+ */
+static inline u16 ow_rx_slot_flag_get(const u8 *slot_base)
+{
+  return ow_rx_read_u16(slot_base, RX_BUF_PKT_EXIST_FLAG_OFFSET);
+}
+
+/**
+ * @brief Clear RX slot packet-exist marker.
+ *
+ * @param slot_base RX slot start pointer.
+ */
+static inline void ow_rx_slot_flag_clear(u8 *slot_base)
+{
+  ow_rx_write_u16(slot_base, RX_BUF_PKT_EXIST_FLAG_OFFSET, OW_RX_PKT_EXIST_FLAG_CLEAR);
+}
+
+/**
+ * @brief Decode MAC address bytes into high16/low32 words.
+ *
+ * @param mac_addr Pointer to 6-byte MAC address.
+ * @param addr_high16_out Output high 16 bits.
+ * @param addr_low32_out Output low 32 bits.
+ */
+static inline void ow_rx_get_mac_parts(const u8 *mac_addr, u16 *addr_high16_out, u32 *addr_low32_out)
+{
+  *addr_high16_out = ow_rx_read_u16(mac_addr, OW_IEEE80211_MAC_ADDR_HIGH_OFFSET_BYTES);
+  *addr_low32_out = ow_rx_read_u32(mac_addr, OW_IEEE80211_MAC_ADDR_LOW_OFFSET_BYTES);
+}
+
+/**
+ * @brief Check whether decoded MAC words are broadcast address.
+ *
+ * @param addr_high16 MAC high 16 bits.
+ * @param addr_low32 MAC low 32 bits.
+ * @return true when address is FF:FF:FF:FF:FF:FF.
+ */
+static inline bool ow_rx_is_broadcast_addr(u16 addr_high16, u32 addr_low32)
+{
+  return (addr_low32 == OW_MAC_ADDR_BCAST_LOW32) && (addr_high16 == OW_MAC_ADDR_BCAST_HIGH16);
+}
+
+/**
+ * @brief Check whether decoded MAC words match this interface MAC.
+ *
+ * @param priv Driver private state.
+ * @param addr_high16 Candidate MAC high 16 bits.
+ * @param addr_low32 Candidate MAC low 32 bits.
+ * @return true when destination address matches interface MAC.
+ */
+static inline bool ow_rx_is_own_mac(const struct openwifi_priv *priv, u16 addr_high16, u32 addr_low32)
+{
+  return (addr_low32 == priv->own_mac_low32) && (addr_high16 == priv->own_mac_high16);
+}
+
+/**
+ * @brief Check whether sender address passes RX statistics sender filter.
+ *
+ * Legacy compatibility:
+ * - target_high16 == 0 and target_low32 != 0 keeps low32-only match behavior.
+ * - target_high16 != 0 and target_low32 != 0 uses full 48-bit match.
+ * - target_high16 == 0 and target_low32 == 0 is wildcard.
+ *
+ * @param sender_high16 Sender MAC high 16 bits.
+ * @param sender_low32 Sender MAC low 32 bits.
+ * @param target_low32 Configured filter low 32 bits (0 means wildcard).
+ * @param target_high16 Configured filter high 16 bits.
+ * @return true when sender passes filter.
+ */
+static inline bool ow_rx_sender_filter_match(u16 sender_high16, u32 sender_low32, u16 target_high16, u32 target_low32)
+{
+  if (target_low32 == OW_TARGET_SENDER_LOW32_WILDCARD
+      && target_high16 == OW_TARGET_SENDER_HIGH16_WILDCARD) {
+    return true;
+  }
+  if (target_high16 == OW_TARGET_SENDER_HIGH16_WILDCARD) {
+    return (sender_low32 == target_low32);
+  }
+  return (sender_low32 == target_low32) && (sender_high16 == target_high16);
+}
+
+/**
+ * @brief Check whether RX PHY state history indicates idle/no-traffic.
+ *
+ * @param state_history Raw state-history register value.
+ * @return true when history matches known idle encodings.
+ */
+static bool ow_rx_phy_is_idle(u32 state_history)
+{
+  return (state_history == OW_RX_PHY_IDLE_STATE_HISTORY)
+      || (state_history == OW_RX_PHY_IDLE_STATE_HISTORY_ALT)
+      || (state_history == OW_RX_PHY_IDLE_STATE_RESET)
+      || (state_history == OW_RX_PHY_IDLE_STATE_MIN);
+}
+
+/**
+ * @brief Print ADI RX DMA register snapshot for diagnostics.
+ *
+ * @param priv Driver private state.
+ * @param tag Caller context tag.
+ */
+static void openwifi_rx_dma_log_regs(struct openwifi_priv *priv, const char *tag)
+{
+  u32 start_transfer;
+  u32 xfer_done;
+  u32 active_id;
+  u32 curr_dest;
+  u32 irq_mask;
+  u32 irq_pending;
+  u32 irq_source;
+
+  if (!priv || !priv->rx_dma_regs || priv->dma_backend != OPENWIFI_DMA_ADI) {
+    return;
+  }
+
+  start_transfer = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_START_TRANSFER);
+  xfer_done = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_TRANSFER_DONE);
+  active_id = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_ACTIVE_TRANSFER_ID);
+  /* TODO(openwifi-rx-watchdog-dmac-debug-reg): CURRENT_DEST_ADDR may depend on
+   * DMAC debug-register build options in some HDL configurations.
+   * If debug regs are disabled, this signal can be static/zero and should not
+   * dominate watchdog progress decisions. Keep ACTIVE_ID/TRANSFER_DONE checks as
+   * primary signals and gate CURRENT_DEST_ADDR usage by verified platform
+   * capability when adding backend variants. */
+  curr_dest = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_CURRENT_DEST_ADDR);
+  irq_mask = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_IRQ_MASK);
+  irq_pending = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_IRQ_PENDING);
+  irq_source = readl(priv->rx_dma_regs + OW_AXI_DMAC_REG_IRQ_SOURCE);
+
+  printk(KERN_INFO "%s %s: start=0x%08x done=0x%08x active_id=0x%08x curr_dest=0x%08x irq_mask=0x%08x irq_pending=0x%08x irq_source=0x%08x\n",
+    sdr_compatible_str, tag, start_transfer, xfer_done, active_id, curr_dest, irq_mask, irq_pending, irq_source);
+}
+
+/**
+ * @brief Clear RX slot packet-exist flags in the cyclic RX buffer.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_clear_rx_ring_flags(struct openwifi_priv *priv)
+{
+  int i;
+  u8 *pdata_tmp;
+
+  for (i = 0; i < NUM_RX_BD; i++) {
+    /* Skip slots currently claimed by Phase RX-A/RX-B — Phase RX-C will clear them. */
+    if (priv->rx_slot_claimed[i]) {
+      continue;
+    }
+    pdata_tmp = priv->rx_cyclic_buf + i * RX_BD_BUF_SIZE;
+    ow_rx_slot_flag_clear(pdata_tmp);
+  }
+  priv->rx_target_buf_idx_old = 0;
+}
+
+/**
+ * @brief Allocate and initialize the coherent RX cyclic buffer.
+ *
+ * @param priv Driver private state.
+ * @return 0 on success, -1 on allocation failure.
+ */
+static int openwifi_init_rx_ring(struct openwifi_priv *priv)
+{
+  priv->rx_cyclic_buf = dma_alloc_coherent(priv->rx_chan->device->dev,
+    RX_BD_BUF_SIZE * NUM_RX_BD, &priv->rx_cyclic_buf_dma_mapping_addr, GFP_KERNEL);
+  if (!priv->rx_cyclic_buf) {
+    /* Allocation failed: there is no valid buffer to free here. */
+    printk("%s openwifi_init_rx_ring: WARNING dma_alloc_coherent failed!\n", sdr_compatible_str);
+    return -1;
+  }
+
+  /* Set pkt-exist flags to 0. Non-zero flags are interpreted as valid packets. */
+  openwifi_clear_rx_ring_flags(priv);
+  printk("%s openwifi_init_rx_ring: NUM_RX_BD %d RX_BD_BUF_SIZE %d pkt existing flag are cleared!\n",
+    sdr_compatible_str, NUM_RX_BD, RX_BD_BUF_SIZE);
+
+  return 0;
+}
+
+/**
+ * @brief Free the coherent RX cyclic buffer.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_free_rx_ring(struct openwifi_priv *priv)
+{
+  if (priv->rx_cyclic_buf) {
+    dma_free_coherent(priv->rx_chan->device->dev, RX_BD_BUF_SIZE * NUM_RX_BD,
+      priv->rx_cyclic_buf, priv->rx_cyclic_buf_dma_mapping_addr);
+  }
+
+  priv->rx_cyclic_buf_dma_mapping_addr = 0;
+  priv->rx_cyclic_buf = NULL;
+}
+
+/**
+ * @brief Map ADI RX DMA register space for watchdog diagnostics.
+ *
+ * @param priv Driver private state.
+ * @return 0 on success, negative errno on failure.
+ */
+static int openwifi_map_rx_dma_regs(struct openwifi_priv *priv)
+{
+  struct resource res;
+  int ret;
+  resource_size_t size;
+  struct device_node *np;
+
+  priv->rx_dma_regs = NULL;
+
+  /* Map ADI DMAC registers only.
+   * These offsets are ADI-specific and invalid on Xilinx backend. */
+  if (priv->dma_backend != OPENWIFI_DMA_ADI) {
+    return 0;
+  }
+
+  if (!priv->rx_chan || !priv->rx_chan->device || !priv->rx_chan->device->dev) {
+    return -ENODEV;
+  }
+
+  np = priv->rx_chan->device->dev->of_node;
+  if (!np) {
+    return -ENODEV;
+  }
+
+  ret = of_address_to_resource(np, 0, &res);
+  if (ret) {
+    return ret;
+  }
+
+  size = resource_size(&res);
+  priv->rx_dma_regs = ioremap(res.start, size);
+  if (!priv->rx_dma_regs) {
+    return -ENOMEM;
+  }
+
+  return 0;
+}
+
+/**
+ * @brief Match compatible strings by vendor/IP prefix.
+ *
+ * @param np Device-tree node to inspect.
+ * @param compatible_prefix Prefix such as "adi,axi-dmac" or "xlnx,axi-dma".
+ * @return true when any compatible entry begins with the prefix.
+ */
+static bool openwifi_of_has_compatible_prefix(struct device_node *np, const char *compatible_prefix)
+{
+  const char *compat;
+  int idx_compat;
+  int num_compat;
+  size_t prefix_len;
+
+  if (!np || !compatible_prefix) {
+    return false;
+  }
+
+  num_compat = of_property_count_strings(np, "compatible");
+  if (num_compat <= 0) {
+    return false;
+  }
+
+  prefix_len = strlen(compatible_prefix);
+  for (idx_compat = 0; idx_compat < num_compat; idx_compat++) {
+    if (of_property_read_string_index(np, "compatible", idx_compat, &compat)) {
+      continue;
+    }
+    if (!strncmp(compat, compatible_prefix, prefix_len)) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+/**
+ * @brief Classify DMA backend from the DMA channel DT compatible string.
+ *
+ * @param chan DMA channel pointer returned by dma_request_chan().
+ * @return OPENWIFI_DMA_ADI, OPENWIFI_DMA_XILINX, or OPENWIFI_DMA_UNKNOWN.
+ */
+static enum openwifi_dma_backend openwifi_classify_dma_backend(struct dma_chan *chan)
+{
+  struct device_node *np;
+  struct device_node *np_parent;
+  const char *driver_name;
+
+  if (!chan || !chan->device || !chan->device->dev) {
+    return OPENWIFI_DMA_UNKNOWN;
+  }
+
+  np = chan->device->dev->of_node;
+  if (!np) {
+    return OPENWIFI_DMA_UNKNOWN;
+  }
+
+  np_parent = np->parent;
+
+  /* Accept versioned compatible strings and channel-node/controller-node variations. */
+  if (openwifi_of_has_compatible_prefix(np, "adi,axi-dmac")
+      || openwifi_of_has_compatible_prefix(np_parent, "adi,axi-dmac")) {
+    return OPENWIFI_DMA_ADI;
+  }
+  if (openwifi_of_has_compatible_prefix(np, "xlnx,axi-dma")
+      || openwifi_of_has_compatible_prefix(np_parent, "xlnx,axi-dma")) {
+    return OPENWIFI_DMA_XILINX;
+  }
+
+  /* Last-resort fallback from bound DMA driver name. */
+  driver_name = chan->device->dev->driver ? chan->device->dev->driver->name : NULL;
+  if (driver_name) {
+    if (strstr(driver_name, "axi_dmac") || strstr(driver_name, "dma-axi-dmac")) {
+      return OPENWIFI_DMA_ADI;
+    }
+    if (strstr(driver_name, "xilinx-dma")
+        || strstr(driver_name, "xilinx_dma")) {
+      return OPENWIFI_DMA_XILINX;
+    }
+  }
+
+  return OPENWIFI_DMA_UNKNOWN;
+}
+
+/**
+ * @brief Unmap previously mapped ADI RX DMA register space.
+ *
+ * @param priv Driver private state.
+ */
+static void openwifi_unmap_rx_dma_regs(struct openwifi_priv *priv)
+{
+  if (priv->rx_dma_regs) {
+    iounmap(priv->rx_dma_regs);
+    priv->rx_dma_regs = NULL;
+  }
+}
