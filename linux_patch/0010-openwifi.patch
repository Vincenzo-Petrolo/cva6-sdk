+#define MAX_PHY_TX_SN ((1 << NUM_BIT_MAX_PHY_TX_SN) - 1)
+#define OPENWIFI_TX_SEQ_INVALID            0xFFFFU
+#define OPENWIFI_TX_PRIO_INVALID           0xFFU
