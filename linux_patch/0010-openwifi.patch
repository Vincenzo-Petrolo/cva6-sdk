+#define DRV_RX_REG_IDX_PRINT_CFG   (MAX_NUM_DRV_REG-1)
+
+#define DRV_XPU_REG_IDX_LBT_TH     0
+#define DRV_XPU_REG_IDX_GIT_REV    (MAX_NUM_DRV_REG-1)
