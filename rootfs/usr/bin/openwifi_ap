#!/bin/sh
#******************************************************************************
# openwifi_ap — AP mode helper for OpenWiFi on CVA6 Linux target
#
# Starts/stops hostapd + udhcpd for WiFi AP mode.
# This remains useful for controlled AP-side testing on theshire/CVA6 even
# though STA mode is still the primary deployment path.
#
# KNOWN LIMITATION: TX/data reliability is still degraded. Beacons broadcast and
# client association can complete, but DHCP/data traffic remains unreliable due
# to high data-frame ACK failure rate. The bundled hostapd config keeps
# `wmm_enabled=1` explicit for deterministic HT/AMPDU negotiation during AP
# testing. See parent theshire docs: `docs/guide_debug_openwifi.md` and
# `docs/guide_test_throughput.md`.
#
# Supported commands:
#   start   — start AP mode on wlan0
#   stop    — stop AP mode on wlan0
#   status  — show AP status on wlan0
#******************************************************************************

set -eu

#==============================================================================
# Constants
#==============================================================================
PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly RUNTIME_DIR="/run/openwifi"
readonly HOSTAPD_CONF="/etc/openwifi/hostapd-openwifi.conf"
readonly UDHCPD_CONF="/etc/openwifi/udhcpd-openwifi.conf"
readonly AP_SUBNET="192.168.44.1/24"
readonly AP_IFACE="wlan0"

#==============================================================================
# Helpers
#==============================================================================

usage() {
  echo "Usage:"
  echo "  openwifi_ap start"
  echo "  openwifi_ap stop"
  echo "  openwifi_ap status"
}

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

warn_tx_ack() {
  echo ""
  echo "WARNING: AP mode is still degraded for DHCP/data traffic."
  echo "  Beacons broadcast — AP is VISIBLE to nearby devices."
  echo "  Client association may succeed, but DHCP/data traffic remains unreliable."
  echo "  This AP path is still useful for controlled Wi-Fi-side testing."
  echo "  See parent theshire docs: docs/guide_debug_openwifi.md and docs/guide_test_throughput.md"
  echo ""
}

#==============================================================================
# Commands
#==============================================================================

do_start() {
  iface="$AP_IFACE"

  need_cmd hostapd
  need_cmd udhcpd
  need_cmd iw
  need_cmd ip

  mkdir -p "$RUNTIME_DIR"

  # Kill any running wpa_supplicant (nl80211 interface ownership conflict)
  if [ -f "$RUNTIME_DIR/wpa_supplicant-${iface}.pid" ]; then
    pid=$(cat "$RUNTIME_DIR/wpa_supplicant-${iface}.pid")
    if kill -0 "$pid" 2>/dev/null; then
      echo "Stopping wpa_supplicant (pid $pid) to release interface..."
      kill "$pid"
      sleep 1
    fi
  fi

  # Ensure regulatory domain is set (S80openwifi sets this at boot,
  # but check as a safety net)
  if ! iw reg get | grep -q '^country CH:'; then
    iw reg set CH
  fi

  # Create lease directory and file (busybox udhcpd requires the lease file to exist)
  mkdir -p /var/lib/misc
  touch /var/lib/misc/udhcpd.leases

  # Configure interface
  ip link set "$iface" up
  ip addr add "$AP_SUBNET" dev "$iface" 2>/dev/null || true

  # Start hostapd
  echo "Starting hostapd..."
  hostapd -B -P "$RUNTIME_DIR/hostapd-${iface}.pid" "$HOSTAPD_CONF"

  # Start udhcpd
  echo "Starting udhcpd..."
  udhcpd "$UDHCPD_CONF"

  warn_tx_ack
  echo "AP started on $iface (SSID: theshire, channel: 36)"
}

do_stop() {
  iface="$AP_IFACE"

  # Stop hostapd
  if [ -f "$RUNTIME_DIR/hostapd-${iface}.pid" ]; then
    pid=$(cat "$RUNTIME_DIR/hostapd-${iface}.pid")
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid"
      echo "hostapd stopped"
    fi
  fi

  # Stop udhcpd (no PID file by default — kill by name)
  if command -v killall >/dev/null 2>&1; then
    killall udhcpd 2>/dev/null || true
  fi

  # Clean up interface
  ip addr flush dev "$iface" 2>/dev/null || true
  ip link set "$iface" down 2>/dev/null || true

  echo "AP stopped on $iface"
}

do_status() {
  iface="$AP_IFACE"

  echo "=== Interface ==="
  ip addr show "$iface" 2>/dev/null || echo "$iface not found"

  echo ""
  echo "=== hostapd ==="
  if [ -f "$RUNTIME_DIR/hostapd-${iface}.pid" ]; then
    pid=$(cat "$RUNTIME_DIR/hostapd-${iface}.pid")
    if kill -0 "$pid" 2>/dev/null; then
      echo "Running (pid $pid)"
    else
      echo "Not running (stale PID file)"
    fi
  else
    echo "Not running"
  fi

  echo ""
  echo "=== udhcpd leases ==="
  if [ -f /var/lib/misc/udhcpd.leases ]; then
    cat /var/lib/misc/udhcpd.leases
  else
    echo "No lease file"
  fi
}

#==============================================================================
# Main
#==============================================================================

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

cmd="$1"
shift

if [ $# -gt 0 ]; then
  echo "This helper is wlan0-only; extra arguments are not supported." >&2
  usage
  exit 1
fi

case "$cmd" in
  start)  do_start ;;
  stop)   do_stop ;;
  status) do_status ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
