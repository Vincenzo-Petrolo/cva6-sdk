#==============================================================================
# Buildroot 64-bit defconfig — CVA6 (Cheshire) ZCU104 + OpenWiFi
#
# Structure:
#   - Architecture/toolchain and rootfs/kernel sections are build infrastructure
#   - Required packages: core platform operation (WiFi, SSH, basic networking)
#   - Optional packages: improve usability, can be commented out to save image
#
# Topics may appear in both Required and Optional (e.g., Network has core
# connectivity tools in Required and diagnostic tools in Optional).
#
# Rebuild with: make chs-linux-rebuild (from repo root)
#==============================================================================

#==============================================================================
# Architecture and toolchain
#==============================================================================
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_CUSTOM_RVM=y
BR2_RISCV_ISA_CUSTOM_RVF=y
BR2_RISCV_ISA_CUSTOM_RVD=y
BR2_RISCV_ISA_CUSTOM_RVC=y
BR2_CCACHE=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_10=y

#==============================================================================
# Rootfs and kernel
#==============================================================================
BR2_ROOTFS_OVERLAY="../rootfs"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v5.10.7"
BR2_LINUX_KERNEL_PATCH="../linux_patch/"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="../configs/linux64_openwifi_defconfig"
BR2_LINUX_KERNEL_VMLINUX=y

# devtmpfs: create device nodes at runtime based on detected hardware
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_ROOTFS_DEVICE_TABLE=""

BR2_PACKAGE_BUSYBOX_CONFIG="../configs/busybox64.config"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

#==============================================================================
# Required packages — core platform operation
#==============================================================================

#------------------------------------------------------------------------------
# WiFi — client + AP mode (no Ethernet on Theshire)
#------------------------------------------------------------------------------
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y

# OpenWiFi userspace tools (build from committed bundled package sources)
BR2_PACKAGE_OPENWIFI_SDRCTL=y
BR2_PACKAGE_OPENWIFI_SIDE_CH_CTL=y
BR2_PACKAGE_OPENWIFI_INJECT_80211=y

#------------------------------------------------------------------------------
# Remote access — SSH over WiFi (Dropbear: ~110 KB, includes scp)
#------------------------------------------------------------------------------
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_HAVEGED=y

#------------------------------------------------------------------------------
# Network — core connectivity
#------------------------------------------------------------------------------
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_NETCAT=y

#------------------------------------------------------------------------------
# File transfer — serial fallback (works before WiFi is up)
#------------------------------------------------------------------------------
BR2_PACKAGE_LRZSZ=y

#------------------------------------------------------------------------------
# Hardware debugging — core
#------------------------------------------------------------------------------
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_LINUX_TOOLS_PERF=y
BR2_PACKAGE_TRACE_CMD=y

#==============================================================================
# Optional packages — comment out to save image size
#==============================================================================

#------------------------------------------------------------------------------
# Shell — full GNU bash (for upstream OpenWiFi scripts with bash-isms)
#------------------------------------------------------------------------------
BR2_PACKAGE_BASH=y

#------------------------------------------------------------------------------
# WiFi — AP mode testing (beacons visible; client assoc blocked by TX ACK timing)
#------------------------------------------------------------------------------
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_LIBPCAP=y

#------------------------------------------------------------------------------
# Network — diagnostics and testing
#------------------------------------------------------------------------------
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_TCPDUMP=y

#------------------------------------------------------------------------------
# File transfer — network (requires WiFi)
#------------------------------------------------------------------------------
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_LIBNFS=y
BR2_PACKAGE_SOCAT=y

#------------------------------------------------------------------------------
# Hardware debugging — specialized
#------------------------------------------------------------------------------
BR2_PACKAGE_SPIDEV_TEST=y

#------------------------------------------------------------------------------
# System monitoring
#------------------------------------------------------------------------------
BR2_PACKAGE_HTOP=y

#------------------------------------------------------------------------------
# Terminal multiplexer — detach/reattach sessions over SSH
#------------------------------------------------------------------------------
BR2_PACKAGE_TMUX=y

#------------------------------------------------------------------------------
# Benchmarks
#------------------------------------------------------------------------------
BR2_PACKAGE_DHRYSTONE=y
BR2_PACKAGE_MEMSTAT=y
BR2_PACKAGE_RAMSPEED=y
BR2_PACKAGE_EASYPERF=y
BR2_PACKAGE_MATMUL=y
BR2_PACKAGE_COREMARK=y

#------------------------------------------------------------------------------
# System utilities — small, useful for hardware debugging
#------------------------------------------------------------------------------
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_BC=y

#------------------------------------------------------------------------------
# Convenience
#------------------------------------------------------------------------------
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_NANO=y
